cabal-version: 3.0
name: cfta-liquid
version: 0.1.0.0
synopsis: Refinement generators from Liquid Haskell specifications
description:
  Translate the Liquid Haskell specification of a datatype (its data
  specification, its measure, and its refinement aliases) into the
  annotations of the refinement generators of cfta-generator. The parser
  of liquidhaskell-boot reads the specification, without a GHC session.

homepage: https://github.com/TharkunAB/cfta/tree/main/cfta-liquid#readme
bug-reports: https://github.com/TharkunAB/cfta/issues
category: Testing
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Tharkun AB
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/TharkunAB/cfta.git
  subdir: cfta-liquid

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wno-pattern-namespace-specifier

library
  import: warnings
  default-language: Haskell2010
  default-extensions:
    NamedFieldPuns
    ScopedTypeVariables
    TypeApplications

  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Liquid
    Data.CFTA.Liquid.TH

  build-depends:
    base >=4.22 && <4.23,
    cfta >=0.1.0.0 && <0.2,
    cfta-generator >=0.1.0.0 && <0.2,
    containers >=0.8 && <0.9,
    liquid-fixpoint >=0.9.6.3.7 && <0.10,
    liquidhaskell-boot >=0.9.14.1 && <0.9.15,
    megaparsec >=9.8 && <9.9,
    pretty >=1.1 && <1.2,
    template-haskell >=2.24 && <2.25,

test-suite liquid-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: LiquidSpec.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -rtsopts
  build-depends:
    base >=4.22 && <4.23,
    cfta >=0.1.0.0 && <0.2,
    cfta-generator >=0.1.0.0 && <0.2,
    cfta-liquid,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    hspec >=2.11 && <2.12,
