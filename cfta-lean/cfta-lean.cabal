cabal-version: 3.0
name: cfta-lean
version: 0.1.0.0
synopsis: Component synthesis checked inside Lean's elaborator
description:
  Hectare's equality-constrained automaton proposes programs over Lean
  constants, and a walk in Lean's MetaM checks them prefix by prefix: it
  instantiates the constants, unifies their types with isDefEq, and
  synthesizes their instances. The Lean side is a Lake project in
  oracle/, which runs as a child process.

homepage: https://github.com/TharkunAB/cfta/tree/main/cfta-lean#readme
bug-reports: https://github.com/TharkunAB/cfta/issues
category: Development
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/TharkunAB/cfta.git
  subdir: cfta-lean

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules: Data.CFTA.Lean
  build-depends:
    base >=4.22 && <4.23,
    cfta-generator >=0.1.0.0 && <0.2,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,

executable hectare-propose
  import: warnings
  default-language: Haskell2010
  main-is: HectarePropose.hs
  hs-source-dirs: app
  build-depends:
    base >=4.22 && <4.23,
    cfta-generator,
    cfta-lean,
    text >=2.1 && <2.2,

benchmark hectare-lean
  import: warnings
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: HectareLean.hs
  hs-source-dirs: benchmarks
  -- No -threaded: the benchmark runs one child at a time, and a blocking
  -- read in the non-threaded runtime answers a round trip sooner.
  ghc-options:
    -rtsopts
    -with-rtsopts=-M8G

  build-depends:
    base >=4.22 && <4.23,
    cfta-generator,
    cfta-lean,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,

test-suite lean-tests
  import: warnings
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: LeanSpec.hs
  hs-source-dirs: test
  ghc-options: -rtsopts
  build-depends:
    base >=4.22 && <4.23,
    cfta-generator,
    cfta-lean,
    directory >=1.3 && <1.4,
    hspec >=2.11 && <2.12,
    text >=2.1 && <2.2,
