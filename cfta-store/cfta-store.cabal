cabal-version: 3.0
name: cfta-store
version: 0.1.0.0
synopsis: A content-addressed store of language revisions
description:
  A revision is a language with its parents, its origin, and its metadata. Its
  identity is the SHA-256 hash of the canonical text of the language. The
  revisions form a DAG: an update or a three-way merge makes a child. An
  in-memory store and a directory store keep the revisions.

homepage: https://github.com/TharkunAB/cfta/tree/main/cfta-store#readme
bug-reports: https://github.com/TharkunAB/cfta/issues
category: Data
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Tharkun AB
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/TharkunAB/cfta.git
  subdir: cfta-store

common warnings
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.Store
    Data.CFTA.Store.Directory
    Data.CFTA.Store.Memory

  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12 && <0.13,
    cfta >=0.1.0.0 && <0.2,
    cfta-serialization >=0.1.0.0 && <0.2,
    containers >=0.8 && <0.9,
    cryptohash-sha256 >=0.11 && <0.12,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    text >=2.1 && <2.2,

test-suite store-tests
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts

  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12 && <0.13,
    cfta >=0.1.0.0 && <0.2,
    cfta-generator >=0.1.0.0 && <0.2,
    cfta-serialization >=0.1.0.0 && <0.2,
    cfta-store,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hspec >=2.11 && <2.12,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
