cabal-version: 3.0
name: microcfta-ghc
version: 0.1.0.0
synopsis: Component synthesis checked inside GHC's typechecker
description:
  Hectare's equality-constrained automaton proposes programs over GHC
  components, and a walk inside GHC's typechecker checks each program
  prefix by prefix: it instantiates the components, unifies their types,
  and solves their class constraints under the givens of the context. The
  entry point runs inside an existing typechecker context, as a typed-hole
  plugin needs. GHC 9.14 only.

homepage: https://github.com/Tritlo/microecta/tree/main/microcfta-ghc#readme
bug-reports: https://github.com/Tritlo/microecta/issues
category: Development
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/holes/Holes.golden
  test/holes/Holes.hs

source-repository head
  type: git
  location: https://github.com/Tritlo/microecta.git
  subdir: microcfta-ghc

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
    Data.CFTA.GHC.Erase
    Data.CFTA.GHC.Fits
    Data.CFTA.GHC.HoleFits
    Data.CFTA.GHC.Internal.Check

  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5 && <1.6,
    ghc >=9.14 && <9.15,
    microcfta >=0.1.0.0 && <0.2,
    microcfta-generator >=0.1.0.0 && <0.2,
    text >=2.1 && <2.2,

executable ghc-fits
  import: warnings
  default-language: Haskell2010
  main-is: GhcFits.hs
  hs-source-dirs:
    app
    common

  ghc-options:
    -threaded
    -rtsopts

  other-modules:
    Data.CFTA.GHC.Session

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    ghc >=9.14 && <9.15,
    microcfta-generator,
    microcfta-ghc,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,

test-suite ghc-fits-tests
  import: warnings
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: FitsSpec.hs
  hs-source-dirs:
    common
    test

  ghc-options: -rtsopts
  other-modules:
    Data.CFTA.GHC.Session

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    ghc >=9.14 && <9.15,
    hspec >=2.11 && <2.12,
    microcfta-generator,
    microcfta-ghc,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,

test-suite hole-fits-golden
  import: warnings
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: HoleFitsGolden.hs
  hs-source-dirs: test
  ghc-options: -rtsopts
  build-depends:
    base >=4.22 && <4.23,
    directory >=1.3 && <1.4,
    ghc >=9.14 && <9.15,
    microcfta-ghc,
    process >=1.6 && <1.7,

benchmark hectare-ghc
  import: warnings
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  main-is: HectareGhc.hs
  hs-source-dirs:
    benchmarks
    common
    ../microcfta-generator/common

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-M8G

  other-modules:
    Data.CFTA.Gen.Synthesis.HooglePlus
    Data.CFTA.GHC.Session

  build-depends:
    base >=4.22 && <4.23,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    ghc >=9.14 && <9.15,
    microcfta-generator,
    microcfta-ghc,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,
