cabal-version: 3.0
name: decision-model
version: 0.1.0.0
synopsis: Scores for the options of a question from a decision model on a server
description:
  A decision model gives a score to each option of a question. This package
  asks a model that runs on a server: Ollama's decision API, or the chat API of
  a server that is compatible with OpenAI. The package contains no model.

category: AI
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
copyright: 2026 Matthias Pall Gissurarson
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  hs-source-dirs: src
  default-language: Haskell2010
  exposed-modules:
    Decision
    Decision.Ollama
    Decision.OpenAI

  other-modules: Decision.Http
  build-depends:
    aeson >=2.0 && <2.4,
    base >=4.17 && <5,
    bytestring >=0.11 && <0.13,
    http-client >=0.7 && <0.8,
    http-types >=0.12 && <0.13,
    text >=2.0 && <2.2,

test-suite decision-model-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -rtsopts
  build-depends:
    aeson,
    base,
    bytestring,
    decision-model,
    hspec >=2.10 && <2.12,
    text,
