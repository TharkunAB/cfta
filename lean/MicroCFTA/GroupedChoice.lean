import MicroCFTA.GroupedRecord

/-!
# Public grouped choice dispatch

The source checks weights before construction errors. It discards empty
alternatives, preserves every other failure, and permits recursive choices
only when the retained alternative weights are equal. Finite alternatives
retain their declared branch shares. Uniform choice weights finite families
by member count and uses the recursive policy when any input is recursive.
-/

namespace MicroCFTA.GroupedChoice
open Probability GroupedRecord

/-- Empty alternatives are omitted; every other construction error keeps its original identity. -/
inductive Failure (Cause : Type) where
  | empty
  | source (cause : Cause)
  deriving DecidableEq, Repr

/-- The source inspects the recursive constructor before looking inside its result. -/
structure Alternative (Cause α : Type) where
  recursive : Bool
  result : Except (Failure Cause) α

/-- Errors generated by the grouped choice worker, plus preserved construction failures. -/
inductive Error (Cause : Type) where
  | nonPositiveWeight (weight : Rat)
  | source (cause : Cause)
  | empty
  | weightedRecursive
  deriving DecidableEq, Repr

/-- A live alternative retains its original position, weight, kind, and payload. -/
abbrev Live (α : Type) := Rat × Bool × α

/-- Read successful alternatives in source order; empty or failed alternatives are not payloads. -/
def live : List (Rat × Alternative Cause α) → List (Live α)
  | [] => []
  | (weight, alternative) :: rest => match alternative.result with
    | .ok payload => (weight, alternative.recursive, payload) :: live rest
    | .error _ => live rest

/-- Find the first nonempty construction failure, in input order. -/
def firstFailure : List (Rat × Alternative Cause α) → Option Cause
  | [] => none
  | (_, alternative) :: rest => match alternative.result with
    | .error (.source cause) => some cause
    | _ => firstFailure rest

/-- Finite mode stores branch coefficients; recursive mode uses each key's class masses. -/
inductive Choice (α : Type) where
  | finite (branches : Distribution α)
  | recursive (alternatives : List α)
  deriving DecidableEq, Repr

/-- All positive weights of a recursive choice must agree after empty inputs are removed. -/
def equalWeights : List (Live α) → Bool
  | [] => true
  | first :: rest => rest.all (fun entry => decide (entry.1 = first.1))

/-- Complete source dispatch for `frequencies`, before same-key bucket collection. -/
def frequencies (alternatives : List (Rat × Alternative Cause α)) : Except (Error Cause) (Choice α) :=
  match alternatives.find? (fun entry => decide (entry.1 ≤ 0)) with
  | some bad => .error (.nonPositiveWeight bad.1)
  | none => match firstFailure alternatives with
    | some cause => .error (.source cause)
    | none => match live alternatives with
      | [] => .error .empty
      | first :: rest =>
          let retained := first :: rest
          if retained.any (fun entry => entry.2.1) then
            if equalWeights retained then .ok (.recursive (retained.map fun entry => entry.2.2))
            else .error .weightedRecursive
          else .ok (.finite (normalize (retained.map fun entry => (entry.1, entry.2.2))))

/-- The uniform finite path reads cardinalities before constructing weighted alternatives. -/
def counted (cardinality : α → Nat) : List (Alternative Cause α) → Except (Error Cause) (List (Rat × Alternative Cause α))
  | [] => .ok []
  | alternative :: rest => match alternative.result with
    | .error (.source cause) => .error (.source cause)
    | .error .empty => counted cardinality rest
    | .ok payload =>
        match counted cardinality rest with
        | .error error => .error error
        | .ok remaining =>
            .ok (if 0 < cardinality payload then ((cardinality payload : Rat), alternative) :: remaining else remaining)

/-- The source checks for recursive inputs before removing empty alternatives. -/
def uniformly (cardinality : α → Nat) (alternatives : List (Alternative Cause α)) : Except (Error Cause) (Choice α) :=
  if alternatives.any Alternative.recursive then frequencies (alternatives.map fun alternative => (1, alternative))
  else match counted cardinality alternatives with
    | .error error => .error error
    | .ok weighted => frequencies weighted

/-- A nonpositive weight wins over every later error or empty-input case. -/
theorem nonpositive_precedence (alternatives : List (Rat × Alternative Cause α)) (bad : Rat × Alternative Cause α)
    (found : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = some bad) :
    frequencies alternatives = .error (.nonPositiveWeight bad.1) := by simp [frequencies, found]

/-- A source failure is retained after all input weights pass validation. -/
theorem source_failure (alternatives : List (Rat × Alternative Cause α)) (cause : Cause)
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (found : firstFailure alternatives = some cause) : frequencies alternatives = .error (.source cause) := by
  simp [frequencies, positive, found]

/-- No live alternative becomes an empty successful language. -/
theorem no_live_error (alternatives : List (Rat × Alternative Cause α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (successful : firstFailure alternatives = none) (empty : live alternatives = []) :
    frequencies alternatives = .error .empty := by simp [frequencies, positive, successful, empty]

/-- A successful payload occurs in the retained sequence exactly when it occurred in the input. -/
theorem live_member (alternatives : List (Rat × Alternative Cause α)) (weight : Rat) (recursive : Bool) (payload : α) :
    (weight, recursive, payload) ∈ live alternatives ↔
      ∃ alternative, (weight, alternative) ∈ alternatives ∧ alternative.recursive = recursive ∧ alternative.result = .ok payload := by
  induction alternatives with
  | nil => simp [live]
  | cons first rest ih =>
      rcases first with ⟨firstWeight, alternative⟩
      cases result : alternative.result <;> simp [live, result, ih, List.mem_cons, Prod.mk.injEq]
      all_goals grind

/-- Successful weight validation proves strict positivity for every retained branch. -/
theorem live_positive (alternatives : List (Rat × Alternative Cause α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (entry : Live α) (member : entry ∈ live alternatives) : 0 < entry.1 := by
  obtain ⟨alternative, present, _, _⟩ := (live_member alternatives entry.1 entry.2.1 entry.2.2).mp member
  have checked := List.find?_eq_none.mp positive (entry.1, alternative) present
  simp only [decide_eq_true_eq] at checked
  grind

/-- Finite normalized branch coefficients stay positive; weighting cannot silently remove a live input. -/
theorem normalized_live_positive (alternatives : List (Rat × Alternative Cause α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (entry : Rat × α) (member : entry ∈ normalize ((live alternatives).map fun branch => (branch.1, branch.2.2))) :
    0 < entry.1 := by
  obtain ⟨weighted, weightedMember, rfl⟩ := List.mem_map.mp member
  obtain ⟨branch, branchMember, rfl⟩ := List.mem_map.mp weightedMember
  have totalPositive : 0 < total ((live alternatives).map fun branch => (branch.1, branch.2.2)) := by
    apply Sized.total_positive
    · exact List.ne_nil_of_mem (List.mem_map.mpr ⟨branch, branchMember, rfl⟩)
    · intro entry present
      obtain ⟨original, found, rfl⟩ := List.mem_map.mp present
      exact live_positive alternatives positive original found
  exact Rat.mul_pos (Rat.inv_pos.mpr totalPositive) (live_positive alternatives positive branch branchMember)

/-- Recursive success retains every successful alternative in its original order and multiplicity. -/
theorem recursive_success (alternatives : List (Rat × Alternative Cause α)) (first : Live α) (rest : List (Live α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (successful : firstFailure alternatives = none) (retained : live alternatives = first :: rest)
    (recursive : (first :: rest).any (fun entry => entry.2.1) = true) (equal : equalWeights (first :: rest) = true) :
    frequencies alternatives = .ok (.recursive ((first :: rest).map fun entry => entry.2.2)) := by
  simp [frequencies, positive, successful, retained, recursive, equal]

/-- Unequal live recursive branch weights are an explicit public error. -/
theorem recursive_weight_error (alternatives : List (Rat × Alternative Cause α)) (first : Live α) (rest : List (Live α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (successful : firstFailure alternatives = none) (retained : live alternatives = first :: rest)
    (recursive : (first :: rest).any (fun entry => entry.2.1) = true) (unequal : equalWeights (first :: rest) = false) :
    frequencies alternatives = .error .weightedRecursive := by
  simp [frequencies, positive, successful, retained, recursive, unequal]

/-- Finite success retains the user's normalized branch shares independently of branch member counts. -/
theorem finite_success (alternatives : List (Rat × Alternative Cause α)) (first : Live α) (rest : List (Live α))
    (positive : alternatives.find? (fun entry => decide (entry.1 ≤ 0)) = none)
    (successful : firstFailure alternatives = none) (retained : live alternatives = first :: rest)
    (finite : (first :: rest).any (fun entry => entry.2.1) = false) :
    frequencies alternatives = .ok (.finite (normalize ((first :: rest).map fun entry => (entry.1, entry.2.2)))) := by
  simp [frequencies, positive, successful, retained, finite]

/-- A recursive input selects oneof-style dispatch even when that input later proves empty. -/
theorem uniformly_recursive (cardinality : α → Nat) (alternatives : List (Alternative Cause α))
    (recursive : alternatives.any Alternative.recursive = true) :
    uniformly cardinality alternatives = frequencies (alternatives.map fun alternative => (1, alternative)) := by
  simp [uniformly, recursive]

/-- Reweighting a key changes only its mass, leaving all structural ranks and within-key probabilities intact. -/
def scaleGroup (factor : Rat) (group : Group α) : Group α := ⟨factor * group.mass, group.members⟩

/-- Positive finite branch shares preserve the complete grouped record invariant. -/
theorem scaleGroup_valid (factor : Rat) (positive : 0 < factor) (group : Group α) (valid : Valid group) :
    Valid (scaleGroup factor group) := by
  have nonnegative := valid.2.1
  refine ⟨valid.1, Rat.mul_nonneg (by grind) nonnegative, ?_⟩
  change 0 < factor * group.mass ↔ 0 < Decoder.count group.members.plan
  constructor
  · intro live
    have massPositive : 0 < group.mass := by
      by_cases found : 0 < group.mass
      · exact found
      · have zero : group.mass = 0 := by grind
        simp [zero] at live
    exact valid.2.2.mp massPositive
  · intro live
    exact Rat.mul_pos positive (valid.2.2.mpr live)

/-- Finite grouped choice multiplies each bucket's key mass by its public branch coefficient. -/
def compileFiniteByKey [DecidableEq Key] (branches : List (Rat × List (Key × Group α))) (key : Key) : Group α :=
  merge (branches.flatMap fun branch =>
    (branch.2.filter fun entry => decide (entry.1 = key)).map fun entry => scaleGroup branch.1 entry.2)

/-- Every retained finite key builds a coherent mass-weighted member record. -/
theorem compileFiniteByKey_valid [DecidableEq Key] (branches : List (Rat × List (Key × Group α)))
    (positive : ∀ branch ∈ branches, 0 < branch.1)
    (valid : ∀ branch ∈ branches, ∀ entry ∈ branch.2, Valid entry.2) (key : Key) :
    Valid (compileFiniteByKey branches key) := by
  apply merge_valid
  intro group present
  obtain ⟨branch, branchMember, inBranch⟩ := List.mem_flatMap.mp present
  obtain ⟨entry, entryMember, rfl⟩ := List.mem_map.mp inBranch
  exact scaleGroup_valid branch.1 (positive branch branchMember) entry.2
    (valid branch branchMember entry (List.mem_filter.mp entryMember).1)

/-- Key collection preserves every source member at that key, including repeated alternatives and values. -/
theorem compileFiniteByKey_values [DecidableEq Key] (branches : List (Rat × List (Key × Group α))) (key : Key) :
    Decoder.values (compileFiniteByKey branches key).members.plan =
      branches.flatMap fun branch =>
        (branch.2.filter fun entry => decide (entry.1 = key)).flatMap fun entry => Decoder.values entry.2.members.plan := by
  simp [compileFiniteByKey, merge_values, List.flatMap_assoc, List.flatMap_map, scaleGroup]

/-- Uniform finite families use cardinality shares rather than equal family shares. -/
theorem uniformly_finite_counts :
    uniformly (fun n : Nat => if n = 0 then 1 else 3)
      ([⟨false, .ok 0⟩, ⟨false, .ok 1⟩] : List (Alternative Unit Nat)) =
        .ok (.finite [(1 / 4, 0), (3 / 4, 1)]) := by
  simp [uniformly, counted, frequencies, firstFailure, live, normalize, scale, total, List.find?,
    show ¬ (1 : Rat) ≤ 0 by decide, show ¬ (3 : Rat) ≤ 0 by decide]
  congr 2 <;> decide +kernel

/-- The documented recursive-input branch applies before an empty recursive alternative is removed. -/
theorem uniformly_empty_recursive_dispatch :
    uniformly (fun n : Nat => if n = 0 then 1 else 3)
      ([⟨false, .ok 0⟩, ⟨false, .ok 1⟩, ⟨true, .error .empty⟩] : List (Alternative Unit Nat)) =
        .ok (.finite [(1 / 2, 0), (1 / 2, 1)]) := by
  simp [uniformly, frequencies, firstFailure, live, normalize, scale, total, List.find?,
    show ¬ (1 : Rat) ≤ 0 by decide]
  congr 2 <;> decide +kernel

/-- Recursive same-key alternatives use their class masses, not their equal public branch weights. -/
def compileRecursive (alternatives : List (Classes α)) : Classes α := choice alternatives

/-- Public equal-weight recursive dispatch constructs valid records at every size. -/
theorem compileRecursive_valid (alternatives : List (Classes α))
    (valid : ∀ alternative ∈ alternatives, ∀ size, Valid (alternative size)) :
    ∀ size, Valid (compileRecursive alternatives size) := choice_valid alternatives valid

end MicroCFTA.GroupedChoice
