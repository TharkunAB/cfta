  have entrySnapshot := prefixInputs
  obtain ⟨shapes, kept, inventory, memos, packet, querySame, previous, mass, _counted, memberInputs, genuine⟩ := prefixInputs
  obtain ⟨available, closed, ranked, bucketBound, bounded, pending⟩ :=
