    (formulas : SourceGuards.Formulas FullSyntax.Formula)
    (solver : SourceGuards.Entailment FullSyntax.Formula) (recursiveDepth workFuel : Nat)
    (outerIH : RealOuterProgramSlotsAtDepth (bits := bits)
