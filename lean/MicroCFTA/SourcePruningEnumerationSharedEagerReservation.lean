    (entry current : IdentityActualSourcePoint bits) (incoming : Node) (bucket : List Suspended)
    (rest : List (Node × List Suspended)) (edge : EdgeValue Symbol Constraint) (residual : Option Constraint)
    (rowOwn : Cached)
