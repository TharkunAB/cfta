            · cases hookOutcome <;> exact resources
        have tupleComplete : ∃ fuel outcome,
            (∀ extra, SourcePruningEnumerationSharedChildVisitors.visitChildren
              (SourcePruningEnumerationSharedEagerChildren.eagerChild checkEmpty
