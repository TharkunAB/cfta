import MicroCFTA.SourceSizedDeterminizationKernel
import MicroCFTA.SourceSizedDeterminizationFrontier
import MicroCFTA.SymbolicSelection

/-!
# One source determinization round

The source groups original transitions by symbol and arity. It generates
tuples from each group's child lists and removes repeated tuples before it
computes their targets. This finite list view proves membership and distinct
tuples. The source uses ordered sets and maps for iteration. Their sequence
order and the final `sortedRows` adapter remain separate obligations.
-/
namespace MicroCFTA.SourceSizedDeterminizationStep
open Language SourceSizedDeterminizationKernel SourceSizedDeterminizationFrontier

variable {State Symbol : Type} [DecidableEq State] [DecidableEq Symbol]

/-- The source group key retains both the symbol and its child arity. -/
def token (edge : Edge State Symbol) : Symbol × Nat := (edge.label, edge.children.length)

/-- Group keys come from every original row, including unreachable rows. -/
def tokens (states : List State) (rows : Automaton State Symbol) : List (Symbol × Nat) :=
  (states.flatMap fun state => (rows state).map token).eraseDups

/-- Retain the child-list seed of every original transition with this token. -/
def seeds (states : List State) (rows : Automaton State Symbol) (wanted : Symbol × Nat) :
    List (List State) :=
  states.flatMap fun state => ((rows state).filter fun edge => decide (token edge = wanted)).map Edge.children

omit [DecidableEq State] in
private theorem mem_seeds (states : List State) (rows : Automaton State Symbol)
    (wanted : Symbol × Nat) (children : List State) :
    children ∈ seeds states rows wanted ↔ ∃ state ∈ states, ∃ edge ∈ rows state,
      token edge = wanted ∧ edge.children = children := by
  simp only [seeds, List.mem_flatMap, List.mem_map, List.mem_filter, decide_eq_true_eq]
  constructor
  · rintro ⟨state, member, edge, ⟨stored, label⟩, children⟩
    exact ⟨state, member, edge, stored, label, children⟩
  · rintro ⟨state, member, edge, stored, label, children⟩
    exact ⟨state, member, edge, ⟨stored, label⟩, children⟩

/-- Generate each token's tuples once, as the source set conversion does. -/
def round (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State)) :
    List (Choice State Symbol) :=
  (tokens states rows).flatMap fun wanted =>
    ((seeds states rows wanted).flatMap (tuples fresh holding known)).eraseDups.map
      fun keys => (wanted.1, keys)

/-- A round contains exactly the tuples generated by some original transition seed. -/
theorem mem_round (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State))
    (choice : Choice State Symbol) :
    choice ∈ round states rows fresh holding known ↔
      ∃ state ∈ states, ∃ edge ∈ rows state, edge.label = choice.1 ∧
        choice.2 ∈ tuples fresh holding known edge.children := by
  constructor
  · intro member
    obtain ⟨wanted, _, mapped⟩ := List.mem_flatMap.mp member
    obtain ⟨keys, keyMember, rfl⟩ := List.mem_map.mp mapped
    obtain ⟨children, seeded, generated⟩ := List.mem_flatMap.mp (List.mem_eraseDups.mp keyMember)
    obtain ⟨state, present, edge, stored, same, rfl⟩ := (mem_seeds states rows wanted children).mp seeded
    exact ⟨state, present, edge, stored, congrArg Prod.fst same, generated⟩
  · rintro ⟨state, present, edge, stored, label, generated⟩
    apply List.mem_flatMap.mpr
    refine ⟨token edge, ?_, ?_⟩
    · apply List.mem_eraseDups.mpr
      exact List.mem_flatMap.mpr ⟨state, present, List.mem_map.mpr ⟨edge, stored, rfl⟩⟩
    · apply List.mem_map.mpr
      refine ⟨choice.2, List.mem_eraseDups.mpr ?_, Prod.ext label rfl⟩
      exact List.mem_flatMap.mpr ⟨edge.children,
        (mem_seeds states rows _ _).mpr ⟨state, present, edge, stored, rfl, rfl⟩, generated⟩

private theorem tuple_arity (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State))
    (wanted : Symbol × Nat) (keys : List (List State))
    (member : keys ∈ ((seeds states rows wanted).flatMap (tuples fresh holding known)).eraseDups) :
    keys.length = wanted.2 := by
  obtain ⟨children, seeded, generated⟩ := List.mem_flatMap.mp (List.mem_eraseDups.mp member)
  obtain ⟨_, _, edge, _, same, rfl⟩ := (mem_seeds states rows wanted children).mp seeded
  have lengths := ((mem_tuples fresh holding known edge.children keys).mp generated).1.length_eq
  exact lengths.symm.trans (congrArg Prod.snd same)

/-- Set conversion and the token arity prevent repeated emissions within one round. -/
theorem round_distinct (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State)) :
    (round states rows fresh holding known).Nodup := by
  apply List.pairwise_flatMap.mpr
  constructor
  · intro wanted _
    apply List.pairwise_map.mpr
    apply (SymbolicDriver.eraseDups_nodup _).imp
    intro first second different same
    exact different (congrArg Prod.snd same)
  · apply (SymbolicDriver.eraseDups_nodup _).imp
    intro first second different left leftMember right rightMember same
    obtain ⟨leftKeys, leftSeed, rfl⟩ := List.mem_map.mp leftMember
    obtain ⟨rightKeys, rightSeed, rfl⟩ := List.mem_map.mp rightMember
    have leftArity := tuple_arity states rows fresh holding known first leftKeys leftSeed
    have rightArity := tuple_arity states rows fresh holding known second rightKeys rightSeed
    have sameLabel : first.1 = second.1 := congrArg (fun entry : Choice State Symbol => entry.1) same
    have sameKeys : leftKeys = rightKeys := congrArg (fun entry : Choice State Symbol => entry.2) same
    exact different (Prod.ext sameLabel
      (leftArity.symm.trans ((congrArg List.length sameKeys).trans rightArity)))

/-- Faithful holder entries ensure that every generated target contains an original owner. -/
theorem round_target_nonempty (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State))
    (faithful : ∀ state key, key ∈ holding state → state ∈ key)
    (choice : Choice State Symbol) (member : choice ∈ round states rows fresh holding known) :
    target states rows choice.1 choice.2 ≠ [] := by
  obtain ⟨state, present, edge, stored, label, generated⟩ :=
    (mem_round states rows fresh holding known choice).mp member
  have children := ((mem_tuples fresh holding known edge.children choice.2).mp generated).1
  have owner := (mem_target states rows choice.1 choice.2 state).mpr
    ⟨present, edge, stored, label, children.imp (fun state key member => faithful state key member)⟩
  intro empty
  rw [empty] at owner
  cases owner

/-- An emission with only old children cannot occur after the initial round. -/
theorem round_old_excluded (states : List State) (rows : Automaton State Symbol)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State))
    (started : known ≠ []) (choice : Choice State Symbol)
    (older : ∀ key ∈ choice.2, key ∉ fresh) : choice ∉ round states rows fresh holding known := by
  intro member
  obtain ⟨_, _, edge, _, _, generated⟩ := (mem_round states rows fresh holding known choice).mp member
  exact old_tuple_excluded fresh holding known started edge.children choice.2 older generated

/-- The actual per-round generator derives the tuple uniqueness needed by the count recurrence. -/
theorem round_classes_unique (states : List State) (rows : Automaton State Symbol)
    (plain : Decoder.Plain rows)
    (supported : ∀ state edge, edge ∈ rows state → state ∈ states)
    (fresh : List (List State)) (holding : State → List (List State)) (known : List (List State)) :
    SizedRank.Unambiguous (emittedRows states rows (round states rows fresh holding known)) :=
  classes_unique states rows plain supported _ (round_distinct states rows fresh holding known)

end MicroCFTA.SourceSizedDeterminizationStep
