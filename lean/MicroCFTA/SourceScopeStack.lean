import MicroCFTA.SourceSemanticNames

/-!
# Source-resolved stacks instantiate nested formula transport

A stack records the exact successful resolveMany calls of nested Substitute
guards. Its finite environment invariants are derived from the source reads,
actual tables, and resolved records. The source spelling map is constructed.
-/
namespace MicroCFTA.SourceScopeStack
open FullSyntax FormulaSubstitution SourceFormula

abbrev Recipe := List SourceGuards.Substitution
abbrev Scope := List (SourceGuards.Resolved Formula)

/-- Every entry of a nested substitution belongs to the original guard's full-symbol read plan. -/
def Requested (guard : SourceGuards.Guard Formula) (recipe : Recipe) : Prop :=
  ∀ entry ∈ recipe, entry.actual ∈ SourceGuards.sensitive guard ∧ entry.formal ∈ SourceGuards.sensitive guard

/-- Resolve one source scope with the actual shared tables computed for the complete guard. -/
def resolve (guard : SourceGuards.Guard Formula) (observed : SourceGuards.Observations Formula) (recipe : Recipe) : Option Scope :=
  let table := SourceGuards.substitutionValues operations observed (SourceObservations.sameShape operations observed []) guard
  SourceGuards.resolveMany operations observed table.1 table.2 recipe

/-- A source stack consists of successful ordered scope resolutions at requested paths. -/
def Resolves (guard : SourceGuards.Guard Formula) (observed : SourceGuards.Observations Formula)
    (recipes : List Recipe) (scopes : List Scope) : Prop :=
  Language.All₂ (fun recipe scope => resolve guard observed recipe = some scope ∧ Requested guard recipe) recipes scopes

/-- Read-equivalent source cells resolve the same stack recipes in the same order. -/
theorem transport (guard : SourceGuards.Guard Formula) (first second : SourceGuards.Observations Formula)
    (reads : SourceReadAgreement.Reads guard first second) (recipes : List Recipe) (scopes : List Scope)
    (resolved : Resolves guard first recipes scopes) :
    ∃ other, Resolves guard second recipes other ∧
      Language.All₂ (Language.All₂ (SourceResolvedTables.Aligned (SourceFreshTables.tableRenaming operations guard first second)))
        scopes other := by
  induction resolved with
  | nil => exact ⟨[], Language.All₂.nil, Language.All₂.nil⟩
  | @cons recipe scope recipes scopes head tail ih =>
      obtain ⟨otherTail, resolvedTail, alignedTail⟩ := ih
      have one := SourceResolvedTables.resolveMany_aligned operations guard first second reads recipe head.2
      change SourceResolvedTables.OptionRel _ (resolve guard first recipe) (resolve guard second recipe) at one
      rw [head.1] at one
      cases result : resolve guard second recipe with
      | none => simp [result, SourceResolvedTables.OptionRel] at one
      | some other =>
          have aligned : Language.All₂ (SourceResolvedTables.Aligned (SourceFreshTables.tableRenaming operations guard first second))
              scope other := by simpa [result, SourceResolvedTables.OptionRel] using one
          exact ⟨other :: otherTail, Language.All₂.cons ⟨result, head.2⟩ resolvedTail,
            Language.All₂.cons aligned alignedTail⟩

/-- Every scope generated by the source closes over the derived semantic live-name set. -/
theorem closed (guard : SourceGuards.Guard Formula) (first second : SourceGuards.Observations Formula)
    (recipes : List Recipe) (scopes : List Scope) (resolved : Resolves guard first recipes scopes) :
    ∀ scope ∈ scopes, ∀ entry ∈ scope,
      entry.replacement.1 ∈ SourceSemanticNames.live operations first guard ∧
      entry.replacement.2 ∈ SourceSemanticNames.live operations first guard ∧
      renameName (SourceFreshTables.tableRenaming operations guard first second) entry.replacement.1 = entry.replacement.1 := by
  induction resolved with
  | nil => simp
  | @cons recipe scope recipes scopes head tail ih =>
      intro current member entry present
      rcases List.mem_cons.mp member with rfl | later
      · exact SourceSemanticNames.resolveMany_live operations guard first second recipe current head.2 head.1 entry present
      · exact ih current later entry present

/-- Both the environment relation and finite-name closure follow from actual source stack resolution. -/
theorem formula_transport (model : Interpretation Value) (nullary : ∀ value, model.apply value [] = value)
    (guard : SourceGuards.Guard Formula) (first second : SourceGuards.Observations Formula)
    (reads : SourceReadAgreement.Reads guard first second) (recipes : List Recipe) (scopes : List Scope)
    (resolved : Resolves guard first recipes scopes) (env : Name → Value) :
    ∃ other, Resolves guard second recipes other ∧
      ∀ formula, (∀ name ∈ formulaNames formula, name ∈ SourceSemanticNames.ambient operations first guard) →
        (Holds model env (SourceGuards.applySubstitutions operations scopes formula) ↔
         Holds model (FreshEnvironment.liftEnvironment (SourceFreshTables.tableRenaming operations guard first second) env)
           (SourceGuards.applySubstitutions operations other formula)) := by
  obtain ⟨other, otherResolved, aligned⟩ := transport guard first second reads recipes scopes resolved
  refine ⟨other, otherResolved, ?_⟩
  intro formula names
  have unique := SourceFreshTables.renaming_unique operations guard first second
  have avoided := SourceSemanticNames.live_avoid operations guard first second reads
  apply SourceScopeEnvironment.scoped_formula_equivalent model nullary
    (SourceFreshTables.tableRenaming operations guard first second) (SourceSemanticNames.live operations first guard)
    (SourceSemanticNames.live_injective operations guard first second reads) env _
    (SourceScopeEnvironment.lift_related model _ _ unique.1 unique.2 avoided env)
    scopes other aligned (closed guard first second recipes scopes resolved) formula
  intro name member
  have ambient := names name member
  exact ⟨List.mem_append_left _ ambient, SourceSemanticNames.ambient_fixed operations guard first second name ambient⟩

/-- A refinement read automatically satisfies the preceding source formula-name premise. -/
theorem observed_formula_names (guard : SourceGuards.Guard Formula) (observed : SourceGuards.Observations Formula)
    (path : SourceGuards.Path) (value : SourceGuards.Observed Formula)
    (requested : path ∈ SourceGuards.paths guard) (found : observed path = some value) :
    ∀ name ∈ formulaNames value.refinement, name ∈ SourceSemanticNames.ambient operations observed guard := by
  intro name member
  exact SourceSemanticNames.refinement_ambient operations observed guard path value name requested found
    (by simpa [operations, freeNames] using member)

/-- A literal requirement automatically satisfies the source formula-name premise. -/
theorem requirement_formula_names (guard : SourceGuards.Guard Formula) (observed : SourceGuards.Observations Formula)
    (formula : Formula) (requirement : formula ∈ SourceGuards.requirements guard) :
    ∀ name ∈ formulaNames formula, name ∈ SourceSemanticNames.ambient operations observed guard := by
  intro name member
  apply List.mem_append_left
  apply List.mem_append_right
  exact List.mem_flatMap.mpr ⟨formula, requirement, by simpa [operations, freeNames] using member⟩

end MicroCFTA.SourceScopeStack
