import MicroCFTA.IntegerTermViews

/-!
# Original static outcome candidates after integer filling

This finite source fragment follows pure, hole, indexed source, map, pay,
application, binary frequency choice, and flexible label callbacks. Candidate
lists omit CheckedRank flags because pointsStatic ignores those flags.
-/
namespace MicroCFTA.StaticCandidateRanks
open Language GeneratorCombinators IntegerTermViews

/-- The finite static combinators whose callbacks are modeled here. -/
inductive Source (Symbol : Type) where
  | pure | hole
  | indexed (count : Nat)
  | map (inner : Source Symbol)
  | pay (inner : Source Symbol)
  | app (functions arguments : Source Symbol)
  | choice (left right : Source Symbol)
  | label (symbol : Symbol) (acceptsLabel : Symbol → Bool) (inner : Source Symbol)

/-- The cardinality used by source product radices and choice offsets. -/
def cardinality : Source Symbol → Nat
  | .pure | .hole => 1
  | .indexed count => count
  | .map inner | .pay inner | .label _ _ inner => cardinality inner
  | .app functions arguments => cardinality functions * cardinality arguments
  | .choice left right => cardinality left + cardinality right

/-- Execute the source outcome selector, projecting errors to absence and retaining its private term. -/
def select : Source Symbol → Nat → Option (Term (Label Symbol))
  | .pure, rank => if rank = 0 then some (.node .pure []) else none
  | .hole, rank => if rank = 0 then some (.node .placeholder []) else none
  | .indexed count, rank => if rank < count then some (.node (.index rank) []) else none
  | .map inner, rank | .pay inner, rank => select inner rank
  | .app functions arguments, rank => do
      let function ← select functions (rank / cardinality arguments)
      let argument ← select arguments (rank % cardinality arguments)
      some (.node .apply [function, argument])
  | .choice left right, rank =>
      if rank < cardinality left then (select left rank).map (fun term => .node (.choice 0) [term])
      else (select right (rank - cardinality left)).map (fun term => .node (.choice 1) [term])
  | .label symbol _ inner, rank => (select inner rank).map (SupportTerms.labelTerm symbol)

/-- Original outcome terms and ranks are generated by the source constructors. -/
inductive Selected : Source Symbol → Nat → Term (Label Symbol) → Prop where
  | pure : Selected .pure 0 (.node .pure [])
  | hole : Selected .hole 0 (.node .placeholder [])
  | indexed (count rank : Nat) : rank < count → Selected (.indexed count) rank (.node (.index rank) [])
  | map {inner rank term} : Selected inner rank term → Selected (.map inner) rank term
  | pay {inner rank term} : Selected inner rank term → Selected (.pay inner) rank term
  | app {functions arguments functionRank argumentRank functionTerm argumentTerm} :
      Selected functions functionRank functionTerm → Selected arguments argumentRank argumentTerm →
      Selected (.app functions arguments) (Probability.pairRank (cardinality arguments) functionRank argumentRank)
        (.node .apply [functionTerm, argumentTerm])
  | left {left right rank term} : Selected left rank term → Selected (.choice left right) rank (.node (.choice 0) [term])
  | right {left right rank term} : Selected right rank term →
      Selected (.choice left right) (cardinality left + rank) (.node (.choice 1) [term])
  | label {inner rank term} (symbol : Symbol) (acceptsLabel : Symbol → Bool) : Selected inner rank term →
      Selected (.label symbol acceptsLabel inner) rank (SupportTerms.labelTerm symbol term)

/-- Every constructed original rank is inside its source cardinality. -/
theorem selected_bound {source : Source Symbol} {rank term} (selected : Selected source rank term) : rank < cardinality source := by
  induction selected with
  | pure | hole => simp [cardinality]
  | indexed count rank valid => exact valid
  | map selected ih | pay selected ih | label symbol acceptsLabel selected ih => exact ih
  | app left right ihl ihr => exact Probability.pairRank_lt ihl ihr
  | left selected ih => simp only [cardinality]; omega
  | right selected ih => simp only [cardinality]; omega

/-- The executable selector produces only the original constructor-generated rank and term. -/
theorem select_sound (source : Source Symbol) (rank : Nat) (term : Term (Label Symbol))
    (found : select source rank = some term) : Selected source rank term := by
  induction source generalizing rank term with
  | pure =>
      by_cases zero : rank = 0
      · subst rank
        have same : term = .node .pure [] := by simpa [select] using found.symm
        subst term; exact .pure
      · simp [select, zero] at found
  | hole =>
      by_cases zero : rank = 0
      · subst rank
        have same : term = .node .placeholder [] := by simpa [select] using found.symm
        subst term; exact .hole
      · simp [select, zero] at found
  | indexed count =>
      by_cases valid : rank < count
      · have same : term = .node (.index rank) [] := by simpa [select, valid] using found.symm
        subst term; exact .indexed count rank valid
      · simp [select, valid] at found
  | map inner ih => exact .map (ih rank term found)
  | pay inner ih => exact .pay (ih rank term found)
  | app functions arguments ihf iha =>
      cases functionFound : select functions (rank / cardinality arguments) with
      | none => simp [select, functionFound, Bind.bind, Option.bind] at found
      | some function => cases argumentFound : select arguments (rank % cardinality arguments) with
        | none => simp [select, functionFound, argumentFound, Bind.bind, Option.bind] at found
        | some argument =>
            have same : term = .node .apply [function, argument] := by
              simpa [select, functionFound, argumentFound, Bind.bind, Option.bind] using found.symm
            subst term
            have chosen := Selected.app (ihf _ _ functionFound) (iha _ _ argumentFound)
            have rankEq := Probability.pair_split (cardinality arguments) rank
            simp only [Probability.splitRank] at rankEq
            simpa only [rankEq] using chosen
  | choice left right ihl ihr =>
      by_cases first : rank < cardinality left
      · obtain ⟨child, selected, same⟩ := Option.map_eq_some_iff.mp (by simpa [select, first] using found)
        subst term
        exact .left (ihl rank child selected)
      · obtain ⟨child, selected, same⟩ := Option.map_eq_some_iff.mp (by simpa [select, first] using found)
        subst term
        have chosen := Selected.right (left := left) (ihr _ child selected)
        have rankEq : cardinality left + (rank - cardinality left) = rank := by omega
        simpa only [rankEq] using chosen
  | label symbol acceptsLabel inner ih =>
      obtain ⟨child, selected, same⟩ := Option.map_eq_some_iff.mp found
      subst term
      exact .label symbol acceptsLabel (ih rank child selected)

/-- Every constructor-generated outcome is returned by the actual selector at its rank. -/
theorem select_complete {source : Source Symbol} {rank term} (selected : Selected source rank term) :
    select source rank = some term := by
  induction selected with
  | pure | hole => simp [select]
  | indexed count rank valid => simp [select, valid]
  | map selected ih | pay selected ih => exact ih
  | @app functions arguments functionRank argumentRank functionTerm argumentTerm left right ihl ihr =>
      have split := Probability.split_pair (left := functionRank) (selected_bound right)
      have functionEq := congrArg Prod.fst split
      have argumentEq := congrArg Prod.snd split
      simp only [Probability.splitRank] at functionEq argumentEq
      simp [select, functionEq, argumentEq, ihl, ihr, Bind.bind, Option.bind]
  | left selected ih => simp [select, selected_bound selected, ih]
  | @right left right rank term selected ih =>
      have outside : ¬ cardinality left + rank < cardinality left := by omega
      simp [select, outside, ih]
  | label symbol acceptsLabel selected ih => simp [select, ih]

/-- Every rank below the source cardinality selects an original outcome. -/
theorem select_total (source : Source Symbol) (rank : Nat) (bounded : rank < cardinality source) :
    ∃ term, select source rank = some term := by
  induction source generalizing rank with
  | pure =>
      have zero : rank = 0 := by simpa [cardinality] using bounded
      exact ⟨.node .pure [], by simp [select, zero]⟩
  | hole =>
      have zero : rank = 0 := by simpa [cardinality] using bounded
      exact ⟨.node .placeholder [], by simp [select, zero]⟩
  | indexed count =>
      have valid : rank < count := bounded
      exact ⟨.node (.index rank) [], by simp [select, valid]⟩
  | map inner ih | pay inner ih => exact ih rank bounded
  | app functions arguments ihf iha =>
      have bounds := Probability.split_lt bounded
      obtain ⟨function, functionFound⟩ := ihf _ bounds.1
      obtain ⟨argument, argumentFound⟩ := iha _ bounds.2
      simp only [Probability.splitRank] at functionFound argumentFound
      exact ⟨.node .apply [function, argument], by
        simp [select, functionFound, argumentFound, Bind.bind, Option.bind]⟩
  | choice left right ihl ihr =>
      by_cases first : rank < cardinality left
      · obtain ⟨term, found⟩ := ihl rank first
        exact ⟨.node (.choice 0) [term], by simp [select, first, found]⟩
      · have last : rank - cardinality left < cardinality right := by
          simp only [cardinality] at bounded
          omega
        obtain ⟨term, found⟩ := ihr _ last
        exact ⟨.node (.choice 1) [term], by simp [select, first, found]⟩
  | label symbol acceptsLabel inner ih =>
      obtain ⟨term, found⟩ := ih rank bounded
      exact ⟨SupportTerms.labelTerm symbol term, by simp [select, found]⟩

/-- Original static terms satisfy the typed fill and projection shape requirements. -/
theorem selected_valid {source : Source Symbol} {rank term} (selected : Selected source rank term) : Valid term := by
  induction selected with
  | pure => exact pure_valid
  | hole => exact placeholder_valid
  | indexed count rank valid => simp [Valid]
  | map selected ih | pay selected ih => exact ih
  | app left right ihl ihr => exact apply_valid _ _ ihl ihr
  | left selected ih | right selected ih => exact choice_valid _ _ ih
  | label symbol acceptsLabel selected ih => exact label_valid symbol _ ih

/-- Source checkedProduct after its unused checked flags are erased. -/
def productCandidates (radix : Nat) (functions arguments : List Nat) : List Nat :=
  functions.flatMap fun function => arguments.map (Probability.pairRank radix function)

/-- The source rightmost spine argument selects this product's argument callback. -/
def spineCandidates (functions : List (Term (Label Symbol)) → List Nat)
    (arguments : Term (Label Symbol) → List Nat) (radix : Nat) (wanted : List (Term (Label Symbol))) : List Nat :=
  match wanted.getLast? with
  | none => []
  | some argument => productCandidates radix (functions wanted.dropLast) (arguments argument)

/-- Execute the original outcomeRanks callbacks on one typed request view. -/
def candidates : Source Symbol → View → List (Term (Label Symbol)) → List Nat
  | .pure, view, wanted => match view, wanted with
      | .whole, [.node .pure []] => [0]
      | .spine, [] | .labelled, [] => [0]
      | _, _ => []
  | .hole, _, [.node _ []] => [0]
  | .hole, _, _ => []
  | .indexed count, _, [.node (.index rank) []] => if rank < count then [rank] else []
  | .indexed _, _, _ => []
  | .map inner, view, wanted | .pay inner, view, wanted => candidates inner view wanted
  | .app functions arguments, .whole, [.node .apply [function, argument]] =>
      productCandidates (cardinality arguments) (candidates functions .whole [function]) (candidates arguments .whole [argument])
  | .app _ _, .whole, _ => []
  | .app functions arguments, _, wanted =>
      spineCandidates (candidates functions .spine) (fun term => candidates arguments .whole [term]) (cardinality arguments) wanted
  | .choice left right, .labelled, wanted =>
      candidates left .labelled wanted ++ (candidates right .labelled wanted).map (cardinality left + ·)
  | .choice left _, _, [.node (.choice 0) [term]] => candidates left .whole [term]
  | .choice left right, _, [.node (.choice 1) [term]] => (candidates right .whole [term]).map (cardinality left + ·)
  | .choice _ _, _, _ => []
  | .label _ acceptsLabel inner, _, [.node (.user found) children] =>
      if acceptsLabel found then candidates inner .labelled children else []
  | .label _ _ _, _, _ => []

/-- Each flexible user label accepts every successful specialization used by filling. -/
def Compatible (exactLabel : List Int → Symbol → Symbol) : Source Symbol → Prop
  | .pure | .hole | .indexed _ => True
  | .map inner | .pay inner => Compatible exactLabel inner
  | .app left right | .choice left right => Compatible exactLabel left ∧ Compatible exactLabel right
  | .label symbol acceptsLabel inner =>
      (∀ point, acceptsLabel (exactLabel point symbol) = true) ∧ Compatible exactLabel inner

/-- Combining two retained candidates retains their actual mixed-radix source rank. -/
theorem product_member (radix : Nat) (functions arguments : List Nat) (function argument : Nat)
    (left : function ∈ functions) (right : argument ∈ arguments) :
    Probability.pairRank radix function argument ∈ productCandidates radix functions arguments := by
  exact List.mem_flatMap.mpr ⟨function, left, List.mem_map.mpr ⟨argument, right, rfl⟩⟩

/-- Splitting a nonempty projected spine recovers exactly its function prefix and argument. -/
theorem spine_append (functions : List (Term (Label Symbol)) → List Nat)
    (arguments : Term (Label Symbol) → List Nat) (radix : Nat)
    (front : List (Term (Label Symbol))) (last : Term (Label Symbol)) :
    spineCandidates functions arguments radix (front ++ [last]) = productCandidates radix (functions front) (arguments last) := by
  simp [spineCandidates]

/-- A labelled root is opaque to all three source request projections. -/
theorem project_user (view : View) (symbol : Symbol) (children : List (Term (Label Symbol))) :
    project view (.node (.user symbol) children) = [.node (.user symbol) children] := by
  cases view <;> simp [project, labelled, spine, SupportTerms.applicationLeftChildren, SupportTerms.applicationTermChildren]

/-- Every original source rank remains a candidate after filling, in every private request view. -/
theorem candidate_complete (literal : Int → Symbol) (exactLabel : List Int → Symbol → Symbol)
    {source : Source Symbol} {rank : Nat} {term : Term (Label Symbol)}
    (selected : Selected source rank term) (compatible : Compatible exactLabel source)
    (point : List Int) (view : View) :
    rank ∈ candidates source view (project view (fill literal exactLabel point term).2) := by
  induction selected generalizing point view with
  | pure =>
      cases view <;> simp [candidates, project, fill, fillForest, labelled, spine,
        SupportTerms.applicationLeftChildren]
  | hole =>
      cases point <;> cases view <;> simp [candidates, project, fill, fillForest, labelled, spine,
        SupportTerms.applicationLeftChildren, SupportTerms.applicationTermChildren]
  | indexed count rank valid =>
      cases view <;> simp [candidates, project, fill, fillForest, labelled, spine,
        SupportTerms.applicationLeftChildren, SupportTerms.applicationTermChildren, valid]
  | map selected ih | pay selected ih => exact ih compatible point view
  | @app functions arguments functionRank argumentRank functionTerm argumentTerm left right ihl ihr =>
      have argument := ihr compatible.2 (fill literal exactLabel point functionTerm).1 .whole
      cases view with
      | whole =>
          have product := product_member (cardinality arguments) _ _ functionRank argumentRank
            (ihl compatible.1 point .whole) argument
          simpa [candidates, project, fill, fillForest] using product
      | spine =>
          have product := product_member (cardinality arguments) _ _ functionRank argumentRank
            (ihl compatible.1 point .spine) argument
          simpa [candidates, project, fill, fillForest, spine, SupportTerms.applicationLeftChildren,
            SupportTerms.applicationTermChildren, spine_append] using product
      | labelled =>
          have product := product_member (cardinality arguments) _ _ functionRank argumentRank
            (ihl compatible.1 point .spine) argument
          simpa [candidates, project, fill, fillForest, labelled, spine, SupportTerms.applicationLeftChildren,
            SupportTerms.applicationTermChildren, spine_append] using product
  | @left left right rank term selected ih =>
      cases view with
      | whole => simpa [candidates, project, fill, fillForest] using ih compatible.1 point .whole
      | spine => simpa [candidates, project, fill, fillForest, spine, SupportTerms.applicationLeftChildren,
          SupportTerms.applicationTermChildren] using ih compatible.1 point .whole
      | labelled =>
          simp only [fill, fillForest, project, labelled, candidates]
          exact List.mem_append_left _ (ih compatible.1 point .labelled)
  | @right left right rank term selected ih =>
      cases view with
      | whole =>
          simpa [candidates, project, fill, fillForest] using ih compatible.2 point .whole
      | spine =>
          simpa [candidates, project, fill, fillForest, spine, SupportTerms.applicationLeftChildren,
            SupportTerms.applicationTermChildren] using ih compatible.2 point .whole
      | labelled =>
          simp only [fill, fillForest, project, labelled, candidates]
          exact List.mem_append_right _ (List.mem_map.mpr ⟨rank, ih compatible.2 point .labelled, rfl⟩)
  | @label inner rank term symbol acceptsLabel selected ih =>
      rw [labelled_source]
      simp only [fill, project_user, candidates, compatible.1 point, ↓reduceIte]
      have same := congrArg Prod.snd (labelled_fill literal exactLabel point term (selected_valid selected))
      rw [same]
      exact ih compatible.2 point .labelled

/-- Successful actual integer-label specialization supplies the flexible label callback. -/
theorem integer_label_compatible
    (specialize : List Int → IntegerLabelCodec.Symbol → IntegerLabelCodec.Symbol)
    (symbol : IntegerLabelCodec.Symbol) (inner : Source IntegerLabelCodec.Symbol)
    (success : ∀ point, IntegerLabelCodec.exactLabel point symbol = .ok (specialize point symbol))
    (compatible : Compatible specialize inner) :
    Compatible specialize (.label symbol (IntegerLabelCodec.fills symbol) inner) :=
  ⟨fun point => IntegerLabelCodec.exactLabel_matches point symbol _ (success point), compatible⟩

/-- The source pointsStatic scan first discovers original outcomes, then checks and ranks the integer view. -/
def pointCandidates [DecidableEq Symbol] (literal : Int → Symbol) (exactLabel : List Int → Symbol → Symbol)
    (read : Symbol → Option Int) (points : LatticeAPI.Points) (source : Source Symbol)
    (view : View) (wanted : List (Term (Label Symbol))) : List Nat :=
  (candidates source view wanted).flatMap fun originalRank =>
    match select source originalRank with
    | none => []
    | some original => match rankView literal exactLabel read points view original wanted with
      | none => []
      | some pointRank => [Probability.pairRank (LatticeSelect.pointCount points.levels) originalRank pointRank]

/-- Every original outcome/point rank pair survives the actual discovery and final-view checks. -/
theorem pointCandidates_complete [DecidableEq Symbol]
    (literal : Int → Symbol) (exactLabel : List Int → Symbol → Symbol)
    (read : Symbol → Option Int) (literalRead : ∀ value, read (literal value) = some value)
    (names : List FullSyntax.Name) (formula : FullSyntax.Formula) (points : LatticeAPI.Points)
    (pointsBuilt : LatticeAPI.points names (FullSyntax.lowerFormula formula) = .ok points)
    (source : Source Symbol) (compatible : Compatible exactLabel source)
    (originalRank : Nat) (original : Term (Label Symbol)) (found : select source originalRank = some original)
    (dimension : count original = names.length) (view : View)
    (pointRank : Fin (LatticeSelect.pointCount points.levels)) :
    Probability.pairRank (LatticeSelect.pointCount points.levels) originalRank pointRank.val ∈
      pointCandidates literal exactLabel read points source view (decodeView literal exactLabel points view original pointRank) := by
  have selected := select_sound source originalRank original found
  apply List.mem_flatMap.mpr
  refine ⟨originalRank, ?_, ?_⟩
  · exact candidate_complete literal exactLabel selected compatible _ view
  · simp only [found]
    rw [rank_decode literal exactLabel read literalRead names formula points pointsBuilt view original
      (selected_valid selected) dimension pointRank]
    simp

/-- Every accepted combined candidate has an actual original outcome and an exact filled point view. -/
theorem pointCandidates_sound [DecidableEq Symbol]
    (literal : Int → Symbol) (exactLabel : List Int → Symbol → Symbol) (read : Symbol → Option Int)
    (names : List FullSyntax.Name) (formula : FullSyntax.Formula) (points : LatticeAPI.Points)
    (pointsBuilt : LatticeAPI.points names (FullSyntax.lowerFormula formula) = .ok points)
    (source : Source Symbol) (view : View) (wanted : List (Term (Label Symbol))) (rank : Nat)
    (member : rank ∈ pointCandidates literal exactLabel read points source view wanted) :
    ∃ originalRank original, select source originalRank = some original ∧
      ∃ pointRank : Fin (LatticeSelect.pointCount points.levels),
        rank = Probability.pairRank (LatticeSelect.pointCount points.levels) originalRank pointRank.val ∧
        decodeView literal exactLabel points view original pointRank = wanted ∧
        rank < cardinality source * LatticeSelect.pointCount points.levels := by
  obtain ⟨originalRank, _, accepted⟩ := List.mem_flatMap.mp member
  cases found : select source originalRank with
  | none => simp [found] at accepted
  | some original =>
      cases ranked : rankView literal exactLabel read points view original wanted with
      | none => simp [found, ranked] at accepted
      | some pointRank =>
          have same : rank = Probability.pairRank (LatticeSelect.pointCount points.levels) originalRank pointRank :=
            by simpa [found, ranked] using accepted
          obtain ⟨validRank, value, decoded⟩ := rankView_sound literal exactLabel read names formula points pointsBuilt
            view original wanted pointRank ranked
          refine ⟨originalRank, original, found, validRank, by simpa [value] using same, decoded, ?_⟩
          rw [same, ← value]
          exact Probability.pairRank_lt (selected_bound (select_sound source originalRank original found)) validRank.isLt

/-- Original outcome discovery and point ranking give exact combined ranks for this source fragment. -/
theorem pointCandidates_exact [DecidableEq Symbol]
    (literal : Int → Symbol) (exactLabel : List Int → Symbol → Symbol)
    (read : Symbol → Option Int) (literalRead : ∀ value, read (literal value) = some value)
    (names : List FullSyntax.Name) (formula : FullSyntax.Formula) (points : LatticeAPI.Points)
    (pointsBuilt : LatticeAPI.points names (FullSyntax.lowerFormula formula) = .ok points)
    (source : Source Symbol) (compatible : Compatible exactLabel source)
    (dimensions : ∀ originalRank original, select source originalRank = some original → count original = names.length)
    (view : View) (wanted : List (Term (Label Symbol))) (rank : Nat) :
    rank ∈ pointCandidates literal exactLabel read points source view wanted ↔
      ∃ originalRank original, select source originalRank = some original ∧
        ∃ pointRank : Fin (LatticeSelect.pointCount points.levels),
          rank = Probability.pairRank (LatticeSelect.pointCount points.levels) originalRank pointRank.val ∧
          decodeView literal exactLabel points view original pointRank = wanted := by
  constructor
  · intro member
    obtain ⟨originalRank, original, found, pointRank, same, decoded, _⟩ :=
      pointCandidates_sound literal exactLabel read names formula points pointsBuilt source view wanted rank member
    exact ⟨originalRank, original, found, pointRank, same, decoded⟩
  · rintro ⟨originalRank, original, found, pointRank, rfl, rfl⟩
    exact pointCandidates_complete literal exactLabel read literalRead names formula points pointsBuilt source compatible
      originalRank original found (dimensions originalRank original found) view pointRank

end MicroCFTA.StaticCandidateRanks
