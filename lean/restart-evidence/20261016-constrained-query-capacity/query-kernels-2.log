'MicroCFTA.QueryReservationIntegration.mismatch_body' depends on axioms: [propext, Classical.choice, Quot.sound]
@MicroCFTA.QueryReservationIntegration.mismatch_body : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  {width : Nat} (before : MicroCFTA.SourceEqualityNativeDemand.State width)
  (symbol : MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
  (guard : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula),
  have left :=
    MicroCFTA.InternedConstructorTemplates.EdgeValue.mk
      { identity := 0, key := { symbol := symbol, children := [], constraint := guard } } [];
  have right :=
    MicroCFTA.InternedConstructorTemplates.EdgeValue.mk
      { identity := 1,
        key := { symbol := symbol, children := [MicroCFTA.InternedBinderProtocol.NodeRef.empty], constraint := guard } }
      [MicroCFTA.InternedConstructorTemplates.Value.empty];
  have request := { domain := MicroCFTA.IntersectionEmptyDomain.emptyDomain, left := left, right := right };
  have after :=
    { native := before.native, operations := MicroCFTA.SourceEqualityMkEdgeAllocation.emptyField before.operations };
  MicroCFTA.SourceEqualityNativeDemand.step
        (MicroCFTA.SourceEqualityNativeDemand.Control.edgeBody request
          MicroCFTA.SourceRecursiveIntersectionCode.Code.pure)
        before =
      MicroCFTA.SourceEqualityNativeDemand.Outcome.yielded
        (MicroCFTA.SourceEqualityNativeDemand.Control.code (MicroCFTA.SourceEqualityNativeCheckedCode.sentinel left))
        after ∧
    MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryQueryReservations.requestsThrough 1
          (MicroCFTA.SourceEqualityNativeDemand.Control.edgeBody request
            MicroCFTA.SourceRecursiveIntersectionCode.Code.pure)
          before =
        [] ∧
      after.native = before.native
'MicroCFTA.QueryReservationIntegration.zero_prefix' depends on axioms: [propext, Classical.choice, Quot.sound]
@MicroCFTA.QueryReservationIntegration.zero_prefix : ∀
  [DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [DecidableEq
