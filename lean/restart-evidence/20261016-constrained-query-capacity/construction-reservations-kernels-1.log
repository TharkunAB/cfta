MicroCFTA.ConstructionReservationIntegration.duplicate_source_rows : MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount
      MicroCFTA.ConstructionReservationIntegration.duplicateRows =
    1 ∧
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount
        MicroCFTA.ConstructionReservationIntegration.duplicateRows =
      2 ∧
    MicroCFTA.InternedFreshOrdinaryConstruction.build MicroCFTA.ConstructionReservationIntegration.duplicateRows []
          MicroCFTA.InternedConstructorTemplates.empty =
        MicroCFTA.InternedNestedConstruction.Outcome.done
          MicroCFTA.ConstructionReservationIntegration.duplicateBuild.fst
          MicroCFTA.ConstructionReservationIntegration.duplicateBuild.snd ∧
      MicroCFTA.ConstructionReservationIntegration.duplicateBuild.snd.nodes.next = 1 ∧
        MicroCFTA.ConstructionReservationIntegration.duplicateBuild.snd.edges.next = 1 ∧
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
              MicroCFTA.ConstructionReservationIntegration.duplicateBuild.fst ∧
            MicroCFTA.InternedProbeProvenance.Available MicroCFTA.ConstructionReservationIntegration.duplicateBuild.snd
              MicroCFTA.ConstructionReservationIntegration.duplicateBuild.fst
