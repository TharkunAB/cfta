@MicroCFTA.ConstructionReservationIntegration.missing_variable : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (state : MicroCFTA.InternedConstructorTemplates.State Symbol Guard) (index : Nat),
  ∃ value after,
    MicroCFTA.InternedFreshOrdinaryConstruction.build (MicroCFTA.InternedNestedConstruction.Syntax.var index) [] state =
        MicroCFTA.InternedNestedConstruction.Outcome.done value after ∧
      value = MicroCFTA.InternedConstructorTemplates.Value.empty ∧
        after = state ∧
          after.nodes.next ≤
              state.nodes.next +
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount
                  (MicroCFTA.InternedNestedConstruction.Syntax.var index) ∧
            after.edges.next ≤
              state.edges.next +
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount
                  (MicroCFTA.InternedNestedConstruction.Syntax.var index)
'MicroCFTA.ConstructionReservationIntegration.two_constructions' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@MicroCFTA.ConstructionReservationIntegration.two_constructions : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (expression : MicroCFTA.InternedNestedConstruction.Syntax Symbol Guard),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstruction.Node expression →
    ∃ first middle second after,
      MicroCFTA.InternedFreshOrdinaryConstruction.build expression [] MicroCFTA.InternedConstructorTemplates.empty =
          MicroCFTA.InternedNestedConstruction.Outcome.done first middle ∧
        MicroCFTA.InternedFreshOrdinaryConstruction.build expression [] middle =
            MicroCFTA.InternedNestedConstruction.Outcome.done second after ∧
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node first ∧
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node second ∧
              MicroCFTA.InternedProbeProvenance.Available middle first ∧
                MicroCFTA.InternedProbeProvenance.Available after second ∧
                  after.nodes.next ≤
                      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount expression +
                        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount expression ∧
                    after.edges.next ≤
                      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount expression +
                        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount expression
'MicroCFTA.ConstructionReservationIntegration.source_keys' depends on axioms: [propext, Classical.choice, Quot.sound]
@MicroCFTA.ConstructionReservationIntegration.source_keys : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (expression : MicroCFTA.InternedNestedConstruction.Syntax Symbol Guard),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstruction.Node expression →
    ∀ (bits : Nat),
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount expression ≤ 2 ^ bits →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount expression ≤ 2 ^ (bits + 2) →
          ∃ value after,
            MicroCFTA.InternedFreshOrdinaryConstruction.build expression []
                  MicroCFTA.InternedConstructorTemplates.empty =
                MicroCFTA.InternedNestedConstruction.Outcome.done value after ∧
              MicroCFTA.InternedProbeProvenance.Available after value ∧
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryKeys.Node bits value
'MicroCFTA.ConstructionReservationIntegration.supplied_actual' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@MicroCFTA.ConstructionReservationIntegration.supplied_actual : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (expression : MicroCFTA.InternedNestedConstruction.Syntax Symbol Guard),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstruction.Node expression →
    ∀ (environment : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard))
      (before : MicroCFTA.InternedConstructorTemplates.State Symbol Guard)
      (value : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
      (after : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
      MicroCFTA.InternedFreshOrdinaryConstruction.build expression environment before =
          MicroCFTA.InternedNestedConstruction.Outcome.done value after →
        ∀ (bits : Nat),
          before.nodes.next +
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.nodeCount expression ≤
              2 ^ bits →
            before.edges.next +
                  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryConstructionReservations.edgeCount expression ≤
                2 ^ (bits + 2) →
              after.nodes.next ≤ 2 ^ bits ∧ after.edges.next ≤ 2 ^ (bits + 2)
