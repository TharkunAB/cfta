MicroCFTA.SourcePruningEnumerationNarrowContext.complete {EnumGuard Typing Key : Type} {width : Nat}
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory)
  (caller : MicroCFTA.SourceCurrentAllocatedPartialState.State width) (memos : MicroCFTA.EndpointMemoGateTrace.Memos)
  (holeKey : Typing → Nat → Key) (fits : Key → MicroCFTA.SourcePruningTemplates.Symbol → Bool)
  (admits :
    Key →
      MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
        Bool)
  (metadata : MicroCFTA.SourcePruningRecordTypes.Metadata Typing)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readAfter : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readFuel uv oldHandle : Nat) (scs : List MicroCFTA.EnumerationState.Suspended) (roots : Nat → Nat)
  (initial : MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory caller memos)
  (ready : MicroCFTA.EnumerationDriver.Ready uv before.core)
  (realized :
    MicroCFTA.SourcePruningEnumerationObservation.PendingRealized caller.checked.native.machine.heap before.core)
  (paths : MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots)
  (counts : MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting)
  (flags :
    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate caller.checked.native.machine.heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot))
  (read :
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.getValue readFuel uv) before.core
      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) readAfter) :
  ∃ oldValue result nativeFuel heap newHandle final,
    have afterCaller :=
      MicroCFTA.SourceCurrentAllocatedPartialState.advance caller
        (MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical caller.checked
          { heap := heap, equality := caller.checked.operations })
        caller.fourth caller.merge;
    MicroCFTA.SourcePruningEnumerationNodes.lookupNode caller.checked.native.machine.heap oldHandle = some oldValue ∧
      MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata nativeFuel uv oldValue
            caller.checked.native.machine.heap =
          MicroCFTA.MergedSourceComparison.Result.done result heap ∧
        (∀ (extra : Nat),
            MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata (nativeFuel + extra) uv oldValue
                caller.checked.native.machine.heap =
              MicroCFTA.MergedSourceComparison.Result.done result heap) ∧
          MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver inventory caller afterCaller final ∧
            MicroCFTA.Cache.Extends memos.unfolding final.unfolding ∧
              final.query = memos.query ∧
                MicroCFTA.InternedProbeProvenance.Available afterCaller.checked.native.machine.heap result ∧
                  result.free = [] ∧
                    MicroCFTA.SourcePruningEnumerationNodes.encodeNode result = some newHandle ∧
                      MicroCFTA.SourcePruningEnumerationNodes.lookupNode afterCaller.checked.native.machine.heap
                            newHandle =
                          some result ∧
                        (result = MicroCFTA.InternedConstructorTemplates.Value.empty →
                            ∀ (representativeFuel : Nat),
                              MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                    representativeFuel uv oldHandle scs oldValue caller.checked.native.machine.heap =
                                  MicroCFTA.MergedSourceComparison.Result.done
                                    (result, some MicroCFTA.EnumerationState.reject) heap ∧
                                ¬∃ after,
                                    MicroCFTA.EnumerationCorrectness.Success MicroCFTA.EnumerationState.reject readAfter
                                      () after) ∧
                          (result ≠ MicroCFTA.InternedConstructorTemplates.Value.empty →
                            ∃ representativeFuel countFuel action after,
                              MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                    representativeFuel uv oldHandle scs oldValue caller.checked.native.machine.heap =
                                  MicroCFTA.MergedSourceComparison.Result.done (result, some action) heap ∧
                                MicroCFTA.EnumerationCorrectness.Success action readAfter () after.core ∧
                                  (newHandle = oldHandle ∧
                                        after = MicroCFTA.EnumerationExpandableIndex.frame readAfter before ∨
                                      newHandle ≠ oldHandle ∧
                                        ∃ rereadAfter,
                                          MicroCFTA.EnumerationCorrectness.Success
                                              (MicroCFTA.EnumerationState.representative representativeFuel uv)
                                              readAfter uv rereadAfter ∧
                                            MicroCFTA.EnumerationCorrectness.Success
                                                (MicroCFTA.EnumerationState.setValue uv
                                                  (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                    scs))
                                                rereadAfter () after.core ∧
                                              ∀ (extra : Nat),
                                                MicroCFTA.SourcePruningEnumerationNativeIndex.write
                                                    afterCaller.checked.native.machine.heap (countFuel + extra) uv
                                                    (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                      scs)
                                                    scs scs
                                                    (MicroCFTA.EnumerationExpandableIndex.frame rereadAfter before) =
                                                  some after) ∧
                                    after.waiting = before.waiting ∧
                                      MicroCFTA.EnumerationDriver.Ready uv after.core ∧
                                        MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                                          MicroCFTA.SourcePruningEnumerationObservation.PendingRealized
                                              afterCaller.checked.native.machine.heap after.core ∧
                                            after.core.values[uv]? =
                                                some
                                                  (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                    scs) ∧
                                              MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values
                                                  after.waiting ∧
                                                (∀ (slot : Nat),
                                                    MicroCFTA.SourcePruningEnumerationNativeIndex.candidate
                                                        afterCaller.checked.native.machine.heap
                                                        (after.core.values[slot]?.getD
                                                          MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                                      some (after.expandable slot)) ∧
                                                  (MicroCFTA.EnumerationReferences.PendingReferences before.core →
                                                      MicroCFTA.EnumerationReferences.PendingReferences after.core) ∧
                                                    ∀ (held : Nat),
                                                      MicroCFTA.EnumerationReferences.IncomingAvoid held before.core →
                                                        MicroCFTA.EnumerationReferences.IncomingAvoid held after.core)
