      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {memos : MicroCFTA.EndpointMemoGateTrace.Memos} (budget : Nat)
  (initial : MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory before memos)
  (available : MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap query) :
  ∃ answer after saved final p h,
    (∀ (P H : Nat),
        p ≤ P →
          h ≤ H →
            MicroCFTA.SourceCurrentAllocatedConjunctionWorker.call P H budget query before.checked before.fourth =
