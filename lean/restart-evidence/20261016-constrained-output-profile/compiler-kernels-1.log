'OutputCompilerChecks.guarded_compile' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
@guarded_compile : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)]
  (request : NodeRequest Symbol Guard) (state : Machine Symbol Guard),
