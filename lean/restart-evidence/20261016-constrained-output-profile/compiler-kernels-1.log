'OutputCompilerChecks.self_profile' depends on axioms: [propext, Classical.choice, Quot.sound]
@self_profile : ∀ [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Guard)] (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SemanticReady state.heap →
      ∀ (entry : Interned InternedBinderProtocol.NodeKey) (rows : List Edge) (depth : Nat),
        Available state.heap (Value.node entry rows depth []) →
          SourceCurrentAllocatedFiniteOrdinaryDomain.Rows rows →
            NodeCertificate
              { domain := emptyDomain, left := Value.node entry rows depth [], right := Value.node entry rows depth [] }
              (Value.node entry rows depth [])
