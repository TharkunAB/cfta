@nullary_sentinel : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)] (left right : Interned (EdgeKey Symbol Guard))
  (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SemanticReady state.heap →
      have result :=
