@MicroCFTA.OutputStoredKernels.serial_families : ∀ {Symbol Guard : Type} {width : Nat}
  (before : MicroCFTA.SourceRecursiveIntersectionThunks.State width Symbol Guard),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.Stored before →
    ∀ (nodeHandle edgeHandle : Nat) (nodeRequest : MicroCFTA.SourceRecursiveIntersectionThunks.NodeRequest Symbol Guard)
      (edgeRequest : MicroCFTA.SourceRecursiveIntersectionThunks.EdgeRequest Symbol Guard)
      (entry : MicroCFTA.Cache.Interned (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)),
      before.nodes.cells nodeHandle =
          some { request := nodeRequest, status := MicroCFTA.FlatMemoThunk.Status.evaluating } →
        before.edges.cells edgeHandle =
            some { request := edgeRequest, status := MicroCFTA.FlatMemoThunk.Status.evaluating } →
          have middle :=
            MicroCFTA.SourceRecursiveIntersectionThunks.finishNode nodeHandle
              MicroCFTA.InternedConstructorTemplates.Value.empty before;
          have result :=
            MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry
              [MicroCFTA.InternedConstructorTemplates.Value.empty];
          have final := MicroCFTA.SourceRecursiveIntersectionThunks.finishEdge edgeHandle result middle;
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.Stored final ∧
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.NodeCertificate nodeRequest
                MicroCFTA.InternedConstructorTemplates.Value.empty ∧
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.EdgeCertificate edgeRequest result ∧
                final.nodes.cells nodeHandle =
                    some
                      { request := nodeRequest,
                        status :=
                          MicroCFTA.FlatMemoThunk.Status.returned MicroCFTA.InternedConstructorTemplates.Value.empty } ∧
                  final.edges.cells edgeHandle =
                    some { request := edgeRequest, status := MicroCFTA.FlatMemoThunk.Status.returned result }
