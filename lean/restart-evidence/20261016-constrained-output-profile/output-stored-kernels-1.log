@MicroCFTA.OutputStoredKernels.publish_empty : ∀ {Symbol Guard : Type} {width : Nat}
  (request owner : MicroCFTA.SourceRecursiveIntersectionThunks.NodeRequest Symbol Guard)
  (before chosen running : MicroCFTA.SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat),
  MicroCFTA.SourceCurrentAllocatedNativePhysicalCache.Valid before →
    MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.Stored before →
      MicroCFTA.SourceRecursiveIntersectionThunks.NodeReady before.machine request →
        MicroCFTA.SourceRecursiveIntersectionMemo.KeySafe width request.domain request.left request.right →
          MicroCFTA.SourceRecursiveIntersectionThunks.lookupNode width request before =
              (MicroCFTA.SourceRecursiveIntersectionThunks.NodeSelection.memoized handle, chosen) →
            MicroCFTA.SourceRecursiveIntersectionThunks.demandNode handle chosen =
                (MicroCFTA.FlatMemoThunk.Observation.evaluate owner, running) →
              have final :=
                MicroCFTA.SourceRecursiveIntersectionThunks.finishNode handle
                  MicroCFTA.InternedConstructorTemplates.Value.empty running;
              owner = request ∧
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.Stored final ∧
                  final.edges = running.edges ∧
                    final.nodes.cells handle =
                        some
                          { request := request,
                            status :=
                              MicroCFTA.FlatMemoThunk.Status.returned
                                MicroCFTA.InternedConstructorTemplates.Value.empty } ∧
                      MicroCFTA.SourceRecursiveIntersectionThunks.demandNode handle final =
                        (MicroCFTA.FlatMemoThunk.Observation.ready MicroCFTA.InternedConstructorTemplates.Value.empty,
                          final)
