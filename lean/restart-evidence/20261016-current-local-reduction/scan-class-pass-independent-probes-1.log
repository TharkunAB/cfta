                    MicroCFTA.SourceCurrentMemoMergeLanguage.CacheCovers
                      (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver) ambient memo) →
                  MicroCFTA.SourceCurrentConjunctionScanClassPass.Ranges budget records values before fourth memo →
                    ∀ (memos : MicroCFTA.EndpointMemoGateTrace.Memos),
                      MicroCFTA.EndpointMemoGateTrace.Valid before.native.machine.heap memos →
                        ∃ outcome results after savedFourth saved next final actual,
