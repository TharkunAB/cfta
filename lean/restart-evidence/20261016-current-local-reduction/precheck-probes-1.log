  {formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula}
  {solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula}
  {inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory}
  {original : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula}
  {loaded : MicroCFTA.SourceEqualityConjoinAllocation.Constraint MicroCFTA.FullSyntax.Formula}
  {inherited own : MicroCFTA.SourceEqualityConstraintAllocation.Value}
  {before : MicroCFTA.SourceEqualityNativeDemand.State width} {branch : MicroCFTA.SourceEqualityPrecheck.Branch},
  MicroCFTA.SourceCurrentAllocatedPrecheck.Receipt formulas solver inventory original loaded inherited before own
      branch →
    ∀ (output : List MicroCFTA.SourceEqualityClassOrder.Record),
      branch = MicroCFTA.SourceEqualityPrecheck.Branch.classes output →
        (∀ (paths : MicroCFTA.EqualityNormalize.Class),
            paths ∈ List.map MicroCFTA.SourceEqualityClassOrder.Record.paths output →
              ∀ (path : MicroCFTA.EqualityNormalize.Path), path ∈ paths → path ≠ []) ∧
          ∃ records,
            MicroCFTA.SourceEqualityPhysicalPayload.own original = Except.ok (some records) ∧
              MicroCFTA.SourceCompactGuards.sourceEqualities original =
                  some (List.map MicroCFTA.SourceEqualityClassOrder.Record.paths records) ∧
                output = MicroCFTA.SourceEqualityClassOrder.ordered records ∧
                  ∀ (record : MicroCFTA.SourceEqualityClassOrder.Record),
                    record ∈ output →
                      MicroCFTA.SourceEqualityClassOrder.Coherent record ∧
                        MicroCFTA.EqualityTrie.Ascending record.trie ∧
                          MicroCFTA.EqualityNormalize.Nontrivial record.paths
