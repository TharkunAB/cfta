        (MicroCFTA.InternedConstructorTemplates.EdgeValue MicroCFTA.SourcePruningTemplates.Symbol
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)) →
      Nat :=
fun scs start x => List.brecOn x (MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.cost._f scs start)
def MicroCFTA.SourcePruningEnumerationIncomingReservation.Reserved : Nat →
  MicroCFTA.SourcePruningEnumerationIncomingReservation.Seed → Nat → Prop :=
fun bits seed count =>
  ∀ (index : Nat),
    index < count →
      MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Room bits
        (MicroCFTA.SourcePruningEnumerationIncomingReservation.advance seed index).snd
def MicroCFTA.SourcePruningEnumerationIncomingReservation.advance : MicroCFTA.SourcePruningEnumerationIncomingReservation.Seed →
  Nat → MicroCFTA.SourcePruningEnumerationIncomingReservation.Seed :=
fun seed x =>
