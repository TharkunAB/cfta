diff --git a/lean/MicroCFTA/SourceCurrentAllocatedNativeObservedWords.lean b/lean/MicroCFTA/SourceCurrentAllocatedNativeObservedWords.lean
new file mode 100644
index 000000000..54917a55e
--- /dev/null
+++ b/lean/MicroCFTA/SourceCurrentAllocatedNativeObservedWords.lean
@@ -0,0 +1,47 @@
+import MicroCFTA.SourceCurrentAllocatedNativePhysicalTraceCompletion
+
+namespace MicroCFTA.SourceCurrentAllocatedNativeObservedWords
+open InternedConstructorTemplates SourceRecursiveIntersectionCode SourceEqualityNativeDemand
+open SourceCurrentAllocatedNativePhysicalExecution (Inputs)
+open SourceCurrentAllocatedNativePhysicalTraceCompletion (Trace)
+open SourceCurrentAllocatedNativeRequestBounds (Words WordRanges)
+local notation "Symbol" => SourceObservations.Label FullSyntax.Formula
+local notation "Guard" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Checked" => SourceEqualityNativeDemand.State
+variable {A : Type} {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Guard)]
+
+/-- A recorded physical instruction check includes its current numeric key bounds. -/
+theorem inputs_words (control : Control A) (state : Checked width) (inputs : Inputs control state) :
+    Words width control := by
+  cases control with
+  | edgeBody _ _ => trivial
+  | code code =>
+      cases code with
+      | node _ _ | edge _ _ => exact inputs.2
+      | pure | fail | work | enter | read | optionalBinder | finishNode | finishEdge => trivial
+
+/-- A completed checked trace contains the numeric checks of every possible actual prefix. -/
+theorem trace_wordRanges {fuel : Nat} {control : Control A} {before after : Checked width} {value : A}
+    (trace : Trace fuel control before (.code (.pure value)) after) : WordRanges control before := by
+  intro count next reached observed
+  induction fuel generalizing control before count next reached with
+  | zero =>
+      cases trace
+      cases observed with
+      | refl => trivial
+      | cons _ _ _ _ _ _ _ one _ =>
+          simp only [step, SourceRecursiveIntersectionNative.step, lift] at one
+          cases one
+  | succ fuel ih =>
+      cases trace with
+      | cons start initial middle current final result size inputs one rest =>
+          cases observed with
+          | refl => exact inputs_words _ _ inputs
+          | cons _ _ other after _ _ _ actual tail =>
+              obtain ⟨sameControl, sameState⟩ := Outcome.yielded.inj (one.symm.trans actual)
+              subst other
+              subst after
+              exact ih rest _ _ _ tail
+
+end MicroCFTA.SourceCurrentAllocatedNativeObservedWords
diff --git a/lean/MicroCFTA/SourceCurrentAllocatedNativeWordBoundary.lean b/lean/MicroCFTA/SourceCurrentAllocatedNativeWordBoundary.lean
new file mode 100644
index 000000000..3b9012b8e
--- /dev/null
+++ b/lean/MicroCFTA/SourceCurrentAllocatedNativeWordBoundary.lean
@@ -0,0 +1,127 @@
+import MicroCFTA.SourceCurrentAllocatedNativeObservedWords
+import MicroCFTA.SourceEqualityNativeDemandNodeShortcut
+import MicroCFTA.InternedFreshOrdinaryFacts
+
+/-!
+# Successful native execution does not check word bounds
+
+A closed source constructor allocates an ordinary node with identity one.
+Its tagged code is four, which exceeds the safe range at word width two.
+An empty-left native request still publishes the key and returns Empty.
+The initial physical memo tables are valid and both operands are available.
+This example does not assert semantic Ready or an inventory At receipt.
+It distinguishes raw execution from a trace that records physical checks.
+-/
+namespace MicroCFTA.SourceCurrentAllocatedNativeWordBoundary
+open Cache InternedConstructorTemplates InternedProbeProvenance
+open InternedNestedConstruction (Syntax Outcome)
+open SourceRecursiveIntersectionKernel SourceRecursiveIntersectionThunks
+open SourceRecursiveIntersectionCode SourceEqualityNativeDemand
+local notation "Symbol" => SourceObservations.Label FullSyntax.Formula
+local notation "Guard" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Guard
+local notation "Heap" => InternedConstructorTemplates.State Symbol Guard
+local notation "Checked" => SourceEqualityNativeDemand.State
+
+private instance : DecidableEq FullSyntax.Formula :=
+  fun first second => decidable_of_iff (FormulaOrder.compareFormula first second = .eq)
+    (FormulaOrder.formula_eq first second)
+private instance : DecidableEq (SourceGuards.Guard FullSyntax.Formula) :=
+  SourceEqualityPCSNativeEdge.guardDecidableEq
+private instance : DecidableEq Guard := fun first second =>
+  decidable_of_iff (first.equalities = second.equalities ∧ first.guard = second.guard)
+    (by cases first; cases second; simp)
+
+private def plain : Guard := ⟨some [], .top⟩
+private def expression : Syntax Symbol Guard :=
+  .node [.mk ("root", .top) plain [.node [.mk ("leaf", .top) plain []]]]
+private def built := InternedFreshOrdinaryConstruction.build expression [] empty
+private def root : Node := match built with | .done value _ => value | .pending .. => .empty
+private def heap : Heap := built.state
+private def request : NodeRequest Symbol Guard := ⟨IntersectionEmptyDomain.emptyDomain, .empty, root⟩
+private def before : Checked 2 :=
+  ⟨initial 2 ⟨heap, Cache.emptyState⟩, SourceEqualityConstraintMemoAllocation.empty⟩
+private def control : Control Node := .code (.node request .pure)
+private def key : IntersectionFlatMemoKeyDomain.Triple 2 :=
+  IntersectionFlatMemoKeyDomain.flatKey 2 IntersectionEmptyDomain.emptyDomain .empty (.node 1)
+private def published := (lookupNode 2 request before.native).2
+private def running := (demandNode 0 published).2
+private def after : Checked 2 := ⟨finishNode 0 .empty running, before.operations⟩
+
+private theorem built_done : built = .done root heap := by cbv
+
+private theorem root_reference : root.referenceOf = .node 1 := by cbv
+
+private theorem heap_facts : InternedNestedFacts.Facts heap :=
+  (InternedFreshOrdinaryFacts.closed_verified expression).facts
+
+private theorem root_available : Available heap root :=
+  (InternedFreshOrdinaryFacts.closed_verified expression).result root heap built_done
+
+private theorem operands_ready : NodeReady before.native.machine request :=
+  ⟨empty_domain _, empty_available _, root_available⟩
+
+private theorem initial_valid : SourceCurrentAllocatedNativePhysicalCache.Valid before.native :=
+  SourceCurrentAllocatedNativePhysicalCache.initial_valid _ ⟨heap_facts, Cache.empty_valid⟩
+
+private theorem actual_key :
+    SourceRecursiveIntersectionMemo.requestKey 2 request.domain request.left request.right = some key := by
+  change IntersectionFlatMemoKeyDomain.sourceKey 2 IntersectionEmptyDomain.emptyDomain
+    (Value.empty : Node).referenceOf root.referenceOf = some key
+  rw [root_reference]
+  rfl
+
+private theorem unsafe_key :
+    ¬ SourceRecursiveIntersectionMemo.KeySafe 2 request.domain request.left request.right := by
+  rintro ⟨_, _, _first, second, _, secondInput, _, secondSafe⟩
+  have same : IntersectSchedule.Input.node 1 = second := by
+    simpa only [request, root_reference, IntersectionFlatMemoKey.input, Option.some.injEq] using secondInput
+  cases same
+  simp [IntersectionFlatMemoKey.Safe, IntersectionFlatMemoKey.code] at secondSafe
+
+private theorem actual_done : execute 4 control before = .done .empty after := by
+  apply SourceEqualityNativeDemandProvenance.pure_node_complete request before .empty
+    (handle := 0) (chosen := published) (current := running)
+  · simp [compileNode, SourceRecursiveIntersectionControl.decision,
+      SourceRecursiveIntersectionControl.hasEmpty, request, Value.referenceOf]
+  · cbv
+  · cbv
+
+private theorem unsafe_words : ¬ SourceCurrentAllocatedNativeRequestBounds.Words 2 control := by
+  intro words
+  exact unsafe_key (words key actual_key)
+
+private theorem no_checked_trace :
+    ¬ ∃ fuel, SourceCurrentAllocatedNativePhysicalTraceCompletion.Trace fuel control before
+      (.code (.pure (Value.empty : Node))) after := by
+  rintro ⟨fuel, trace⟩
+  exact unsafe_words (SourceCurrentAllocatedNativeRequestBounds.WordRanges.current control before
+    (SourceCurrentAllocatedNativeObservedWords.trace_wordRanges trace))
+
+/-- Closed available operands and valid empty tables can complete with an unsafe positive-width key. -/
+theorem witness :
+    ∃ source : Syntax Symbol Guard, ∃ sourceHeap : Heap, ∃ value : Node,
+      ∃ original : NodeRequest Symbol Guard, ∃ start finish : Checked 2,
+        InternedFreshOrdinaryConstruction.build source [] empty = .done value sourceHeap ∧
+        InternedNestedFacts.Facts sourceHeap ∧ value.free = [] ∧ value.referenceOf = .node 1 ∧
+        original = ⟨IntersectionEmptyDomain.emptyDomain, .empty, value⟩ ∧
+        start.native = initial 2 ⟨sourceHeap, Cache.emptyState⟩ ∧
+        SourceCurrentAllocatedNativePhysicalCache.Valid start.native ∧
+        SourceEqualityConstraintMemoAllocation.Valid start.operations ∧
+        NodeReady start.native.machine original ∧
+        (∃ actualKey, SourceRecursiveIntersectionMemo.requestKey 2 original.domain original.left original.right =
+          some actualKey) ∧
+        ¬ SourceRecursiveIntersectionMemo.KeySafe 2 original.domain original.left original.right ∧
+        execute 4 (.code (.node original .pure)) start = .done (Value.empty : Node) finish ∧
+        ¬ SourceCurrentAllocatedNativeRequestBounds.Words 2 (.code (.node original (.pure : Node → Code Symbol Guard Node))) ∧
+        ¬ SourceCurrentAllocatedNativePhysicalExecution.Inputs (.code (.node original (.pure : Node → Code Symbol Guard Node))) start ∧
+        ¬ ∃ fuel, SourceCurrentAllocatedNativePhysicalTraceCompletion.Trace fuel
+          (.code (.node original .pure)) start (.code (.pure (Value.empty : Node))) finish := by
+  refine ⟨expression, heap, root, request, before, after, built_done, heap_facts, ?_, root_reference,
+    rfl, rfl, initial_valid, SourceEqualityConstraintMemoAllocation.empty_valid, operands_ready,
+    ⟨key, actual_key⟩, unsafe_key, actual_done, unsafe_words, ?_, no_checked_trace⟩
+  · cbv
+  · intro inputs
+    exact unsafe_words (SourceCurrentAllocatedNativeObservedWords.inputs_words control before inputs)
+
+end MicroCFTA.SourceCurrentAllocatedNativeWordBoundary
diff --git a/lean/MicroCFTA/SourceCurrentAllocatedTargetCallerObserved.lean b/lean/MicroCFTA/SourceCurrentAllocatedTargetCallerObserved.lean
new file mode 100644
index 000000000..4158c5697
--- /dev/null
+++ b/lean/MicroCFTA/SourceCurrentAllocatedTargetCallerObserved.lean
@@ -0,0 +1,77 @@
+import MicroCFTA.SourceCurrentAllocatedTargetObserved
+import MicroCFTA.SourceCurrentAllocatedTargetInitial
+import MicroCFTA.SourceCurrentAllocatedPartialInvariant
+
+namespace MicroCFTA.SourceCurrentAllocatedTargetQuery
+open InternedConstructorTemplates InternedProbeProvenance
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Context Post)
+local notation "Symbol" => SourceObservations.Label FullSyntax.Formula
+local notation "Guard" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Checked" => SourceEqualityNativeDemand.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+variable [DecidableEq (EdgeKey Symbol Guard)]
+variable {width : Nat} {formulas : SourceGuards.Formulas FullSyntax.Formula}
+  {solver : SourceGuards.Entailment FullSyntax.Formula} {inventory next : Inventory}
+  {before : Caller width} {after : Checked width} {left right value : Value Symbol Guard} {memos : Memos}
+
+/-- An actual query receipt preserves the full outer caller at its literal returned checked state. -/
+theorem receipt_post [DecidableEq Symbol]
+    (initial : Context formulas solver inventory before memos)
+    (receipt : Receipt formulas solver next left right before.checked value after memos) :
+    Post formulas solver next before
+      (SourceCurrentAllocatedPartialState.advance before after before.fourth before.merge) memos := by
+  have probes : InternedFreshOrdinaryProbeHeap.Heap after.native.machine.heap := by
+    cases receipt.actual with
+    | run trace => exact SourceCurrentAllocatedMuRebuild.trace_heap trace initial.ready.semantic initial.probes
+  exact ⟨⟨receipt.ready, receipt.admitted,
+    initial.sound.advance formulas solver after before.fourth before.merge receipt.effects,
+    initial.stored.grows receipt.effects.keeps, initial.covered,
+    SourceCurrentEmptinessMemo.grows formulas solver receipt.effects.keeps before.fourth initial.correct,
+    receipt.globals, probes⟩, receipt.effects, Cache.extends_refl _, fun _ _ found => found⟩
+
+/-- A recorded target step derives the full caller postcondition from its own physical checks. -/
+theorem Step.caller_post [DecidableEq Symbol]
+    (initial : Context formulas solver inventory before memos)
+    (leftAvailable : Available before.checked.native.machine.heap left)
+    (rightAvailable : Available before.checked.native.machine.heap right)
+    (leftClosed : left.free = []) (rightClosed : right.free = [])
+    (actual : Step left right before.checked value after) :
+    ∃ next : Inventory,
+      next.source = before.checked.native.machine.heap ∧ next.roots = inventory.roots ++ [left, right] ∧
+      Receipt formulas solver next left right before.checked value after memos ∧
+      Post formulas solver next before
+        (SourceCurrentAllocatedPartialState.advance before after before.fourth before.merge) memos := by
+  obtain ⟨next, source, roots, receipt⟩ := actual.verified_observed formulas solver inventory
+    initial.ready initial.admitted leftAvailable rightAvailable leftClosed rightClosed memos initial.globals
+  exact ⟨next, source, roots, receipt, receipt_post initial receipt⟩
+
+/-- Initial numeric room verifies the exact raw query return and its full outer postcondition. -/
+theorem raw_done_caller_initial [DecidableEq Symbol] (bits fuel : Nat)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (before : Caller (bits + 2)) (after : Checked (bits + 2))
+    (left right value : Value Symbol Guard) (memos : Memos)
+    (initial : Context formulas solver inventory before memos)
+    (leftAvailable : Available before.checked.native.machine.heap left)
+    (rightAvailable : Available before.checked.native.machine.heap right)
+    (leftClosed : left.free = []) (rightClosed : right.free = [])
+    (nodes : before.checked.native.machine.heap.nodes.next < 2 ^ bits)
+    (edges : before.checked.native.machine.heap.edges.next ≤ 2 ^ (bits + 2))
+    (room : before.checked.native.machine.domains.next +
+      2 ^ (before.checked.native.machine.heap.nodes.next +
+        before.checked.native.machine.heap.nodes.next * before.checked.native.machine.heap.nodes.next) < 2 ^ (bits + 1))
+    (done : SourceEqualityNativeDemand.execute fuel
+      (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right))
+      before.checked = .done value after) :
+    ∃ next : Inventory,
+      next.source = before.checked.native.machine.heap ∧ next.roots = inventory.roots ++ [left, right] ∧
+      Receipt formulas solver next left right before.checked value after memos ∧
+      Post formulas solver next before
+        (SourceCurrentAllocatedPartialState.advance before after before.fourth before.merge) memos := by
+  obtain ⟨next, source, roots, receipt⟩ := raw_done_verified_initial bits fuel formulas solver inventory
+    left right value before.checked after initial.ready initial.admitted leftAvailable rightAvailable
+    leftClosed rightClosed nodes edges room memos initial.globals done
+  exact ⟨next, source, roots, receipt, receipt_post initial receipt⟩
+
+end MicroCFTA.SourceCurrentAllocatedTargetQuery
diff --git a/lean/MicroCFTA/SourceCurrentAllocatedTargetInitial.lean b/lean/MicroCFTA/SourceCurrentAllocatedTargetInitial.lean
new file mode 100644
index 000000000..6290baea4
--- /dev/null
+++ b/lean/MicroCFTA/SourceCurrentAllocatedTargetInitial.lean
@@ -0,0 +1,73 @@
+import MicroCFTA.SourceCurrentAllocatedTargetQuery
+import MicroCFTA.SourceCurrentAllocatedRecursiveWarmInitialRanges
+
+/-!
+# Current target queries from initial numeric room
+
+Initial counters and domain room derive the reached word checks.
+The existing query producer returns the full receipt at its actual endpoint.
+A supplied raw return is verified only under the same initial premises.
+-/
+namespace MicroCFTA.SourceCurrentAllocatedTargetQuery
+open InternedConstructorTemplates InternedProbeProvenance SourceRecursiveIntersectionCode
+open SourceEqualityNativeDemand
+open SourceCurrentAllocatedNativeInventoryState (Inventory At)
+open SourceCurrentConjunctionClassScan (Ready)
+local notation "Symbol" => SourceObservations.Label FullSyntax.Formula
+local notation "Guard" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Checked" => SourceEqualityNativeDemand.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Guard)]
+
+/-- Initial numeric room constructs the full target receipt with the same warm tables. -/
+theorem finite_initial (bits : Nat)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (left right : Value Symbol Guard) (before : Checked (bits + 2))
+    (ready : Ready before) (admitted : At formulas solver inventory before)
+    (leftAvailable : Available before.native.machine.heap left) (rightAvailable : Available before.native.machine.heap right)
+    (leftClosed : left.free = []) (rightClosed : right.free = [])
+    (nodes : before.native.machine.heap.nodes.next < 2 ^ bits)
+    (edges : before.native.machine.heap.edges.next ≤ 2 ^ (bits + 2))
+    (room : before.native.machine.domains.next +
+      2 ^ (before.native.machine.heap.nodes.next +
+        before.native.machine.heap.nodes.next * before.native.machine.heap.nodes.next) < 2 ^ (bits + 1))
+    (memos : Memos) (valid : EndpointMemoGateTrace.Valid before.native.machine.heap memos) :
+    ∃ next : Inventory, ∃ value after,
+      next.source = before.native.machine.heap ∧ next.roots = inventory.roots ++ [left, right] ∧
+      Receipt formulas solver next left right before value after memos := by
+  have leftOriginal := SourceRecursiveIntersectionOriginalOutput.closed_original
+    left before.native.machine.heap ready.good.native.machine.1.coherent leftAvailable leftClosed
+  have rightOriginal := SourceRecursiveIntersectionOriginalOutput.closed_original
+    right before.native.machine.heap ready.good.native.machine.1.coherent rightAvailable rightClosed
+  have ranges := SourceCurrentAllocatedRecursiveWarmInitialRanges.warm_initial_ranges
+    bits before ready.good ready.semantic left right leftOriginal rightOriginal
+      leftAvailable rightAvailable nodes edges room
+  exact finite formulas solver inventory left right before ready admitted
+    leftAvailable rightAvailable leftClosed rightClosed ranges.1 memos valid
+
+/-- The same initial premises verify a raw return at its literal value and full state. -/
+theorem raw_done_verified_initial (bits givenFuel : Nat)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (left right value : Value Symbol Guard) (before after : Checked (bits + 2))
+    (ready : Ready before) (admitted : At formulas solver inventory before)
+    (leftAvailable : Available before.native.machine.heap left) (rightAvailable : Available before.native.machine.heap right)
+    (leftClosed : left.free = []) (rightClosed : right.free = [])
+    (nodes : before.native.machine.heap.nodes.next < 2 ^ bits)
+    (edges : before.native.machine.heap.edges.next ≤ 2 ^ (bits + 2))
+    (room : before.native.machine.domains.next +
+      2 ^ (before.native.machine.heap.nodes.next +
+        before.native.machine.heap.nodes.next * before.native.machine.heap.nodes.next) < 2 ^ (bits + 1))
+    (memos : Memos) (valid : EndpointMemoGateTrace.Valid before.native.machine.heap memos)
+    (done : execute givenFuel (.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) before =
+      .done value after) :
+    ∃ next : Inventory,
+      next.source = before.native.machine.heap ∧ next.roots = inventory.roots ++ [left, right] ∧
+      Receipt formulas solver next left right before value after memos := by
+  obtain ⟨next, result, reached, source, roots, receipt⟩ := finite_initial bits formulas solver inventory
+    left right before ready admitted leftAvailable rightAvailable leftClosed rightClosed nodes edges room memos valid
+  obtain ⟨fuel, actual⟩ := receipt.actual.done
+  obtain ⟨rfl, rfl⟩ := SourceCurrentAllocatedNativeColdClosedExact.completed_unique
+    givenFuel fuel _ before after reached value result done actual
+  exact ⟨next, source, roots, receipt⟩
+
+end MicroCFTA.SourceCurrentAllocatedTargetQuery
diff --git a/lean/MicroCFTA/SourceCurrentAllocatedTargetObserved.lean b/lean/MicroCFTA/SourceCurrentAllocatedTargetObserved.lean
new file mode 100644
index 000000000..3879d71d7
--- /dev/null
+++ b/lean/MicroCFTA/SourceCurrentAllocatedTargetObserved.lean
@@ -0,0 +1,39 @@
+import MicroCFTA.SourceCurrentAllocatedTargetQuery
+import MicroCFTA.SourceCurrentAllocatedNativeObservedWords
+
+namespace MicroCFTA.SourceCurrentAllocatedTargetQuery
+open InternedConstructorTemplates InternedProbeProvenance SourceRecursiveIntersectionCode
+open SourceCurrentAllocatedNativeInventoryState (Inventory At)
+open SourceCurrentConjunctionClassScan (Ready)
+local notation "Symbol" => SourceObservations.Label FullSyntax.Formula
+local notation "Guard" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Checked" => SourceEqualityNativeDemand.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+variable {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Guard)]
+
+/-- An actual recorded target step supplies its own numeric prefix checks. -/
+theorem Step.wordRanges {left right value : Value Symbol Guard} {before after : Checked width}
+    (actual : Step left right before value after) :
+    SourceCurrentAllocatedNativeRequestBounds.WordRanges
+      (.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) before := by
+  cases actual with
+  | run trace => exact SourceCurrentAllocatedNativeObservedWords.trace_wordRanges trace
+
+/-- A recorded target step derives its receipts without a separate range premise.
+The step already contains each actual instruction's physical input checks. -/
+theorem Step.verified_observed
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) {left right value : Value Symbol Guard} {before after : Checked width}
+    (actual : Step left right before value after)
+    (ready : Ready before) (admitted : At formulas solver inventory before)
+    (leftAvailable : Available before.native.machine.heap left) (rightAvailable : Available before.native.machine.heap right)
+    (leftClosed : left.free = []) (rightClosed : right.free = [])
+    (memos : Memos) (valid : EndpointMemoGateTrace.Valid before.native.machine.heap memos) :
+    ∃ next : Inventory,
+      next.source = before.native.machine.heap ∧ next.roots = inventory.roots ++ [left, right] ∧
+      Receipt formulas solver next left right before value after memos :=
+  actual.verified formulas solver inventory ready admitted leftAvailable rightAvailable leftClosed rightClosed
+    actual.wordRanges memos valid
+
+end MicroCFTA.SourceCurrentAllocatedTargetQuery
