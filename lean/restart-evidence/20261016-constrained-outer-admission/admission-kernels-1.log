@numeric_node_constructs : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node] (bits : Nat)
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  {inventory : SourceCurrentAllocatedNativeInventoryState.Inventory} {before : Caller (bits + 2)} {memos : Memos}
  (budget : Nat) (request : NodeRequest),
  Context formulas solver inventory before memos →
    EqReady before.checked.operations.constraints request.inherited →
      Available before.checked.native.machine.heap request.value →
        SourceCurrentAllocatedFiniteOrdinaryDomain.Node request.value →
          Stored before →
            SourceCurrentAllocatedPartialActiveOrder.ActiveAbove
                (SourceCurrentAllocatedPartialActiveOrder.nodeRank request) before →
              Plan bits budget (Entry.nodeCall request before) →
                ∃ result after next final,
                  SourceCurrentAllocatedPartialWorkerCompletion.StableRun
                      (fun f g s r e p h m c n =>
                        SourceCurrentAllocatedPartialWorker.nodeCall f g s r e p h m c n budget request before)
                      result after ∧
                    ∃ actual,
                      SourceCurrentAllocatedPartialSourceReads.NodeCallReads formulas solver actual memos final ∧
                        SourceCurrentAllocatedPartialChecks.Checks
                            (SourceCurrentAllocatedPartialChecks.nodeCallTrace actual) ∧
                          Post formulas solver next before after final ∧
                            Available after.checked.native.machine.heap result ∧
                              Stored after ∧
                                SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow request.value result ∧
                                  SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver request result
'MicroCFTA.OuterAdmissionKernels.numeric_node_constructs' depends on axioms: [propext, Classical.choice, Quot.sound]
@row_suffix_admitted : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node] (bits : Nat)
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  {budget : Nat} {inherited : SourceEqualityConstraintAllocation.Value}
  {original narrowed result : EdgeValue Symbol Guard} {originals : List (EdgeValue Symbol Guard)}
  {before middle afterChildren : Caller (bits + 2)},
  Admitted formulas solver (Entry.rows inherited (original :: originals) before) →
    Plan bits budget (Entry.rows inherited (original :: originals) before) →
      EdgeCall budget { inherited := inherited, value := original } before narrowed middle →
        Descendants budget inherited narrowed middle result afterChildren →
          Admitted formulas solver (Entry.rows inherited originals afterChildren) ∧
            SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Plan budget (Entry.rows inherited originals afterChildren)
'MicroCFTA.OuterAdmissionKernels.row_suffix_admitted' depends on axioms: [propext, Classical.choice, Quot.sound]
@indexed_suffix_admitted : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node] (bits : Nat)
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  {budget : Nat} {combined : SourceEqualityConstraintAllocation.Value} {index : Nat} {value result : Node}
  {values : List Node} {before middle : Caller (bits + 2)},
  Admitted formulas solver (Entry.walk combined index (value :: values) before) →
    Plan bits budget (Entry.walk combined index (value :: values) before) →
      NodeCall budget { inherited := (descend before combined index).fst, value := value }
          (descend before combined index).snd result middle →
        Admitted formulas solver (Entry.walk combined (index + 1) values middle) ∧
          SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Plan budget (Entry.walk combined (index + 1) values middle)
