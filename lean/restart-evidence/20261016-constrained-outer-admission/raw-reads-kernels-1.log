'FiniteOrdinaryRawReadsChecks.same_node_return' depends on axioms: [propext, Classical.choice, Quot.sound]
@same_node_return : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node]
  {bits budget : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) {request : NodeRequest} {before after : Caller (bits + 2)}
  {result : Node} (actual : NodeCall budget request before result after) (inventory : Inventory) {memos : Memos},
  Context formulas solver inventory before memos →
    EqReady before.checked.operations.constraints request.inherited →
      Available before.checked.native.machine.heap request.value →
        DNode request.value →
          Stored before →
            Plan bits budget (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.nodeCall request before) →
              ∃ final next,
                NodeCallReads formulas solver actual memos final ∧
                  Checks (nodeCallTrace actual) ∧
                    Post formulas solver next before after final ∧
                      Available after.checked.native.machine.heap result ∧
                        Stored after ∧
                          NodeNarrow request.value result ∧
                            SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver request result
'FiniteOrdinaryRawReadsChecks.generated_next_node' depends on axioms: [propext, Classical.choice, Quot.sound]
@generated_next_node : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node]
  {bits budget : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) {request : NodeRequest}
  {before middle after : Caller (bits + 2)} {firstValue result : Node}
  (first : NodeCall budget request before firstValue middle)
  (last : NodeCall budget { inherited := request.inherited, value := firstValue } middle result after)
  (inventory : Inventory) {memos : Memos},
  Context formulas solver inventory before memos →
    EqReady before.checked.operations.constraints request.inherited →
      Available before.checked.native.machine.heap request.value →
        DNode request.value →
          Stored before →
            Plan bits budget (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.nodeCall request before) →
              Plan bits budget
                  (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.nodeCall
                    { inherited := request.inherited, value := firstValue } middle) →
                ∃ current final next,
                  NodeCallReads formulas solver first memos current ∧
                    NodeCallReads formulas solver last current final ∧
                      Post formulas solver next before after final ∧ Stored after ∧ NodeNarrow request.value result
'FiniteOrdinaryRawReadsChecks.ordered_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
@ordered_rows : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)]
  [inst_2 : DecidableEq Node] {bits budget : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) {inherited : EqValue} {values results : List Edge}
  {before after : Caller (bits + 2)} (actual : Rows budget inherited values before results after)
  (inventory : Inventory) {memos : Memos},
  Context formulas solver inventory before memos →
    EqReady before.checked.operations.constraints inherited →
      Edges before.checked.native.machine.heap values →
        DRows values →
          Stored before →
            Plan bits budget (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.rows inherited values before) →
              ∃ final next,
                RowsReads formulas solver actual memos final ∧
                  Post formulas solver next before after final ∧
                    Stored after ∧
                      DRows results ∧
                        results.length = values.length ∧
                          MergedOrdinaryHeight.edgesHeight results ≤ MergedOrdinaryHeight.edgesHeight values
'FiniteOrdinaryRawReadsChecks.descendant_child_rank' depends on axioms: [propext, Classical.choice, Quot.sound]
@descendant_child_rank : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node]
  {bits budget : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) {inherited childInherited : EqValue} {value result : Edge}
  {before after : Caller (bits + 2)},
  Descendants budget inherited value before result after →
    ∀ (inventory : Inventory) {memos : Memos},
      Context formulas solver inventory before memos →
        EqReady before.checked.operations.constraints inherited →
          Resident before.checked.native.machine.heap value →
            DEdge value →
              Stored before →
                Plan bits budget
                    (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.descendants inherited value before) →
                  ∀ (child : Node),
                    child ∈ result.children →
                      DNode child ∧
                        SourceCurrentAllocatedPartialActiveOrder.nodeRank
                            { inherited := childInherited, value := child } <
                          SourceCurrentAllocatedPartialActiveOrder.edgeRank { inherited := inherited, value := value }
'FiniteOrdinaryRawReadsChecks.contradictory_children' depends on axioms: [propext, Classical.choice, Quot.sound]
@contradictory_children : ∀ [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq Node]
  {bits budget : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory) (values : List Node)
  (before : Caller (bits + 2)) (memos : Memos),
  Context formulas solver inventory before memos →
    EqReady before.checked.operations.constraints SourceEqualityConstraintAllocation.Value.contradiction →
      Values before.checked.native.machine.heap values →
        DChildren values →
          Stored before →
            Plan bits budget
                (SourceCurrentAllocatedFiniteOrdinaryOuterEntries.Entry.children
                  SourceEqualityConstraintAllocation.Value.contradiction values before) →
              ∃ final, ChildrenReads formulas solver ⋯ memos final ∧ final = memos
