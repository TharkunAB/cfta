  {entry : MicroCFTA.Cache.Interned MicroCFTA.InternedBinderProtocol.NodeKey}
  {free : List MicroCFTA.InternedBinderProtocol.Reference},
  @Eq Bool
      ((@BEq.beq Nat (@instBEqOfDecidableEq Nat instDecidableEqNat) depth
            (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))).and
        (@List.isEmpty MicroCFTA.InternedBinderProtocol.Reference free))
