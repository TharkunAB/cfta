diff --git a/lean/MicroCFTA/SourcePruningEnumerationSuspendedMass.lean b/lean/MicroCFTA/SourcePruningEnumerationSuspendedMass.lean
new file mode 100644
index 000000000..cc6c848a6
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationSuspendedMass.lean
@@ -0,0 +1,117 @@
+import MicroCFTA.SourcePruningEnumerationExpansionAdmission
+
+/-!
+# Exact suspended mass at pending-slot writes
+
+Assimilation moves the source bucket into a distinct target and removes
+its old occurrence. Incoming replacement adds only the incoming bucket.
+These equations count every suspended occurrence, including duplicates.
+-/
+namespace MicroCFTA.SourcePruningEnumerationSuspendedMass
+open EnumerationState EnumerationCorrectness
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Core" => EnumerationState.State Symbol Constraint
+
+private theorem sum_map_set_balance {α : Type} (weight : α → Nat)
+    (values : List α) (index : Nat) (old new : α)
+    (stored : values[index]? = some old) :
+    ((values.set index new).map weight).sum + weight old =
+      (values.map weight).sum + weight new := by
+  induction values generalizing index with
+  | nil => simp at stored
+  | cons first rest ih =>
+      cases index with
+      | zero =>
+          simp only [List.getElem?_cons_zero, Option.some.injEq] at stored
+          subst first
+          simp only [List.set_cons_zero, List.map_cons, List.sum_cons]
+          omega
+      | succ index =>
+          simp only [List.getElem?_cons_succ] at stored
+          have balance := ih index stored
+          simp only [List.set_cons_succ, List.map_cons, List.sum_cons]
+          omega
+
+/-- Distinct pending-slot assimilation preserves the total suspended mass. -/
+theorem assimilated_mass
+    (before : Core) (source target : Nat) (sourceNode targetNode merged : Option Nat)
+    (sourceScs targetScs : List Suspended)
+    (sourceStored : before.values[source]? = some (.unenumerated sourceNode sourceScs))
+    (targetStored : before.values[target]? = some (.unenumerated targetNode targetScs))
+    (different : target ≠ source) :
+    suspendedBound (assimilated before target source
+      (.unenumerated merged (sourceScs ++ targetScs))) = suspendedBound before := by
+  let weight : UVarValue Symbol → Nat := fun value => match value with
+    | .unenumerated _ scs => scs.length
+    | _ => 0
+  have targetBalance := sum_map_set_balance weight before.values target
+    (.unenumerated targetNode targetScs)
+    (.unenumerated merged (sourceScs ++ targetScs)) targetStored
+  have sourceAfter : (before.values.set target
+      (.unenumerated merged (sourceScs ++ targetScs)))[source]? =
+      some (.unenumerated sourceNode sourceScs) := by
+    rw [List.getElem?_set_ne different]
+    exact sourceStored
+  have sourceBalance := sum_map_set_balance weight
+    (before.values.set target (.unenumerated merged (sourceScs ++ targetScs))) source
+    (.unenumerated sourceNode sourceScs) .eliminated sourceAfter
+  change (((before.values.set target (.unenumerated merged (sourceScs ++ targetScs))).set
+    source .eliminated).map weight).sum = (before.values.map weight).sum
+  simp only [weight, List.length_append] at targetBalance sourceBalance ⊢
+  omega
+
+/-- Appending incoming constraints adds exactly their length to the suspended mass. -/
+theorem incoming_mass
+    (before : Core) (target : Nat) (oldNode newNode : Option Nat)
+    (incomingScs oldScs : List Suspended)
+    (stored : before.values[target]? = some (.unenumerated oldNode oldScs)) :
+    suspendedBound {before with values := before.values.set target (.unenumerated newNode (incomingScs ++ oldScs))} =
+      suspendedBound before + incomingScs.length := by
+  let weight : UVarValue Symbol → Nat := fun value => match value with
+    | .unenumerated _ scs => scs.length
+    | _ => 0
+  have balance := sum_map_set_balance weight before.values target
+    (.unenumerated oldNode oldScs) (.unenumerated newNode (incomingScs ++ oldScs)) stored
+  change ((before.values.set target (.unenumerated newNode (incomingScs ++ oldScs))).map weight).sum =
+    (before.values.map weight).sum + incomingScs.length
+  simp only [weight, List.length_append] at balance ⊢
+  omega
+
+end MicroCFTA.SourcePruningEnumerationSuspendedMass
+
+
+namespace MicroCFTA.SourcePruningEnumerationPrefixAdmission
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Core" => EnumerationState.State Symbol Constraint
+
+/-- Equal stored slots retain the complete pending-bucket mass, including repeated entries. -/
+theorem suspendedBound_values (before after : Core) (values : after.values = before.values) :
+    suspendedBound after = suspendedBound before := by
+  simp only [suspendedBound, values]
+
+end MicroCFTA.SourcePruningEnumerationPrefixAdmission
+
+namespace MicroCFTA.SourcePruningEnumerationExpansionAdmission
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Core" => EnumerationState.State Symbol Constraint
+
+/-- Equal stored slots retain the expansion count fixed at the original native seed. -/
+theorem count_values (seed : Seed) (before after : Core) (values : after.values = before.values) :
+    count seed after = count seed before := by
+  unfold count
+  rw [SourcePruningEnumerationPrefixAdmission.suspendedBound_values before after values]
+
+/-- The original reservation applies after a callback that retains every stored slot. -/
+theorem reserved_values (bits : Nat) (seed : Seed) (before after : Core)
+    (values : after.values = before.values)
+    (reserved : Reserved bits (narrowSeed seed) (count seed before)) :
+    Reserved bits (narrowSeed seed) (count seed after) := by
+  rw [count_values seed before after values]
+  exact reserved
+
+end MicroCFTA.SourcePruningEnumerationExpansionAdmission
diff --git a/lean/MicroCFTA/SourcePruningEnumerationCallbackOneResources.lean b/lean/MicroCFTA/SourcePruningEnumerationCallbackOneResources.lean
new file mode 100644
index 000000000..35007f19a
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationCallbackOneResources.lean
@@ -0,0 +1,130 @@
+import MicroCFTA.SourcePruningEnumerationSuspendedMass
+import MicroCFTA.SourcePruningEnumerationRunOneResources
+import MicroCFTA.SourcePruningEnumerationRecursiveCallback
+
+/-!
+# A concrete fragment callback followed by one recursive expansion
+
+The callback retains every stored bucket. Its returned packet uses the
+reservation fixed before recording. One common work bound covers recording
+and the actual depth-one driver. The generic callback equation remains
+available for every continuation.
+-/
+namespace MicroCFTA.SourcePruningEnumerationRecursive
+open EnumerationState EnumerationCorrectness EnumerationDriver EnumerationCompressionFrame
+open InternedConstructorTemplates
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+open SourcePruningRecordTypes
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Fragment" => Fragments.Fragment Symbol
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "reservationAdvance" => SourcePruningEnumerationIncomingReservation.advance
+local notation "narrowSeed" => SourcePruningEnumerationExpansionAdmission.narrowSeed
+local notation "forecastCount" => SourcePruningEnumerationExpansionAdmission.count
+variable {Typing Key : Type} {bits : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+local notation "Result" => SourcePruningEnumerationNativeContinuations.HookResult
+  (Output (bits + 2) Typing) (Failure (bits + 2) Typing) (bits + 2)
+
+/-- The original callback packet and reservation derive the exact depth-one hook and its resources. -/
+theorem callback_one_complete_resources
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (metadata : Metadata Typing) (uv : Nat) (fragment : Fragment)
+    (caller : Caller (bits + 2)) (memos : Memos) (before : Cached)
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (seed : Seed)
+    (packet : Packet formulas solver inventory caller memos metadata before)
+    (allocated : FragmentBound before.core.counter fragment)
+    (bounded : Fits seed.2 caller.checked)
+    (known : Heap (fun guard => guard ∈ seed.1) caller.checked.native.machine.heap)
+    (selectionMembers : ∀ entry rows depth free, ∀ edge ∈ edgesOf (.node entry rows depth free), edge ∈ rows)
+    (selectionLength : ∀ entry rows depth free, (edgesOf (.node entry rows depth free)).length ≤ rows.length)
+    (reserved : Reserved bits (narrowSeed seed) (forecastCount seed before.core)) :
+    ∃ (fuel : Nat) (result : Bool × Metadata Typing) (after : Core) (outcome : Result),
+      Packet formulas solver inventory caller memos result.2 (EnumerationExpandableIndex.frame after before) ∧
+      RenderStable before.core after ∧ Frame before.core after ∧
+      result.2.types = updatedTypes metadata uv (.inl fragment) ∧
+      result.2.openHoles = metadata.openHoles ∧ result.2.typing = metadata.typing ∧
+      (∀ extra,
+        Success (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment)) before.core result after ∧
+        ExceptT.run (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment) before.core) =
+          [.ok (result, after)] ∧
+        ∀ (recur : Metadata Typing → Caller (bits + 2) → Queries → Cached → Option Next → Result) stop order,
+          continueWith recur graph templates stop order (fuel + extra) metadata uv fragment caller memos.query before =
+            if result.1 then .complete [] caller memos.query
+            else recur result.2 caller memos.query (EnumerationExpandableIndex.frame after before)
+              (SourcePruningEnumerationRestart.decision stop order result.2
+                (EnumerationExpandableIndex.frame after before))) ∧
+      (∀ extra, continueWith
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (fuel + extra) 1)
+        graph templates stop order (fuel + extra) metadata uv fragment caller memos.query before = outcome) ∧
+      OutcomeResources formulas solver caller
+        (reservationAdvance (narrowSeed seed) (forecastCount seed before.core)) outcome := by
+  obtain ⟨callbackFuel, result, after, returned, stable, frame, types, holes, typing, callback⟩ :=
+    callback_complete formulas solver inventory graph templates metadata uv fragment caller memos before
+      packet allocated
+  by_cases rejected : result.1 = true
+  · have resources : OutcomeResources (Typing := Typing) formulas solver caller seed (.complete [] caller memos.query) := by
+      refine ⟨caller, inventory, memos, Post.refl packet.context, bounded, known, rfl, rfl, ?_⟩
+      intro output member
+      exact False.elim (List.not_mem_nil member)
+    have numeric := (SourceCurrentConstrainedCapEditForecast.headProfile_ge seed.2).trans
+      (SourcePruningEnumerationIncomingReservation.advance_profile_ge
+        (seed.1, SourceCurrentConstrainedCapEditForecast.headProfile seed.2)
+        (forecastCount seed before.core))
+    have alphabet : seed.1 ⊆
+        (reservationAdvance (seed.1, SourceCurrentConstrainedCapEditForecast.headProfile seed.2)
+          (forecastCount seed before.core)).1 :=
+      SourcePruningEnumerationIncomingReservation.advance_alphabet_ge
+        (seed.1, SourceCurrentConstrainedCapEditForecast.headProfile seed.2)
+        (forecastCount seed before.core)
+    refine ⟨callbackFuel, result, after, .complete [] caller memos.query,
+      returned, stable, frame, types, holes, typing, callback, ?_, resources.mono numeric alphabet⟩
+    intro extra
+    rw [(callback extra).2.2
+      (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (callbackFuel + extra) 1)
+      stop order, ite_eq_left rejected]
+  · have reservedAfter : Reserved bits (narrowSeed seed)
+        (forecastCount seed (EnumerationExpandableIndex.frame after before).core) :=
+      SourcePruningEnumerationExpansionAdmission.reserved_values bits seed before.core after frame.values reserved
+    obtain ⟨resumeFuel, outcome, running, resources⟩ := run_one_complete_resources
+      holeKey fits admits graph templates checkEmpty edgesOf stop order formulas solver inventory caller memos
+      (EnumerationExpandableIndex.frame after before) result.2 seed returned bounded known
+      selectionMembers selectionLength reservedAfter
+    have sameCount : forecastCount seed (EnumerationExpandableIndex.frame after before).core =
+        forecastCount seed before.core :=
+      SourcePruningEnumerationExpansionAdmission.count_values seed before.core after frame.values
+    rw [sameCount] at resources
+    refine ⟨callbackFuel + resumeFuel, result, after, outcome,
+      returned, stable, frame, types, holes, typing, ?_, ?_, resources⟩
+    · intro extra
+      have actual := callback (resumeFuel + extra)
+      rw [← Nat.add_assoc] at actual
+      exact actual
+    · intro extra
+      have actual := callback (resumeFuel + extra)
+      rw [← Nat.add_assoc] at actual
+      rw [actual.2.2
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order
+          (callbackFuel + resumeFuel + extra) 1) stop order, ite_eq_right rejected]
+      have observed := running (callbackFuel + extra)
+      have common : resumeFuel + (callbackFuel + extra) = callbackFuel + resumeFuel + extra := by omega
+      rw [common] at observed
+      exact observed
+
+end MicroCFTA.SourcePruningEnumerationRecursive
diff --git a/lean/MicroCFTA/SourcePruningEnumerationSubtreeEffects.lean b/lean/MicroCFTA/SourcePruningEnumerationSubtreeEffects.lean
new file mode 100644
index 000000000..a80401dbf
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationSubtreeEffects.lean
@@ -0,0 +1,68 @@
+import MicroCFTA.SourcePruningEnumerationOutcomeResources
+
+/-!
+# Native effects from a recursive subtree
+
+A completed subtree supplies the actual caller and full memos for the next
+sibling. The captured cache and metadata retain their packet there. A stopped
+subtree keeps its outputs, nested reason and actual optional endpoint.
+-/
+namespace MicroCFTA.SourcePruningEnumerationRecursive
+open EnumerationState InternedConstructorTemplates
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Receipt" => SourcePruningEnumerationSelectedEdge.Result
+local notation "FoldResult" => SourcePruningEnumerationNativeContinuations.Result
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+variable {Typing : Type} {width : Nat}
+variable [DecidableEq (EdgeKey Symbol Constraint)]
+
+/-- A completed subtree retains the captured sibling packet at its actual native endpoint. -/
+theorem completed_captured_packet
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (caller : Caller width) (memos : Memos)
+    (metadata : Metadata Typing) (before : Cached) (seed : Seed)
+    (outputs : List (Output width Typing)) (reached : Caller width) (queries : Queries)
+    (packet : Packet formulas solver inventory caller memos metadata before)
+    (resources : OutcomeResources formulas solver caller seed (.complete outputs reached queries)) :
+    ∃ (next : Inventory) (final : Memos),
+      Post formulas solver next caller reached final ∧ final.query = queries ∧
+      Packet formulas solver next reached final metadata before ∧
+      Fits seed.2 reached.checked ∧ Heap (fun guard => guard ∈ seed.1) reached.checked.native.machine.heap ∧
+      ∀ output ∈ outputs, OutputResources formulas solver caller seed output := by
+  obtain ⟨actual, next, final, post, bounded, known, same, query, outputPackets⟩ := resources
+  subst actual
+  exact ⟨next, final, post, query.symm, captured_post packet post, bounded, known, outputPackets⟩
+
+/-- Finish retains arbitrary stopped subtree outputs and never fills an absent endpoint. -/
+theorem finish_resources_general
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (original : Caller width) (uv : Nat) (seed : Seed)
+    (processed : List (Receipt width)) (outputs : List (Output width Typing))
+    (afterCaller : Caller width) (next : Inventory) (final : Memos)
+    (result : FoldResult (Output width Typing) (Failure width Typing) width)
+    (post : Post formulas solver next original afterCaller final)
+    (bounded : Fits seed.2 afterCaller.checked)
+    (known : Heap (fun guard => guard ∈ seed.1) afterCaller.checked.native.machine.heap)
+    (outputResources : ∀ output ∈ outputs, OutputResources formulas solver original seed output)
+    (shape : result = .complete processed outputs afterCaller final.query ∨
+      ∃ current, result = .stopped processed outputs current ∧
+        (endpoint current = none ∨ endpoint current = some (afterCaller, final.query))) :
+    OutcomeResources formulas solver original seed (finish uv result) := by
+  refine ⟨afterCaller, next, final, post, bounded, known, ?_⟩
+  rcases shape with completed | ⟨current, stopped, observed⟩
+  · subst result
+    exact ⟨rfl, rfl, outputResources⟩
+  · subst result
+    exact ⟨observed, outputResources⟩
+
+end MicroCFTA.SourcePruningEnumerationRecursive
