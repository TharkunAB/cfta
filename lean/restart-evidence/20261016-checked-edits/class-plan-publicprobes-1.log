MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled_nonroot : ∀ (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    MicroCFTA.EqualityNormalize.Nontrivial record.paths →
      ∀ (path : MicroCFTA.SourceEqualityEdits.Path) (action : MicroCFTA.EqualityNormalize.Path),
        (path, action) ∈ MicroCFTA.SourceEqualityClassEdits.edits record.paths id → path ≠ []
MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled_not_leaf : ∀
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    MicroCFTA.EqualityNormalize.Nontrivial record.paths →
      ∀ (token : MicroCFTA.EqualityNormalize.Path),
        MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record ≠ MicroCFTA.SourceEqualityEdits.Edits.editAt token
MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled_children : ∀
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    MicroCFTA.EqualityNormalize.Nontrivial record.paths →
      ∃ entries,
        MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record =
          MicroCFTA.SourceEqualityEdits.Edits.editBelow entries
@MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled_safe : ∀ {Symbol Guard : Type}
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    ∀ (values : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)),
      (∀ (path : MicroCFTA.EqualityNormalize.Path),
          path ∈ record.paths →
            MicroCFTA.SourceEqualityProjectionPathDomain.ForestClosed (List.map Int.ofNat path) values) →
        ∀ (entries : List (Int × MicroCFTA.SourceEqualityEdits.Edits MicroCFTA.EqualityNormalize.Path)),
          MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record =
              MicroCFTA.SourceEqualityEdits.Edits.editBelow entries →
            MicroCFTA.SourceCurrentEditDomains.ChildrenSafe entries 0 values
@MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled_condition : ∀ {Symbol : Type}
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    MicroCFTA.EqualityNormalize.Nontrivial record.paths →
      ∀ (symbol : Symbol) (terms : List (MicroCFTA.Language.Term Symbol)),
        MicroCFTA.SourceEqualityEditAPI.ListCondition
          (fun path part => (MicroCFTA.Language.Term.node symbol terms).atPath path = some part)
          (MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record) terms
