MicroCFTA.SourceCurrentAllocatedClassEditPlanProbes.compiled_tokens : ∀
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    ∀ (signed : List Int) (token : MicroCFTA.EqualityNormalize.Path),
      (signed, token) ∈
          MicroCFTA.SourceEqualityEditLeafPaths.leaves (MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record) ↔
        token ∈ record.paths ∧ signed = List.map Int.ofNat token
@MicroCFTA.SourceCurrentAllocatedClassEditPlanProbes.selected_plan : ∀ {Symbol Guard : Type}
  (record : MicroCFTA.SourceEqualityClassOrder.Record),
  MicroCFTA.SourceEqualityClassOrder.Coherent record →
    MicroCFTA.EqualityNormalize.Nontrivial record.paths →
      ∀ (values : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)),
        (∀ (path : MicroCFTA.EqualityNormalize.Path),
            path ∈ record.paths →
              MicroCFTA.SourceEqualityProjectionPathDomain.ForestClosed (List.map Int.ofNat path) values) →
          ∃ entries,
            MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record =
                MicroCFTA.SourceEqualityEdits.Edits.editBelow entries ∧
              MicroCFTA.SourceCurrentEditDomains.ChildrenSafe entries 0 values ∧
                MicroCFTA.SourceEqualityEdits.Valid (MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record) ∧
                  MicroCFTA.SourceCurrentEditDomains.Populated
                      (MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record) ∧
                    MicroCFTA.SourceEqualitySharedEditEffects.Allowed record
                      (MicroCFTA.SourceCurrentAllocatedClassEditPlan.compiled record)
