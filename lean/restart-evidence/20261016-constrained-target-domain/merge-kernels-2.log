'FiniteOrdinaryMergeKernels.cold_empty_then_warm' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteOrdinaryMergeKernels.cold_empty_then_warm : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (clear : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula → Bool)
  (before : MicroCFTA.SourceCurrentAllocatedMergeGraph.State),
  MicroCFTA.SourceCurrentConjunctionRowsAllocation.Ready before →
    have saved :=
      MicroCFTA.SourceCurrentMemoMergeGraph.remember MicroCFTA.SourceCurrentMemoMergeGraph.empty
        MicroCFTA.InternedConstructorTemplates.Value.empty MicroCFTA.InternedConstructorTemplates.Value.empty;
    MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear MicroCFTA.InternedConstructorTemplates.Value.empty before
        MicroCFTA.SourceCurrentMemoMergeGraph.empty MicroCFTA.InternedConstructorTemplates.Value.empty before saved ∧
      MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear MicroCFTA.InternedConstructorTemplates.Value.empty before
          saved MicroCFTA.InternedConstructorTemplates.Value.empty before saved ∧
        MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects before before ∧
          MicroCFTA.SourceCurrentMemoMergeEffects.Stored before.heap saved ∧
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored saved ∧
              MicroCFTA.InternedProbeProvenance.Available before.heap
                  MicroCFTA.InternedConstructorTemplates.Value.empty ∧
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
                    MicroCFTA.InternedConstructorTemplates.Value.empty ∧
                  saved MicroCFTA.InternedBinderProtocol.NodeRef.empty =
                    some
                      { original := MicroCFTA.InternedConstructorTemplates.Value.empty,
                        result := MicroCFTA.InternedConstructorTemplates.Value.empty }
'FiniteOrdinaryMergeKernels.finite_then_finite_warm' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteOrdinaryMergeKernels.finite_then_finite_warm : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (clear : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula → Bool)
  (input :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (before : MicroCFTA.SourceCurrentAllocatedMergeGraph.State) (memo : MicroCFTA.SourceCurrentAllocatedMergeGraph.Memo),
  MicroCFTA.SourceCurrentConjunctionRowsAllocation.Ready before →
    MicroCFTA.SourceCurrentMemoMergeEffects.Stored before.heap memo →
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored memo →
        MicroCFTA.InternedProbeProvenance.Available before.heap input →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node input →
            ∃ output after saved,
              MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear input before memo output after saved ∧
                MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear input after saved output after saved ∧
                  MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects before after ∧
                    MicroCFTA.SourceCurrentMemoMergeEffects.Stored after.heap saved ∧
                      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored saved ∧
                        MicroCFTA.InternedProbeProvenance.Available after.heap output ∧
                          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node output ∧
                            ∃ entry,
                              saved input.referenceOf = some entry ∧ entry.original = input ∧ entry.result = output
'FiniteOrdinaryMergeKernels.constrained_small_group' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteOrdinaryMergeKernels.constrained_small_group : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (clear : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula → Bool)
  (before : MicroCFTA.SourceCurrentAllocatedMergeGraph.State)
  (own : MicroCFTA.Cache.Interned MicroCFTA.InternedBinderProtocol.NodeKey)
  (entry :
    MicroCFTA.Cache.Interned
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)))
  (depth : Nat),
  MicroCFTA.SourceCurrentConjunctionRowsAllocation.Ready before →
    MicroCFTA.InternedProbeProvenance.Available before.heap
        (MicroCFTA.InternedConstructorTemplates.Value.node own
          [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry []] depth []) →
      have input :=
        MicroCFTA.InternedConstructorTemplates.Value.node own
          [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry []] depth [];
      have rebuilt :=
        MicroCFTA.InternedConstructorTemplates.run
          (MicroCFTA.InternedConstructorTemplates.makeEdge entry.key.symbol entry.key.constraint []) before.heap;
      have nodeBuilt :=
        MicroCFTA.InternedConstructorTemplates.run (MicroCFTA.InternedConstructorTemplates.makeNode [rebuilt.fst])
          rebuilt.snd;
      have after := { heap := nodeBuilt.snd, equality := before.equality };
      have saved :=
        MicroCFTA.SourceCurrentMemoMergeGraph.remember MicroCFTA.SourceCurrentMemoMergeGraph.empty input nodeBuilt.fst;
      MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear input before MicroCFTA.SourceCurrentMemoMergeGraph.empty
          nodeBuilt.fst after saved ∧
        MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects before after ∧
          MicroCFTA.SourceCurrentMemoMergeEffects.Stored after.heap saved ∧
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored saved ∧
              MicroCFTA.InternedProbeProvenance.Available after.heap nodeBuilt.fst ∧
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node nodeBuilt.fst ∧
                  after.equality = before.equality
