'MicroCFTA.FiniteOrdinaryMergeCacheReview.completed_candidate' depends on axioms: [propext, Quot.sound]
@MicroCFTA.FiniteOrdinaryMergeCacheReview.completed_candidate : ∀ {Symbol Guard : Type} [DecidableEq Symbol]
  [DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (heap : MicroCFTA.InternedConstructorTemplates.State Symbol Guard)
  (memo : MicroCFTA.SourceCurrentMemoMergeGraph.Memo Symbol Guard)
  (input candidate : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady heap →
    MicroCFTA.SourceCurrentMemoMergeEffects.Stored heap memo →
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored memo →
        MicroCFTA.InternedProbeProvenance.Available heap input →
          MicroCFTA.InternedProbeProvenance.Available heap candidate →
            (input.free = [] → candidate.free = []) →
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node input →
                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node candidate →
                  MicroCFTA.SourceCurrentMemoMergeEffects.Stored heap
                      (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo input candidate) ∧
                    MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored
                        (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo input candidate) ∧
                      MicroCFTA.SourceCurrentMemoMergeGraph.remember memo input candidate input.referenceOf =
                          some (MicroCFTA.SourceCurrentMemoMergeGraph.winner memo input candidate) ∧
                        (MicroCFTA.SourceCurrentMemoMergeGraph.winner memo input candidate).original = input ∧
                          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
                              (MicroCFTA.SourceCurrentMemoMergeGraph.winner memo input candidate).result ∧
                            MicroCFTA.Cache.Extends memo
                              (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo input candidate)
'MicroCFTA.FiniteOrdinaryMergeCacheReview.earlier_winner' depends on axioms: [propext, Quot.sound]
@MicroCFTA.FiniteOrdinaryMergeCacheReview.earlier_winner : ∀ {Symbol Guard : Type} [DecidableEq Symbol]
  [DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (heap : MicroCFTA.InternedConstructorTemplates.State Symbol Guard)
  (memo : MicroCFTA.SourceCurrentMemoMergeGraph.Memo Symbol Guard)
  (input candidate : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
  (entry : MicroCFTA.SourceCurrentMemoMergeGraph.Entry Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady heap →
    MicroCFTA.InternedProbeProvenance.Available heap input →
      MicroCFTA.SourceCurrentMemoMergeEffects.Stored heap memo →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored memo →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node input →
            memo input.referenceOf = some entry →
              MicroCFTA.SourceCurrentMemoMergeGraph.remember memo input candidate = memo ∧
                MicroCFTA.SourceCurrentMemoMergeGraph.winner memo input candidate = entry ∧
                  entry.original = input ∧ MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node entry.result
'MicroCFTA.FiniteOrdinaryMergeCacheReview.serial_candidates' depends on axioms: [propext, Quot.sound]
@MicroCFTA.FiniteOrdinaryMergeCacheReview.serial_candidates : ∀ {Symbol Guard : Type}
  (memo : MicroCFTA.SourceCurrentMemoMergeGraph.Memo Symbol Guard)
  (first second one two : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored memo →
    (MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node first →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node one) →
      (MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node second →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node two) →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored
            (MicroCFTA.SourceCurrentMemoMergeGraph.remember
              (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo first one) second two) ∧
          MicroCFTA.Cache.Extends memo
              (MicroCFTA.SourceCurrentMemoMergeGraph.remember
                (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo first one) second two) ∧
            MicroCFTA.SourceCurrentMemoMergeGraph.remember
                (MicroCFTA.SourceCurrentMemoMergeGraph.remember memo first one) second two first.referenceOf =
              some (MicroCFTA.SourceCurrentMemoMergeGraph.winner memo first one)
'MicroCFTA.FiniteOrdinaryMergeCacheReview.empty_miss_then_hit' depends on axioms: [propext, Quot.sound]
@MicroCFTA.FiniteOrdinaryMergeCacheReview.empty_miss_then_hit : ∀ {Symbol Guard : Type} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)] (clear : Guard → Bool)
  (top : Guard) (heap : MicroCFTA.InternedConstructorTemplates.State Symbol Guard)
  (name : MicroCFTA.InternedBinderProtocol.Reference),
  have memo :=
    MicroCFTA.SourceCurrentMemoMergeGraph.remember MicroCFTA.SourceCurrentMemoMergeGraph.empty
      MicroCFTA.InternedConstructorTemplates.Value.empty MicroCFTA.InternedConstructorTemplates.Value.empty;
  MicroCFTA.SourceCurrentMemoMergeGraph.Call clear top MicroCFTA.InternedConstructorTemplates.Value.empty heap
      MicroCFTA.SourceCurrentMemoMergeGraph.empty MicroCFTA.InternedConstructorTemplates.Value.empty heap memo ∧
    MicroCFTA.SourceCurrentMemoMergeGraph.Call clear top MicroCFTA.InternedConstructorTemplates.Value.empty heap memo
        MicroCFTA.InternedConstructorTemplates.Value.empty heap memo ∧
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored memo ∧
        MicroCFTA.SourceCurrentMemoMergeGraph.remember memo MicroCFTA.InternedConstructorTemplates.Value.empty
              (MicroCFTA.InternedConstructorTemplates.Value.reference name) =
            memo ∧
          MicroCFTA.SourceCurrentMemoMergeGraph.winner memo MicroCFTA.InternedConstructorTemplates.Value.empty
                (MicroCFTA.InternedConstructorTemplates.Value.reference name) =
              { original := MicroCFTA.InternedConstructorTemplates.Value.empty,
                result := MicroCFTA.InternedConstructorTemplates.Value.empty } ∧
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
                (MicroCFTA.SourceCurrentMemoMergeGraph.winner memo MicroCFTA.InternedConstructorTemplates.Value.empty
                    (MicroCFTA.InternedConstructorTemplates.Value.reference name)).result ∧
              ¬MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
                  (MicroCFTA.InternedConstructorTemplates.Value.reference name)
