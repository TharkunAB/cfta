      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))}
  {base :
    MicroCFTA.InternedConstructorTemplates.State (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {path : MicroCFTA.EqualityNormalize.Path} {before : MicroCFTA.SourceCurrentAllocatedSharedTargetState.State width},
  MicroCFTA.SourceCurrentAllocatedSharedTargetState.Ready formulas solver inventory record values base before →
    MicroCFTA.InternedNestedProvenance.Values base values →
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Children values →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryShared.Stored before →
          MicroCFTA.SourceEqualityClassOrder.Coherent record →
            MicroCFTA.EqualityNormalize.Nontrivial record.paths →
              path ∈ record.paths →
                MicroCFTA.SourceCurrentAllocatedSharedTargetForce.ForceRanges record values path before →
                  ∀ (memos : MicroCFTA.EndpointMemoGateTrace.Memos),
                    MicroCFTA.EndpointMemoGateTrace.Valid before.checked.native.machine.heap memos →
                      ∃ value after next final,
                        MicroCFTA.SourceCurrentAllocatedSharedTargetForce.Receipt formulas solver next record values
                            base path before value after memos final ∧
                          MicroCFTA.SourceCurrentAllocatedSharedTargetForce.Force record values path after value after ∧
                            MicroCFTA.SourceCurrentAllocatedSharedTargetForce.Receipt formulas solver next record values
                                base path after value after final final ∧
                              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryShared.Stored after ∧
                                MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node value
