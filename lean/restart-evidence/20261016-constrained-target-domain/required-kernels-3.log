                  MicroCFTA.Language.All₂ MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow
                    [first, second] [first, second]
'FiniteOrdinaryRequiredKernels.serial_requireAll' depends on axioms: [propext, Classical.choice, Quot.sound]
@FiniteOrdinaryRequiredKernels.serial_requireAll : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (fuel readFuel nextFuel nextRead : Nat) (paths more : List (List Int))
  (values results outputs : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard))
  (before middle after : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredExecution.requireAll fuel readFuel paths values before =
      MicroCFTA.SourceEqualityRequiredWorker.Result.done results middle →
    MicroCFTA.SourceEqualityRequiredExecution.requireAll nextFuel nextRead more results middle =
        MicroCFTA.SourceEqualityRequiredWorker.Result.done outputs after →
      MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
        MicroCFTA.InternedNestedProvenance.Values before values →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Children values →
            MicroCFTA.SourceEqualityRequiredCache.Keeps before after ∧
              MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady after ∧
                MicroCFTA.InternedNestedProvenance.Values after outputs ∧
                  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Children outputs ∧
                    MicroCFTA.Language.All₂ MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow values
                        outputs ∧
                      outputs.length = values.length
