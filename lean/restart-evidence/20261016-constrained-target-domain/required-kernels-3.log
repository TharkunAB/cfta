                      [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry []] depth free)
'FiniteOrdinaryRequiredKernels.selected_then_unselected' depends on axioms: [propext, Quot.sound]
@FiniteOrdinaryRequiredKernels.selected_then_unselected : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (first second : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
  (state : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady state →
