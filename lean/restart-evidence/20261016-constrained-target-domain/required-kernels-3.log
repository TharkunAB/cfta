'FiniteOrdinaryRequiredKernels.rejected_zero_arity' depends on axioms: [propext, Quot.sound]
@FiniteOrdinaryRequiredKernels.rejected_zero_arity : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (entry : MicroCFTA.Cache.Interned (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard))
  (state : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady state →
    MicroCFTA.InternedEdgeResidency.EdgeResident state (MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry []) →
      have edge := MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry [];
      ∃ _actual,
        MicroCFTA.SourceEqualityRequiredCache.Keeps state state ∧
          MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady state ∧
            MicroCFTA.InternedNestedProvenance.Edges state [] ∧
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Rows [] ∧
                ∃ selected,
                  selected.Sublist [edge] ∧
                    MicroCFTA.Language.All₂ MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.EdgeNarrow selected
                      []
'FiniteOrdinaryRequiredKernels.retained_negative_key' depends on axioms: [propext, Quot.sound]
@FiniteOrdinaryRequiredKernels.retained_negative_key : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (entry : MicroCFTA.Cache.Interned (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard))
  (own : MicroCFTA.Cache.Interned MicroCFTA.InternedBinderProtocol.NodeKey) (depth : Nat)
  (free : List MicroCFTA.InternedBinderProtocol.Reference)
  (state : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady state →
    MicroCFTA.InternedProbeProvenance.Available state
        (MicroCFTA.InternedConstructorTemplates.Value.node own
          [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry []] depth free) →
      have edge := MicroCFTA.InternedConstructorTemplates.EdgeValue.mk entry [];
      have rebuilt :=
        MicroCFTA.InternedConstructorTemplates.run
          (MicroCFTA.InternedConstructorTemplates.makeEdge entry.key.symbol entry.key.constraint []) state;
      have final :=
        MicroCFTA.InternedConstructorTemplates.run (MicroCFTA.InternedConstructorTemplates.makeNode [rebuilt.fst])
          rebuilt.snd;
      ∃ _actual,
        MicroCFTA.SourceEqualityRequiredCache.Keeps state final.snd ∧
          MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady final.snd ∧
            MicroCFTA.InternedProbeProvenance.Available final.snd final.fst ∧
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow
                (MicroCFTA.InternedConstructorTemplates.Value.node own [edge] depth free) final.fst
'FiniteOrdinaryRequiredKernels.rejected_parent_empty' depends on axioms: [propext, Quot.sound]
@FiniteOrdinaryRequiredKernels.rejected_parent_empty : ∀ {Symbol Guard : Type}
  [inst : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)]
  (entry : MicroCFTA.Cache.Interned (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard))
