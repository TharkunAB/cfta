              MicroCFTA.SourceCurrentAllocatedMergeWorker.call clear w₂ s₂ first middle current =
                  MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done second after saved →
                MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear input before memo first middle current ∧
                  MicroCFTA.SourceCurrentAllocatedMergeGraph.Call clear first middle current second after saved ∧
                    MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects before after ∧
                      MicroCFTA.SourceCurrentMemoMergeEffects.Stored after.heap saved ∧
                        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeCache.Stored saved ∧
                          MicroCFTA.InternedProbeProvenance.Available after.heap first ∧
                            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node first ∧
