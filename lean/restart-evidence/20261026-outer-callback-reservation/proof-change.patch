--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationMassForecast.lean
@@ -0,0 +1,50 @@
+import MicroCFTA.SourcePruningEnumerationExpansionAdmission
+
+/-!
+# Reservations from an upper bound on suspended mass
+
+The upper bound can be fixed before an edge returns its cache. A smaller
+actual mass uses a prefix of the same incoming-query reservation.
+-/
+namespace MicroCFTA.SourcePruningEnumerationOriginalForecast
+open SourcePruningEnumerationIncomingReservation (Seed)
+
+/-- A larger inherited bucket bound covers the same original scan. -/
+theorem count_mono (seed : Seed) {first last : Nat} (bounded : first ≤ last) :
+    count seed first ≤ count seed last := by
+  exact Nat.mul_le_mul_left _ (Nat.add_le_add_right (Nat.add_le_add_right bounded _) 1)
+
+end MicroCFTA.SourcePruningEnumerationOriginalForecast
+
+namespace MicroCFTA.SourcePruningEnumerationExpansionAdmission
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Core" => EnumerationState.State Symbol Constraint
+
+/-- An original mass ceiling bounds the count at the actual returned cache. -/
+theorem count_le_mass (seed : Seed) (before : Core) (ceiling : Nat)
+    (bounded : SourcePruningEnumerationPrefixAdmission.suspendedBound before ≤ ceiling) :
+    count seed before ≤ SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling :=
+  SourcePruningEnumerationOriginalForecast.count_mono (narrowSeed seed) bounded
+
+/-- A reservation at the original mass ceiling pays the actual smaller scan. -/
+theorem reserved_of_mass (bits : Nat) (seed : Seed) (before : Core) (ceiling : Nat)
+    (bounded : SourcePruningEnumerationPrefixAdmission.suspendedBound before ≤ ceiling)
+    (reserved : Reserved bits (narrowSeed seed)
+      (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)) :
+    Reserved bits (narrowSeed seed) (count seed before) :=
+  reserved.prefix (count_le_mass seed before ceiling bounded)
+
+end MicroCFTA.SourcePruningEnumerationExpansionAdmission
+
+namespace MicroCFTA.SourcePruningEnumerationIncomingReservation
+
+/-- A later entry of the same schedule retains the guards at every earlier entry. -/
+theorem advance_count_alphabet_mono (seed : Seed) {first last : Nat} (counts : first ≤ last) :
+    (advance seed first).1 ⊆ (advance seed last).1 := by
+  obtain ⟨extra, rfl⟩ := Nat.exists_eq_add_of_le counts
+  rw [advance_add]
+  exact advance_alphabet_ge (advance seed first) extra
+
+end MicroCFTA.SourcePruningEnumerationIncomingReservation
diff --git a/lean/MicroCFTA/SourcePruningEnumerationNativeBranchBoundedResources.lean b/lean/MicroCFTA/SourcePruningEnumerationNativeBranchBoundedResources.lean
new file mode 100644
index 000000000..5c6fa495b
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationNativeBranchBoundedResources.lean
@@ -0,0 +1,149 @@
+import MicroCFTA.SourcePruningEnumerationNativeBranchResources
+import MicroCFTA.SourcePruningEnumerationCapturedEdgeScalarBounds
+
+/-!
+# Original cache bounds for one actual native alternative
+
+The complete head certificate remains available. The same actual receipt
+also retains bounds from the original arity and projected-class ceilings.
+-/
+namespace MicroCFTA.SourcePruningEnumerationNativeBranchCompletion
+open EnumerationState EnumerationCorrectness EnumerationSchedule EnumerationDependencies
+open InternedConstructorTemplates InternedProbeProvenance
+open SourcePruningEnumerationNodes SourcePruningEnumerationObservation
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Context Post)
+open SourcePruningEnumerationNativeBranches (advance)
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Receipt" => SourcePruningEnumerationSelectedEdge.Result
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "reservationAdvance" => SourcePruningEnumerationIncomingReservation.advance
+variable {width bits : Nat}
+
+/-- Bound each actual receipt cache from the captured input and original edge widths. -/
+def HeadCacheBounds (before : Cached) (scs : List Suspended) (arity own : Nat) : Receipt width → Prop
+  | .complete _ _ _ after | .rejected _ _ after =>
+      after.core.counter ≤ before.core.counter + own + arity ∧
+        suspendedBound after.core ≤ suspendedBound before.core + arity * (scs.length + own)
+  | .stopped _ _ candidate =>
+      ∀ after, candidate = some after →
+        after.core.counter ≤ before.core.counter + own + arity ∧
+          suspendedBound after.core ≤ suspendedBound before.core + arity * (scs.length + own)
+  | .unhandled => True
+
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- Original arity and projection widths bound every actual captured-edge cache receipt. -/
+theorem observed_head_cache_bounds
+    (checkEmpty : Bool) (r n p h k target : Nat) (scs : List Suspended)
+    (edge : EdgeValue Symbol Constraint) (caller : Caller width) (before : Cached) (queries : Queries)
+    (arity own : Nat) (arityBound : edge.children.length ≤ arity)
+    (ownBound : ∀ tries residual,
+      SourcePruningEnumerationConstraint.project edge.entry.key.constraint = some (tries, residual) →
+        tries.length ≤ own)
+    (receipt : Receipt width)
+    (observed : SourcePruningEnumerationCapturedEdge.run checkEmpty r n p h k target scs edge
+      caller before queries = some receipt) :
+    HeadCacheBounds before scs arity own receipt := by
+  by_cases allowed : arityAllows edge.children.length scs = true
+  · cases projected : SourcePruningEnumerationConstraint.project edge.entry.key.constraint with
+    | none =>
+        rw [SourcePruningEnumerationCapturedEdge.run,
+          SourcePruningEnumerationSelectedEdge.unsupported checkEmpty r n p h k scs edge caller before queries
+            allowed projected] at observed
+        cases Option.some.inj observed
+        trivial
+    | some pair =>
+        obtain ⟨tries, residual⟩ := pair
+        have ownLe := ownBound tries residual projected
+        have counterCeiling : before.core.counter + tries.length + edge.children.length ≤
+            before.core.counter + own + arity := by omega
+        have massCeiling : suspendedBound before.core + edge.children.length * (scs.length + tries.length) ≤
+            suspendedBound before.core + arity * (scs.length + own) :=
+          Nat.add_le_add_left (Nat.mul_le_mul arityBound (Nat.add_le_add_left ownLe scs.length)) _
+        have bounds := SourcePruningEnumerationCapturedEdge.observed_scalar_bounds
+          checkEmpty r n p h k target scs edge caller before queries tries residual projected
+        rw [observed] at bounds
+        cases receipt with
+        | unhandled => trivial
+        | complete _ _ _ after | rejected _ _ after =>
+            exact ⟨Nat.le_trans bounds.1 counterCeiling, Nat.le_trans bounds.2 massCeiling⟩
+        | stopped _ _ candidate =>
+            intro after attached
+            obtain ⟨counter, mass⟩ := bounds after attached
+            exact ⟨Nat.le_trans counter counterCeiling, Nat.le_trans mass massCeiling⟩
+  · have rejected : arityAllows edge.children.length scs = false := by
+      cases value : arityAllows edge.children.length scs with
+      | false => rfl
+      | true => exact (allowed value).elim
+    rw [SourcePruningEnumerationCapturedEdge.run,
+      SourcePruningEnumerationSelectedEdge.arity_rejected checkEmpty r n p h k scs edge caller before queries
+        rejected] at observed
+    cases Option.some.inj observed
+    exact ⟨by omega, Nat.le_add_right _ _⟩
+
+/-- The original head producer retains every receipt field and adds original-input cache bounds. -/
+theorem head_complete_cache_bounds
+    (seed : Seed)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (caller : Caller (bits + 2)) (before : Cached) (checkEmpty : Bool)
+    (uv handle : Nat) (scs : List Suspended)
+    (parentEntry : Cache.Interned InternedBinderProtocol.NodeKey)
+    (edges : List (EdgeValue Symbol Constraint)) (depth : Nat) (free : List InternedBinderProtocol.Reference)
+    (edge : EdgeValue Symbol Constraint) (roots : Nat → Nat) (memos : Memos)
+    (initial : Context formulas solver inventory caller memos)
+    (ready : EnumerationDriver.Ready uv before.core)
+    (stored : before.core.values[uv]? = some (.unenumerated (some handle) scs))
+    (decoded : lookupNode caller.checked.native.machine.heap handle = some (.node parentEntry edges depth free))
+    (realized : PendingRealized caller.checked.native.machine.heap before.core) (selected : edge ∈ edges)
+    (paths : Roots before.core.representatives roots)
+    (counts : EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting)
+    (flags : ∀ slot, SourcePruningEnumerationNativeIndex.candidate caller.checked.native.machine.heap
+      ((before.core.values[slot]?).getD .eliminated) = some (before.expandable slot))
+    (pending : InputsPending before.core scs)
+    (fits : Fits seed.2 caller.checked)
+    (reserved : Reserved bits seed (edgeCost scs before.core.counter edge))
+    (known : Heap (fun guard => guard ∈ seed.1) caller.checked.native.machine.heap)
+    (arity own : Nat) (arityBound : edge.children.length ≤ arity)
+    (ownBound : ∀ tries residual,
+      SourcePruningEnumerationConstraint.project edge.entry.key.constraint = some (tries, residual) →
+        tries.length ≤ own) :
+    ∃ (r n p h k : Nat) (receipt : Receipt (bits + 2)) (afterCaller : Caller (bits + 2)) (saved : Queries)
+      (final : Memos) (next : Inventory),
+      (∀ er en P H ek, p ≤ P → h ≤ H →
+        SourcePruningEnumerationCapturedEdge.run checkEmpty (r + er) (n + en) P H (k + ek)
+          uv scs edge caller before memos.query = some receipt) ∧
+      Post formulas solver next caller afterCaller final ∧ final.query = saved ∧ Admitted uv receipt ∧
+      (EnumerationReferences.PendingReferences before.core → EnumerationReferences.IncomingAvoid uv before.core →
+        Pending receipt) ∧
+      FragmentHistory before.core receipt ∧
+      (advance receipt = some (afterCaller, saved) ∨
+        receipt = .unhandled ∧ arityAllows edge.children.length scs = true ∧
+          SourcePruningEnumerationConstraint.project edge.entry.key.constraint = none) ∧
+      Fits (reservationAdvance seed (edgeCost scs before.core.counter edge)).2 afterCaller.checked ∧
+      Heap (fun guard => guard ∈ (reservationAdvance seed (edgeCost scs before.core.counter edge)).1)
+        afterCaller.checked.native.machine.heap ∧
+      HeadCacheBounds before scs arity own receipt := by
+  obtain ⟨r, n, p, h, k, receipt, afterCaller, saved, final, next,
+    running, post, queries, admitted, pendingHistory, history, shape, returnedFits, returnedKnown⟩ :=
+    head_complete_resources seed formulas solver inventory caller before checkEmpty uv handle scs
+      parentEntry edges depth free edge roots memos initial ready stored decoded realized selected
+      paths counts flags pending fits reserved known
+  refine ⟨r, n, p, h, k, receipt, afterCaller, saved, final, next,
+    running, post, queries, admitted, pendingHistory, history, shape, returnedFits, returnedKnown, ?_⟩
+  have observed := running 0 0 p h 0 (Nat.le_refl _) (Nat.le_refl _)
+  simp only [Nat.add_zero] at observed
+  exact observed_head_cache_bounds checkEmpty r n p h k uv scs edge caller before memos.query
+    arity own arityBound ownBound receipt observed
+
+end MicroCFTA.SourcePruningEnumerationNativeBranchCompletion
diff --git a/lean/MicroCFTA/SourcePruningEnumerationCallbackMassResources.lean b/lean/MicroCFTA/SourcePruningEnumerationCallbackMassResources.lean
new file mode 100644
index 000000000..5c5478342
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationCallbackMassResources.lean
@@ -0,0 +1,94 @@
+import MicroCFTA.SourcePruningEnumerationCallbackOneResources
+import MicroCFTA.SourcePruningEnumerationMassForecast
+
+/-!
+# A callback reservation fixed before the edge cache exists
+
+The original mass ceiling pays the callback's actual depth-one expansion.
+The complete earlier callback result remains available. The same outcome
+also fits the larger reservation computed from that ceiling.
+-/
+namespace MicroCFTA.SourcePruningEnumerationRecursive
+open EnumerationState EnumerationCorrectness EnumerationDriver EnumerationCompressionFrame
+open InternedConstructorTemplates
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+open SourcePruningRecordTypes
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Fragment" => Fragments.Fragment Symbol
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "reservationAdvance" => SourcePruningEnumerationIncomingReservation.advance
+local notation "narrowSeed" => SourcePruningEnumerationExpansionAdmission.narrowSeed
+local notation "forecastCount" => SourcePruningEnumerationExpansionAdmission.count
+variable {Typing Key : Type} {bits : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+local notation "Result" => SourcePruningEnumerationNativeContinuations.HookResult
+  (Output (bits + 2) Typing) (Failure (bits + 2) Typing) (bits + 2)
+
+/-- An original mass ceiling derives the full callback result and one uniform resource bound. -/
+theorem callback_one_complete_mass_resources
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (metadata : Metadata Typing) (uv : Nat) (fragment : Fragment)
+    (caller : Caller (bits + 2)) (memos : Memos) (before : Cached)
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (seed : Seed)
+    (packet : Packet formulas solver inventory caller memos metadata before)
+    (allocated : FragmentBound before.core.counter fragment)
+    (bounded : Fits seed.2 caller.checked)
+    (known : Heap (fun guard => guard ∈ seed.1) caller.checked.native.machine.heap)
+    (selectionMembers : ∀ entry rows depth free, ∀ edge ∈ edgesOf (.node entry rows depth free), edge ∈ rows)
+    (selectionLength : ∀ entry rows depth free, (edgesOf (.node entry rows depth free)).length ≤ rows.length)
+    (ceiling : Nat)
+    (mass : SourcePruningEnumerationPrefixAdmission.suspendedBound before.core ≤ ceiling)
+    (reserved : Reserved bits (narrowSeed seed)
+      (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)) :
+    ∃ (fuel : Nat) (result : Bool × Metadata Typing) (after : Core) (outcome : Result),
+      Packet formulas solver inventory caller memos result.2 (EnumerationExpandableIndex.frame after before) ∧
+      RenderStable before.core after ∧ Frame before.core after ∧
+      result.2.types = updatedTypes metadata uv (.inl fragment) ∧
+      result.2.openHoles = metadata.openHoles ∧ result.2.typing = metadata.typing ∧
+      (∀ extra,
+        Success (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment)) before.core result after ∧
+        ExceptT.run (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment) before.core) =
+          [.ok (result, after)] ∧
+        ∀ (recur : Metadata Typing → Caller (bits + 2) → Queries → Cached → Option Next → Result) stop order,
+          continueWith recur graph templates stop order (fuel + extra) metadata uv fragment caller memos.query before =
+            if result.1 then .complete [] caller memos.query
+            else recur result.2 caller memos.query (EnumerationExpandableIndex.frame after before)
+              (SourcePruningEnumerationRestart.decision stop order result.2
+                (EnumerationExpandableIndex.frame after before))) ∧
+      (∀ extra, continueWith
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (fuel + extra) 1)
+        graph templates stop order (fuel + extra) metadata uv fragment caller memos.query before = outcome) ∧
+      OutcomeResources formulas solver caller
+        (reservationAdvance (narrowSeed seed) (forecastCount seed before.core)) outcome ∧
+      OutcomeResources formulas solver caller
+        (reservationAdvance (narrowSeed seed)
+          (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)) outcome := by
+  have actualReserved := SourcePruningEnumerationExpansionAdmission.reserved_of_mass
+    bits seed before.core ceiling mass reserved
+  obtain ⟨fuel, result, after, outcome, returned, stable, frame, types, holes, typing,
+    callback, running, resources⟩ := callback_one_complete_resources
+      holeKey fits admits formulas solver inventory graph templates metadata uv fragment caller memos before
+      checkEmpty edgesOf stop order seed packet allocated bounded known selectionMembers selectionLength actualReserved
+  have counts := SourcePruningEnumerationExpansionAdmission.count_le_mass seed before.core ceiling mass
+  have numeric := SourcePruningEnumerationIncomingReservation.advance_count_profile_mono (narrowSeed seed) counts
+  have alphabet := SourcePruningEnumerationIncomingReservation.advance_count_alphabet_mono (narrowSeed seed) counts
+  exact ⟨fuel, result, after, outcome, returned, stable, frame, types, holes, typing,
+    callback, running, resources, resources.mono numeric alphabet⟩
+
+end MicroCFTA.SourcePruningEnumerationRecursive
diff --git a/lean/MicroCFTA/SourcePruningEnumerationReceiptOneResources.lean b/lean/MicroCFTA/SourcePruningEnumerationReceiptOneResources.lean
new file mode 100644
index 000000000..c70244775
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationReceiptOneResources.lean
@@ -0,0 +1,99 @@
+import MicroCFTA.SourcePruningEnumerationCallbackMassResources
+import MicroCFTA.SourcePruningEnumerationHookCertificates
+
+/-!
+# One recursive expansion after an actual edge receipt
+
+The completed receipt derives its callback packet. An original mass ceiling
+pays the actual callback. Rejected and stopped receipts continue without
+emitting callback outputs. Unhandled receipts have no endpoint.
+-/
+namespace MicroCFTA.SourcePruningEnumerationNativeHookResources
+open EnumerationState EnumerationSchedule InternedConstructorTemplates
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+open SourcePruningEnumerationNativeBranchCompletion (Admitted Pending FragmentHistory)
+open SourcePruningEnumerationRecursive (Packet Output Failure continueWith resume OutcomeResources)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Receipt" => SourcePruningEnumerationSelectedEdge.Result
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "HookResult" => SourcePruningEnumerationNativeContinuations.HookResult
+local notation "advance" => SourcePruningEnumerationNativeBranches.advance
+local notation "narrowSeed" => SourcePruningEnumerationExpansionAdmission.narrowSeed
+local notation "reservationAdvance" => SourcePruningEnumerationIncomingReservation.advance
+variable {Typing Key : Type} {bits : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- An actual receipt and an original mass reservation derive the exact depth-one hook. -/
+theorem receipt_one_complete_resources
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (SourcePruningRecordTypes.Metadata Typing → Nat → Bool))
+    (order : SourcePruningRecordTypes.Metadata Typing → List Nat → Option Nat)
+    (metadata : SourcePruningRecordTypes.Metadata Typing)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (original next : Inventory) (caller reached : Caller (bits + 2)) (memos final : Memos) (before : Cached)
+    (uv : Nat) (receipt : Receipt (bits + 2))
+    (packet : Packet formulas solver original caller memos metadata before)
+    (post : Post formulas solver next caller reached final)
+    (advanced : advance receipt = some (reached, final.query))
+    (admitted : Admitted uv receipt) (pending : Pending receipt) (history : FragmentHistory before.core receipt)
+    (seed : Seed) (ceiling : Nat)
+    (bounded : Fits seed.2 reached.checked) (known : Heap (fun guard => guard ∈ seed.1) reached.checked.native.machine.heap)
+    (selectionMembers : ∀ entry rows depth free, ∀ edge ∈ edgesOf (.node entry rows depth free), edge ∈ rows)
+    (selectionLength : ∀ entry rows depth free, (edgesOf (.node entry rows depth free)).length ≤ rows.length)
+    (mass : match (generalizing := false) receipt with
+      | .complete _ _ _ after => SourcePruningEnumerationPrefixAdmission.suspendedBound after.core ≤ ceiling
+      | _ => True)
+    (reserved : Reserved bits (narrowSeed seed)
+      (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)) :
+    ∃ (fuel : Nat) (outcome : HookResult (Output (bits + 2) Typing) (Failure (bits + 2) Typing) (bits + 2)),
+      (∀ extra, match (generalizing := false) receipt with
+        | .complete fragment actual saved after =>
+            continueWith (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (fuel + extra) 1)
+              graph templates stop order (fuel + extra) metadata uv fragment actual saved after = outcome
+        | _ => outcome = .complete [] reached final.query) ∧
+      OutcomeResources formulas solver reached
+        (reservationAdvance (narrowSeed seed)
+          (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)) outcome := by
+  cases receipt with
+  | unhandled => cases advanced
+  | rejected actual saved after | stopped fragments observation candidate =>
+      have originalResources : OutcomeResources (Typing := Typing) formulas solver reached seed
+          (.complete [] reached final.query) := by
+        refine ⟨reached, next, final, Post.refl post.context, bounded, known, rfl, rfl, ?_⟩
+        intro output member
+        exact False.elim (List.not_mem_nil member)
+      have numeric := (SourceCurrentConstrainedCapEditForecast.headProfile_ge seed.2).trans
+        (SourcePruningEnumerationIncomingReservation.advance_profile_ge
+          (seed.1, SourceCurrentConstrainedCapEditForecast.headProfile seed.2)
+          (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling))
+      have alphabet := SourcePruningEnumerationIncomingReservation.advance_alphabet_ge
+        (seed.1, SourceCurrentConstrainedCapEditForecast.headProfile seed.2)
+        (SourcePruningEnumerationOriginalForecast.count (narrowSeed seed) ceiling)
+      exact ⟨0, .complete [] reached final.query, fun _ => rfl, originalResources.mono numeric alphabet⟩
+  | complete fragment actual saved after =>
+      have endpoints : (actual, saved) = (reached, final.query) := Option.some.inj advanced
+      obtain ⟨callerSame, querySame⟩ := Prod.mk.inj endpoints
+      subst actual
+      subst saved
+      obtain ⟨level, frontier, ordered⟩ := packet.ordered
+      have current := SourcePruningEnumerationRecursive.receipt_packet before.core uv fragment after level frontier
+        post.context admitted history pending ordered packet.bounded
+      obtain ⟨fuel, result, callbackCore, outcome, _returned, _stable, _frame, _types, _holes, _typing,
+        _callback, running, _exactResources, resources⟩ :=
+        SourcePruningEnumerationRecursive.callback_one_complete_mass_resources
+          holeKey fits admits formulas solver next graph templates metadata uv fragment reached final after
+          checkEmpty edgesOf stop order seed current admitted.2.2.1 bounded known selectionMembers selectionLength
+          ceiling mass reserved
+      exact ⟨fuel, outcome, running, resources⟩
+
+end MicroCFTA.SourcePruningEnumerationNativeHookResources
