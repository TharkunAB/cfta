@MergeProfileProducerKernels.actual_miss_then_warm : ∀ {Symbol Guard : Type} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)] {clear : Guard → Bool}
  {top : Guard} {input candidate : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard}
  {before after : MicroCFTA.InternedConstructorTemplates.State Symbol Guard}
  {current : MicroCFTA.SourceCurrentMemoMergeGraph.Memo Symbol Guard},
  MicroCFTA.SourceCurrentMemoMergeGraph.Run clear top (MicroCFTA.SourceCurrentMemoMergeGraph.body top input) before
      MicroCFTA.SourceCurrentMemoMergeGraph.empty candidate after current →
    MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
      MicroCFTA.InternedFreshOrdinaryCostHeap.Heap before →
        MicroCFTA.InternedProbeProvenance.Available before input →
          ∀ (rows arity bound : Nat),
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryNativeProfile.NodeShape rows arity input →
              MicroCFTA.MergedOrdinaryHeight.height input ≤ bound →
                have saved := MicroCFTA.SourceCurrentMemoMergeGraph.remember current input candidate;
                have output := (MicroCFTA.SourceCurrentMemoMergeGraph.winner current input candidate).result;
                MicroCFTA.SourceCurrentMemoMergeGraph.Call clear top input before
                    MicroCFTA.SourceCurrentMemoMergeGraph.empty output after saved ∧
                  MicroCFTA.SourceCurrentMemoMergeGraph.Call clear top input after saved output after saved ∧
                    MicroCFTA.SourceCurrentMemoMergeEffects.Stored after saved ∧
                      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeProfileCache.Stored saved ∧
                        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryNativeProfile.NodeShape
                            (MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeProfileBounds.envelope rows bound) arity
                            output ∧
                          MicroCFTA.MergedOrdinaryHeight.height output ≤ MicroCFTA.MergedOrdinaryHeight.height input
