@MergeProfileProducerKernels.actual_reentrant_winner : ∀ {Symbol Guard : Type} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey Symbol Guard)] {clear : Guard → Bool}
  {top : Guard} {input candidate : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard}
  {before after : MicroCFTA.InternedConstructorTemplates.State Symbol Guard}
  {current : MicroCFTA.SourceCurrentMemoMergeGraph.Memo Symbol Guard}
  {entry : MicroCFTA.SourceCurrentMemoMergeGraph.Entry Symbol Guard},
  MicroCFTA.SourceCurrentMemoMergeGraph.Run clear top (MicroCFTA.SourceCurrentMemoMergeGraph.body top input) before
      MicroCFTA.SourceCurrentMemoMergeGraph.empty candidate after current →
    MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
      MicroCFTA.InternedFreshOrdinaryCostHeap.Heap before →
        MicroCFTA.InternedProbeProvenance.Available before input →
          current input.referenceOf = some entry →
            MicroCFTA.SourceCurrentMemoMergeGraph.remember current input candidate = current ∧
              MicroCFTA.SourceCurrentMemoMergeGraph.winner current input candidate = entry ∧
                MicroCFTA.SourceCurrentMemoMergeEffects.Stored after current ∧
                  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeProfileCache.Stored current ∧
                    MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeProfileCache.Certificate input entry.result
