'MicroCFTA.FiniteOrdinaryWordsChecks.arbitrary_full_guards' depends on axioms: [propext, Classical.choice, Quot.sound]
@MicroCFTA.FiniteOrdinaryWordsChecks.arbitrary_full_guards : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (bits : Nat) (before : MicroCFTA.SourceEqualityNativeDemand.State (bits + 2)),
  MicroCFTA.SourceCurrentAllocatedNativePhysicalCompletion.Good before →
    ∀ (leftNode rightNode : MicroCFTA.Cache.Interned MicroCFTA.InternedBinderProtocol.NodeKey)
      (leftEdge rightEdge :
        MicroCFTA.Cache.Interned
          (MicroCFTA.InternedConstructorTemplates.EdgeKey
            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))),
      leftNode.identity < 2 ^ bits →
        rightNode.identity < 2 ^ bits →
          leftEdge.identity < 2 ^ (bits + 2) →
            rightEdge.identity < 2 ^ (bits + 2) →
              MicroCFTA.InternedProbeProvenance.Available before.native.machine.heap
                  (MicroCFTA.InternedConstructorTemplates.Value.node leftNode
                    [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk leftEdge
                        [MicroCFTA.InternedConstructorTemplates.Value.empty]]
                    0 []) →
                MicroCFTA.InternedProbeProvenance.Available before.native.machine.heap
                    (MicroCFTA.InternedConstructorTemplates.Value.node rightNode
                      [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk rightEdge
                          [MicroCFTA.InternedConstructorTemplates.Value.empty]]
                      0 []) →
                  MicroCFTA.SourceCurrentAllocatedNativeRequestBounds.WordRanges
                    (MicroCFTA.SourceEqualityNativeDemand.Control.code
                      (MicroCFTA.SourceRecursiveIntersectionCode.requestNode
                        MicroCFTA.IntersectionEmptyDomain.emptyDomain
                        (MicroCFTA.InternedConstructorTemplates.Value.node leftNode
                          [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk leftEdge
                              [MicroCFTA.InternedConstructorTemplates.Value.empty]]
                          0 [])
                        (MicroCFTA.InternedConstructorTemplates.Value.node rightNode
                          [MicroCFTA.InternedConstructorTemplates.EdgeValue.mk rightEdge
                              [MicroCFTA.InternedConstructorTemplates.Value.empty]]
                          0 [])))
                    before
'MicroCFTA.FiniteOrdinaryWordsChecks.warm_owner_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
MicroCFTA.FiniteOrdinaryWordsChecks.warm_owner_exact : ∀ (bits : Nat)
  (before : MicroCFTA.SourceEqualityNativeDemand.State (bits + 2)),
  MicroCFTA.SourceCurrentAllocatedNativePhysicalCompletion.Good before →
    ∀
      (left right :
        MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
      MicroCFTA.InternedProbeProvenance.Available before.native.machine.heap left →
        MicroCFTA.InternedProbeProvenance.Available before.native.machine.heap right →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryKeys.Node bits left →
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryKeys.Node bits right →
              ∀
                (owner :
                  MicroCFTA.SourceRecursiveIntersectionThunks.NodeRequest
                    (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                    (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                (chosen running :
                  MicroCFTA.SourceRecursiveIntersectionThunks.State (bits + 2)
                    (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                    (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                (handle : Nat),
                MicroCFTA.SourceRecursiveIntersectionThunks.lookupNode (bits + 2)
                      { domain := MicroCFTA.IntersectionEmptyDomain.emptyDomain, left := left, right := right }
                      before.native =
                    (MicroCFTA.SourceRecursiveIntersectionThunks.NodeSelection.memoized handle, chosen) →
                  MicroCFTA.SourceRecursiveIntersectionThunks.demandNode handle chosen =
                      (MicroCFTA.FlatMemoThunk.Observation.evaluate owner, running) →
                    owner = { domain := MicroCFTA.IntersectionEmptyDomain.emptyDomain, left := left, right := right }
'MicroCFTA.FiniteOrdinaryWordsChecks.finish_exact_owner' depends on axioms: [propext]
@MicroCFTA.FiniteOrdinaryWordsChecks.finish_exact_owner : ∀ {width : Nat}
  (source :
    MicroCFTA.SourceRecursiveIntersectionKernel.Machine
      (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (before :
    MicroCFTA.SourceRecursiveIntersectionThunks.State width
      (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
  MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryWordExecution.Origins source before →
    ∀ (handle : Nat)
      (owner :
        MicroCFTA.SourceRecursiveIntersectionThunks.NodeRequest
          (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
      (value :
        MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
      before.nodes.cells handle = some { request := owner, status := MicroCFTA.FlatMemoThunk.Status.evaluating } →
        MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryWordExecution.Origins source
            (MicroCFTA.SourceRecursiveIntersectionThunks.finishNode handle value before) ∧
          (MicroCFTA.SourceRecursiveIntersectionThunks.finishNode handle value before).nodes.cells handle =
            some { request := owner, status := MicroCFTA.FlatMemoThunk.Status.returned value }
