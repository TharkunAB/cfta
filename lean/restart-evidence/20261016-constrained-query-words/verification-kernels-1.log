@FiniteOrdinaryOuterVerificationKernels.two_actual_node_reads : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [inst_2 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  {width : Nat} (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  {inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory} {budget : Nat}
  {request : MicroCFTA.SourceCurrentAllocatedPartialState.NodeRequest}
  {before middle after : MicroCFTA.SourceCurrentAllocatedPartialState.State width}
  {first last :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {memos intermediate final : MicroCFTA.EndpointMemoGateTrace.Memos}
  {one : MicroCFTA.SourceCurrentAllocatedPartialGraph.NodeCall budget request before first middle}
  {two :
    MicroCFTA.SourceCurrentAllocatedPartialGraph.NodeCall budget { inherited := request.inherited, value := first }
      middle last after},
  MicroCFTA.SourceCurrentAllocatedPartialSourceReads.NodeCallReads formulas solver one memos intermediate →
    MicroCFTA.SourceCurrentAllocatedPartialSourceReads.NodeCallReads formulas solver two intermediate final →
      MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory before memos →
        MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints request.inherited →
          MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap request.value →
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node request.value →
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOuterState.Stored before →
                MicroCFTA.SourceCurrentAllocatedPartialChecks.Checks
                    (MicroCFTA.SourceCurrentAllocatedPartialChecks.nodeCallTrace one) ∧
                  MicroCFTA.SourceCurrentAllocatedPartialChecks.Checks
                      (MicroCFTA.SourceCurrentAllocatedPartialChecks.nodeCallTrace two) ∧
                    ∃ next,
                      MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next before after final ∧
