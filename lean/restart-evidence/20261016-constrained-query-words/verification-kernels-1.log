'FiniteOrdinaryOuterVerificationKernels.rows_rebuild_actual_node' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@FiniteOrdinaryOuterVerificationKernels.rows_rebuild_actual_node : ∀
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [inst_2 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  {width : Nat} (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  {inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory} {budget : Nat}
  {inherited : MicroCFTA.SourceEqualityConstraintAllocation.Value}
  {entry : MicroCFTA.Cache.Interned MicroCFTA.InternedBinderProtocol.NodeKey}
  {edges results :
    List
      (MicroCFTA.InternedConstructorTemplates.EdgeValue
        (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))}
  {depth : Nat} {free : List MicroCFTA.InternedBinderProtocol.Reference}
  {before middle : MicroCFTA.SourceCurrentAllocatedPartialState.State width}
  {memos final : MicroCFTA.EndpointMemoGateTrace.Memos}
  {actualRows : MicroCFTA.SourceCurrentAllocatedPartialGraph.Rows budget inherited edges before results middle},
  MicroCFTA.SourceCurrentAllocatedPartialSourceReads.RowsReads formulas solver actualRows memos final →
    MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory before memos →
      MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints inherited →
        MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap
            (MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free) →
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryDomain.Node
              (MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free) →
            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOuterState.Stored before →
              have result :=
                (MicroCFTA.SourceCurrentAllocatedRawRebuild.modify
                    (MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free) edges results
                    middle.checked).fst;
              have after :=
                MicroCFTA.SourceCurrentAllocatedPartialState.advance middle
                  (MicroCFTA.SourceCurrentAllocatedRawRebuild.modify
                      (MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free) edges results
                      middle.checked).snd
                  middle.fourth middle.merge;
              ∃ actual,
                MicroCFTA.SourceCurrentAllocatedPartialSourceReads.NodeBodyReads formulas solver actual memos final ∧
                  MicroCFTA.SourceCurrentAllocatedPartialChecks.Checks
                      (MicroCFTA.SourceCurrentAllocatedPartialChecks.nodeBodyTrace actual) ∧
                    ∃ next,
                      MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next before after final ∧
                        MicroCFTA.InternedProbeProvenance.Available after.checked.native.machine.heap result ∧
                          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOuterState.Stored after ∧
                            MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow
                                (MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free) result ∧
                              MicroCFTA.SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver
                                { inherited := inherited,
                                  value := MicroCFTA.InternedConstructorTemplates.Value.node entry edges depth free }
                                result
