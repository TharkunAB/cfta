  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula) {width : Nat}
  {inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory}
  {before : MicroCFTA.SourceCurrentAllocatedPartialState.State width} {memos : MicroCFTA.EndpointMemoGateTrace.Memos}
  (budget : Nat) (first second : MicroCFTA.SourceCurrentAllocatedPartialState.NodeRequest),
  MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory before memos →
    MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints first.inherited →
      MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints second.inherited →
        MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap first.value →
          MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap second.value →
