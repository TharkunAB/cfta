                      (∃ actual,
                          MicroCFTA.SourceCurrentAllocatedPartialSourceReads.NodeCallReads formulas solver actual memos
                              middleMemos ∧
                            MicroCFTA.SourceCurrentAllocatedPartialChecks.Checks
                              (MicroCFTA.SourceCurrentAllocatedPartialChecks.nodeCallTrace actual)) ∧
                        (∃ actual,
                            MicroCFTA.SourceCurrentAllocatedPartialSourceReads.NodeCallReads formulas solver actual
                                middleMemos final ∧
                              MicroCFTA.SourceCurrentAllocatedPartialChecks.Checks
                                (MicroCFTA.SourceCurrentAllocatedPartialChecks.nodeCallTrace actual)) ∧
                          MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver firstInventory before
                              middle middleMemos ∧
                            MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next middle after
                                final ∧
                              MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next before after
                                  final ∧
                                MicroCFTA.SourceCurrentAllocatedPartialReturnedDomain.Stored after ∧
                                  MicroCFTA.SourceCurrentAllocatedPartialActiveOrder.ActiveAbove
                                      (max (MicroCFTA.SourceCurrentAllocatedPartialActiveOrder.nodeRank first)
                                        (MicroCFTA.SourceCurrentAllocatedPartialActiveOrder.nodeRank second))
                                      after ∧
                                    MicroCFTA.SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver first
                                        result ∧
                                      MicroCFTA.SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver second
                                        output
