                      (@Outcome.done Symbol Guard (Value Symbol Guard) value before))
                    (And (@SourceEqualityRequiredHead.Head Symbol Guard inst value before exposed middle)
                      (And (@RequireNode Symbol Guard inst needed exposed middle result after)
                        (And (@MuStored Guard Symbol valid after)
                          (And (@Cap Symbol Guard valid capDepth result)
                            (And (@SemanticReady Symbol Guard after)
