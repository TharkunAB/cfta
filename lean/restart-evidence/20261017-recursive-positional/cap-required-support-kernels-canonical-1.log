@children_then_forest : ∀ {Symbol Guard : Type} [inst : DecidableEq.{1} (EdgeKey Symbol Guard)] (valid : Guard → Prop)
  (depth : Nat) (entries : List.{0} (Prod.{0, 0} Int SourceEqualityNeeded.Needed))
  (values : List.{0} (Value Symbol Guard)) (before : InternedConstructorTemplates.State Symbol Guard),
  @SemanticReady Symbol Guard before →
    @InternedFreshOrdinaryCostHeap.Heap Symbol Guard before →
      @Values Symbol Guard before values →
        @ClosedValues Symbol Guard values →
          @MuStored Guard Symbol valid before →
            (∀ (value : Value Symbol Guard),
                @Membership.mem.{0, 0} (Value Symbol Guard) (List.{0} (Value Symbol Guard))
                    (@List.instMembership.{0} (Value Symbol Guard)) values value →
                  @Cap Symbol Guard valid depth value) →
              ∀ (path : List.{0} Int),
                @ForestSupported Symbol Guard valid path values →
                  @Exists.{1} (List.{0} (Value Symbol Guard)) fun results =>
                    @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun middle =>
                      @Exists.{1} (Value Symbol Guard) fun output =>
                        @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun after =>
                          And
                            (@RequireChildren Symbol Guard inst entries
