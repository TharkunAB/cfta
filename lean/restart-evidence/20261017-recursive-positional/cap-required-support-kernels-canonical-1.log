@required_then_two_paths : ∀ {Symbol Guard : Type} [inst : DecidableEq.{1} (EdgeKey Symbol Guard)]
  (valid : Guard → Prop) (depth : Nat) (needed : SourceEqualityNeeded.Needed) (value : Value Symbol Guard)
  (before : InternedConstructorTemplates.State Symbol Guard),
  @SemanticReady Symbol Guard before →
    @InternedFreshOrdinaryCostHeap.Heap Symbol Guard before →
      @Available Symbol Guard before value →
        @Eq.{1} (List.{0} InternedBinderProtocol.Reference) (@Value.free Symbol Guard value)
            (@List.nil.{0} InternedBinderProtocol.Reference) →
          @MuStored Guard Symbol valid before →
            @Cap Symbol Guard valid depth value →
              ∀ (firstPath secondPath : List.{0} Int),
                @Supported Symbol Guard valid firstPath value →
                  @Supported Symbol Guard valid secondPath value →
                    @Exists.{1} (Value Symbol Guard) fun required =>
                      @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun middle =>
                        @Exists.{1} (Value Symbol Guard) fun first =>
                          @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun afterFirst =>
                            @Exists.{1} (Value Symbol Guard) fun second =>
                              @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun after =>
                                And (@RequireNode Symbol Guard inst needed value before required middle)
                                  (And (@Preserves Symbol Guard valid value required)
                                    (And (@Project Symbol Guard inst firstPath required middle first afterFirst)
                                      (And (@Annotated Guard valid Symbol first)
                                        (And (@Project Symbol Guard inst secondPath required afterFirst second after)
                                          (And (@Annotated Guard valid Symbol second)
                                            (And (@MuStored Guard Symbol valid after)
                                              (And (@Keeps Symbol Guard before after)
                                                (And (@Available Symbol Guard after second)
                                                  (And
                                                    (@Eq.{1} (List.{0} InternedBinderProtocol.Reference)
                                                      (@Value.free Symbol Guard second)
                                                      (@List.nil.{0} InternedBinderProtocol.Reference))
                                                    (And
                                                      (@SourceEqualityRequiredWorkerComplete.StableRun Symbol Guard
                                                        (Value Symbol Guard)
                                                        (fun fuel headFuel =>
                                                          @SourceEqualityRequiredWorker.require Symbol Guard inst fuel
                                                            headFuel needed value before)
                                                        required middle)
                                                      (@SourceEqualityRequiredWorkerComplete.StableRun Symbol Guard
                                                        (Value Symbol Guard)
                                                        (fun fuel readFuel =>
                                                          @SourceEqualityProjectionWorker.project Symbol Guard inst fuel
                                                            readFuel secondPath required afterFirst)
                                                        second after)))))))))))
