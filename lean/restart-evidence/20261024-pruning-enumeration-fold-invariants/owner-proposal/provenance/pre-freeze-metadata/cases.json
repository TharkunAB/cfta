{
  "groups": [
    {
      "scope": "assimilated_preserves.mergedBound.source",
      "kind": "case binder",
      "binders": [
        {
          "name": "sourceMember",
          "type": "sc ∈ sourceScs"
        }
      ]
    },
    {
      "scope": "assimilated_preserves.mergedBound.target",
      "kind": "case binder",
      "binders": [
        {
          "name": "targetMember",
          "type": "sc ∈ targetScs"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.same",
      "kind": "condition",
      "binders": [
        {
          "name": "same",
          "type": "source = target"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.different",
      "kind": "condition",
      "binders": [
        {
          "name": "same",
          "type": "¬ source = target"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.source.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "sourceValue",
          "type": "EnumerationState.UVarValue Symbol"
        },
        {
          "name": "sourceStored",
          "type": "before.values[source]? = some sourceValue"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.source.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "sourceStored",
          "type": "before.values[source]? = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.sourceValue.eliminated",
      "kind": "case binder",
      "binders": []
    },
    {
      "scope": "dispatch_preserves.sourceValue.enumerated",
      "kind": "case binder",
      "binders": [
        {
          "name": "sourceFragment",
          "type": "Fragments.Fragment Symbol"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.sourceValue.unenumerated",
      "kind": "case binder",
      "binders": [
        {
          "name": "sourceNode",
          "type": "Option Nat"
        },
        {
          "name": "sourceScs",
          "type": "List EnumerationState.Suspended"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.targetValue.eliminated",
      "kind": "case binder",
      "binders": []
    },
    {
      "scope": "dispatch_preserves.targetValue.enumerated",
      "kind": "case binder",
      "binders": [
        {
          "name": "targetFragment",
          "type": "Fragments.Fragment Symbol"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.targetValue.unenumerated",
      "kind": "case binder",
      "binders": [
        {
          "name": "targetNode",
          "type": "Option Nat"
        },
        {
          "name": "targetScs",
          "type": "List EnumerationState.Suspended"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.target.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "targetValue",
          "type": "EnumerationState.UVarValue Symbol"
        },
        {
          "name": "targetStored",
          "type": "before.values[target]? = some targetValue"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.target.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "targetStored",
          "type": "before.values[target]? = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.sourceNode.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "sourceNodeSame",
          "type": "sourceNode = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.sourceNode.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "sourceHandle",
          "type": "Nat"
        },
        {
          "name": "sourceNodeSame",
          "type": "sourceNode = some sourceHandle"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.targetNode.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "targetNodeSame",
          "type": "targetNode = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.targetNode.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "targetHandle",
          "type": "Nat"
        },
        {
          "name": "targetNodeSame",
          "type": "targetNode = some targetHandle"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.left.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "leftDecoded",
          "type": "SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap sourceHandle = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.left.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "left",
          "type": "Node"
        },
        {
          "name": "leftDecoded",
          "type": "SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap sourceHandle = some left"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.right.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "rightDecoded",
          "type": "SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap targetHandle = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.right.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "right",
          "type": "Node"
        },
        {
          "name": "rightDecoded",
          "type": "SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap targetHandle = some right"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.native.yielded",
      "kind": "match equation",
      "binders": [
        {
          "name": "control",
          "type": "SourceEqualityNativeDemand.Control Node"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "native",
          "type": "SourceEqualityNativeDemand.execute nativeFuel (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right)) beforeCaller.checked = .yielded control checkedAfter"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.native.done",
      "kind": "match equation",
      "binders": [
        {
          "name": "query",
          "type": "Node"
        },
        {
          "name": "queried",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "native",
          "type": "SourceEqualityNativeDemand.execute nativeFuel (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right)) beforeCaller.checked = .done query queried"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.native.failed",
      "kind": "match equation",
      "binders": [
        {
          "name": "nativeFailure",
          "type": "SourceRecursiveIntersectionKernel.Failure"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "native",
          "type": "SourceEqualityNativeDemand.execute nativeFuel (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right)) beforeCaller.checked = .failed nativeFailure checkedAfter"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.native.constraintError",
      "kind": "match equation",
      "binders": [
        {
          "name": "message",
          "type": "String"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "native",
          "type": "SourceEqualityNativeDemand.execute nativeFuel (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right)) beforeCaller.checked = .constraintError message checkedAfter"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.native.blocked",
      "kind": "match equation",
      "binders": [
        {
          "name": "reason",
          "type": "SourceEqualityNativeDemand.Blocked"
        },
        {
          "name": "control",
          "type": "SourceEqualityNativeDemand.Control Node"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "native",
          "type": "SourceEqualityNativeDemand.execute nativeFuel (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain left right)) beforeCaller.checked = .blocked reason control checkedAfter"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.phase.pair",
      "kind": "match equation",
      "binders": [
        {
          "name": "worker",
          "type": "SourceCurrentAllocatedConjunctionWorker.Outcome width"
        },
        {
          "name": "workerQueries",
          "type": "Queries"
        },
        {
          "name": "phase",
          "type": "if checkEmpty then SourcePruningEnumerationEnabledEmpty.check p h query queried beforeCaller.fourth queries else (.done false queried beforeCaller.fourth, queries) = (worker, workerQueries)"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.phase.done",
      "kind": "match equation",
      "binders": [
        {
          "name": "answer",
          "type": "Bool"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "saved",
          "type": "SourceCurrentEmptinessMemo.Memo"
        },
        {
          "name": "workerSame",
          "type": "worker = .done answer checkedAfter saved"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.phase.failed",
      "kind": "match equation",
      "binders": [
        {
          "name": "fault",
          "type": "SourceCurrentConjunctionWorker.Fault Symbol FullSyntax.Formula"
        },
        {
          "name": "checkedAfter",
          "type": "SourceEqualityNativeDemand.State width"
        },
        {
          "name": "saved",
          "type": "SourceCurrentEmptinessMemo.Memo"
        },
        {
          "name": "workerSame",
          "type": "worker = .failed fault checkedAfter saved"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.encoded.none",
      "kind": "match equation",
      "binders": [
        {
          "name": "encoded",
          "type": "SourcePruningEnumerationNodes.encodeNode (if answer then (.empty : Node) else query) = none"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.encoded.some",
      "kind": "match equation",
      "binders": [
        {
          "name": "handle",
          "type": "Nat"
        },
        {
          "name": "encoded",
          "type": "SourcePruningEnumerationNodes.encodeNode (if answer then (.empty : Node) else query) = some handle"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.optionalTarget.reject",
      "kind": "condition",
      "binders": [
        {
          "name": "empty",
          "type": "targetNode = some 0"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.optionalTarget.survive",
      "kind": "condition",
      "binders": [
        {
          "name": "empty",
          "type": "targetNode ≠ some 0"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.optionalSource.reject",
      "kind": "condition",
      "binders": [
        {
          "name": "empty",
          "type": "some sourceHandle = some 0"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.optionalSource.survive",
      "kind": "condition",
      "binders": [
        {
          "name": "empty",
          "type": "some sourceHandle ≠ some 0"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.replacement.empty",
      "kind": "case binder",
      "binders": []
    },
    {
      "scope": "dispatch_preserves.replacement.reference",
      "kind": "case binder",
      "binders": [
        {
          "name": "name",
          "type": "InternedBinderProtocol.Reference"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.replacement.node",
      "kind": "case binder",
      "binders": [
        {
          "name": "entry",
          "type": "Cache.Interned InternedBinderProtocol.NodeKey"
        },
        {
          "name": "edges",
          "type": "List (InternedConstructorTemplates.EdgeValue Symbol Constraint)"
        },
        {
          "name": "depth",
          "type": "Nat"
        },
        {
          "name": "free",
          "type": "List InternedBinderProtocol.Reference"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.replacement.union",
      "kind": "case binder",
      "binders": [
        {
          "name": "entry",
          "type": "Cache.Interned InternedBinderProtocol.NodeKey"
        },
        {
          "name": "members",
          "type": "List Node"
        },
        {
          "name": "depth",
          "type": "Nat"
        },
        {
          "name": "free",
          "type": "List InternedBinderProtocol.Reference"
        }
      ]
    },
    {
      "scope": "dispatch_preserves.replacement.mu",
      "kind": "case binder",
      "binders": [
        {
          "name": "entry",
          "type": "Cache.Interned InternedBinderProtocol.NodeKey"
        },
        {
          "name": "body",
          "type": "Node"
        },
        {
          "name": "depthShape",
          "type": "Node"
        },
        {
          "name": "ordinaryShape",
          "type": "Node"
        }
      ]
    },
    {
      "scope": "run_preserves.cons",
      "kind": "case binder",
      "binders": [
        {
          "name": "source",
          "type": "Nat"
        },
        {
          "name": "rest",
          "type": "List Nat"
        }
      ]
    },
    {
      "scope": "run_preserves.dispatch.pair",
      "kind": "match equation",
      "binders": [
        {
          "name": "dispatchResult",
          "type": "Except (SourceEqualityNativeDemand.Outcome width Node ⊕ SourceCurrentAllocatedConjunctionWorker.Outcome width) (Option (EnumerateM Symbol EnumGuard Unit))"
        },
        {
          "name": "reachedCaller",
          "type": "Caller width"
        },
        {
          "name": "saved",
          "type": "Queries"
        },
        {
          "name": "dispatchObserved",
          "type": "SourcePruningEnumerationDispatch.dispatch checkEmpty nativeFuel p h beforeCaller before source target queries = (dispatchResult, reachedCaller, saved)"
        }
      ]
    },
    {
      "scope": "run_preserves.dispatch.error",
      "kind": "case binder",
      "binders": [
        {
          "name": "fault",
          "type": "SourceEqualityNativeDemand.Outcome width Node ⊕ SourceCurrentAllocatedConjunctionWorker.Outcome width"
        }
      ]
    },
    {
      "scope": "run_preserves.dispatch.some",
      "kind": "case binder",
      "binders": [
        {
          "name": "action",
          "type": "EnumerateM Symbol EnumGuard Unit"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.nil",
      "kind": "match equation",
      "binders": [
        {
          "name": "rawObserved",
          "type": "ExceptT.run (action before) = []"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.cons",
      "kind": "match equation",
      "binders": [
        {
          "name": "head",
          "type": "Except EnumerationState.Error (Unit × EnumerationState.State Symbol EnumGuard)"
        },
        {
          "name": "tail",
          "type": "List (Except EnumerationState.Error (Unit × EnumerationState.State Symbol EnumGuard))"
        },
        {
          "name": "rawObserved",
          "type": "ExceptT.run (action before) = head :: tail"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.error",
      "kind": "case binder",
      "binders": [
        {
          "name": "error",
          "type": "EnumerationState.Error"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.ok",
      "kind": "case binder",
      "binders": [
        {
          "name": "unit",
          "type": "Unit"
        },
        {
          "name": "middle",
          "type": "EnumerationState.State Symbol EnumGuard"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.tail.cons",
      "kind": "case binder",
      "binders": [
        {
          "name": "second",
          "type": "Except EnumerationState.Error (Unit × EnumerationState.State Symbol EnumGuard)"
        },
        {
          "name": "remaining",
          "type": "List (Except EnumerationState.Error (Unit × EnumerationState.State Symbol EnumGuard))"
        }
      ]
    },
    {
      "scope": "run_preserves.raw.singleton",
      "kind": "match equation",
      "binders": [
        {
          "name": "rawObserved",
          "type": "ExceptT.run (action before) = [.ok ((), middle)]"
        }
      ]
    }
  ],
  "tuple_identity_eliminations": [
    {
      "scope": "dispatch_preserves.selected.noop",
      "from": "selected after concrete branch reduction",
      "fields": [
        {
          "name": "actionSame",
          "type": "(fun state => [.ok ((), state)] : EnumerateM Symbol EnumGuard Unit) = action"
        },
        {
          "name": "callerSame",
          "type": "beforeCaller = afterCaller"
        },
        {
          "name": "queriesSame",
          "type": "queries = savedQueries"
        }
      ],
      "patterns": [
        "rfl",
        "rfl",
        "rfl"
      ],
      "not_extra_haves": true
    },
    {
      "scope": "dispatch_preserves.selected.optionalTarget",
      "from": "selected after concrete branch reduction",
      "fields": [
        {
          "name": "actionSame",
          "type": "SourcePruningEnumerationDispatch.finishOptional source target targetNode sourceScs targetScs = action"
        },
        {
          "name": "callerSame",
          "type": "beforeCaller = afterCaller"
        },
        {
          "name": "queriesSame",
          "type": "queries = savedQueries"
        }
      ],
      "patterns": [
        "rfl",
        "rfl",
        "rfl"
      ],
      "not_extra_haves": true
    },
    {
      "scope": "dispatch_preserves.selected.optionalSource",
      "from": "selected after concrete branch reduction",
      "fields": [
        {
          "name": "actionSame",
          "type": "SourcePruningEnumerationDispatch.finishOptional source target (some sourceHandle) sourceScs targetScs = action"
        },
        {
          "name": "callerSame",
          "type": "beforeCaller = afterCaller"
        },
        {
          "name": "queriesSame",
          "type": "queries = savedQueries"
        }
      ],
      "patterns": [
        "rfl",
        "rfl",
        "rfl"
      ],
      "not_extra_haves": true
    },
    {
      "scope": "dispatch_preserves.selected.present",
      "from": "selected after concrete branch reduction",
      "fields": [
        {
          "name": "actionSame",
          "type": "SourcePruningEnumerationAssimilation.finish source target handle sourceScs targetScs (if answer then (.empty : Node) else query) = action"
        },
        {
          "name": "callerSame",
          "type": "SourceCurrentAllocatedPartialState.advance beforeCaller checkedAfter saved beforeCaller.merge = afterCaller"
        },
        {
          "name": "queriesSame",
          "type": "workerQueries = savedQueries"
        }
      ],
      "patterns": [
        "rfl",
        "rfl",
        "rfl"
      ],
      "not_extra_haves": true
    }
  ],
  "replacement_cases": {
    "empty": [],
    "reference": [
      [
        "name",
        "InternedBinderProtocol.Reference"
      ]
    ],
    "node": [
      [
        "entry",
        "Cache.Interned InternedBinderProtocol.NodeKey"
      ],
      [
        "edges",
        "List (InternedConstructorTemplates.EdgeValue Symbol Constraint)"
      ],
      [
        "depth",
        "Nat"
      ],
      [
        "free",
        "List InternedBinderProtocol.Reference"
      ]
    ],
    "union": [
      [
        "entry",
        "Cache.Interned InternedBinderProtocol.NodeKey"
      ],
      [
        "members",
        "List Node"
      ],
      [
        "depth",
        "Nat"
      ],
      [
        "free",
        "List InternedBinderProtocol.Reference"
      ]
    ],
    "mu": [
      [
        "entry",
        "Cache.Interned InternedBinderProtocol.NodeKey"
      ],
      [
        "body",
        "Node"
      ],
      [
        "depthShape",
        "Node"
      ],
      [
        "ordinaryShape",
        "Node"
      ]
    ]
  },
  "no_induction_in_dispatch": true,
  "no_new_haves_or_lets_from_eliminations": true,
  "raw_shapes_complete": [
    "[]",
    "error :: tail",
    "ok(unit,middle) :: []",
    "ok(unit,middle) :: second :: remaining"
  ],
  "pattern_equations_preserve_actual_native_and_worker_outcomes": true
}
