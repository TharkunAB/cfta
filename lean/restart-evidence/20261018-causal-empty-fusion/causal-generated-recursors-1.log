                  (@MicroCFTA.InternedConstructorTemplates.Value.reference Symbol Guard b))
                head →
              motive_1
                  (@Option.getD (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard) (second b)
                    (@MicroCFTA.InternedConstructorTemplates.Value.reference Symbol Guard b))
                  (@Option.getD (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard) (first a)
                    (@MicroCFTA.InternedConstructorTemplates.Value.reference Symbol Guard a))
