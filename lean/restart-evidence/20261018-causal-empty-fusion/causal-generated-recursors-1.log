                motive_2 first second left right tail →
                  motive_2 first second
                    (@List.cons (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
                      (@MicroCFTA.InternedConstructorTemplates.Value.reference Symbol Guard a) left)
                    (@List.cons (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
                      (@MicroCFTA.InternedConstructorTemplates.Value.reference Symbol Guard b) right)
                    ⋯) →
          (∀ {first second : MicroCFTA.InternedStoredSubstitution.Environment Symbol Guard}
              {left right : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)}
              (value : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)
              (agree :
                ∀ (name : MicroCFTA.InternedBinderProtocol.Reference),
                  @Membership.mem MicroCFTA.InternedBinderProtocol.Reference
