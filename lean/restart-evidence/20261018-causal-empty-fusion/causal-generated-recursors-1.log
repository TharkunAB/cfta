                    @Eq (Option (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)) (first name) (second name))
              (tail :
                @MicroCFTA.SourceCurrentRetainedMuDirectedCase.Inputs Symbol Guard inst reader first second left right),
              motive_2 first second left right tail →
                motive_2 first second
                  (@List.cons (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard) value left)
                  (@List.cons (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard) value right) ⋯) →
            ∀ {a a_1 : MicroCFTA.InternedStoredSubstitution.Environment Symbol Guard}
              {a_2 a_3 : List (MicroCFTA.InternedConstructorTemplates.Value Symbol Guard)}
              (t : @MicroCFTA.SourceCurrentRetainedMuDirectedCase.Inputs Symbol Guard inst reader a a_1 a_2 a_3),
              motive_2 a a_1 a_2 a_3 t
