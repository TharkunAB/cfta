'MicroCFTA.OuterProgressBoundaryProbe.fresh_owner_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
MicroCFTA.OuterProgressBoundaryProbe.fresh_owner_boundary [DecidableEq Symbol]
  [DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [DecidableEq Node] {width : Nat}
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  {inventory : SourceCurrentAllocatedNativeInventoryState.Inventory} {before : Caller width}
  {memos : EndpointMemoGateTrace.Memos} (initial : Context formulas solver inventory before memos)
  (request : NodeRequest)
  (inherited : SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints request.inherited)
  (available : Available before.checked.native.machine.heap request.value)
  (missing : before.nodeResults.table request.key = none) :
  ∃ running,
    beginNode request before = (before.nodeResults.next, FlatMemoThunk.Observation.evaluate request, running) ∧
      Context formulas solver inventory running memos ∧
        SourceEqualityConstraintAllocation.Ready running.checked.operations.constraints request.inherited ∧
          Available running.checked.native.machine.heap request.value ∧
            running.nodeResults.table request.key = some before.nodeResults.next ∧
              running.nodeResults.cells before.nodeResults.next =
                  some { request := request, status := FlatMemoThunk.Status.evaluating } ∧
                ∀ (fuel g s r e p h m c n budget : Nat),
                  SourceCurrentAllocatedPartialWorkerRanges.nodeCall fuel g s r e p h m c n budget request running ∧
                    SourceCurrentAllocatedPartialWorker.nodeCall fuel g s r e p h m c n budget request running =
                      SourceCurrentAllocatedPartialWorker.Outcome.failed
                        (SourceCurrentAllocatedPartialWorker.Fault.nodeMemo before.nodeResults.next
                          FlatMemoThunk.Observation.busy)
                        running
