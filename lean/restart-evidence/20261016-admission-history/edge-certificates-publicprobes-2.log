@children_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  (source : InternedConstructorTemplates.State Symbol Guard),
  InternedNestedFacts.Facts source →
    ∀ (holds : Guard → Term Symbol → Bool) (inputs : FiniteInput (view source holds))
      (request : EdgeRequest Symbol Guard),
      EdgeScope source request →
        EdgeCovered inputs request →
          ∀ (combined : SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) (state : Machine Symbol Guard),
            SourceRecursiveIntersectionKernel.Valid state →
              SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
                SourceRecursiveIntersectionThunks.EdgeReady state request →
                  Certified source holds inputs
                    (SourceEqualityNativeCheckedCode.children request.domain request.left request.right combined) state
                    fun after value => EdgeResident after.heap value
@sentinel_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  (source : InternedConstructorTemplates.State Symbol Guard) (holds : Guard → Term Symbol → Bool)
  (inputs : FiniteInput (view source holds)) (left : EdgeValue Symbol Guard) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    Certified source holds inputs (SourceEqualityNativeCheckedCode.sentinel left) state fun after value =>
      EdgeResident after.heap value
@body_certified : ∀ {width : Nat} [DecidableEq Symbol] [inst : DecidableEq (EdgeKey Symbol Guard)]
  (source : InternedConstructorTemplates.State Symbol Guard),
  InternedNestedFacts.Facts source →
    ∀ (holds : Guard → Term Symbol → Bool) (inputs : FiniteInput (view source holds))
      (request : EdgeRequest Symbol Guard),
      EdgeScope source request →
        EdgeCovered inputs request →
          ∀ (before after : SourceEqualityNativeDemand.State width) (code : Code Symbol Guard (EdgeValue Symbol Guard)),
            SourceRecursiveIntersectionKernel.Valid before.native.machine →
              SourceEqualityRequiredSemanticCache.SemanticReady before.native.machine.heap →
                SourceRecursiveIntersectionThunks.EdgeReady before.native.machine request →
                  SourceEqualityNativeDemand.body request Code.pure before =
                      SourceEqualityNativeDemand.Outcome.yielded (SourceEqualityNativeDemand.Control.code code) after →
                    Certified source holds inputs code after.native.machine fun final value =>
                      EdgeResident final.heap value
