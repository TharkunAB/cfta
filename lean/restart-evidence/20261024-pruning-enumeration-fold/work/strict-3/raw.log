            (action prefixEnum).run = [] ∧ tailAfter = prefixEnum
headAt :
  ∀ (extra P H : Nat),
    max headP tailP ≤ P →
      max headH tailH ≤ H →
        SourcePruningEnumerationDispatch.dispatch checkEmpty (headFuel + tailFuel + extra) P H beforeCaller before
            source target memos.query =
          (Except.ok (some action), headCaller, headQueries)
tailAt :
  ∀ (extra P H : Nat),
    max headP tailP ≤ P →
      max headH tailH ≤ H →
        run checkEmpty (headFuel + tailFuel + extra) P H rest headCaller headAfter target headMemos.query =
          (Except.ok (some tailRaw), tailCaller, tailQueries, tailAfter)
rejected : tailRaw = []
prefix : List Nat
rejectSource : Nat
suffix : List Nat
prefixCaller : Caller width
prefixEnum : State Symbol EnumGuard
prefixQueries : Queries
rejectAction : EnumerateM Symbol EnumGuard Unit
split : rest = «prefix» ++ rejectSource :: suffix
prefixRun :
  ∀ (extra P H : Nat),
    tailP ≤ P →
      tailH ≤ H →
        run checkEmpty (tailFuel + extra) P H «prefix» headCaller headAfter target headMemos.query =
          (Except.ok (some [Except.ok ((), prefixEnum)]), prefixCaller, prefixQueries, prefixEnum)
rejectRun :
  ∀ (extra P H : Nat),
    tailP ≤ P →
      tailH ≤ H →
        SourcePruningEnumerationDispatch.dispatch checkEmpty (tailFuel + extra) P H prefixCaller prefixEnum rejectSource
            target prefixQueries =
          (Except.ok (some rejectAction), tailCaller, tailQueries)
rejectRaw : (rejectAction prefixEnum).run = []
rejectedAfter : tailAfter = prefixEnum
extra P H : Nat
largeP : max headP tailP ≤ P
largeH : max headH tailH ≤ H
⊢ (match (Except.ok (some action), headCaller, headQueries) with
    | (Except.error fault, reachedCaller, savedQueries) => (Except.error fault, reachedCaller, savedQueries, before)
    | (Except.ok none, reachedCaller, savedQueries) => (Except.ok none, reachedCaller, savedQueries, before)
    | (Except.ok (some action), reachedCaller, savedQueries) =>
      have raw := (action before).run;
      match raw with
      | [Except.ok (PUnit.unit, after)] =>
        run checkEmpty (headFuel + tailFuel + extra) P H «prefix» reachedCaller after target savedQueries
      | other => (Except.ok (some other), reachedCaller, savedQueries, before)) =
    (Except.ok (some [Except.ok ((), prefixEnum)]), prefixCaller, prefixQueries, prefixEnum)
