MicroCFTA.SourcePruningTemplates.order : List
    (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol) →
  List Nat → Option Nat
MicroCFTA.SourcePruningTemplates.indexTemplates_unknown : ∀
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol))
  (term : MicroCFTA.SourcePruningTemplates.PartialTerm),
  MicroCFTA.SourcePruningTemplates.partialSpine term = none →
    MicroCFTA.SourcePruningTemplates.indexTemplates templates term = templates
MicroCFTA.SourcePruningTemplates.indexTemplates_known : ∀
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol))
  (term : MicroCFTA.SourcePruningTemplates.PartialTerm) (key : MicroCFTA.SourcePruningTemplates.Symbol × Nat),
  MicroCFTA.SourcePruningTemplates.partialSpine term = some key →
    MicroCFTA.SourcePruningTemplates.indexTemplates templates term =
      have tagged := templates.zipIdx;
      have generic :=
        List.filter (fun entry => (MicroCFTA.SourcePruningTemplates.templateSpine entry.fst).isNone) tagged;
      have fixed :=
        List.filter (fun entry => decide (MicroCFTA.SourcePruningTemplates.templateSpine entry.fst = some key)) tagged;
      List.filterMap
        (fun position =>
          (Option.map Prod.fst (List.find? (fun entry => entry.snd == position) generic)).orElse fun x =>
            Option.map Prod.fst (List.find? (fun entry => entry.snd == position) fixed))
        (List.range templates.length)
MicroCFTA.SourcePruningTemplates.fragmentTerm_hole : ∀ (uv : Nat),
  MicroCFTA.SourcePruningTemplates.fragmentTerm (MicroCFTA.Fragments.Fragment.hole uv) =
    MicroCFTA.Language.Term.node (MicroCFTA.EnumerationState.PartialSymbol.hole uv) []
MicroCFTA.SourcePruningTemplates.programs_filter : ∀ (annotation term : MicroCFTA.SourcePruningTemplates.PartialTerm),
  MicroCFTA.SourcePruningTemplates.programs
      (MicroCFTA.Language.Term.node
        (MicroCFTA.EnumerationState.PartialSymbol.concrete ("filter", MicroCFTA.FullSyntax.Formula.top))
        [annotation, term]) =
    MicroCFTA.SourcePruningTemplates.programs term
MicroCFTA.SourcePruningTemplates.programs_app : ∀
  (annotation marker function argument : MicroCFTA.SourcePruningTemplates.PartialTerm),
  MicroCFTA.SourcePruningTemplates.programs
      (MicroCFTA.Language.Term.node
        (MicroCFTA.EnumerationState.PartialSymbol.concrete ("app", MicroCFTA.FullSyntax.Formula.top))
        [annotation, marker, function, argument]) =
    MicroCFTA.Language.Term.node
          (MicroCFTA.EnumerationState.PartialSymbol.concrete ("app", MicroCFTA.FullSyntax.Formula.top))
          [annotation, marker, function, argument] ::
        MicroCFTA.SourcePruningTemplates.programs function ++
      MicroCFTA.SourcePruningTemplates.programs argument
MicroCFTA.SourcePruningTemplates.rejectEarly_hole : ∀
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (uv : Nat),
  MicroCFTA.SourcePruningTemplates.rejectEarly templates (MicroCFTA.Fragments.Fragment.hole uv) = false
MicroCFTA.SourcePruningTemplates.finishChecks_nil : MicroCFTA.SourcePruningTemplates.finishChecks [] [] = (false, [])
MicroCFTA.SourcePruningTemplates.order_nil : ∀
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)),
  MicroCFTA.SourcePruningTemplates.order pending [] = none
