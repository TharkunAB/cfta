@MicroCFTA.SourcePruningOracle.oracle_inr : ∀ {Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (fuel : Nat)
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol))
  (uv node : Nat),
  MicroCFTA.SourcePruningOracle.oracle graph templates fuel pending uv (Sum.inr node) = pure (false, pending)
@MicroCFTA.SourcePruningOracle.oracle_frame : ∀ {Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (fuel : Nat)
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)) (uv : Nat)
  (input : MicroCFTA.Fragments.Fragment MicroCFTA.SourcePruningTemplates.Symbol ⊕ Nat)
  (before after : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (result : Bool × List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)),
  MicroCFTA.UnionFind.Total before.representatives →
    MicroCFTA.EnumerationCorrectness.Success
        (MicroCFTA.SourcePruningOracle.oracle graph templates fuel pending uv input) before result after →
      MicroCFTA.EnumerationCompressionFrame.Frame before after
@MicroCFTA.SourcePruningOracle.oracle_agrees : ∀ {Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (leftFuel rightFuel : Nat)
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)) (uv : Nat)
  (input : MicroCFTA.Fragments.Fragment MicroCFTA.SourcePruningTemplates.Symbol ⊕ Nat)
  (left right leftAfter rightAfter : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (leftResult rightResult :
    Bool × List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)),
  MicroCFTA.EnumerationCompressionFrame.Frame left right →
    MicroCFTA.UnionFind.Total left.representatives →
      MicroCFTA.EnumerationCorrectness.Success
          (MicroCFTA.SourcePruningOracle.oracle graph templates leftFuel pending uv input) left leftResult leftAfter →
        MicroCFTA.EnumerationCorrectness.Success
            (MicroCFTA.SourcePruningOracle.oracle graph templates rightFuel pending uv input) right rightResult
            rightAfter →
          leftResult = rightResult ∧ MicroCFTA.EnumerationCompressionFrame.Frame leftAfter rightAfter
@MicroCFTA.SourcePruningOracle.oracle_moreFuel : ∀ {Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (fuel extra : Nat)
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)) (uv : Nat)
  (input : MicroCFTA.Fragments.Fragment MicroCFTA.SourcePruningTemplates.Symbol ⊕ Nat),
  MicroCFTA.EnumerationExecution.Retains (MicroCFTA.SourcePruningOracle.oracle graph templates fuel pending uv input)
    (MicroCFTA.SourcePruningOracle.oracle graph templates (fuel + extra) pending uv input)
@MicroCFTA.SourcePruningOracle.oracle_transport : ∀ {Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (templates : List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol)) (leftFuel : Nat)
  (pending : List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)) (uv : Nat)
  (input : MicroCFTA.Fragments.Fragment MicroCFTA.SourcePruningTemplates.Symbol ⊕ Nat)
  (left right leftAfter : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol Guard)
  (result : Bool × List (MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol)),
  MicroCFTA.EnumerationCompressionFrame.Frame left right →
    MicroCFTA.UnionFind.Total left.representatives →
      MicroCFTA.EnumerationCorrectness.Success
          (MicroCFTA.SourcePruningOracle.oracle graph templates leftFuel pending uv input) left result leftAfter →
        ∃ rightFuel rightAfter,
          MicroCFTA.EnumerationCorrectness.Success
              (MicroCFTA.SourcePruningOracle.oracle graph templates rightFuel pending uv input) right result
              rightAfter ∧
            MicroCFTA.EnumerationCompressionFrame.Frame leftAfter rightAfter
