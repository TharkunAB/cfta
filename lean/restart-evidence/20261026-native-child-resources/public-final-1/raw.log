    checkEmpty representativeFuel nativeFuel p h indexFuel scs incoming beforeCaller before queries =>
  if incoming = MicroCFTA.InternedConstructorTemplates.Value.empty then
    ((Except.ok (some []), beforeCaller, queries, before.core, before.waiting), some before)
  else
    match List.partition (fun sc => MicroCFTA.EqualityTrie.isTerminal sc.trie) scs with
