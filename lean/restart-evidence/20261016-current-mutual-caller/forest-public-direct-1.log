'MicroCFTA.PartialForestLanguageIndependent.descendants_from_physical' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
descendants_from_physical : ∀ (F : SourceGuards.Formulas FullSyntax.Formula)
  (S : SourceGuards.Entailment FullSyntax.Formula) [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq (Value Symbol Guard)]
  {width budget : Nat} {inherited combined : EqValue} {edge : EdgeValue Symbol Guard}
  {values : List (Value Symbol Guard)} {before middle : Caller width} {prefixInventory : Inventory}
  (inventory : Inventory),
  SourceCurrentAllocatedInheritedPrefix.Receipt F S prefixInventory edge.entry.key.constraint inherited before.checked
      combined →
    ∀ (children : Children budget combined edge.children (prefixState before edge inherited) values middle),
      ChildrenLaw F S children →
        Ready middle.checked →
          At F S inventory middle.checked →
            InternedEdgeResidency.EdgeResident middle.checked.native.machine.heap edge →
              InternedNestedProvenance.Values middle.checked.native.machine.heap values →
                values.length = edge.children.length →
                  EdgeLaw F S { inherited := inherited, value := edge }
                    (SourceCurrentAllocatedRawRebuild.edge edge values middle.checked).fst
'MicroCFTA.PartialForestLanguageIndependent.ordinary_from_physical' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
ordinary_from_physical : ∀ (F : SourceGuards.Formulas FullSyntax.Formula)
  (S : SourceGuards.Entailment FullSyntax.Formula) [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)] [inst_2 : DecidableEq (Value Symbol Guard)]
  {width budget : Nat} {inherited : EqValue} {entry : Interned InternedBinderProtocol.NodeKey}
  {edges results : List (EdgeValue Symbol Guard)} {depth : Nat} {free : List InternedBinderProtocol.Reference}
  {before middle : Caller width} (inventory : Inventory) (rows : Rows budget inherited edges before results middle),
  RowsLaw F S rows →
    Ready middle.checked →
      At F S inventory middle.checked →
        Available middle.checked.native.machine.heap (Value.node entry edges depth free) →
          InternedNestedProvenance.Edges middle.checked.native.machine.heap results →
            NodeLaw F S { inherited := inherited, value := Value.node entry edges depth free }
              (SourceCurrentAllocatedRawRebuild.modify (Value.node entry edges depth free) edges results
                  middle.checked).fst
'MicroCFTA.PartialForestLanguageIndependent.two_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
two_rows : ∀ (F : SourceGuards.Formulas FullSyntax.Formula) (S : SourceGuards.Entailment FullSyntax.Formula)
  [inst : DecidableEq Symbol] [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)]
  [inst_2 : DecidableEq (Value Symbol Guard)] {width budget : Nat} {inherited : EqValue}
  {left leftNarrowed leftResult right rightNarrowed rightResult : EdgeValue Symbol Guard}
  {before first afterFirst second afterSecond : Caller width}
  (leftCall : EdgeCall budget { inherited := inherited, value := left } before leftNarrowed first)
  (leftChildren : Descendants budget inherited leftNarrowed first leftResult afterFirst)
  (rightCall : EdgeCall budget { inherited := inherited, value := right } afterFirst rightNarrowed second)
  (rightChildren : Descendants budget inherited rightNarrowed second rightResult afterSecond),
  EdgeLaw F S { inherited := inherited, value := left } leftNarrowed →
    EdgeLaw F S { inherited := inherited, value := leftNarrowed } leftResult →
      EdgeLaw F S { inherited := inherited, value := right } rightNarrowed →
        EdgeLaw F S { inherited := inherited, value := rightNarrowed } rightResult → RowsLaw F S ⋯
