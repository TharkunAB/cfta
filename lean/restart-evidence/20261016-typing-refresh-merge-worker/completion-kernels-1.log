@successful_observation_unique : ∀ [inst : DecidableEq (SourceObservations.Label FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (EdgeKey (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  {clear : SourceSymbolicIndex.Constraint FullSyntax.Formula → Bool}
  {input firstResult secondResult :
    Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {before firstAfter secondAfter : SourceCurrentAllocatedMergeGraph.State} {memo firstSaved secondSaved : Memo}
  {firstWork firstSelection secondWork secondSelection : Nat},
  @Eq
      (Outcome
        (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)))
      (@call inst inst_1 clear firstWork firstSelection input before memo)
      (@Outcome.done
        (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
        firstResult firstAfter firstSaved) →
    @Eq
        (Outcome
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)))
        (@call inst inst_1 clear secondWork secondSelection input before memo)
        (@Outcome.done
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
          secondResult secondAfter secondSaved) →
      And
        (@Eq (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
          firstResult secondResult)
        (And (@Eq SourceCurrentAllocatedMergeGraph.State firstAfter secondAfter) (@Eq Memo firstSaved secondSaved))
