'MicroCFTA.SourceCurrentAllocatedMergeWorker.call_miss' depends on axioms: [propext, Quot.sound]
MicroCFTA.SourceCurrentAllocatedMergeWorker.call_miss
  [DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (clear : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula → Bool) (remaining selectionFuel : Nat)
  (input :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (state : MicroCFTA.SourceCurrentAllocatedMergeGraph.State) (memo : MicroCFTA.SourceCurrentAllocatedMergeGraph.Memo)
  (absent : memo input.referenceOf = none) :
  MicroCFTA.SourceCurrentAllocatedMergeWorker.call clear (remaining + 1) selectionFuel input state memo =
    (MicroCFTA.SourceCurrentAllocatedMergeWorker.execute clear remaining selectionFuel
          (MicroCFTA.SourceCurrentAllocatedMergeGraph.body input) state memo).bind
      fun candidate after current =>
      MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done
        (MicroCFTA.SourceCurrentMemoMergeGraph.winner current input candidate).result after
        (MicroCFTA.SourceCurrentMemoMergeGraph.remember current input candidate)
'MicroCFTA.SourceCurrentAllocatedMergeWorker.topRow_done' depends on axioms: [propext, Quot.sound]
MicroCFTA.SourceCurrentAllocatedMergeWorker.topRow_done
  [DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (clear : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula → Bool) (remaining selectionFuel : Nat)
  (symbol : MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
  (children :
    List
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)))
  (state : MicroCFTA.SourceCurrentAllocatedMergeGraph.State) (memo : MicroCFTA.SourceCurrentAllocatedMergeGraph.Memo) :
  MicroCFTA.SourceCurrentAllocatedMergeWorker.execute clear (remaining + 1) selectionFuel
      (MicroCFTA.SourceCurrentAllocatedMergeGraph.Code.topRow symbol children) state memo =
    MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done
      (MicroCFTA.InternedConstructorTemplates.run
          (MicroCFTA.InternedConstructorTemplates.makeEdge symbol MicroCFTA.SourceCurrentAllocatedMergeGraph.top
            children)
          state.heap).fst
      {
        heap :=
          (MicroCFTA.InternedConstructorTemplates.run
              (MicroCFTA.InternedConstructorTemplates.makeEdge symbol MicroCFTA.SourceCurrentAllocatedMergeGraph.top
                children)
              state.heap).snd,
        equality := MicroCFTA.SourceEqualityMkEdgeAllocation.emptyField state.equality }
      memo
'MicroCFTA.SourceCurrentAllocatedMergeWorkerSound.bind_done_iff' does not depend on any axioms
MicroCFTA.SourceCurrentAllocatedMergeWorkerSound.bind_done_iff {Input Output : Type}
  (first : MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome Input)
  (next :
    Input →
      MicroCFTA.SourceCurrentAllocatedMergeGraph.State →
        MicroCFTA.SourceCurrentAllocatedMergeGraph.Memo → MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome Output)
  (output : Output) (after : MicroCFTA.SourceCurrentAllocatedMergeGraph.State)
  (saved : MicroCFTA.SourceCurrentAllocatedMergeGraph.Memo) :
  first.bind next = MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done output after saved ↔
    ∃ value middle current,
      first = MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done value middle current ∧
        next value middle current = MicroCFTA.SourceCurrentAllocatedMergeWorker.Outcome.done output after saved
