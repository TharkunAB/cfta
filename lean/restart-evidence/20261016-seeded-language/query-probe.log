 Classical.choice,
 Quot.sound]
MicroCFTA.SourceCurrentConjunctionRefusedClassQuery.class_witness {width : Nat}
  [DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory)
  (unconstrained :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
      Bool)
  (paths : MicroCFTA.EqualityNormalize.Class) (active : MicroCFTA.EqualityNormalize.Nontrivial paths)
  (values :
    List
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)))
  {before after : MicroCFTA.SourceEqualityNativeDemand.State width}
  {anchor :
    MicroCFTA.InternedConstructorTemplates.State (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {query :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  (gate :
    MicroCFTA.SourceCurrentSecondaryTrace.ClassTrace unconstrained values paths before.native.machine.heap false anchor)
  (actual :
    MicroCFTA.SourceCurrentAllocatedSeededQuery.Seeded values (List.map (List.map Int.ofNat) paths)
      (MicroCFTA.SourceCurrentConjunctionClassScan.advanceHeap before anchor) query after)
  (ranges :
    MicroCFTA.SourceCurrentAllocatedSeededQuery.SeededRanges values (List.map (List.map Int.ofNat) paths)
      (MicroCFTA.SourceCurrentConjunctionClassScan.advanceHeap before anchor))
  (ready : MicroCFTA.SourceCurrentConjunctionClassScan.Ready before)
  (admitted : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver inventory before)
  (available : MicroCFTA.InternedNestedProvenance.Values before.native.machine.heap values)
  (ambient : MicroCFTA.InternedGuardedLanguage.Env (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula))
  (symbol : MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
  (terms : List (MicroCFTA.Language.Term (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)))
  (accepted :
    MicroCFTA.Language.All₂
      (MicroCFTA.InternedGuardedLanguage.meaning (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver) ambient)
      values terms)
  (satisfied : MicroCFTA.EqualityNormalize.ClassSat (MicroCFTA.Language.Term.node symbol terms) paths) :
  ∃ next,
    MicroCFTA.SourceCurrentAllocatedSeededLanguage.Receipt formulas solver next before query after ∧
      ∃ part,
        MicroCFTA.InternedGuardedLanguage.meaning (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver) ambient query
            part ∧
          part.height < (MicroCFTA.Language.Term.node symbol terms).height
