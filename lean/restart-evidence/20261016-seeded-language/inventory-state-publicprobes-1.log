  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory)
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (state : MicroCFTA.SourceEqualityNativeDemand.State width),
  MicroCFTA.SourceCurrentAllocatedNativePhysicalCompletion.Good state →
    MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver inventory state →
      MicroCFTA.SourceCurrentAllocatedNativeScopeCache.Scoped state.native →
        MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady state.native.machine.heap →
          MicroCFTA.SourceRecursiveIntersectionNative.Idle state.native →
            ∀
              (left right :
                MicroCFTA.InternedConstructorTemplates.Value
                  (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                  (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
              MicroCFTA.InternedProbeProvenance.Available state.native.machine.heap left →
                MicroCFTA.InternedProbeProvenance.Available state.native.machine.heap right →
                  left.free = [] →
