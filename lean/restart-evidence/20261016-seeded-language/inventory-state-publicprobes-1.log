                                              (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver))
                                            (next.inputs (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver)))
                                          after.native ∧
                                        MicroCFTA.SourceCurrentAllocatedNativeContextRebase.SeenAdmitted
                                            (next.inputs (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver))
                                            after.native ∧
                                          ∀
                                            (output :
                                              MicroCFTA.InternedGuardedLanguage.Env
                                                (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula))
