'MicroCFTA.SourceCurrentConjunctionClassScanSoundness.verified' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
MicroCFTA.SourceCurrentConjunctionClassScanSoundness.verified {width : Nat}
  [DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory) {budget : Nat}
  {unconstrained reaches :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
      Bool}
  {values :
    List
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))}
  {classes selected : MicroCFTA.EqualityNormalize.Constraints} {outcome : Option MicroCFTA.EqualityNormalize.Class}
  {before after : MicroCFTA.SourceEqualityNativeDemand.State width}
  {memo saved : MicroCFTA.SourceCurrentEmptinessMemo.Memo}
  (actual :
    MicroCFTA.SourceCurrentConjunctionClassScan.Scan budget unconstrained reaches values classes before memo outcome
      selected after saved)
  (ready : MicroCFTA.SourceCurrentConjunctionClassScan.Ready before)
  (admitted : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver inventory before)
  (available : MicroCFTA.InternedNestedProvenance.Values before.native.machine.heap values)
  (proper :
    ∀ (paths : MicroCFTA.EqualityNormalize.Class),
      paths ∈ classes → ∀ (path : MicroCFTA.EqualityNormalize.Path), path ∈ paths → path ≠ [])
  (active :
    ∀ (paths : MicroCFTA.EqualityNormalize.Class), paths ∈ classes → MicroCFTA.EqualityNormalize.Nontrivial paths)
  (correct : MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver before.native.machine.heap memo)
  (ranges :
    MicroCFTA.SourceCurrentConjunctionClassScanCompletion.Ranges budget unconstrained reaches values classes before
      memo) :
  ∃ next,
    MicroCFTA.SourceCurrentConjunctionClassScan.Ready after ∧
      MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver next after ∧
        MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects
            (MicroCFTA.SourceCurrentAllocatedNativeEffects.physical before)
            (MicroCFTA.SourceCurrentAllocatedNativeEffects.physical after) ∧
          MicroCFTA.InternedNestedProvenance.Values after.native.machine.heap values ∧
            MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver after.native.machine.heap saved ∧
              MicroCFTA.SourceCurrentEmptinessMemo.Extends memo saved ∧
                ∀ (paths : MicroCFTA.EqualityNormalize.Class),
                  outcome = some paths →
                    ∀
                      (ambient :
                        MicroCFTA.InternedGuardedLanguage.Env
                          (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula))
                      (symbol : MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                      (terms :
                        List
                          (MicroCFTA.Language.Term (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula))),
                      MicroCFTA.Language.All₂
                          (MicroCFTA.InternedGuardedLanguage.meaning
                            (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver) ambient)
                          values terms →
                        ¬MicroCFTA.EqualityNormalize.ClassSat (MicroCFTA.Language.Term.node symbol terms) paths
