+import MicroCFTA.SourcePruningEnumerationCachedTerminalAdapter
+import MicroCFTA.SourcePruningEnumerationTerminalAdmission
+
+/-!
+# Original resources through the executable terminal adapter
+
+The original mixed schedule covers the ordered fold and its incoming query.
+The old completion packet and cache remain at the same actual endpoints.
+Rejected folds retain their native effects and skip the incoming query.
+-/
+namespace MicroCFTA.SourcePruningEnumerationCachedTerminalAdapter
+open EnumerationState EnumerationCorrectness EnumerationSchedule
+open EnumerationCompleteness EnumerationDependencies
+open InternedConstructorTemplates InternedProbeProvenance
+open SourcePruningEnumerationNodes SourcePruningEnumerationObservation
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Context Post)
+open SourcePruningEnumerationIncomingReservation (Seed step advance Reserved)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Checked" => SourceEqualityNativeDemand.State
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
