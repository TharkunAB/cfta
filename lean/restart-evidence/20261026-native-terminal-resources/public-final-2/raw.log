          value.referenceOf = MicroCFTA.InternedBinderProtocol.NodeRef.node 1 ∧
            original =
                { domain := MicroCFTA.IntersectionEmptyDomain.emptyDomain,
                  left := MicroCFTA.InternedConstructorTemplates.Value.empty, right := value } ∧
              start.native =
                  MicroCFTA.SourceRecursiveIntersectionThunks.initial 2
                    { heap := sourceHeap, domains := MicroCFTA.Cache.emptyState } ∧
                MicroCFTA.SourceCurrentAllocatedNativePhysicalCache.Valid start.native ∧
                  MicroCFTA.SourceEqualityConstraintMemoAllocation.Valid start.operations ∧
                    MicroCFTA.SourceRecursiveIntersectionThunks.NodeReady start.native.machine original ∧
                      (∃ actualKey,
                          MicroCFTA.SourceRecursiveIntersectionMemo.requestKey 2 original.domain original.left
                              original.right =
                            some actualKey) ∧
                        ¬MicroCFTA.SourceRecursiveIntersectionMemo.KeySafe 2 original.domain original.left
                              original.right ∧
                          MicroCFTA.SourceEqualityNativeDemand.execute 4
                                (MicroCFTA.SourceEqualityNativeDemand.Control.code
                                  (MicroCFTA.SourceRecursiveIntersectionCode.Code.node original
                                    MicroCFTA.SourceRecursiveIntersectionCode.Code.pure))
                                start =
                              MicroCFTA.SourceEqualityNativeDemand.Outcome.done
                                MicroCFTA.InternedConstructorTemplates.Value.empty finish ∧
                            ¬MicroCFTA.SourceCurrentAllocatedNativeRequestBounds.Words 2
                                  (MicroCFTA.SourceEqualityNativeDemand.Control.code
                                    (MicroCFTA.SourceRecursiveIntersectionCode.Code.node original
                                      MicroCFTA.SourceRecursiveIntersectionCode.Code.pure)) ∧
                              ¬MicroCFTA.SourceCurrentAllocatedNativePhysicalExecution.Inputs
                                    (MicroCFTA.SourceEqualityNativeDemand.Control.code
                                      (MicroCFTA.SourceRecursiveIntersectionCode.Code.node original
                                        MicroCFTA.SourceRecursiveIntersectionCode.Code.pure))
                                    start ∧
                                ¬∃ fuel,
                                    MicroCFTA.SourceCurrentAllocatedNativePhysicalTraceCompletion.Trace fuel
                                      (MicroCFTA.SourceEqualityNativeDemand.Control.code
                                        (MicroCFTA.SourceRecursiveIntersectionCode.Code.node original
                                          MicroCFTA.SourceRecursiveIntersectionCode.Code.pure))
                                      start
                                      (MicroCFTA.SourceEqualityNativeDemand.Control.code
                                        (MicroCFTA.SourceRecursiveIntersectionCode.Code.pure
