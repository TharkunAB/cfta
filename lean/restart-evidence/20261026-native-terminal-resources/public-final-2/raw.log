      List MicroCFTA.EnumerationState.Suspended →
        MicroCFTA.EnumerationWaitingIndex.Waiting →
          MicroCFTA.EnumerationState.EnumerateM MicroCFTA.SourcePruningTemplates.Symbol EnumGuard
            (List Nat × Nat × MicroCFTA.EnumerationWaitingIndex.Waiting) :=
fun {EnumGuard} fuel first rest waiting => do
  let recorded ← List.mapM (fun sc => MicroCFTA.EnumerationState.representative fuel sc.var) (first :: rest)
  rest.forM fun sc => MicroCFTA.EnumerationState.unionVariables fuel first.var sc.var
  let winner ← MicroCFTA.EnumerationState.representative fuel first.var
  have sources : List Nat :=
    MicroCFTA.EnumerationBuilderCaches.canonicalIds (List.filter (fun key => key != winner) recorded)
  pure (recorded, winner, MicroCFTA.EnumerationCanonicalWaiting.moveMany winner sources waiting)
