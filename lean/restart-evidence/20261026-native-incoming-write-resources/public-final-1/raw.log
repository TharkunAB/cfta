                        else [Except.ok ((), after)])),
                    afterCaller, savedQueries, read)) ∧
          ((MicroCFTA.EnumerationState.setValue uv
                      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) (incomingScs ++ oldScs)) >>=
                    fun __r => MicroCFTA.EnumerationState.inheritAncestry uv)
                  read).run =
              [Except.ok ((), after)] ∧
            after =
                { counter := read.counter, representatives := read.representatives,
                  values :=
                    read.values.set uv
                      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) (incomingScs ++ oldScs)),
                  obligations := read.obligations,
                  recursionAncestry := fun other =>
                    if other = uv then (read.expansionAncestry ++ read.recursionAncestry uv).eraseDups
                    else read.recursionAncestry other,
                  expansionAncestry := read.expansionAncestry } ∧
