MicroCFTA.SourcePruningEnumerationIncomingQuery.complete_resources {bits : Nat}
  [DecidableEq MicroCFTA.SourcePruningTemplates.Symbol]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (alphabet : List (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (profile : MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Profile)
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory)
  (beforeCaller : MicroCFTA.SourceCurrentAllocatedPartialState.State (bits + 2))
  (left right :
    MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (checkEmpty : Bool) (memos : MicroCFTA.EndpointMemoGateTrace.Memos)
  (initial : MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory beforeCaller memos)
  (leftAvailable : MicroCFTA.InternedProbeProvenance.Available beforeCaller.checked.native.machine.heap left)
  (rightAvailable : MicroCFTA.InternedProbeProvenance.Available beforeCaller.checked.native.machine.heap right)
  (leftClosed : left.free = []) (rightClosed : right.free = [])
  (fits : MicroCFTA.SourceCurrentConstrainedCapGeneratedQueryResources.Fits profile beforeCaller.checked)
  (room : MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Room bits profile)
  (known :
    MicroCFTA.SourceEqualityAnnotationHeap.Heap (fun guard => guard ∈ alphabet)
      beforeCaller.checked.native.machine.heap) :
  ∃ next query queried answer checkedAfter saved final queries replacement handle fuel p h,
    next.source = beforeCaller.checked.native.machine.heap ∧
      next.roots = inventory.roots ++ [left, right] ∧
        MicroCFTA.SourceCurrentAllocatedTargetQuery.Receipt formulas solver next left right beforeCaller.checked query
            queried memos ∧
          (∀ (extra : Nat),
              MicroCFTA.SourceEqualityNativeDemand.execute (fuel + extra)
                  (MicroCFTA.SourceEqualityNativeDemand.Control.code
                    (MicroCFTA.SourceRecursiveIntersectionCode.requestNode MicroCFTA.IntersectionEmptyDomain.emptyDomain
                      left right))
                  beforeCaller.checked =
                MicroCFTA.SourceEqualityNativeDemand.Outcome.done query queried) ∧
            (∀ (P H : Nat),
                p ≤ P →
                  h ≤ H →
                    (if checkEmpty = true then
                        MicroCFTA.SourcePruningEnumerationEnabledEmpty.check P H query queried beforeCaller.fourth
                          memos.query
                      else
                        (MicroCFTA.SourceCurrentAllocatedConjunctionWorker.Outcome.done false queried
                            beforeCaller.fourth,
                          memos.query)) =
                      (MicroCFTA.SourceCurrentAllocatedConjunctionWorker.Outcome.done answer checkedAfter saved,
                        queries)) ∧
              MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next beforeCaller
                  (MicroCFTA.SourceCurrentAllocatedPartialState.advance beforeCaller checkedAfter saved
                    beforeCaller.merge)
                  final ∧
