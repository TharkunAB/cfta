                              MicroCFTA.SourcePruningEnumerationNodes.encodeNode replacement = some handle ∧
                                MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                      afterCaller.checked.native.machine.heap handle =
                                    some replacement ∧
                                  (oldNode = none →
                                      replacement = incoming ∧
                                        afterCaller = beforeCaller ∧
                                          savedQueries = memos.query ∧ final = memos ∧ next = inventory) ∧
                                    (∀ (oldHandle : Nat),
                                        oldNode = some oldHandle →
                                          ∃ old query queried,
                                            MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                  beforeCaller.checked.native.machine.heap oldHandle =
                                                some old ∧
                                              next.source = beforeCaller.checked.native.machine.heap ∧
                                                next.roots = inventory.roots ++ [incoming, old] ∧
                                                  MicroCFTA.SourceCurrentAllocatedTargetQuery.Receipt formulas solver
                                                      next incoming old beforeCaller.checked query queried memos ∧
                                                    (∀
                                                        (ambient :
                                                          MicroCFTA.InternedGuardedLanguage.Env
                                                            (MicroCFTA.SourceObservations.Label
                                                              MicroCFTA.FullSyntax.Formula))
                                                        (term :
                                                          MicroCFTA.Language.Term
                                                            (MicroCFTA.SourceObservations.Label
                                                              MicroCFTA.FullSyntax.Formula)),
                                                        MicroCFTA.InternedGuardedLanguage.meaning
                                                            (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver)
                                                            ambient replacement term ↔
                                                          MicroCFTA.InternedGuardedLanguage.meaning
                                                              (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver)
                                                              ambient incoming term ∧
                                                            MicroCFTA.InternedGuardedLanguage.meaning
                                                              (MicroCFTA.SourceEqualityPCSGuard.holds formulas solver)
                                                              ambient old term) ∧
                                                      (checkEmpty = false →
                                                        replacement = query ∧
                                                          afterCaller =
                                                              MicroCFTA.SourceCurrentAllocatedPartialState.advance
                                                                beforeCaller queried beforeCaller.fourth
                                                                beforeCaller.merge ∧
                                                            final = memos)) ∧
                                      MicroCFTA.SourceCurrentConstrainedCapGeneratedQueryResources.Fits
                                          (MicroCFTA.SourcePruningEnumerationIncomingQuery.forecast alphabet profile)
                                          afterCaller.checked ∧
                                        MicroCFTA.SourceEqualityAnnotationHeap.Heap
                                          (fun guard =>
                                            guard ∈
                                              MicroCFTA.SourceCurrentGeneratedQueryGuardResources.forecast alphabet
                                                profile)
                                          afterCaller.checked.native.machine.heap
