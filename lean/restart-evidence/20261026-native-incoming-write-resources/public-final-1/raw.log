    MicroCFTA.SourcePruningEnumerationObservation.PendingRealized beforeCaller.checked.native.machine.heap before)
  (storage : MicroCFTA.EnumerationCorrectness.StorageValid before)
  (root : MicroCFTA.EnumerationSchedule.IsRoot before.representatives uv)
