                                  (SourceEqualityMkEdgeAllocation.work symbol original children
                                    (SourceEqualityMkEdgeAllocation.accepted original children.length))
                                  heap).fst.entry.key.symbol
                        fragments)
                    childrenResult)
                  after ∧
                after.counter = entry.counter + tries.length + stop ∧
                  after.counter = after.values.length ∧ PendingRealized (run (makeNode rows) current).snd after
