⊢ let tries := EnumerationEquality.readClasses classes;
  let residual :=
    if
        (SourceCompactGuards.positive
              (run
                          (SourceEqualityMkEdgeAllocation.work symbol original children
                            (SourceEqualityMkEdgeAllocation.accepted original children.length))
                          heap).fst.entry.key.constraint.guard).isSome =
          true then
      none
    else
      some
        (run
                  (SourceEqualityMkEdgeAllocation.work symbol original children
                    (SourceEqualityMkEdgeAllocation.accepted original children.length))
                  heap).fst.entry.key.constraint;
  let staged :=
    List.map
      (fun indexed =>
        (indexed.fst, descendScs indexed.snd scs ++ descendScs indexed.snd (suspendedVars entry.counter tries),
          SourcePruningEnumerationShallowChild.prepareChild
            (descendScs indexed.snd scs ++ descendScs indexed.snd (suspendedVars entry.counter tries)) indexed.fst))
      (run
              (SourceEqualityMkEdgeAllocation.work symbol original children
                (SourceEqualityMkEdgeAllocation.accepted original children.length))
              heap).fst.children.zipIdx;
  let stop := List.findIdx (fun stage => stage.snd.snd.isNone) staged;
  ∃ action childrenResult childrenAfter after,
    SourcePruningEnumerationEdgeTraversal.prepare scs
          (run
              (SourceEqualityMkEdgeAllocation.work symbol original children
                (SourceEqualityMkEdgeAllocation.accepted original children.length))
              heap).fst =
        some action ∧
      Success (SourcePruningEnumerationEdgeTraversal.runStaged staged) (suspendedState tries.length entry)
          childrenResult childrenAfter ∧
        Success (SourcePruningEnumerationEdgeTraversal.runStaged (List.take stop staged))
            (suspendedState tries.length entry)
            (some (List.map (fun uv => Fragments.Fragment.hole uv) (List.range' (entry.counter + tries.length) stop)))
            childrenAfter ∧
          (childrenResult =
              if stop < staged.length then none
              else
                some
                  (List.map (fun uv => Fragments.Fragment.hole uv)
                    (List.range' (entry.counter + tries.length) staged.length))) ∧
            (after =
                match childrenResult with
                | none => childrenAfter
                | some fragments =>
                  match residual with
                  | none => childrenAfter
                  | some guard =>
                    { counter := childrenAfter.counter, representatives := childrenAfter.representatives,
                      values := childrenAfter.values,
                      obligations :=
                        (guard,
                            Fragments.Fragment.node
                              (run
                                        (SourceEqualityMkEdgeAllocation.work symbol original children
                                          (SourceEqualityMkEdgeAllocation.accepted original children.length))
                                        heap).fst.entry.key.symbol
                              fragments) ::
                          childrenAfter.obligations,
                      recursionAncestry := childrenAfter.recursionAncestry,
                      expansionAncestry := childrenAfter.expansionAncestry }) ∧
              Success action entry
                  (Option.map
                    (fun fragments =>
                      Fragments.Fragment.node
