                                                        MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                              beforeCaller.checked.native.machine.heap leftHandle =
                                                            some left ∧
                                                          MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                                beforeCaller.checked.native.machine.heap rightHandle =
                                                              some right ∧
                                                            next.source = beforeCaller.checked.native.machine.heap ∧
                                                              next.roots = inventory.roots ++ [left, right] ∧
                                                                MicroCFTA.SourceCurrentAllocatedTargetQuery.Receipt
                                                                    formulas solver next left right beforeCaller.checked
                                                                    query queried memos ∧
                                                                  merged = some handle ∧
                                                                    MicroCFTA.SourcePruningEnumerationNodes.encodeNode
                                                                          replacement =
                                                                        some handle ∧
                                                                      MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                                            afterCaller.checked.native.machine.heap
                                                                            handle =
                                                                          some replacement ∧
