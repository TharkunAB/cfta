                                                                                    (MicroCFTA.SourceObservations.Label
                                                                                      MicroCFTA.FullSyntax.Formula))
                                                                                (term :
                                                                                  MicroCFTA.Language.Term
                                                                                    (MicroCFTA.SourceObservations.Label
                                                                                      MicroCFTA.FullSyntax.Formula)),
                                                                                MicroCFTA.InternedGuardedLanguage.meaning
                                                                                    (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                                      formulas solver)
                                                                                    ambient replacement term ↔
                                                                                  MicroCFTA.InternedGuardedLanguage.meaning
                                                                                      (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                                        formulas solver)
                                                                                      ambient left term ∧
                                                                                    MicroCFTA.InternedGuardedLanguage.meaning
                                                                                      (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                                        formulas solver)
                                                                                      ambient right term) ∧
                                                                              (checkEmpty = false →
                                                                                  replacement = query ∧
                                                                                    afterCaller =
                                                                                        MicroCFTA.SourceCurrentAllocatedPartialState.advance
                                                                                          beforeCaller queried
                                                                                          beforeCaller.fourth
                                                                                          beforeCaller.merge ∧
                                                                                      final = memos) ∧
                                                                                (checkEmpty = true →
                                                                                  ∃ reached answer guardSaved,
                                                                                    MicroCFTA.SourceEndpointMemo.run
                                                                                          query memos.query =
                                                                                        (reached, guardSaved) ∧
                                                                                      MicroCFTA.SourceEndpointMemoCorrect.Checked
                                                                                          queried.native.machine.heap
                                                                                          memos.query
                                                                                          (MicroCFTA.SourceCurrentEmptinessMerge.reaches
