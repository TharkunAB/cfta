  if source = target then True
  else
    match before.values[source]?, before.values[target]? with
    | some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some left) a),
      some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some right) a_1) =>
      match MicroCFTA.SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap left,
        MicroCFTA.SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap right with
