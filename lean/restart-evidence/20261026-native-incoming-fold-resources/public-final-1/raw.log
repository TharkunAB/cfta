                                                                                          (reached, guardSaved) ∧
                                                                                        (∀ (P H : Nat),
                                                                                            p ≤ P →
                                                                                              h ≤ H →
                                                                                                MicroCFTA.SourcePruningEnumerationEnabledEmpty.check
                                                                                                    P H query queried
                                                                                                    beforeCaller.fourth
                                                                                                    memos.query =
                                                                                                  (MicroCFTA.SourceCurrentAllocatedConjunctionWorker.Outcome.done
                                                                                                      answer
                                                                                                      afterCaller.checked
                                                                                                      afterCaller.fourth,
                                                                                                    guardSaved)) ∧
                                                                                          savedQueries = guardSaved ∧
                                                                                            (replacement =
                                                                                                if answer = true then
                                                                                                  MicroCFTA.InternedConstructorTemplates.Value.empty
                                                                                                else query) ∧
                                                                                              (reached = false →
                                                                                                  answer = false ∧
                                                                                                    afterCaller.checked =
                                                                                                        queried ∧
                                                                                                      afterCaller.fourth =
                                                                                                          beforeCaller.fourth ∧
                                                                                                        final =
                                                                                                          {
                                                                                                            unfolding :=
                                                                                                              memos.unfolding,
                                                                                                            query :=
                                                                                                              guardSaved }) ∧
                                                                                                (reached = true →
                                                                                                  ∃ reachedPhysical,
                                                                                                    afterCaller.checked =
                                                                                                        MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical
                                                                                                          queried
                                                                                                          reachedPhysical ∧
                                                                                                      ∃ actual,
                                                                                                        MicroCFTA.SourceCurrentConjunctionGlobalMemos.CallReads
                                                                                                          actual
                                                                                                          {
                                                                                                            unfolding :=
                                                                                                              memos.unfolding,
                                                                                                            query :=
                                                                                                              guardSaved }
                                                                                                          final))) ∧
                                MicroCFTA.SourceCurrentConstrainedCapGeneratedQueryResources.Fits
                                    (MicroCFTA.SourcePruningEnumerationIncomingQuery.forecast alphabet profile)
                                    afterCaller.checked ∧
                                  MicroCFTA.SourceEqualityAnnotationHeap.Heap
                                    (fun guard =>
                                      guard ∈
                                        MicroCFTA.SourceCurrentGeneratedQueryGuardResources.forecast alphabet profile)
                                    afterCaller.checked.native.machine.heap
