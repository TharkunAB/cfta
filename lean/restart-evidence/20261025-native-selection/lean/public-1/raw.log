MicroCFTA.SourcePruningEnumerationSelection.realized {EnumGuard NativeGuard : Type}
  (heap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (preference : List Nat → Option Nat) (uv : Nat) (aligned : before.core.counter = before.core.values.length)
  (pending : MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap before.core)
  (flags :
    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot))
  (selected : MicroCFTA.EnumerationPureSelection.next preference before = MicroCFTA.EnumerationState.Next.expand uv) :
  ∃ node scs value,
    before.core.values[uv]? = some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some node) scs) ∧
      MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap node = some value ∧
        MicroCFTA.InternedProbeProvenance.Available heap value ∧
          value.free = [] ∧ (!(MicroCFTA.MergedOrdinaryHeight.recursiveBoundary value && scs.isEmpty)) = true
