@MicroCFTA.SourceCurrentAllocatedPartialMemoSound.beginNode_fresh : ∀ {width : Nat}
  (request : MicroCFTA.SourceCurrentAllocatedPartialState.NodeRequest)
  (before : MicroCFTA.SourceCurrentAllocatedPartialState.State width),
  before.nodeResults.table request.key = none →
    MicroCFTA.SourceCurrentAllocatedPartialState.beginNode request before =
        (before.nodeResults.next, MicroCFTA.FlatMemoThunk.Observation.evaluate request,
          { checked := before.checked, merge := before.merge, fourth := before.fourth,
            nodeResults :=
              MicroCFTA.FlatMemoThunk.setStatus before.nodeResults.next MicroCFTA.FlatMemoThunk.Status.evaluating
                (MicroCFTA.FlatMemoThunk.lookupOrInsert request.key request before.nodeResults).snd,
            edgeResults := before.edgeResults }) ∧
      (MicroCFTA.SourceCurrentAllocatedPartialState.beginNode request before).snd.snd.nodeResults.cells
          before.nodeResults.next =
        some { request := request, status := MicroCFTA.FlatMemoThunk.Status.evaluating }
