    ∀ (original candidate : MicroCFTA.SourceCurrentAllocatedPartialState.NodeRequest) (handle : Nat)
      (result :
        MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
      before.nodeResults.table candidate.key = some handle →
        before.nodeResults.cells handle =
            some { request := original, status := MicroCFTA.FlatMemoThunk.Status.evaluating } →
          MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints candidate.inherited →
            MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap candidate.value →
              MicroCFTA.InternedProbeProvenance.Available before.checked.native.machine.heap result →
                MicroCFTA.SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver original result →
                  MicroCFTA.Cache.Valid before.checked.operations.constraints →
                    MicroCFTA.InternedRecordCoherence.Coherent before.checked.native.machine.heap →
                      have after := MicroCFTA.SourceCurrentAllocatedPartialState.finishNode handle result before;
                      MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver after ∧
                        MicroCFTA.SourceCurrentAllocatedPartialState.beginNode candidate after =
                            (handle, MicroCFTA.FlatMemoThunk.Observation.ready result, after) ∧
                          MicroCFTA.InternedProbeProvenance.Available after.checked.native.machine.heap result ∧
                            MicroCFTA.SourceCurrentAllocatedPartialMemoSound.NodeLaw formulas solver candidate result
@MicroCFTA.SourceCurrentAllocatedPartialMemoSoundProbes.physical_growth_retains_edge_hit : ∀ {width : Nat}
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (before : MicroCFTA.SourceCurrentAllocatedPartialState.State width)
  (checked : MicroCFTA.SourceEqualityNativeDemand.State width) (fourth : MicroCFTA.SourceCurrentEmptinessMemo.Memo)
  (merge :
    MicroCFTA.SourceCurrentMemoMergeGraph.Memo (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
  MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver before →
    MicroCFTA.SourceCurrentConjunctionRowsAllocation.Effects
        (MicroCFTA.SourceCurrentAllocatedNativeEffects.physical before.checked)
        (MicroCFTA.SourceCurrentAllocatedNativeEffects.physical checked) →
      ∀ (candidate original : MicroCFTA.SourceCurrentAllocatedPartialState.EdgeRequest) (handle : Nat)
        (result :
          MicroCFTA.InternedConstructorTemplates.EdgeValue
            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
        before.edgeResults.table candidate.key = some handle →
          before.edgeResults.cells handle =
              some { request := original, status := MicroCFTA.FlatMemoThunk.Status.returned result } →
            MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints
                candidate.inherited →
              MicroCFTA.InternedEdgeResidency.EdgeResident before.checked.native.machine.heap candidate.value →
                MicroCFTA.Cache.Valid checked.operations.constraints →
                  MicroCFTA.InternedRecordCoherence.Coherent checked.native.machine.heap →
                    have after := MicroCFTA.SourceCurrentAllocatedPartialState.advance before checked fourth merge;
                    MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver after ∧
                      MicroCFTA.SourceCurrentAllocatedPartialState.beginEdge candidate after =
                          (handle, MicroCFTA.FlatMemoThunk.Observation.ready result, after) ∧
                        MicroCFTA.InternedEdgeResidency.EdgeResident checked.native.machine.heap result ∧
                          MicroCFTA.SourceCurrentAllocatedPartialMemoSound.EdgeLaw formulas solver candidate result
