@MicroCFTA.SourceCurrentAllocatedPartialMemoSoundProbes.cold_edge_start : ∀ {width : Nat}
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (checked : MicroCFTA.SourceEqualityNativeDemand.State width)
  (merge :
    MicroCFTA.SourceCurrentMemoMergeGraph.Memo (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (fourth : MicroCFTA.SourceCurrentEmptinessMemo.Memo)
  (request : MicroCFTA.SourceCurrentAllocatedPartialState.EdgeRequest),
  MicroCFTA.SourceEqualityConstraintAllocation.Ready checked.operations.constraints request.inherited →
    MicroCFTA.InternedEdgeResidency.EdgeResident checked.native.machine.heap request.value →
      have before := MicroCFTA.SourceCurrentAllocatedPartialState.initial checked merge fourth;
      have running := (MicroCFTA.SourceCurrentAllocatedPartialState.beginEdge request before).snd.snd;
      (MicroCFTA.SourceCurrentAllocatedPartialState.beginEdge request before).fst = 0 ∧
        (MicroCFTA.SourceCurrentAllocatedPartialState.beginEdge request before).snd.fst =
            MicroCFTA.FlatMemoThunk.Observation.evaluate request ∧
          MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver running ∧
            running.edgeResults.cells 0 =
                some { request := request, status := MicroCFTA.FlatMemoThunk.Status.evaluating } ∧
              MicroCFTA.SourceCurrentAllocatedPartialMemoSound.EdgeGood formulas solver running.checked
                { request := request, status := MicroCFTA.FlatMemoThunk.Status.evaluating }
@MicroCFTA.SourceCurrentAllocatedPartialMemoSoundProbes.edge_finish_then_alias_hit : ∀ {width : Nat}
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (before : MicroCFTA.SourceCurrentAllocatedPartialState.State width),
  MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver before →
    ∀ (original candidate : MicroCFTA.SourceCurrentAllocatedPartialState.EdgeRequest) (handle : Nat)
      (result :
        MicroCFTA.InternedConstructorTemplates.EdgeValue
          (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
      before.edgeResults.table candidate.key = some handle →
        before.edgeResults.cells handle =
            some { request := original, status := MicroCFTA.FlatMemoThunk.Status.evaluating } →
          MicroCFTA.SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints candidate.inherited →
            MicroCFTA.InternedEdgeResidency.EdgeResident before.checked.native.machine.heap candidate.value →
              MicroCFTA.InternedEdgeResidency.EdgeResident before.checked.native.machine.heap result →
                MicroCFTA.SourceCurrentAllocatedPartialMemoSound.EdgeLaw formulas solver original result →
                  MicroCFTA.Cache.Valid before.checked.operations.constraints →
                    MicroCFTA.InternedRecordCoherence.Coherent before.checked.native.machine.heap →
                      have after := MicroCFTA.SourceCurrentAllocatedPartialState.finishEdge handle result before;
                      MicroCFTA.SourceCurrentAllocatedPartialMemoSound.Sound formulas solver after ∧
                        MicroCFTA.SourceCurrentAllocatedPartialState.beginEdge candidate after =
                            (handle, MicroCFTA.FlatMemoThunk.Observation.ready result, after) ∧
                          MicroCFTA.InternedEdgeResidency.EdgeResident after.checked.native.machine.heap result ∧
                            MicroCFTA.SourceCurrentAllocatedPartialMemoSound.EdgeLaw formulas solver candidate result
@MicroCFTA.SourceCurrentAllocatedPartialMemoSoundProbes.node_finish_then_alias_hit : ∀ {width : Nat}
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (before : MicroCFTA.SourceCurrentAllocatedPartialState.State width),
