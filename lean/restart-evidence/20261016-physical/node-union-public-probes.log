'MicroCFTA.SourceCurrentAllocatedNativeNodeBranches.union_members' depends on axioms: [propext, Quot.sound]
MicroCFTA.SourceCurrentAllocatedNativeNodeBranches.union_members
  (source : InternedConstructorTemplates.State Symbol Guard) (facts : InternedNestedFacts.Facts source)
  (holds : Guard → Term Symbol → Bool) (entry : Cache.Interned InternedBinderProtocol.NodeKey)
  (members : List (Value Symbol Guard)) (depth : Nat) (free : List InternedBinderProtocol.Reference)
  (available : InternedProbeProvenance.Available source (Value.union entry members depth free)) :
  (SourceRecursiveIntersectionInputView.view source holds).members entry.identity =
    List.map SourceRecursiveIntersectionInputView.inputOf members
