'MicroCFTA.SourceCurrentAllocatedNativeUnionMeaning.union_body' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
MicroCFTA.SourceCurrentAllocatedNativeUnionMeaning.union_body {width : Nat} [DecidableEq Symbol]
  [DecidableEq (EdgeKey Symbol Guard)] (source : InternedConstructorTemplates.State Symbol Guard)
  (sourceFacts : InternedNestedFacts.Facts source) (holds : Guard → Term Symbol → Bool)
  (model : IntersectSchedule.InputMeaning (SourceRecursiveIntersectionInputView.view source holds))
  (ranked : IntersectSchedule.RankedInput (SourceRecursiveIntersectionInputView.view source holds) model.valid)
  (domain : Cache.Interned IntersectionFlatMemoKeyDomain.DomainKey)
  (entry : Cache.Interned InternedBinderProtocol.NodeKey) (members : List (Value Symbol Guard)) (depth : Nat)
  (free : List InternedBinderProtocol.Reference) (other : Value Symbol Guard) (side : Bool)
  (available : InternedProbeProvenance.Available source (Value.union entry members depth free))
  (before middle : SourceEqualityNativeDemand.State width) (values : List (Value Symbol Guard)) (fuel : Nat)
  (ready : SourceEqualityRequiredCache.Ready before.native.machine.heap)
  (selected :
    SourceRecursiveIntersectionControl.decision domain.key
        (if side = true then Value.union entry members depth free else other)
        (if side = true then other else Value.union entry members depth free) =
      if side = true then SourceRecursiveIntersectionControl.Branch.leftUnion
      else SourceRecursiveIntersectionControl.Branch.rightUnion)
  (walk :
    SourceCurrentAllocatedNativeEdgeMeaning.Walk (SourceRecursiveIntersectionInputView.view source holds) model ranked
      holds domain (List.map (fun member => if side = true then (member, other) else (other, member)) members) before
      values middle fuel) :
  have request :=
    { domain := domain, left := if side = true then Value.union entry members depth free else other,
      right := if side = true then other else Value.union entry members depth free };
  have built := run (makeUnion values) middle.native.machine.heap;
  have after :=
    {
      native :=
        advance middle.native
          (have __src := middle.native.machine;
          { heap := built.snd, domains := __src.domains }),
      operations := middle.operations };
  execute (fuel + 2) (Control.code (compileNode request)) before = Outcome.done built.fst after ∧
    NodeLaw (SourceRecursiveIntersectionInputView.view source holds) model ranked holds request built.fst ∧
      SourceEqualityRequiredCache.Keeps before.native.machine.heap after.native.machine.heap ∧
        InternedProbeProvenance.Available after.native.machine.heap built.fst
