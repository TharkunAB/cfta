MicroCFTA.SourceCurrentAllocatedNativeNodeBranches.left_union_law [DecidableEq (EdgeKey Symbol Guard)]
  (source : InternedConstructorTemplates.State Symbol Guard) (sourceFacts : InternedNestedFacts.Facts source)
  (holds : Guard → Term Symbol → Bool)
  (model : IntersectSchedule.InputMeaning (SourceRecursiveIntersectionInputView.view source holds))
  (ranked : IntersectSchedule.RankedInput (SourceRecursiveIntersectionInputView.view source holds) model.valid)
  (domain : Cache.Interned IntersectionFlatMemoKeyDomain.DomainKey)
  (entry : Cache.Interned InternedBinderProtocol.NodeKey) (members : List (Value Symbol Guard)) (depth : Nat)
  (free : List InternedBinderProtocol.Reference) (right : Value Symbol Guard)
  (available : InternedProbeProvenance.Available source (Value.union entry members depth free))
  (state : InternedConstructorTemplates.State Symbol Guard) (facts : InternedNestedFacts.Facts state)
  (values : List (Value Symbol Guard)) (resident : InternedNestedProvenance.Values state values)
  (laws :
    All₂
      (fun member value =>
        NodeLaw (SourceRecursiveIntersectionInputView.view source holds) model ranked holds
          { domain := domain, left := member, right := right } value)
      members values) :
  NodeLaw (SourceRecursiveIntersectionInputView.view source holds) model ranked holds
    { domain := domain, left := Value.union entry members depth free, right := right }
    (run (makeUnion values) state).fst
