'MicroCFTA.QueryWorkTraceIndependentKernels.single_makeEdge' depends on axioms: [propext, Classical.choice, Quot.sound]
@single_makeEdge : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (bits : Nat)
  (source : Machine Symbol Guard) (before : Checked (bits + 2)) (symbol : Symbol) (guard : Guard)
  (children : List (Value Symbol Guard)),
  have job := makeEdge symbol guard children;
  have actual := run job before.native.machine.heap;
  have after :=
    {
      native :=
        advance before.native
          (have __src := before.native.machine;
          { heap := actual.snd, domains := __src.domains }),
      operations := before.operations };
  step (Control.code (Code.work job Code.pure)) before = Outcome.yielded (Control.code (Code.pure actual.fst)) after ∧
    Trace before.native.machine.heap after.native.machine.heap (observe job before.native.machine.heap)
'MicroCFTA.QueryWorkTraceIndependentKernels.mismatched_body_zero_work' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@mismatched_body_zero_work : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (bits : Nat)
  (source : Machine Symbol Guard) (before : Checked (bits + 2)) (request : EdgeRequest Symbol Guard),
  SourceCurrentAllocatedFiniteOrdinaryWordCode.EdgeInputs bits source request →
    request.left.children.length ≠ request.right.children.length →
      have after :=
        { native := before.native, operations := SourceEqualityMkEdgeAllocation.emptyField before.operations };
      Trace before.native.machine.heap after.native.machine.heap [] ∧
        step (Control.edgeBody request Code.pure) before =
          Outcome.yielded (Control.code ((SourceEqualityNativeCheckedCode.sentinel request.left).bind Code.pure)) after
'MicroCFTA.QueryWorkTraceIndependentKernels.query_prefix_work_budget' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@query_prefix_work_budget : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (bits : Nat)
  (before : Checked (bits + 2)),
  SourceCurrentAllocatedNativePhysicalCompletion.Good before →
    ∀ (left right : Value Symbol Guard),
      Available before.native.machine.heap left →
        Available before.native.machine.heap right →
          SourceCurrentAllocatedFiniteOrdinaryDomain.Node left →
            SourceCurrentAllocatedFiniteOrdinaryDomain.Node right →
              SourceCurrentAllocatedFiniteOrdinaryCapacity.Capacity bits before →
                ∀ (fuel : Nat) (next : Control (Value Symbol Guard)) (after : Checked (bits + 2)),
                  SourceEqualityNativeDemand.Steps fuel
                      (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) before next after →
                    ∃ requests,
                      Trace before.native.machine.heap after.native.machine.heap requests ∧
                        nodeRequests requests + edgeRequests requests ≤
                          SourceCurrentAllocatedFiniteOrdinaryNativeBudget.nodeBudget left right
'MicroCFTA.QueryWorkTraceIndependentKernels.consecutive_prefixes' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
@consecutive_prefixes : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)] {A : Type}
  (bits : Nat) (source : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid source →
    ∀ (firstFuel lastFuel : Nat) (control middle next : Control A) (before current after : Checked (bits + 2)),
      Origins source before.native →
        Certified bits source control →
          SourceEqualityNativeDemand.Steps firstFuel control before middle current →
            SourceEqualityNativeDemand.Steps lastFuel middle current next after →
              ∃ requests,
                requests = requestsThrough firstFuel control before ++ requestsThrough lastFuel middle current ∧
                  Trace before.native.machine.heap after.native.machine.heap requests ∧
                    after.native.machine.heap.nodes.next =
                        before.native.machine.heap.nodes.next +
                          SourceCurrentAllocatedFiniteOrdinaryReservations.nodeReservations requests ∧
                      after.native.machine.heap.edges.next =
                        before.native.machine.heap.edges.next +
                          SourceCurrentAllocatedFiniteOrdinaryReservations.edgeReservations requests
