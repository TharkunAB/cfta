@two_three_path_targets : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)]
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  (inventory : Inventory) (bits : Nat) (values : List (Value Symbol Guard)) (seed first second : List Int)
  (before : Checked (bits + 2)) (memo : Memo),
  Ready before →
    At formulas solver inventory before →
      Values before.native.machine.heap values →
        SourceCurrentMemoMergeEffects.Stored before.native.machine.heap memo →
          Profiles memo →
            NativeStored before.native →
              OutputStored before.native →
                (∀ (ambient : InternedGuardedLanguage.Env Symbol),
                    SourceCurrentMemoMergeLanguage.CacheCovers (SourceEqualityPCSGuard.holds formulas solver) ambient
                      memo) →
                  ∀ (memos : Memos),
                    EndpointMemoGateTrace.Valid before.native.machine.heap memos →
                      ∀ (rows arity count depth bound : Nat),
                        ChildrenShape rows arity values →
                          values.length ≤ count →
                            (∀ (path : List Int), path ∈ [seed, first, second] → path.length ≤ depth) →
                              childrenHeight values ≤ bound →
                                before.native.machine.heap.nodes.next + 2 * N rows arity count depth bound 3 ≤
                                    2 ^ bits →
                                  before.native.machine.heap.edges.next + 2 * E rows arity count depth bound 3 ≤
                                      2 ^ (bits + 2) →
                                    ∃ result middle saved next final later after last lastInventory lastGlobals
                                      firstRequests lastRequests, ⋯
