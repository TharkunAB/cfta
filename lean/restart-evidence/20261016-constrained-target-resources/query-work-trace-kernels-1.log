@single_makeEdge : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (bits : Nat)
  (source : Machine Symbol Guard) (before : Checked (bits + 2)) (symbol : Symbol) (guard : Guard)
  (children : List (Value Symbol Guard)),
  have job := makeEdge symbol guard children;
  have actual := run job before.native.machine.heap;
  have after :=
    {
      native :=
        advance before.native
          (have __src := before.native.machine;
          { heap := actual.snd, domains := __src.domains }),
      operations := before.operations };
  step (Control.code (Code.work job Code.pure)) before = Outcome.yielded (Control.code (Code.pure actual.fst)) after ∧
    Trace before.native.machine.heap after.native.machine.heap (observe job before.native.machine.heap)
