@@ -0,0 +1,314 @@
+import MicroCFTA.SourcePruningEnumerationPrefixCompletion
+import MicroCFTA.SourcePruningEnumerationRecursivePacket
+import MicroCFTA.SourcePruningEnumerationSuspendedMass
+
+/-!
+# Suspended mass at actual selected prefixes
+
+A repeated recursion clears one bucket. A nonempty narrowing retains the
+same bucket and changes only its node handle. The literal prefix equation
+connects the returned action row to its actual cached endpoint.
+-/
+namespace MicroCFTA.SourcePruningEnumerationPrefixMass
+open EnumerationState EnumerationCorrectness EnumerationSchedule EnumerationCompressionFrame
+open InternedConstructorTemplates
+open SourcePruningEnumerationSelectedStep
+open SourcePruningEnumerationNodes
+open SourcePruningEnumerationPrefixAdmission (suspendedBound suspendedBound_values)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Raw" => List (Except EnumerationState.Error (Unit × Core))
+attribute [local instance] SourcePruningEnumerationAction.actionMonadList
+
+private theorem sum_map_set_zero_le {α : Type} (weight : α → Nat) (replacement : α)
+    (zero : weight replacement = 0) (values : List α) (index : Nat) :
+    ((values.set index replacement).map weight).sum ≤ (values.map weight).sum := by
+  induction values generalizing index with
+  | nil => simp
+  | cons first rest ih =>
+      cases index with
+      | zero =>
+          simp only [List.set_cons_zero, List.map_cons, List.sum_cons, zero]
+          omega
+      | succ index =>
+          simp only [List.set_cons_succ, List.map_cons, List.sum_cons]
+          exact Nat.add_le_add_left (ih index) _
+
+/-- Clearing a bucket cannot increase suspended mass, including at an absent slot. -/
+theorem cleared_mass_le (before : Core) (target : Nat) (node : Option Nat) :
+    suspendedBound {before with values := before.values.set target (.unenumerated node [])} ≤
+      suspendedBound before := by
+  exact sum_map_set_zero_le (fun value : UVarValue Symbol => match value with
+    | .unenumerated _ scs => scs.length
+    | _ => 0) (.unenumerated node []) rfl before.values target
+
+/-- A stored pending bucket keeps its exact mass when only its node handle changes. -/
+theorem same_bucket_mass (before : Core) (target : Nat) (oldNode newNode : Option Nat)
+    (scs : List Suspended) (stored : before.values[target]? = some (.unenumerated oldNode scs)) :
+    suspendedBound {before with values := before.values.set target (.unenumerated newNode scs)} =
+      suspendedBound before := by
+  simpa only [List.nil_append, List.length_nil, Nat.add_zero] using
+    SourcePruningEnumerationSuspendedMass.incoming_mass before target oldNode newNode [] scs stored
+
+private theorem check_true_mass
+    (heap : InternedConstructorTemplates.State Symbol Constraint)
+    (fuel uv handle : Nat) (scs : List Suspended) (before after : Core)
+    (total : UnionFind.Total before.representatives)
+    (observed : Success (SourcePruningEnumerationRecursion.checkRepeated heap fuel uv handle scs)
+      before true after) : suspendedBound after ≤ suspendedBound before := by
+  cases decoded : lookupNode heap handle with
+  | none =>
+      have impossible : Success (failure .unresolvedReference) before true after := by
+        simpa only [SourcePruningEnumerationRecursion.checkRepeated, decoded] using observed
+      exact (success_failure .unresolvedReference before after true impossible).elim
+  | some value =>
+      by_cases boundary : MergedOrdinaryHeight.recursiveBoundary value = true
+      · simp only [SourcePruningEnumerationRecursion.checkRepeated, decoded, boundary, ↓reduceIte] at observed
+        obtain ⟨root, resolved, resolution, continued⟩ := (success_bind _ _ _ _ _).mp observed
+        have frame := representative_frame fuel uv root before resolved total resolution
+        obtain ⟨current, currentState, reading, continued⟩ := (success_bind _ _ _ _ _).mp continued
+        obtain ⟨currentSame, stateSame⟩ := (EnumerationDriver.get_success resolved currentState current).mp reading
+        subst current
+        subst currentState
+        split at continued
+        · obtain ⟨ignored, written, writing, final⟩ := (success_bind _ _ _ _ _).mp continued
+          cases ignored
+          obtain ⟨_answer, afterSame⟩ := (success_pure true true written after).mp final
+          have writtenSame := (EnumerationDriver.modify_success _ resolved written).mp writing
+          rw [afterSame, writtenSame]
+          exact Nat.le_trans (cleared_mass_le resolved root (some handle))
+            (Nat.le_of_eq (suspendedBound_values before resolved frame.values))
+        · obtain ⟨impossible, _state⟩ := (success_pure false true resolved after).mp continued
+          cases impossible
+      · have impossible : Success (pure false : EnumerateM Symbol Constraint Bool) before true after := by
+          simpa only [SourcePruningEnumerationRecursion.checkRepeated, decoded, ite_eq_right boundary] using observed
+        obtain ⟨impossible, _state⟩ := (success_pure false true before after).mp impossible
+        cases impossible
+
+/-- The actual repeated-recursion read and clear cannot increase the original mass. -/
+theorem parked_mass
+    (heap : InternedConstructorTemplates.State Symbol Constraint)
+    (readFuel checkFuel uv oldHandle : Nat) (scs : List Suspended)
+    (before readAfter checked : Core) (safe : Safe before)
+    (reading : Success (getValue readFuel uv) before (.unenumerated (some oldHandle) scs) readAfter)
+    (checking : Success (SourcePruningEnumerationRecursion.checkRepeated heap checkFuel uv oldHandle scs)
+      readAfter true checked) : suspendedBound checked ≤ suspendedBound before := by
+  have frame := (getValue_frame readFuel uv before readAfter _ safe.1.total reading).1
+  exact Nat.le_trans (check_true_mass heap checkFuel uv oldHandle scs readAfter checked
+    (frame.total safe.1.total) checking)
+      (Nat.le_of_eq (suspendedBound_values before readAfter frame.values))
+
+variable {Typing Key : Type} {width : Nat}
+variable [DecidableEq (EdgeKey Symbol Constraint)]
+
+/-- Actual nonempty narrowing preserves the bucket mass after the same read and false recursion check. -/
+theorem narrowed_mass
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (metadata : Metadata Typing) (nativeFuel representativeFuel readFuel checkFuel uv oldHandle newHandle : Nat)
+    (scs : List Suspended) (oldValue value : Node)
+    (heap nextHeap : InternedConstructorTemplates.State Symbol Constraint)
+    (action : EnumerateM Symbol Constraint Unit) (before readAfter checked after : Core)
+    (safe : Safe before)
+    (reading : Success (getValue readFuel uv) before (.unenumerated (some oldHandle) scs) readAfter)
+    (checking : Success (SourcePruningEnumerationRecursion.checkRepeated heap checkFuel uv oldHandle scs)
+      readAfter false checked)
+    (narrowed : SourcePruningOuterNarrow.narrow holeKey fits admits metadata nativeFuel uv oldValue heap =
+      .done value nextHeap)
+    (nonempty : value ≠ .empty) (encoded : encodeNode value = some newHandle)
+    (prepared : SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel representativeFuel
+      uv oldHandle scs oldValue heap = .done (value, some action) nextHeap)
+    (executed : Success action checked () after) : suspendedBound after = suspendedBound before := by
+  obtain ⟨readFrame, root, size, oldPath, _readPath, oldStored⟩ :=
+    getValue_frame readFuel uv before readAfter _ safe.1.total reading
+  have checkFrame := SourcePruningEnumerationRecursionOrder.checkRepeated_false_frame heap checkFuel uv oldHandle scs
+    readAfter checked (readFrame.total safe.1.total) checking
+  have checkedFrame := readFrame.trans checkFrame
+  have selectedAction := prepared_action holeKey fits admits metadata nativeFuel representativeFuel uv oldHandle newHandle
+    scs oldValue value heap nextHeap narrowed nonempty encoded
+  rw [prepared] at selectedAction
+  have actionSame : action =
+      (if newHandle = oldHandle then (pure () : EnumerateM Symbol Constraint Unit)
+        else representative representativeFuel uv >>= fun selected =>
+          setValue selected (.unenumerated (some newHandle) scs)) :=
+    Option.some.inj (Prod.mk.inj (MergedSourceComparison.Result.done.inj selectedAction).1).2
+  rw [actionSame] at executed
+  by_cases same : newHandle = oldHandle
+  · rw [ite_eq_left same] at executed
+    obtain ⟨_unit, afterSame⟩ := (success_pure () () checked after).mp executed
+    rw [afterSame]
+    exact suspendedBound_values before checked checkedFrame.values
+  · rw [ite_eq_right same] at executed
+    obtain ⟨selected, resolved, resolution, writing⟩ := (success_bind _ _ _ _ _).mp executed
+    have resolvedFrame := representative_frame representativeFuel uv selected checked resolved
+      (checkedFrame.total safe.1.total) resolution
+    have wholeFrame := checkedFrame.trans resolvedFrame
+    obtain ⟨found, lookup, selectedSame, _resolvedSame⟩ :=
+      (representative_success representativeFuel uv checked resolved selected).mp resolution
+    have path := (UnionFind.findRoot_correct representativeFuel checked.representatives uv found lookup).1
+    have rootSame : selected = root := selectedSame.trans
+      (UnionFind.reaches_unique path ((checkedFrame.reaches uv root size).mpr oldPath)).1
+    have stored : resolved.values[selected]? = some (.unenumerated (some oldHandle) scs) := by
+      simpa only [wholeFrame.values, rootSame] using oldStored
+    have afterSame := (EnumerationDriver.modify_success _ resolved after).mp writing
+    rw [afterSame]
+    exact (same_bucket_mass resolved selected (some oldHandle) (some newHandle) scs stored).trans
+      (suspendedBound_values before resolved wholeFrame.values)
+
+private theorem narrowed_raw
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (metadata : Metadata Typing) (fuel uv : Nat) (caller : Caller width) (before : Cached) (queries : Queries)
+    (oldHandle : Nat) (scs : List Suspended) (readAfter checked : Core) (oldValue value : Node)
+    (heap : InternedConstructorTemplates.State Symbol Constraint) (selectedAction : EnumerateM Symbol Constraint Unit)
+    (result : Result width Typing) (raw : Raw)
+    (reading : ExceptT.run (getValue fuel uv before.core) =
+      [.ok (.unenumerated (some oldHandle) scs, readAfter)])
+    (checking : ExceptT.run (SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap
+      fuel uv oldHandle scs readAfter) = [.ok (false, checked)])
+    (decoded : lookupNode caller.checked.native.machine.heap oldHandle = some oldValue)
+    (prepared : SourcePruningEnumerationAction.prepare holeKey fits admits metadata fuel fuel
+      uv oldHandle scs oldValue caller.checked.native.machine.heap = .done (value, some selectedAction) heap)
+    (actual : runPrefix holeKey fits admits graph templates stop order metadata fuel fuel fuel fuel fuel fuel
+      uv caller before queries = result)
+    (field : (match (generalizing := false) result with | .narrowed _ _ _ _ action _ _ _ => action | _ => none) = some raw) :
+    ExceptT.run (selectedAction checked) = raw := by
+  have copied : (match (generalizing := false)
+      runPrefix holeKey fits admits graph templates stop order metadata fuel fuel fuel fuel fuel fuel
+        uv caller before queries with
+    | .narrowed _ _ _ _ action _ _ _ => action
+    | _ => none) = some (ExceptT.run (selectedAction checked)) := by
+    simp only [runPrefix, reading, checking, decoded, prepared]
+    cases execution : ExceptT.run (selectedAction checked) with
+    | nil => rfl
+    | cons first rest =>
+        cases rest with
+        | cons _ _ =>
+            cases first with
+            | error _ => rfl
+            | ok pair =>
+                obtain ⟨token, _observed⟩ := pair
+                cases token
+                rfl
+        | nil =>
+            cases first with
+            | error _ => rfl
+            | ok pair =>
+                obtain ⟨token, observed⟩ := pair
+                cases token
+                dsimp only
+                cases encodeNode value with
+                | none => rfl
+                | some newHandle =>
+                    dsimp only
+                    cases SourcePruningEnumerationNarrowAdapter.adapt heap fuel uv oldHandle newHandle scs
+                      before observed with
+                    | none => rfl
+                    | some attached =>
+                        rw [SourcePruningRecordTypes.recordTypes_inr]
+                        rfl
+  have fields := (congrArg (fun observed : Result width Typing => match observed with
+    | .narrowed _ _ _ _ action _ _ _ => action
+    | _ => none) actual).trans field
+  exact Option.some.inj (copied.symm.trans fields)
+
+variable [DecidableEq Symbol] [DecidableEq Node]
+
+private theorem finish_preserves
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (r n p h k uv : Nat) (observed : Result width Typing) :
+    match observed with
+    | .stopped _ _ | .parked _ _ _ => finish checkEmpty edgesOf r n p h k uv observed = observed
+    | .narrowed checked prepared reached queries action candidate right _ =>
+        ∃ ordinary, finish checkEmpty edgesOf r n p h k uv observed =
+          .narrowed checked prepared reached queries action candidate right ordinary := by
+  cases observed with
+  | stopped _ _ => rfl
+  | parked _ _ _ => rfl
+  | narrowed checked prepared reached queries action candidate right ordinary =>
+      dsimp only
+      unfold finish
+      split <;> simp_all only [Result.narrowed.injEq] <;> subst_vars <;>
+        simp only [true_and] <;> exact ⟨_, rfl⟩
+
+/-- The actual selected prefix derives its attached cache's mass bound from the original packet. -/
+theorem retained_le
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (metadata : Metadata Typing) (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : SourceCurrentAllocatedNativeInventoryState.Inventory)
+    (fuel uv : Nat) (caller : Caller width) (memos : Memos) (before : Cached)
+    (packet : SourcePruningEnumerationRecursive.Packet formulas solver inventory caller memos metadata before)
+    (observed : Result width Typing)
+    (valid : PrefixValid holeKey fits admits graph templates checkEmpty edgesOf stop order metadata
+      formulas solver inventory fuel uv caller before memos observed)
+    (actual : runPrefix holeKey fits admits graph templates stop order metadata fuel fuel fuel fuel fuel fuel
+      uv caller before memos.query = observed) :
+    match (generalizing := false) observed with
+    | .parked _ (some after) _ | .narrowed _ _ _ _ _ (some after) _ _ =>
+        suspendedBound after.core ≤ suspendedBound before.core
+    | _ => True := by
+  have full := valid.2.1
+  cases observed with
+  | stopped _ _ => trivial
+  | parked checked candidate raw =>
+      cases candidate with
+      | none => trivial
+      | some after =>
+          obtain ⟨oldHandle, scs, readAfter, reading, checking, cached, same, core,
+            _cacheValid, _safe, _pending, _counter, _ordered, _raw⟩ := full
+          have equal : after = cached := Option.some.inj same
+          subst cached
+          have read : Success (getValue fuel uv) before.core (.unenumerated (some oldHandle) scs) readAfter := by
+            rw [Success, reading]
+            exact List.mem_singleton_self _
+          have check : Success (SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap
+              fuel uv oldHandle scs) readAfter true checked := by
+            rw [Success, checking]
+            exact List.mem_singleton_self _
+          simpa only [core] using parked_mass caller.checked.native.machine.heap fuel fuel uv oldHandle scs
+            before.core readAfter checked packet.safe read check
+  | narrowed checked prepared reached queries action candidate right ordinary =>
+      cases candidate with
+      | none => trivial
+      | some after =>
+          obtain ⟨_next, finished⟩ := finish_preserves checkEmpty edgesOf 0 0 0 0 0 uv
+            (.narrowed checked prepared reached queries action (some after) right ordinary)
+          rw [finished] at full
+          obtain ⟨oldHandle, scs, readAfter, reading, checking, oldValue, value, heap,
+            selectedAction, _final, decoded, narrowed, preparedRun, _preparedSame, _reached,
+            _queries, _post, _saved, shape⟩ := full
+          rcases shape with ⟨_empty, _action, noCache, _right, _ordinary⟩ |
+            ⟨newHandle, cached, nonempty, encoded, rawSame, same, _rest⟩
+          · cases noCache
+          · have equal : after = cached := Option.some.inj same
+            subst cached
+            have execution := narrowed_raw holeKey fits admits graph templates stop order metadata fuel uv
+              caller before memos.query oldHandle scs readAfter checked oldValue value heap selectedAction
+              (.narrowed checked prepared reached queries action (some after) right ordinary)
+              [.ok ((), after.core)] reading checking decoded preparedRun actual rawSame
+            have read : Success (getValue fuel uv) before.core (.unenumerated (some oldHandle) scs) readAfter := by
+              rw [Success, reading]
+              exact List.mem_singleton_self _
+            have check : Success (SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap
+                fuel uv oldHandle scs) readAfter false checked := by
+              rw [Success, checking]
+              exact List.mem_singleton_self _
+            have success : Success selectedAction checked () after.core := by
+              rw [Success, execution]
+              exact List.mem_singleton_self _
+            exact Nat.le_of_eq (narrowed_mass holeKey fits admits metadata fuel fuel fuel fuel uv oldHandle newHandle
+              scs oldValue value caller.checked.native.machine.heap heap selectedAction before.core readAfter checked
+              after.core packet.safe read check narrowed nonempty encoded preparedRun success)
+
+end MicroCFTA.SourcePruningEnumerationPrefixMass
diff --git a/lean/MicroCFTA/SourcePruningEnumerationResumeDepth.lean b/lean/MicroCFTA/SourcePruningEnumerationResumeDepth.lean
new file mode 100644
index 000000000..ea0238c19
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationResumeDepth.lean
@@ -0,0 +1,61 @@
+import MicroCFTA.SourcePruningEnumerationResumeExecution
+
+namespace MicroCFTA.SourcePruningEnumerationRecursive
+open EnumerationState InternedConstructorTemplates
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Prepared" => MergedSourceComparison.Result Symbol Constraint
+  (Node × Option (EnumerateM Symbol Constraint Unit))
+local notation "EntryRaw" => List (Except EnumerationState.Error
+  ((Nat × Nat × List Suspended × Node) × Core))
+local notation "Fold" => SourcePruningEnumerationNativeContinuations.Result
+variable {Typing Key : Type} {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+variable (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+variable (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+variable (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+variable (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+
+/-- Stable prefix and scan observations share one work bound at every recursive depth. -/
+theorem resume_depth_stable
+    (prefixFuel scanFuel recursiveFuel uv : Nat) (metadata updated : Metadata Typing)
+    (caller reached : Caller width) (queries saved : Queries) (before after : Cached)
+    (raw : EntryRaw) (result : Fold (Output width Typing) (Failure width Typing) width)
+    (prefixRun : ∀ extra, ∃ (checked : Core) (prepared : Prepared),
+      SourcePruningEnumerationSelectedStep.runPrefix holeKey fits admits graph templates stop order
+        metadata (prefixFuel + extra) (prefixFuel + extra) (prefixFuel + extra)
+        (prefixFuel + extra) (prefixFuel + extra) (prefixFuel + extra) uv caller before queries =
+        .narrowed checked prepared reached saved (some [.ok ((), after.core)]) (some after)
+          (some [.ok ((false, updated), after.core)]) none)
+    (ordinary : ∀ extra, SourcePruningEnumerationNativeOrdinaryContinuations.run
+      (continueWith
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (scanFuel + extra) recursiveFuel)
+        graph templates stop order (scanFuel + extra) updated uv)
+      checkEmpty (scanFuel + extra) (scanFuel + extra) (scanFuel + extra) (scanFuel + extra)
+        (scanFuel + extra) uv edgesOf reached after saved = (raw, some result)) :
+    ∀ extra, resume holeKey fits admits graph templates checkEmpty edgesOf stop order
+      (prefixFuel + scanFuel + extra) (recursiveFuel + 1) metadata caller queries before (some (.expand uv)) =
+        finish uv result := by
+  intro extra
+  obtain ⟨checked, prepared, prefixAt⟩ := prefixRun (scanFuel + extra)
+  have actualPrefix : SourcePruningEnumerationSelectedStep.runPrefix holeKey fits admits graph templates stop order
+      metadata (prefixFuel + scanFuel + extra) (prefixFuel + scanFuel + extra)
+      (prefixFuel + scanFuel + extra) (prefixFuel + scanFuel + extra)
+      (prefixFuel + scanFuel + extra) (prefixFuel + scanFuel + extra) uv caller before queries =
+      .narrowed checked prepared reached saved (some [.ok ((), after.core)]) (some after)
+        (some [.ok ((false, updated), after.core)]) none := by
+    simpa only [Nat.add_assoc] using prefixAt
+  have actualOrdinary := ordinary (prefixFuel + extra)
+  have sameFuel : scanFuel + (prefixFuel + extra) = prefixFuel + scanFuel + extra := by omega
+  rw [sameFuel] at actualOrdinary
+  exact resume_narrowed_ordinary holeKey fits admits graph templates checkEmpty edgesOf stop order
+    (prefixFuel + scanFuel + extra) recursiveFuel uv metadata updated caller reached queries saved before after
+    checked prepared raw result actualPrefix actualOrdinary
+
+end MicroCFTA.SourcePruningEnumerationRecursive
diff --git a/lean/MicroCFTA/SourcePruningEnumerationTwoExpansionForecast.lean b/lean/MicroCFTA/SourcePruningEnumerationTwoExpansionForecast.lean
new file mode 100644
index 000000000..4833fc5ee
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationTwoExpansionForecast.lean
@@ -0,0 +1,150 @@
+import MicroCFTA.SourcePruningEnumerationSiblingReservation
+
+/-!
+# One original envelope for two recursive expansions
+
+The original profile pays the first narrowing prefix. Original suspended
+mass bounds the inherited bucket and each retained prefix cache. One extra
+paired stage covers a parked first expansion. The schedule supplies room
+without asserting any future execution or endpoint.
+-/
+namespace MicroCFTA.SourcePruningEnumerationTwoExpansionForecast
+open EnumerationState InternedConstructorTemplates InternedProbeProvenance
+open SourceCurrentAllocatedNativeResourceForecast (Le Room)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed)
+attribute [local irreducible] SourcePruningEnumerationRecursiveReservation.afterHook
+attribute [local irreducible] SourceCurrentConstrainedCapEditForecast.headProfile
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "scalar" => SourceCurrentConstrainedCapTargetForecast.scalar
+local notation "headProfile" => SourceCurrentConstrainedCapEditForecast.headProfile
+local notation "mass" => SourcePruningEnumerationPrefixAdmission.suspendedBound
+local notation "stage" => SourcePruningEnumerationSiblingReservation.stage
+local notation "afterHead" => SourcePruningEnumerationRecursiveReservation.afterHead
+local notation "afterHook" => SourcePruningEnumerationRecursiveReservation.afterHook
+local notation "advance" => SourcePruningEnumerationIncomingReservation.advance
+
+/-- The original narrowing prefix retains the alphabet and enlarges the numeric profile. -/
+def start (seed : Seed) : Seed := (seed.1, headProfile seed.2)
+
+/-- One extra paired stage covers the parked route even when the ordinary row bound is zero. -/
+def rows (seed : Seed) : Nat := scalar (start seed).2 + 1
+
+/-- The complete envelope depends only on the original seed and enumeration core. -/
+noncomputable def final (seed : Seed) (before : Core) : Seed :=
+  stage (start seed) (mass before) (mass before) (rows seed)
+
+/-- Reserve all paired stages of the original envelope. -/
+def Reserved (bits : Nat) (seed : Seed) (before : Core) : Prop :=
+  SourcePruningEnumerationSiblingReservation.Reserved bits (start seed)
+    (mass before) (mass before) (rows seed)
+
+/-- The original envelope always contains its first paired stage. -/
+theorem rows_positive (seed : Seed) : 1 ≤ rows seed := by
+  unfold rows
+  omega
+
+/-- The first narrowing forecast retains the original numeric and alphabet bounds. -/
+theorem start_ge (seed : Seed) : Le seed.2 (start seed).2 ∧ seed.1 ⊆ (start seed).1 := by
+  change Le seed.2 (headProfile seed.2) ∧ seed.1 ⊆ seed.1
+  constructor
+  · exact SourceCurrentConstrainedCapEditForecast.headProfile_ge seed.2
+  · exact fun _ member => member
+
+/-- The complete original envelope bounds every shorter part of its same schedule. -/
+theorem stage_le_final (seed : Seed) (before : Core) {count : Nat} (bounded : count ≤ rows seed) :
+    Le (stage (start seed) (mass before) (mass before) count).2 (final seed before).2 ∧
+      (stage (start seed) (mass before) (mass before) count).1 ⊆ (final seed before).1 :=
+  SourcePruningEnumerationSiblingReservation.count_mono (start seed) (mass before) (mass before) bounded
+
+/-- The original caller fits below the final envelope without changing its guard alphabet. -/
+theorem final_ge (seed : Seed) (before : Core) :
+    Le seed.2 (final seed before).2 ∧ seed.1 ⊆ (final seed before).1 := by
+  have stages := SourcePruningEnumerationSiblingReservation.stage_ge
+    (start seed) (mass before) (mass before) (rows seed)
+  exact ⟨(start_ge seed).1.trans stages.1, fun _ member => stages.2 ((start_ge seed).2 member)⟩
+
+/-- Current available rows and a nonincreasing selector fit the original ordinary row budget. -/
+theorem selected_length_le {width : Nat} (seed : Seed) (caller : Caller width)
+    (bounded : Fits (start seed).2 caller.checked)
+    (entry : Cache.Interned InternedBinderProtocol.NodeKey)
+    (stored selected : List (EdgeValue Symbol Constraint)) (depth : Nat)
+    (free : List InternedBinderProtocol.Reference)
+    (available : Available caller.checked.native.machine.heap (.node entry stored depth free))
+    (lengths : selected.length ≤ stored.length) : selected.length ≤ rows seed := by
+  have heapFits : SourceCurrentConstrainedCapRequiredResources.HeapFits (start seed).2
+      caller.checked.native.machine.heap :=
+    SourceCurrentConstrainedCapRequiredResources.of_checked
+      (profile := (start seed).2) (before := caller.checked) bounded
+  have count := SourceCurrentConstrainedCapRequiredResources.node_width heapFits available
+  exact Nat.le_trans lengths (Nat.le_trans count (Nat.le_succ _))
+
+/-- The ordinary route uses a prefix of the original sibling reservation. -/
+theorem Reserved.ordinary {bits : Nat} {seed : Seed} {before : Core}
+    (reservation : Reserved bits seed before) (count : Nat) (bounded : count ≤ rows seed) :
+    SourcePruningEnumerationSiblingReservation.Reserved bits (start seed)
+      (mass before) (mass before) count :=
+  SourcePruningEnumerationSiblingReservation.Reserved.prefix reservation bounded
+
+/-- The original extra stage supplies both phases needed for the parked route. -/
+theorem Reserved.first {bits : Nat} {seed : Seed} {before : Core}
+    (reservation : Reserved bits seed before) :
+    SourcePruningEnumerationRecursiveReservation.Reserved bits (start seed) (mass before) (mass before) :=
+  SourcePruningEnumerationSiblingReservation.Reserved.head reservation
+
+/-- A parked caller can use the planned head endpoint without executing an edge. -/
+theorem parked_input_padding (seed : Seed) (before : Core) :
+    Le seed.2 (afterHead (start seed) (mass before)).2 ∧
+      seed.1 ⊆ (afterHead (start seed) (mass before)).1 := by
+  have planned := SourcePruningEnumerationRecursiveReservation.afterHead_ge (start seed) (mass before)
+  exact ⟨(start_ge seed).1.trans planned.1, fun _ member => planned.2 ((start_ge seed).2 member)⟩
+
+/-- Clearing or retaining original buckets keeps the parked cache below the first mass ceiling. -/
+theorem parked_mass_le (seed : Seed) (before checked : Core) (bounded : mass checked ≤ mass before) :
+    mass checked ≤ SourcePruningEnumerationRecursiveReservation.massCeil
+      (start seed) (mass before) (mass before) :=
+  Nat.le_trans bounded (Nat.le_add_right _ _)
+
+/-- The first paired reservation pays one actual resume from a mass-bounded parked cache. -/
+theorem Reserved.parked {bits : Nat} {seed : Seed} {before : Core}
+    (reservation : Reserved bits seed before) (checked : Core) (bounded : mass checked ≤ mass before) :
+    SourcePruningEnumerationIncomingReservation.Reserved bits
+      ((afterHead (start seed) (mass before)).1,
+        headProfile (afterHead (start seed) (mass before)).2)
+      (SourcePruningEnumerationExpansionAdmission.count (afterHead (start seed) (mass before)) checked) :=
+  reservation.first.callback checked (parked_mass_le seed before checked bounded)
+
+/-- The parked resume's actual shorter count fits the final original envelope. -/
+theorem parked_final_padding (seed : Seed) (before checked : Core) (bounded : mass checked ≤ mass before) :
+    Le (advance ((afterHead (start seed) (mass before)).1,
+          headProfile (afterHead (start seed) (mass before)).2)
+        (SourcePruningEnumerationExpansionAdmission.count (afterHead (start seed) (mass before)) checked)).2
+        (final seed before).2 ∧
+      (advance ((afterHead (start seed) (mass before)).1,
+          headProfile (afterHead (start seed) (mass before)).2)
+        (SourcePruningEnumerationExpansionAdmission.count (afterHead (start seed) (mass before)) checked)).1 ⊆
+        (final seed before).1 := by
+  have counts := SourcePruningEnumerationRecursiveReservation.callback_count_le
+    (start seed) (mass before) (mass before) checked (parked_mass_le seed before checked bounded)
+  have first := SourcePruningEnumerationRecursiveReservation.callback_padding
+    (start seed) (mass before) (mass before)
+    (SourcePruningEnumerationExpansionAdmission.count (afterHead (start seed) (mass before)) checked) counts
+  have rest := stage_le_final seed before (count := 1) (rows_positive seed)
+  exact ⟨first.1.trans rest.1, fun _ member => rest.2 (first.2 member)⟩
+
+/-- Room at the original final forecast supplies every reserved stage. -/
+theorem reserved_of_final_room (bits : Nat) (seed : Seed) (before : Core)
+    (room : Room bits (final seed before).2) : Reserved bits seed before :=
+  SourcePruningEnumerationSiblingReservation.reserved_of_final_room bits (start seed)
+    (mass before) (mass before) (rows seed) room
+
+/-- The original envelope computes a mathematical width for both execution routes. -/
+theorem reserved_computed (seed : Seed) (before : Core) :
+    Reserved (SourceCurrentParentInitialRoom.roomBits (final seed before).2) seed before :=
+  reserved_of_final_room _ seed before (SourceCurrentParentInitialRoom.room_computed _)
+
+end MicroCFTA.SourcePruningEnumerationTwoExpansionForecast
