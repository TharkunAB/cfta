MicroCFTA.UnfoldHistoryIntegration.constructed_change : @Exists.{1}
  (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) fun input =>
  @Exists.{1} (MicroCFTA.InternedConstructorTemplates.State Nat Bool) fun source =>
    @Exists.{1} (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) fun result =>
      @Exists.{1} (MicroCFTA.InternedConstructorTemplates.State Nat Bool) fun after =>
        And
          (@Eq.{1}
            (MicroCFTA.InternedNestedConstruction.Outcome Nat Bool
              (MicroCFTA.InternedConstructorTemplates.Value Nat Bool))
            (@MicroCFTA.InternedFreshOrdinaryConstruction.build Nat Bool
              (fun a b =>
                @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                  instDecidableEqBool a b)
              MicroCFTA.UnfoldHistoryIntegration.expression
              (@List.nil.{0} (MicroCFTA.InternedConstructorTemplates.Value Nat Bool))
              (@MicroCFTA.InternedConstructorTemplates.empty Nat Bool))
            (@MicroCFTA.InternedNestedConstruction.Outcome.done Nat Bool
              (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) input source))
          (And
            (@Eq.{1}
              (MicroCFTA.InternedNestedConstruction.Outcome Nat Bool
                (MicroCFTA.InternedConstructorTemplates.Value Nat Bool))
              (@MicroCFTA.InternedFreshOrdinaryStoredSubstitution.unfold Nat Bool
                (fun a b =>
                  @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                    instDecidableEqBool a b)
                input source)
              (@MicroCFTA.InternedNestedConstruction.Outcome.done Nat Bool
                (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) result after))
            (And
              (@LT.lt.{0} Nat instLTNat
                (@MicroCFTA.Cache.State.next MicroCFTA.InternedBinderProtocol.NodeKey
                  (@MicroCFTA.InternedConstructorTemplates.State.nodes Nat Bool source))
                (@MicroCFTA.Cache.State.next MicroCFTA.InternedBinderProtocol.NodeKey
                  (@MicroCFTA.InternedConstructorTemplates.State.nodes Nat Bool after)))
              (And
                (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.Event Nat Bool
                  (fun a b =>
                    @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                      instDecidableEqBool a b)
                  source after)
                (And
                  (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.History Nat Bool
                    (fun a b =>
                      @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                        instDecidableEqBool a b)
                    source after)
                  (And
                    (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.Good Nat Bool
                      (@MicroCFTA.InternedValueMassHeap.initialBound Nat Bool source) after)
                    (And
                      (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.Fits Nat Bool
                        (MicroCFTA.SourceCurrentAllocatedUnfoldHistory.heapBound
                          (@MicroCFTA.Cache.State.next MicroCFTA.InternedBinderProtocol.NodeKey
                            (@MicroCFTA.InternedConstructorTemplates.State.nodes Nat Bool source))
                          (@MicroCFTA.Cache.State.next (MicroCFTA.InternedConstructorTemplates.EdgeKey Nat Bool)
                            (@MicroCFTA.InternedConstructorTemplates.State.edges Nat Bool source))
                          (@MicroCFTA.InternedValueMassHeap.initialBound Nat Bool source))
                        after)
                      (MicroCFTA.HeightOrder.VectorBelow (@MicroCFTA.InternedValueMassHeap.initialBound Nat Bool source)
                        (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.measure Nat Bool
                          (fun a b =>
                            @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                              instDecidableEqBool a b)
                          (@MicroCFTA.InternedValueMassHeap.initialBound Nat Bool source) after)
                        (@MicroCFTA.SourceCurrentAllocatedUnfoldHistory.measure Nat Bool
                          (fun a b =>
                            @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                              instDecidableEqBool a b)
                          (@MicroCFTA.InternedValueMassHeap.initialBound Nat Bool source) source))))))))
