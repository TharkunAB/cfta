fun {Typing} {width} recur graph templates stop order callbackFuel metadata uv fragment caller queries before =>
  have raw :=
    (MicroCFTA.SourcePruningRecordTypes.recordTypes graph templates callbackFuel metadata uv (Sum.inl fragment)
