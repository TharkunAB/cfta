  (metadata : MicroCFTA.SourcePruningRecordTypes.Metadata Typing) [DecidableEq MicroCFTA.SourcePruningTemplates.Symbol]
  [DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (readFuel checkFuel nativeFuel representativeFuel indexFuel callbackFuel r n p h k uv : Nat)
  (caller : MicroCFTA.SourceCurrentAllocatedPartialState.State width)
  (before :
    MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (queries : MicroCFTA.SourceEndpointMemo.Memos) :
  MicroCFTA.SourcePruningEnumerationSelectedStep.run holeKey fits admits graph templates checkEmpty edgesOf stop order
      metadata readFuel checkFuel nativeFuel representativeFuel indexFuel callbackFuel r n p h k uv caller before
      queries =
    have read := (MicroCFTA.EnumerationState.getValue readFuel uv before.core).run;
    match read with
    | [Except.ok (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs, readAfter)] =>
      have check :=
        (MicroCFTA.SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap checkFuel uv
            oldHandle scs readAfter).run;
      match check with
      | [Except.ok (true, checked)] =>
        have candidate :=
          MicroCFTA.SourcePruningEnumerationParkedRestart.adapt caller.checked.native.machine.heap indexFuel uv
            oldHandle scs before checked;
        MicroCFTA.SourcePruningEnumerationSelectedStep.Result.parked checked candidate
          (Option.map
            (fun parked => (MicroCFTA.SourcePruningEnumerationRestart.run stop order metadata parked checked).run)
            candidate)
      | [Except.ok (false, checked)] =>
        match MicroCFTA.SourcePruningEnumerationNodes.lookupNode caller.checked.native.machine.heap oldHandle with
        | none => MicroCFTA.SourcePruningEnumerationSelectedStep.Result.stopped read (some check)
        | some oldValue =>
          have prepared :=
            MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel representativeFuel
              uv oldHandle scs oldValue caller.checked.native.machine.heap;
          have reached :=
            MicroCFTA.SourceCurrentAllocatedPartialState.advance caller
              (MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical caller.checked
                { heap := prepared.state, equality := caller.checked.operations })
              caller.fourth caller.merge;
          match prepared with
          | MicroCFTA.MergedSourceComparison.Result.failed _fault _heap =>
            MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries none none
              none none
          | MicroCFTA.MergedSourceComparison.Result.done (_value, none) _heap =>
            MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries none none
              none none
          | MicroCFTA.MergedSourceComparison.Result.done (value, some action) heap =>
            have raw := (action checked).run;
            match raw with
            | [Except.ok (PUnit.unit, observed)] =>
              match MicroCFTA.SourcePruningEnumerationNodes.encodeNode value with
              | none =>
                MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries
                  (some raw) none none none
              | some newHandle =>
                have candidate :=
                  MicroCFTA.SourcePruningEnumerationNarrowAdapter.adapt heap indexFuel uv oldHandle newHandle scs before
                    observed;
                match candidate with
                | none =>
                  MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries
                    (some raw) none none none
                | some attached =>
                  have right :=
                    (MicroCFTA.SourcePruningRecordTypes.recordTypes graph templates callbackFuel metadata uv
                        (Sum.inr newHandle) attached.core).run;
                  match right with
                  | [Except.ok ((false, _updated), callbackCore)] =>
                    have after := MicroCFTA.EnumerationExpandableIndex.frame callbackCore attached;
                    MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries
                      (some raw) (some after) (some right)
                      (some
                        (MicroCFTA.SourcePruningEnumerationNativeOrdinary.run checkEmpty r n p h k uv edgesOf reached
                          after queries))
                  | x =>
                    MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries
                      (some raw) (some attached) (some right) none
            | x =>
              MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries (some raw)
                none none none
      | x => MicroCFTA.SourcePruningEnumerationSelectedStep.Result.stopped read (some check)
    | x => MicroCFTA.SourcePruningEnumerationSelectedStep.Result.stopped read none
