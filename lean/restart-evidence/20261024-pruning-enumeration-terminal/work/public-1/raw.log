MicroCFTA.SourcePruningEnumerationTerminal.gained_correct : ∀
  (values : List (MicroCFTA.EnumerationState.UVarValue MicroCFTA.SourcePruningTemplates.Symbol)) (target : Nat)
  (oldNode newNode : Option Nat) (incomingScs oldScs : List MicroCFTA.EnumerationState.Suspended) (roots : Nat → Nat)
  (waiting : MicroCFTA.EnumerationWaitingIndex.Waiting),
  values[target]? = some (MicroCFTA.EnumerationState.UVarValue.unenumerated oldNode oldScs) →
    MicroCFTA.EnumerationCanonicalWaiting.Correct roots values waiting →
      MicroCFTA.EnumerationCanonicalWaiting.Correct roots
        (values.set target (MicroCFTA.EnumerationState.UVarValue.unenumerated newNode (incomingScs ++ oldScs)))
        (MicroCFTA.EnumerationCanonicalWaiting.count roots 1 incomingScs waiting)
