        some (before.expandable slot)) :
  ∃ fuel decoded after,
    (∀ (extra : Nat),
        (MicroCFTA.SourcePruningEnumerationEntry.enter heap (fuel + extra) uv before.core).run =
          [Except.ok ((uv, handle, scs, decoded), after.core)]) ∧
