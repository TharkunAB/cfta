                    before.waiting ∧
                MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                  MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values after.waiting ∧
                    (∀ (slot : Nat),
                        MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                            (after.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
                          some (after.expandable slot)) ∧
                      MicroCFTA.EnumerationCorrectness.StorageValid after.core ∧
                        MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap after.core ∧
                          (MicroCFTA.EnumerationSchedule.Safe before.core →
                            MicroCFTA.EnumerationSchedule.IsRoot before.core.representatives target →
                              MicroCFTA.EnumerationSchedule.Safe after.core)
