  (allowed : MicroCFTA.EnumerationState.arityAllows edge.children.length scs = true)
  (tries : List MicroCFTA.EqualityTrie.Trie)
  (residual : Option (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (projected : MicroCFTA.SourcePruningEnumerationConstraint.project edge.entry.key.constraint = some (tries, residual))
  (ranges : MicroCFTA.SourcePruningEnumerationSelectedEdge.Ranges checkEmpty scs edge caller before memos.query) :
