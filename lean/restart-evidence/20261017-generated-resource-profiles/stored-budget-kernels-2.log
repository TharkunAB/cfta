  @Exists.{1} (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) fun input =>
    @Exists.{1} (MicroCFTA.InternedConstructorTemplates.State Nat Bool) fun source =>
      And
        (@Eq.{1}
          (MicroCFTA.InternedNestedConstruction.Outcome Nat Bool
            (MicroCFTA.InternedConstructorTemplates.Value Nat Bool))
          (@MicroCFTA.InternedFreshOrdinaryConstruction.build Nat Bool
            (fun a b =>
              @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                instDecidableEqBool a b)
            MicroCFTA.StoredBudgetKernels.expression
            (@List.cons.{0} (MicroCFTA.InternedConstructorTemplates.Value Nat Bool)
              (@MicroCFTA.InternedConstructorTemplates.Value.reference Nat Bool
                (MicroCFTA.InternedBinderProtocol.Reference.intersection
                  (@OfNat.ofNat.{0} Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))
                  (@OfNat.ofNat.{0} Nat (nat_lit 5) (instOfNatNat (nat_lit 5)))))
              (@List.nil.{0} (MicroCFTA.InternedConstructorTemplates.Value Nat Bool)))
            (@MicroCFTA.InternedConstructorTemplates.empty Nat Bool))
          (@MicroCFTA.InternedNestedConstruction.Outcome.done Nat Bool
            (MicroCFTA.InternedConstructorTemplates.Value Nat Bool) input source))
        (And
          (@Membership.mem.{0, 0} MicroCFTA.InternedBinderProtocol.Reference
            (List.{0} MicroCFTA.InternedBinderProtocol.Reference)
            (@List.instMembership.{0} MicroCFTA.InternedBinderProtocol.Reference)
            (@MicroCFTA.InternedConstructorTemplates.Value.free Nat Bool input)
            (MicroCFTA.InternedBinderProtocol.Reference.intersection
              (@OfNat.ofNat.{0} Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))
              (@OfNat.ofNat.{0} Nat (nat_lit 5) (instOfNatNat (nat_lit 5)))))
          (And (Not (@MicroCFTA.InternedStoredClosedMuCompletion.PreparedWithoutMu Nat Bool input))
            (And
              (@LE.le.{0} Nat instLENat
                (@MicroCFTA.Cache.State.next MicroCFTA.InternedBinderProtocol.NodeKey
                  (@MicroCFTA.InternedConstructorTemplates.State.nodes Nat Bool
                    (@MicroCFTA.InternedNestedConstruction.Outcome.state Nat Bool
                      (MicroCFTA.InternedConstructorTemplates.Value Nat Bool)
                      (@MicroCFTA.InternedFreshOrdinaryStoredSubstitution.execute Nat Bool
                        (fun a b =>
                          @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                            instDecidableEqBool a b)
                        input replacement current))))
                (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)
                  (@MicroCFTA.Cache.State.next MicroCFTA.InternedBinderProtocol.NodeKey
                    (@MicroCFTA.InternedConstructorTemplates.State.nodes Nat Bool current))
                  (@Prod.fst.{0, 0} Nat Nat
                    (@MicroCFTA.InternedFreshOrdinaryStoredAllocationBudget.executeCharges Nat Bool input))))
              (@LE.le.{0} Nat instLENat
                (@MicroCFTA.Cache.State.next (MicroCFTA.InternedConstructorTemplates.EdgeKey Nat Bool)
                  (@MicroCFTA.InternedConstructorTemplates.State.edges Nat Bool
                    (@MicroCFTA.InternedNestedConstruction.Outcome.state Nat Bool
                      (MicroCFTA.InternedConstructorTemplates.Value Nat Bool)
                      (@MicroCFTA.InternedFreshOrdinaryStoredSubstitution.execute Nat Bool
                        (fun a b =>
                          @MicroCFTA.InternedConstructorTemplates.instDecidableEqEdgeKey Nat Bool instDecidableEqNat
                            instDecidableEqBool a b)
                        input replacement current))))
                (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)
                  (@MicroCFTA.Cache.State.next (MicroCFTA.InternedConstructorTemplates.EdgeKey Nat Bool)
                    (@MicroCFTA.InternedConstructorTemplates.State.edges Nat Bool current))
                  (@Prod.snd.{0, 0} Nat Nat
                    (@MicroCFTA.InternedFreshOrdinaryStoredAllocationBudget.executeCharges Nat Bool input)))))))
