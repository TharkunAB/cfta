      MicroCFTA.SourceCurrentAllocatedPartialState.State width →
        MicroCFTA.SourceEndpointMemo.Memos →
          MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol
              (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
            MicroCFTA.SourcePruningEnumerationNativeContinuations.HookResult Output Reason width)
  (checkEmpty : Bool) (r n p h k target : Nat) (scs : List MicroCFTA.EnumerationState.Suspended)
  (before :
    MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (edge :
    MicroCFTA.InternedConstructorTemplates.EdgeValue MicroCFTA.SourcePruningTemplates.Symbol
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (rest :
    List
      (MicroCFTA.InternedConstructorTemplates.EdgeValue MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)))
  (caller middleCaller : MicroCFTA.SourceCurrentAllocatedPartialState.State width)
  (queries middleQueries : MicroCFTA.SourceEndpointMemo.Memos)
  (receipt : MicroCFTA.SourcePruningEnumerationSelectedEdge.Result width) (outputs : List Output)
  (observed :
    MicroCFTA.SourcePruningEnumerationCapturedEdge.run checkEmpty r n p h k target scs edge caller before queries =
      some receipt)
  (continued :
    match receipt with
    | MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment reached saved after =>
      hook fragment reached saved after =
        MicroCFTA.SourcePruningEnumerationNativeContinuations.HookResult.complete outputs middleCaller middleQueries
    | x =>
      MicroCFTA.SourcePruningEnumerationNativeBranches.advance receipt = some (middleCaller, middleQueries) ∧
        outputs = []) :
  MicroCFTA.SourcePruningEnumerationNativeContinuations.run hook checkEmpty r n p h k target scs before (edge :: rest)
      caller queries =
    match
      MicroCFTA.SourcePruningEnumerationNativeContinuations.run hook checkEmpty r n p h k target scs before rest
        middleCaller middleQueries with
    | MicroCFTA.SourcePruningEnumerationNativeContinuations.Result.complete processed later finalCaller finalQueries =>
      MicroCFTA.SourcePruningEnumerationNativeContinuations.Result.complete (receipt :: processed) (outputs ++ later)
        finalCaller finalQueries
    | MicroCFTA.SourcePruningEnumerationNativeContinuations.Result.stopped processed later current =>
      MicroCFTA.SourcePruningEnumerationNativeContinuations.Result.stopped (receipt :: processed) (outputs ++ later)
        current
