diff --git a/lean/MicroCFTA/SourcePruningEnumerationOrdinaryHookResources.lean b/lean/MicroCFTA/SourcePruningEnumerationOrdinaryHookResources.lean
new file mode 100644
index 000000000..c2432e741
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationOrdinaryHookResources.lean
@@ -0,0 +1,166 @@
+import MicroCFTA.SourcePruningEnumerationHookResources
+import MicroCFTA.SourcePruningEnumerationSelectedEntry
+import MicroCFTA.SourcePruningEnumerationNativeOrdinaryContinuations
+
+/-!
+# Actual ordinary entry with rendered callbacks
+
+The entry runs once before the ordered alternative scan. Each completed edge
+runs its callback and zero-expansion restart before the next sibling. The
+original cache supplies each sibling. Actual native effects and full memos
+pass to the suffix. Expansion exhaustion remains an explicit stopped result.
+-/
+namespace MicroCFTA.SourcePruningEnumerationNativeOrdinaryContinuations
+open EnumerationState EnumerationSchedule InternedConstructorTemplates InternedProbeProvenance
+open SourcePruningEnumerationNodes SourcePruningEnumerationObservation
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationIncomingReservation (Seed Reserved)
+open SourcePruningEnumerationNativeBranchCompletion (cost)
+open SourcePruningEnumerationRecursive (Packet Output Failure continueWith resume)
+open SourcePruningEnumerationNativeHookResources (ReceiptAt OutputAt StoppedAt)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Metadata" => SourcePruningRecordTypes.Metadata
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Receipt" => SourcePruningEnumerationSelectedEdge.Result
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "Result" => SourcePruningEnumerationNativeContinuations.Result
+local notation "reservationAdvance" => SourcePruningEnumerationIncomingReservation.advance
+variable {Typing Key : Type} {bits : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- Initial ordinary entry derives the actual callback-aware scan at one common work bound. -/
+theorem ordinary_zero_complete_resources
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (metadata : Metadata Typing)
+    (seed : Seed) (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory)
+    (caller : Caller (bits + 2)) (memos : Memos) (before : Cached) (uv handle : Nat) (scs : List Suspended)
+    (parentEntry : Cache.Interned InternedBinderProtocol.NodeKey)
+    (storedEdges : List (EdgeValue Symbol Constraint))
+    (depth : Nat) (free : List InternedBinderProtocol.Reference)
+    (packet : Packet formulas solver inventory caller memos metadata before)
+    (ready : EnumerationDriver.Ready uv before.core)
+    (stored : before.core.values[uv]? = some (.unenumerated (some handle) scs))
+    (decoded : lookupNode caller.checked.native.machine.heap handle = some (.node parentEntry storedEdges depth free))
+    (selected : ∀ edge ∈ edgesOf (.node parentEntry storedEdges depth free), edge ∈ storedEdges)
+    (incoming : EnumerationReferences.IncomingAvoid uv before.core)
+    (nonterminal : scs.any (fun sc => EqualityTrie.isTerminal sc.trie) = false)
+    (bounded : Fits seed.2 caller.checked)
+    (reserved : Reserved bits seed (cost scs before.core.counter (edgesOf (.node parentEntry storedEdges depth free))))
+    (known : Heap (fun guard => guard ∈ seed.1) caller.checked.native.machine.heap) :
+    ∃ (bound : Nat) (entered : Cached)
+      (processed : List (Receipt (bits + 2))) (outputs : List (Output (bits + 2) Typing))
+      (afterCaller : Caller (bits + 2)) (next : Inventory) (final : Memos)
+      (result : Result (Output (bits + 2) Typing) (Failure (bits + 2) Typing) (bits + 2)),
+      (∀ extra, ExceptT.run (SourcePruningEnumerationEntry.enter caller.checked.native.machine.heap
+          (bound + extra) uv before.core) =
+        [.ok ((uv, handle, scs, .node parentEntry storedEdges depth free), entered.core)]) ∧
+      EnumerationDriver.RenderStable before.core entered.core ∧
+      entered.core.counter = before.core.counter ∧ entered.core.values = before.core.values ∧
+      entered.expandable = before.expandable ∧ entered.waiting = before.waiting ∧
+      Packet formulas solver inventory caller memos metadata entered ∧
+      (∀ extra, run
+        (continueWith (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (bound + extra) 0)
+          graph templates stop order (bound + extra) metadata uv)
+        checkEmpty (bound + extra) (bound + extra) (bound + extra) (bound + extra) (bound + extra)
+        uv edgesOf caller before memos.query =
+          ([.ok ((uv, handle, scs, .node parentEntry storedEdges depth free), entered.core)], some result)) ∧
+      (∀ extra, SourcePruningEnumerationNativeContinuations.run
+        (continueWith (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (bound + extra) 0)
+          graph templates stop order (bound + extra) metadata uv)
+        checkEmpty (bound + extra) (bound + extra) (bound + extra) (bound + extra) (bound + extra)
+        uv scs entered (edgesOf (.node parentEntry storedEdges depth free)) caller memos.query = result) ∧
+      Post formulas solver next caller afterCaller final ∧
+      Packet formulas solver next afterCaller final metadata entered ∧
+      Fits (reservationAdvance seed (cost scs before.core.counter
+        (edgesOf (.node parentEntry storedEdges depth free)))).2 afterCaller.checked ∧
+      Heap (fun guard => guard ∈ (reservationAdvance seed (cost scs before.core.counter
+        (edgesOf (.node parentEntry storedEdges depth free)))).1) afterCaller.checked.native.machine.heap ∧
+      (∀ index receipt, processed[index]? = some receipt →
+        ReceiptAt formulas solver caller entered uv seed scs
+          (edgesOf (.node parentEntry storedEdges depth free)) index receipt) ∧
+      (∀ output ∈ outputs, ∃ index, index < (edgesOf (.node parentEntry storedEdges depth free)).length ∧
+        OutputAt formulas solver caller entered seed scs
+          (edgesOf (.node parentEntry storedEdges depth free)) index output) ∧
+      (result = .complete processed outputs afterCaller final.query ∨
+        ∃ current, result = .stopped processed outputs current ∧
+          StoppedAt formulas solver caller entered uv seed scs
+            (edgesOf (.node parentEntry storedEdges depth free)) processed.length afterCaller next final current) := by
+  obtain ⟨roots, paths, _storage, realized, counts, flags⟩ := packet.valid
+  obtain ⟨entryFuel, value, enteredCache, entryRun, lookup, _available, _closed, counter, values,
+    sameFlags, sameWaiting, enteredStored, enteredReady, _protected, enteredPaths, enteredRealized,
+    enteredCounts, enteredFlags, _bucketBounded, _retained, stable⟩ :=
+    SourcePruningEnumerationSelectedEntry.complete caller.checked.native.machine.heap before uv handle scs roots
+      ready stored realized paths counts flags
+  have same : value = .node parentEntry storedEdges depth free :=
+    Option.some.inj (lookup.symm.trans decoded)
+  subst value
+  have frame : EnumerationExpandableIndex.frame enteredCache.core before = enteredCache := by
+    cases enteredCache with
+    | mk core expandable waiting =>
+        simp only [EnumerationExpandableIndex.frame] at *
+        congr 1
+        · exact sameFlags.symm
+        · exact sameWaiting.symm
+  have enteredPacket : Packet formulas solver inventory caller memos metadata enteredCache := by
+    obtain ⟨level, frontier, ordered⟩ := packet.ordered
+    refine ⟨packet.context, stable.safe,
+      EnumerationReferences.pending_read before.core enteredCache.core stable packet.pending,
+      ⟨roots, enteredPaths, stable.safe.1, enteredRealized, enteredCounts, enteredFlags⟩,
+      ⟨level, frontier, EnumerationOrder.stratified_read before.core enteredCache.core level frontier stable ordered⟩,
+      ?_⟩
+    simpa only [counter] using packet.bounded
+  have enteredReserved : Reserved bits seed
+      (cost scs enteredCache.core.counter (edgesOf (.node parentEntry storedEdges depth free))) := by
+    simpa only [counter] using reserved
+  obtain ⟨scanBound, processed, outputs, afterCaller, next, final, result, scanRun, post,
+    captured, afterFits, afterKnown, receipts, outputPackets, shape⟩ :=
+    SourcePruningEnumerationNativeHookResources.alternatives_zero_complete_resources
+      holeKey fits admits graph templates checkEmpty edgesOf stop order metadata seed formulas solver inventory
+      caller memos enteredCache uv handle scs parentEntry storedEdges
+      (edgesOf (.node parentEntry storedEdges depth free)) depth free enteredPacket enteredReady enteredStored
+      decoded selected (EnumerationReferences.incoming_read uv before.core enteredCache.core stable incoming)
+      bounded enteredReserved known
+  have entryAt (extra : Nat) :
+      ExceptT.run (SourcePruningEnumerationEntry.enter caller.checked.native.machine.heap
+        (entryFuel + scanBound + extra) uv before.core) =
+        [.ok ((uv, handle, scs, .node parentEntry storedEdges depth free), enteredCache.core)] := by
+    simpa only [Nat.add_assoc] using entryRun (scanBound + extra)
+  have scanAt (extra : Nat) : SourcePruningEnumerationNativeContinuations.run
+      (continueWith
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (entryFuel + scanBound + extra) 0)
+        graph templates stop order (entryFuel + scanBound + extra) metadata uv)
+      checkEmpty (entryFuel + scanBound + extra) (entryFuel + scanBound + extra)
+      (entryFuel + scanBound + extra) (entryFuel + scanBound + extra) (entryFuel + scanBound + extra)
+      uv scs enteredCache (edgesOf (.node parentEntry storedEdges depth free)) caller memos.query = result := by
+    have actual := scanRun (entryFuel + extra)
+    have fuelSame : scanBound + (entryFuel + extra) = entryFuel + scanBound + extra := by omega
+    rw [fuelSame] at actual
+    exact actual
+  refine ⟨entryFuel + scanBound, enteredCache, processed, outputs, afterCaller, next, final, result,
+    entryAt, stable, counter, values, sameFlags, sameWaiting, enteredPacket, ?_, scanAt, post, captured,
+    ?_, ?_, receipts, outputPackets, shape⟩
+  · intro extra
+    have actual := entered
+      (continueWith
+        (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (entryFuel + scanBound + extra) 0)
+        graph templates stop order (entryFuel + scanBound + extra) metadata uv)
+      checkEmpty (entryFuel + scanBound + extra) (entryFuel + scanBound + extra)
+      (entryFuel + scanBound + extra) (entryFuel + scanBound + extra) (entryFuel + scanBound + extra)
+      uv uv handle scs parentEntry storedEdges depth free edgesOf caller before memos.query enteredCache.core
+      (entryAt extra) nonterminal
+    rw [frame, scanAt extra] at actual
+    exact actual
+  · simpa only [counter] using afterFits
+  · simpa only [counter] using afterKnown
+
+end MicroCFTA.SourcePruningEnumerationNativeOrdinaryContinuations
diff --git a/lean/MicroCFTA/SourcePruningEnumerationReceiptHook.lean b/lean/MicroCFTA/SourcePruningEnumerationReceiptHook.lean
new file mode 100644
index 000000000..1939fd393
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationReceiptHook.lean
@@ -0,0 +1,91 @@
+import MicroCFTA.SourcePruningEnumerationCallbackZero
+import MicroCFTA.SourcePruningEnumerationHookCertificates
+
+namespace MicroCFTA.SourcePruningEnumerationNativeHookResources
+open EnumerationState EnumerationSchedule InternedConstructorTemplates
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentAllocatedNativeResourceForecast (Profile)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+open SourcePruningEnumerationNativeBranchCompletion (Admitted Pending FragmentHistory)
+open SourcePruningEnumerationRecursive (Packet Output Failure continueWith resume)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Receipt" => SourcePruningEnumerationSelectedEdge.Result
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+local notation "HookResult" => SourcePruningEnumerationNativeContinuations.HookResult
+local notation "advance" => SourcePruningEnumerationNativeBranches.advance
+variable {Typing Key : Type} {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- An actual admitted receipt derives its rendered callback or its literal rejection continuation. -/
+theorem receipt_zero_complete
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+    (checkEmpty : Bool) (edgesOf : Node → List (EdgeValue Symbol Constraint))
+    (stop : Option (SourcePruningRecordTypes.Metadata Typing → Nat → Bool))
+    (order : SourcePruningRecordTypes.Metadata Typing → List Nat → Option Nat)
+    (metadata : SourcePruningRecordTypes.Metadata Typing)
+    (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (original next : Inventory) (caller reached : Caller width) (memos final : Memos) (before : Cached)
+    (uv : Nat) (receipt : Receipt width)
+    (packet : Packet formulas solver original caller memos metadata before)
+    (post : Post formulas solver next caller reached final)
+    (advanced : advance receipt = some (reached, final.query))
+    (admitted : Admitted uv receipt) (pending : Pending receipt) (history : FragmentHistory before.core receipt)
+    (profile : Profile) (property : Constraint → Prop)
+    (bounded : Fits profile reached.checked) (known : Heap property reached.checked.native.machine.heap) :
+    ∃ (fuel : Nat) (outcome : HookResult (Output width Typing) (Failure width Typing) width),
+      (∀ extra, match (generalizing := false) receipt with
+        | .complete fragment actual saved after =>
+            continueWith (resume holeKey fits admits graph templates checkEmpty edgesOf stop order (fuel + extra) 0)
+              graph templates stop order (fuel + extra) metadata uv fragment actual saved after = outcome
+        | _ => outcome = .complete [] reached final.query) ∧
+      match outcome with
+      | .complete outputs actual saved =>
+          actual = reached ∧ saved = final.query ∧
+          ∀ output ∈ outputs, ∃ updated,
+            Packet formulas solver next reached final updated output.cache ∧
+            output.caller = reached ∧ output.queries = final.query ∧
+            (output.metadata = none ∨ output.metadata = some updated)
+      | .stopped outputs reason endpoint =>
+          outputs = [] ∧ ∃ fragment receiptCache selected updated callbackCache,
+            receipt = .complete fragment reached final.query receiptCache ∧
+            reason = .exhausted selected updated callbackCache ∧ endpoint = some (reached, final.query) ∧
+            Packet formulas solver next reached final updated callbackCache := by
+  cases receipt with
+  | unhandled => cases advanced
+  | rejected actual saved after | stopped fragments observation candidate =>
+      exact ⟨0, .complete [] reached final.query, fun _ => rfl, rfl, rfl,
+        fun _ member => False.elim (List.not_mem_nil member)⟩
+  | complete fragment actual saved after =>
+      have endpoints : (actual, saved) = (reached, final.query) := Option.some.inj advanced
+      obtain ⟨callerSame, querySame⟩ := Prod.mk.inj endpoints
+      subst actual
+      subst saved
+      obtain ⟨level, frontier, ordered⟩ := packet.ordered
+      have current := SourcePruningEnumerationRecursive.receipt_packet before.core uv fragment after level frontier
+        post.context admitted history pending ordered packet.bounded
+      obtain ⟨fuel, result, callbackCore, outcome, _returned, _stable, _frame, _types, _holes, _typing,
+        _shape, observed, running⟩ :=
+        SourcePruningEnumerationRecursive.callback_zero_complete_resources holeKey fits admits formulas solver next
+          graph templates metadata uv fragment reached final after checkEmpty edgesOf stop order profile property
+          current admitted.2.2.1 bounded known
+      refine ⟨fuel, outcome, fun extra => (running extra).2.2.2, ?_⟩
+      cases outcome with
+      | complete outputs actual saved =>
+          obtain ⟨sameCaller, sameQuery, _fits, _known, packets⟩ := observed
+          refine ⟨sameCaller, sameQuery, ?_⟩
+          intro output member
+          obtain ⟨outputPacket, outputCaller, outputQuery, metadataShape, _cacheShape⟩ := packets output member
+          exact ⟨result.2, outputPacket, outputCaller, outputQuery, metadataShape⟩
+      | stopped outputs reason endpoint =>
+          obtain ⟨selected, empty, reasonSame, endpointSame, _fits, _known⟩ := observed
+          exact ⟨empty, fragment, after, selected, result.2,
+            EnumerationExpandableIndex.frame callbackCore after, rfl, reasonSame, endpointSame, _returned⟩
+
+end MicroCFTA.SourcePruningEnumerationNativeHookResources
