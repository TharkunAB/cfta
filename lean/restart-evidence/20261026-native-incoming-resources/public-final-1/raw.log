def MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Room : Nat →
  MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Profile → Prop :=
fun bits profile =>
  profile.nodes < 2 ^ bits ∧
    profile.edges ≤ 2 ^ (bits + 2) ∧
      profile.domains + 2 ^ (profile.nodes + profile.nodes * profile.nodes) < 2 ^ (bits + 1)
