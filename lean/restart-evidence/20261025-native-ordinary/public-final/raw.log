                            MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap after.core ∧
                              MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values after.waiting ∧
                                (∀ (slot : Nat),
                                    MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                                        (after.core.values[slot]?.getD
                                          MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                      some (after.expandable slot)) ∧
                                  (∀ (sc : MicroCFTA.EnumerationState.Suspended),
                                      sc ∈ scs → sc.var < after.core.counter) ∧
                                    (∀ (bucket : List MicroCFTA.EnumerationState.Suspended),
                                        MicroCFTA.EnumerationDependencies.InputsPending before.core bucket →
                                          MicroCFTA.EnumerationDependencies.InputsPending after.core bucket) ∧
                                      MicroCFTA.EnumerationDriver.RenderStable before.core after.core
