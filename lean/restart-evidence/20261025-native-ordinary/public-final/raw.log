    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot)) :
  ∃ fuel decoded after,
    (∀ (extra : Nat),
        (MicroCFTA.SourcePruningEnumerationEntry.enter heap (fuel + extra) uv before.core).run =
          [Except.ok ((uv, handle, scs, decoded), after.core)]) ∧
      MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap handle = some decoded ∧
        MicroCFTA.InternedProbeProvenance.Available heap decoded ∧
          decoded.free = [] ∧
            after.core.counter = before.core.counter ∧
              after.core.values = before.core.values ∧
                after.expandable = before.expandable ∧
                  after.waiting = before.waiting ∧
                    after.core.values[uv]? =
