  (machine : Machine Symbol Guard) (physical : SourceRecursiveIntersectionKernel.Valid machine) :
  SourceCurrentAllocatedNativePhysicalCache.Valid (initial width machine) ∧
    Contextual view model ranked holds (initial width machine)
