MicroCFTA.SourceCurrentAllocatedNativeContextualPhysicalCache.node_observed_ready {width : Nat}
  (view : IntersectSchedule.View Symbol) (model : IntersectSchedule.InputMeaning view)
  (ranked : IntersectSchedule.RankedInput view model.valid) (holds : Guard → Term Symbol → Bool)
  (request : NodeRequest Symbol Guard)
  (before chosen after : SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat)
  (result : Value Symbol Guard) (physical : SourceCurrentAllocatedNativePhysicalCache.Valid before)
  (contextual : Contextual view model ranked holds before) (ready : NodeReady before.machine request)
  (safe : SourceRecursiveIntersectionMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupNode width request before = (NodeSelection.memoized handle, chosen))
  (demanded : demandNode handle chosen = (FlatMemoThunk.Observation.ready result, after)) :
  NodeLaw view model ranked holds request result ∧
    Contextual view model ranked holds after ∧ after = chosen ∧ Available after.machine.heap result
MicroCFTA.SourceCurrentAllocatedNativeContextualPhysicalCache.edge_observed_ready {width : Nat}
  (view : IntersectSchedule.View Symbol) (model : IntersectSchedule.InputMeaning view)
  (ranked : IntersectSchedule.RankedInput view model.valid) (holds : Guard → Term Symbol → Bool)
  (request : EdgeRequest Symbol Guard)
  (before chosen after : SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat)
  (result : EdgeValue Symbol Guard) (physical : SourceCurrentAllocatedNativePhysicalCache.Valid before)
  (contextual : Contextual view model ranked holds before) (ready : EdgeReady before.machine request)
  (safe : SourceRecursiveIntersectionEdgeMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupEdge width request before = (handle, chosen))
  (demanded : demandEdge handle chosen = (FlatMemoThunk.Observation.ready result, after)) :
  EdgeLaw view model ranked holds request result ∧
    Contextual view model ranked holds after ∧
      after = chosen ∧ InternedEdgeResidency.EdgeResident after.machine.heap result
MicroCFTA.SourceCurrentAllocatedNativeContextualPhysicalCache.node_started {width : Nat}
  (view : IntersectSchedule.View Symbol) (model : IntersectSchedule.InputMeaning view)
  (ranked : IntersectSchedule.RankedInput view model.valid) (holds : Guard → Term Symbol → Bool)
  (request actual : NodeRequest Symbol Guard)
  (before chosen running : SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat)
  (physical : SourceCurrentAllocatedNativePhysicalCache.Valid before)
  (contextual : Contextual view model ranked holds before) (ready : NodeReady before.machine request)
  (safe : SourceRecursiveIntersectionMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupNode width request before = (NodeSelection.memoized handle, chosen))
  (demanded : demandNode handle chosen = (FlatMemoThunk.Observation.evaluate actual, running)) :
  actual = request ∧
    SourceCurrentAllocatedNativePhysicalCache.Valid running ∧
      Contextual view model ranked holds running ∧
        running.nodes.cells handle = some { request := request, status := FlatMemoThunk.Status.evaluating }
MicroCFTA.SourceCurrentAllocatedNativeContextualPhysicalCache.edge_started {width : Nat}
  (view : IntersectSchedule.View Symbol) (model : IntersectSchedule.InputMeaning view)
  (ranked : IntersectSchedule.RankedInput view model.valid) (holds : Guard → Term Symbol → Bool)
  (request actual : EdgeRequest Symbol Guard)
  (before chosen running : SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat)
  (physical : SourceCurrentAllocatedNativePhysicalCache.Valid before)
  (contextual : Contextual view model ranked holds before) (ready : EdgeReady before.machine request)
  (safe : SourceRecursiveIntersectionEdgeMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupEdge width request before = (handle, chosen))
  (demanded : demandEdge handle chosen = (FlatMemoThunk.Observation.evaluate actual, running)) :
  actual = request ∧
    SourceCurrentAllocatedNativePhysicalCache.Valid running ∧
      Contextual view model ranked holds running ∧
        running.edges.cells handle = some { request := request, status := FlatMemoThunk.Status.evaluating }
