MicroCFTA.SourceCurrentAllocatedNativeContextCache.NodeLaw.sound
  {view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula)}
  {model : IntersectSchedule.InputMeaning view} {ranked : IntersectSchedule.RankedInput view model.valid}
  {holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool}
  {request :
    NodeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {result : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  (self : NodeLaw view model ranked holds request result) :
  NodeInputs view model request →
    ∀ (output : InternedGuardedLanguage.Env (SourceObservations.Label FullSyntax.Formula)),
      SoundPairs model.languages request.domain.key output →
        Included (InternedGuardedLanguage.meaning holds output result) fun term =>
          IntersectSchedule.inputLanguage model.languages (SourceRecursiveIntersectionInputView.inputOf request.left)
              term ∧
            IntersectSchedule.inputLanguage model.languages (SourceRecursiveIntersectionInputView.inputOf request.right)
              term
MicroCFTA.SourceCurrentAllocatedNativeContextCache.NodeLaw.complete
  {view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula)}
  {model : IntersectSchedule.InputMeaning view} {ranked : IntersectSchedule.RankedInput view model.valid}
  {holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool}
  {request :
    NodeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {result : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  (self : NodeLaw view model ranked holds request result) :
  NodeInputs view model request →
    ∀ (bound : Nat) (output : InternedGuardedLanguage.Env (SourceObservations.Label FullSyntax.Formula)),
      CompletePairs ranked.languages bound request.domain.key output →
        ∀ (first second : Nat),
          first + second ≤ bound →
            ∀ (term : Term (SourceObservations.Label FullSyntax.Formula)),
              IntersectSchedule.inputAt ranked.languages (SourceRecursiveIntersectionInputView.inputOf request.left)
                  first term →
                IntersectSchedule.inputAt ranked.languages (SourceRecursiveIntersectionInputView.inputOf request.right)
                    second term →
                  InternedGuardedLanguage.meaning holds output result term
MicroCFTA.SourceCurrentAllocatedNativeContextCache.EdgeLaw.sound
  {view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula)}
  {model : IntersectSchedule.InputMeaning view} {ranked : IntersectSchedule.RankedInput view model.valid}
  {holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool}
  {request :
    EdgeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {result : EdgeValue (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  (self : EdgeLaw view model ranked holds request result) :
  EdgeInputs view model request →
    ∀ (output : InternedGuardedLanguage.Env (SourceObservations.Label FullSyntax.Formula)),
      SoundPairs model.languages request.domain.key output →
        Included (InternedGuardedLanguage.edgeMeaning holds output result) fun term =>
          RowLanguage holds model.languages request.left term ∧ RowLanguage holds model.languages request.right term
MicroCFTA.SourceCurrentAllocatedNativeContextCache.EdgeLaw.complete
  {view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula)}
  {model : IntersectSchedule.InputMeaning view} {ranked : IntersectSchedule.RankedInput view model.valid}
  {holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool}
  {request :
    EdgeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {result : EdgeValue (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  (self : EdgeLaw view model ranked holds request result) :
  EdgeInputs view model request →
    ∀ (bound : Nat) (output : InternedGuardedLanguage.Env (SourceObservations.Label FullSyntax.Formula)),
      CompletePairs ranked.languages bound request.domain.key output →
        ∀ (first second : Nat),
          first + second ≤ bound →
            ∀ (term : Term (SourceObservations.Label FullSyntax.Formula)),
              RowAt holds ranked.languages first request.left term →
                RowAt holds ranked.languages second request.right term →
                  InternedGuardedLanguage.edgeMeaning holds output result term
