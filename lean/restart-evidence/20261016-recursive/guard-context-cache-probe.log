MicroCFTA.SourceCurrentAllocatedNativeContextCache.node_observed_ready
  (view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula))
  (model : IntersectSchedule.InputMeaning view) (ranked : IntersectSchedule.RankedInput view model.valid)
  (holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool)
  {width : Nat} [DecidableEq (SourceObservations.Label FullSyntax.Formula)]
  [DecidableEq
      (EdgeKey (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  (before chosen after :
    SourceRecursiveIntersectionThunks.State width (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (request :
    NodeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (handle : Nat)
  (result : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (physical : SourceEqualityNativeDemandProvenance.Valid holds before)
  (valid : Contextual view model ranked holds before) (ready : NodeReady before.machine request)
  (safe : SourceRecursiveIntersectionMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupNode width request before = (NodeSelection.memoized handle, chosen))
  (demanded : demandNode handle chosen = (FlatMemoThunk.Observation.ready result, after)) :
  NodeLaw view model ranked holds request result ∧ after = chosen
MicroCFTA.SourceCurrentAllocatedNativeContextCache.edge_observed_ready
  (view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula))
  (model : IntersectSchedule.InputMeaning view) (ranked : IntersectSchedule.RankedInput view model.valid)
  (holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool)
  {width : Nat} [DecidableEq (SourceObservations.Label FullSyntax.Formula)]
  [DecidableEq
      (EdgeKey (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  (before chosen after :
    SourceRecursiveIntersectionThunks.State width (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (request :
    EdgeRequest (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (handle : Nat)
  (result : EdgeValue (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (physical : SourceEqualityNativeDemandProvenance.Valid holds before)
  (valid : Contextual view model ranked holds before) (ready : EdgeReady before.machine request)
  (safe : SourceRecursiveIntersectionEdgeMemo.KeySafe width request.domain request.left request.right)
  (selected : lookupEdge width request before = (handle, chosen))
  (demanded : demandEdge handle chosen = (FlatMemoThunk.Observation.ready result, after)) :
  EdgeLaw view model ranked holds request result ∧ after = chosen
