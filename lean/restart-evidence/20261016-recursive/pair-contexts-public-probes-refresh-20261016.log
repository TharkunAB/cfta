@MicroCFTA.SourceCurrentAllocatedNativePairContexts.sound_extend_candidate : ∀ {Symbol : Type}
  (languages : Nat → MicroCFTA.BinderLanguage.Lang Symbol) (domain : MicroCFTA.IntersectionFlatMemoKeyDomain.DomainKey)
  (output : MicroCFTA.InternedGuardedLanguage.Env Symbol),
  MicroCFTA.SourceCurrentAllocatedNativePairContexts.SoundPairs languages domain output →
    ∀ (bindings : List Nat) (key : Nat × Nat),
      ¬key ∈ domain.seen →
        ∀ (candidate : MicroCFTA.BinderLanguage.Lang Symbol),
          MicroCFTA.BinderLanguage.Included candidate
              (MicroCFTA.SourceCurrentAllocatedNativePairContexts.PairLanguage languages key) →
            MicroCFTA.SourceCurrentAllocatedNativePairContexts.SoundPairs languages
              (MicroCFTA.SourceRecursiveIntersectionDomain.extend domain bindings key)
              (MicroCFTA.InternedGuardedLanguage.bind output
                (MicroCFTA.InternedBinderProtocol.Reference.intersection key.fst key.snd) candidate)
