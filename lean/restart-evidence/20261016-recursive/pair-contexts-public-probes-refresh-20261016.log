@MicroCFTA.SourceCurrentAllocatedNativePairContexts.sound_restrict : ∀ {Symbol : Type}
  (languages : Nat → MicroCFTA.BinderLanguage.Lang Symbol)
  (before after : MicroCFTA.IntersectionFlatMemoKeyDomain.DomainKey)
  (output : MicroCFTA.InternedGuardedLanguage.Env Symbol),
  (∀ (key : Nat × Nat), key ∈ before.seen → key ∈ after.seen) →
    MicroCFTA.SourceCurrentAllocatedNativePairContexts.SoundPairs languages after output →
      MicroCFTA.SourceCurrentAllocatedNativePairContexts.SoundPairs languages before output
