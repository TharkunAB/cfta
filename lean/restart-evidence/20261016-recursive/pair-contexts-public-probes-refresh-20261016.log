@MicroCFTA.SourceCurrentAllocatedNativePairContexts.ranked_pair_exact : ∀ {Symbol : Type}
  (languages : Nat → MicroCFTA.BinderLanguage.Lang Symbol) (ranks : Nat → Nat → MicroCFTA.BinderLanguage.Lang Symbol),
  (∀ (name : Nat) (term : MicroCFTA.Language.Term Symbol), languages name term ↔ ∃ rank, ranks name rank term) →
    ∀ (key : Nat × Nat) (term : MicroCFTA.Language.Term Symbol),
      MicroCFTA.SourceCurrentAllocatedNativePairContexts.PairLanguage languages key term ↔
        ∃ bound, MicroCFTA.SourceCurrentAllocatedNativePairContexts.RankedPair ranks bound key term
@MicroCFTA.SourceCurrentAllocatedNativePairContexts.repeated_reference_exact : ∀ {Symbol Guard : Type}
  (holds : Guard → MicroCFTA.Language.Term Symbol → Bool) (languages : Nat → MicroCFTA.BinderLanguage.Lang Symbol)
  (ranks : Nat → Nat → MicroCFTA.BinderLanguage.Lang Symbol),
  (∀ (name : Nat) (term : MicroCFTA.Language.Term Symbol), languages name term ↔ ∃ rank, ranks name rank term) →
    ∀ (domain : MicroCFTA.IntersectionFlatMemoKeyDomain.DomainKey)
      (output : MicroCFTA.InternedGuardedLanguage.Env Symbol),
      MicroCFTA.SourceCurrentAllocatedNativePairContexts.SoundPairs languages domain output →
        (∀ (bound : Nat), MicroCFTA.SourceCurrentAllocatedNativePairContexts.CompletePairs ranks bound domain output) →
          ∀ (key : Nat × Nat),
            key ∈ domain.seen →
              ∀ (term : MicroCFTA.Language.Term Symbol),
                MicroCFTA.InternedGuardedLanguage.meaning holds output
                    (MicroCFTA.SourceRecursiveIntersectionControl.repeatedValue key) term ↔
                  MicroCFTA.SourceCurrentAllocatedNativePairContexts.PairLanguage languages key term
@MicroCFTA.SourceCurrentAllocatedNativePairContexts.finite_ranks_exact : ∀ {Symbol : Type}
  (view : MicroCFTA.IntersectSchedule.View Symbol) (inputs : MicroCFTA.IntersectSchedule.FiniteInput view) (name : Nat)
  (term : MicroCFTA.Language.Term Symbol),
  MicroCFTA.IntersectSchedule.finiteLanguages view inputs name term ↔
    ∃ rank, MicroCFTA.IntersectSchedule.finiteRanks view inputs name rank term
@MicroCFTA.SourceCurrentAllocatedNativePairContexts.source_input_models : ∀ {Symbol Guard : Type}
  (source : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.InternedNestedFacts.Facts source →
    ∀ (holds : Guard → MicroCFTA.Language.Term Symbol → Bool)
      (left right : MicroCFTA.InternedConstructorTemplates.Value Symbol Guard),
      MicroCFTA.SourceRecursiveIntersectionInputView.Original left →
        MicroCFTA.SourceRecursiveIntersectionInputView.Original right →
          MicroCFTA.InternedProbeProvenance.Available source left →
            MicroCFTA.InternedProbeProvenance.Available source right →
              left.free = [] →
                right.free = [] →
                  ∃ model ranked,
                    model.valid (MicroCFTA.SourceRecursiveIntersectionInputView.inputOf left) ∧
                      model.valid (MicroCFTA.SourceRecursiveIntersectionInputView.inputOf right) ∧
                        (∀ (name : Nat) (term : MicroCFTA.Language.Term Symbol),
                            model.languages name term ↔ ∃ rank, ranked.languages name rank term) ∧
                          (∀ (ambient : MicroCFTA.InternedGuardedLanguage.Env Symbol)
                              (term : MicroCFTA.Language.Term Symbol),
                              MicroCFTA.InternedGuardedLanguage.meaning holds ambient left term ↔
                                MicroCFTA.IntersectSchedule.inputLanguage model.languages
                                  (MicroCFTA.SourceRecursiveIntersectionInputView.inputOf left) term) ∧
                            ∀ (ambient : MicroCFTA.InternedGuardedLanguage.Env Symbol)
                              (term : MicroCFTA.Language.Term Symbol),
                              MicroCFTA.InternedGuardedLanguage.meaning holds ambient right term ↔
                                MicroCFTA.IntersectSchedule.inputLanguage model.languages
                                  (MicroCFTA.SourceRecursiveIntersectionInputView.inputOf right) term
MicroCFTA.SourceCurrentAllocatedNativePairContexts.unrestricted_extension_impossible : ∀
  (holds :
    MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula →
      MicroCFTA.Language.Term (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula) → Bool)
  (source :
    MicroCFTA.InternedConstructorTemplates.State (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
  (input output :
    MicroCFTA.InternedGuardedLanguage.Env (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula))
  (domain : MicroCFTA.IntersectionFlatMemoKeyDomain.DomainKey) (bindings : List Nat) (key : Nat × Nat)
  (symbol : MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula),
  ¬∀ (candidate : MicroCFTA.BinderLanguage.Lang (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)),
      MicroCFTA.SourceEqualityNativeDemandOpenMeaning.SeenContext holds source input
        (MicroCFTA.InternedGuardedLanguage.bind output
          (MicroCFTA.InternedBinderProtocol.Reference.intersection key.fst key.snd) candidate)
        (MicroCFTA.SourceRecursiveIntersectionDomain.extend domain bindings key)
