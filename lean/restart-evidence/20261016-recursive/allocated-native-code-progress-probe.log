MicroCFTA.SourceCurrentAllocatedNativeCodeProgress.body_prefix {width : Nat} [DecidableEq Symbol]
  [DecidableEq (EdgeKey Symbol Guard)] (source : InternedConstructorTemplates.State Symbol Guard)
  (facts : InternedNestedFacts.Facts source) (holds : Guard → Language.Term Symbol → Bool)
  (request : EdgeRequest Symbol Guard) (scope : EdgeScope source request)
  (complete :
    IntersectSchedule.Completes (view source holds) (SourceRecursiveIntersectionNative.edgeSemantic holds request))
  (before : SourceEqualityNativeDemand.State width)
  (valid : SourceRecursiveIntersectionKernel.Valid before.native.machine)
  (ready : EdgeReady before.native.machine request)
  (operations : SourceEqualityConstraintMemoAllocation.Valid before.operations)
  (heap : SourceCurrentConjunctionEquality.Fields before.operations before.native.machine.heap) :
  ∃ code after,
    SourceEqualityNativeDemand.body request Code.pure before =
        Outcome.yielded (Control.code code) { native := before.native, operations := after } ∧
      SourceEqualityConstraintMemoAllocation.Valid after ∧
        SourceEqualityConstraintMemoAllocation.Grows before.operations after ∧
          SourceCurrentConjunctionEquality.Fields after before.native.machine.heap ∧
            SourceCurrentAllocatedNativeCodeFields.Fields after code ∧
              (Safe code before.native.machine fun final value => InternedEdgeResidency.EdgeResident final.heap value) ∧
                Operands code before.native.machine ∧
                  Below source holds
                    (IntersectSchedule.requiredFuel (view source holds)
                      (SourceRecursiveIntersectionNative.edgeSemantic holds request) complete)
                    code before.native.machine
MicroCFTA.SourceCurrentAllocatedNativeCodeProgress.node_certified {width : Nat} [DecidableEq Symbol]
  [DecidableEq (EdgeKey Symbol Guard)] (source : InternedConstructorTemplates.State Symbol Guard)
  (facts : InternedNestedFacts.Facts source) (holds : Guard → Language.Term Symbol → Bool)
  (request : NodeRequest Symbol Guard) (scope : NodeScope source request)
  (complete : IntersectSchedule.Completes (view source holds) (SourceRecursiveIntersectionNative.nodeSemantic request))
  (before : SourceEqualityNativeDemand.State width)
  (valid : SourceRecursiveIntersectionKernel.Valid before.native.machine)
  (ready : NodeReady before.native.machine request) (growth : Grows source before.native.machine.heap)
  (history : Extends source.nodes.issued before.native.machine.heap.nodes.issued) :
  (Safe (compileNode request) before.native.machine fun final value => Available final.heap value) ∧
    Operands (compileNode request) before.native.machine ∧
      Below source holds
          (IntersectSchedule.requiredFuel (view source holds) (SourceRecursiveIntersectionNative.nodeSemantic request)
            complete)
          (compileNode request) before.native.machine ∧
        SourceCurrentAllocatedNativeCodeFields.Fields before.operations (compileNode request)
MicroCFTA.SourceCurrentAllocatedNativeCodeProgress.initial_certified {width : Nat} [DecidableEq Symbol]
  [DecidableEq (EdgeKey Symbol Guard)] (holds : Guard → Language.Term Symbol → Bool)
  (before : SourceEqualityNativeDemand.State width)
  (valid : SourceRecursiveIntersectionKernel.Valid before.native.machine) (left right : Value Symbol Guard)
  (leftOriginal : Original left) (rightOriginal : Original right)
  (leftAvailable : Available before.native.machine.heap left)
  (rightAvailable : Available before.native.machine.heap right) (leftClosed : left.free = [])
  (rightClosed : right.free = []) :
  have request := { domain := IntersectionEmptyDomain.emptyDomain, left := left, right := right };
  ∃ complete,
    (Safe (compileNode request) before.native.machine fun final value => Available final.heap value) ∧
      Operands (compileNode request) before.native.machine ∧
        Below before.native.machine.heap holds
            (IntersectSchedule.requiredFuel (view before.native.machine.heap holds)
              (SourceRecursiveIntersectionNative.nodeSemantic request) complete)
            (compileNode request) before.native.machine ∧
          SourceCurrentAllocatedNativeCodeFields.Fields before.operations (compileNode request)
