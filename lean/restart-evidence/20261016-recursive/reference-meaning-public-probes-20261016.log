bindings_available : ∀
  (source :
    InternedConstructorTemplates.State (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (domain : IntersectionFlatMemoKeyDomain.DomainKey),
  OriginalBindings source domain → SourceRecursiveIntersectionDomain.AvailableBindings source domain
bound_original : ∀
  (source :
    InternedConstructorTemplates.State (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
  InternedNestedFacts.Facts source →
    ∀ (domain : IntersectionFlatMemoKeyDomain.DomainKey),
      OriginalBindings source domain →
        ∀ (entry : Interned InternedBinderProtocol.NodeKey)
          (body depth ordinary :
            Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
          Available source (Value.mu entry body depth ordinary) →
            entry.identity ∈ SourceRecursiveIntersectionDomain.names domain →
              Original (Value.mu entry body depth ordinary)
bound_record : ∀
  (source :
    InternedConstructorTemplates.State (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
  InternedNestedFacts.Facts source →
    ∀ (domain : IntersectionFlatMemoKeyDomain.DomainKey),
      SourceRecursiveIntersectionDomain.Typed domain →
        OriginalBindings source domain →
          ∀ (name : Nat),
            name ∈ SourceRecursiveIntersectionDomain.names domain →
              ∃ entry body depth ordinary,
                entry.identity = name ∧
                  Original (Value.mu entry body depth ordinary) ∧
                    Available source (Value.mu entry body depth ordinary) ∧
                      SourceRecursiveIntersectionDomain.keyLookup domain name = some (NodeRef.mu name) ∧
                        IntersectSchedule.lookup (SourceRecursiveIntersectionSchedule.domain domain) name =
                            some (IntersectSchedule.Input.mu name) ∧
                          SourceRecursiveIntersectionDomain.lookup source domain name =
                              some (Value.mu entry body depth ordinary) ∧
                            SourcePreparedSharedRows.read source name = some (Value.mu entry body depth ordinary)
left_inputs : ∀ (view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula))
  (model : IntersectSchedule.InputMeaning view) (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey) (name : Nat)
  (other : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (entry : Interned InternedBinderProtocol.NodeKey)
  (body depth ordinary :
    Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
  entry.identity = name →
    Original (Value.mu entry body depth ordinary) →
      NodeInputs view model { domain := domain, left := Value.reference (Reference.interned name), right := other } →
        NodeInputs view model { domain := domain, left := Value.mu entry body depth ordinary, right := other }
right_inputs : ∀ (view : IntersectSchedule.View (SourceObservations.Label FullSyntax.Formula))
  (model : IntersectSchedule.InputMeaning view) (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey) (name : Nat)
  (other : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (entry : Interned InternedBinderProtocol.NodeKey)
  (body depth ordinary :
