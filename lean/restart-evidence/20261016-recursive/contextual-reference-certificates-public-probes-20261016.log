'MicroCFTA.SourceCurrentAllocatedNativeContextualReferenceCertificates.resolve' depends on axioms: [propext, Quot.sound]
'MicroCFTA.SourceCurrentAllocatedNativeContextualReferenceCertificates.left_code' depends on axioms: [propext,
 Quot.sound]
'MicroCFTA.SourceCurrentAllocatedNativeContextualReferenceCertificates.right_code' depends on axioms: [propext,
