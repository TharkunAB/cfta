resolve : ∀
  (source current :
    InternedConstructorTemplates.State (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
  InternedNestedFacts.Facts current →
    Grows source current →
      Extends source.nodes.issued current.nodes.issued →
        ∀ (domain : IntersectionFlatMemoKeyDomain.DomainKey),
          OriginalBindings source domain →
            ∀ (name : Nat),
              name ∈ SourceRecursiveIntersectionDomain.names domain →
                ∃ entry body depth ordinary,
                  entry.identity = name ∧
                    Original (Value.mu entry body depth ordinary) ∧
                      Available source (Value.mu entry body depth ordinary) ∧
                        SourcePreparedSharedRows.read current name = some (Value.mu entry body depth ordinary)
@left_code : ∀
  [inst :
    DecidableEq
      (EdgeKey (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  (source :
    InternedConstructorTemplates.State (SourceObservations.Label FullSyntax.Formula)
      (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (holds :
    SourceSymbolicIndex.Constraint FullSyntax.Formula → Term (SourceObservations.Label FullSyntax.Formula) → Bool)
  (model : IntersectSchedule.InputMeaning (view source holds))
  (ranked : IntersectSchedule.RankedInput (view source holds) model.valid)
  (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey),
  OriginalBindings source domain.key →
    ∀ (name : Nat)
      (other : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
      (state :
        Machine (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)),
      SourceRecursiveIntersectionKernel.Valid state →
        Grows source state.heap →
          Extends source.nodes.issued state.heap.nodes.issued →
            Certified (view source holds) model ranked holds (compileReference domain name other true) state
              fun x result =>
              NodeLaw (view source holds) model ranked holds
                { domain := domain, left := Value.reference (InternedBinderProtocol.Reference.interned name),
                  right := other }
                result
