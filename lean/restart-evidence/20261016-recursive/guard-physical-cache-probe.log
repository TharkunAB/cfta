MicroCFTA.SourceCurrentAllocatedNativePhysicalCache.node_ready {width : Nat} {Symbol Guard : Type}
  (request : NodeRequest Symbol Guard)
  (before chosen after : SourceRecursiveIntersectionThunks.State width Symbol Guard) (handle : Nat)
  (value : Value Symbol Guard) (valid : SourceCurrentAllocatedNativePhysicalCache.Valid before)
  (ready : NodeReady before.machine request)
  (safe : SourceRecursiveIntersectionMemo.KeySafe width request.domain request.left request.right)
