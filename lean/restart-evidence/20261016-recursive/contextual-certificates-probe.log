@SourceCurrentAllocatedNativeContextualCertificates.node_walk_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  (view : IntersectSchedule.View Symbol) (model : IntersectSchedule.InputMeaning view)
  (ranked : IntersectSchedule.RankedInput view model.valid) (holds : Guard → Term Symbol → Bool) {A : Type}
  (request : A → NodeRequest Symbol Guard) (inputs : List A) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
      Certified view model ranked holds
        (SourceRecursiveIntersectionCode.walk (fun input => Code.node (request input) Code.pure) inputs) state
        fun after values =>
        InternedNestedProvenance.Values after.heap values ∧
          All₂ (fun input value => NodeLaw view model ranked holds (request input) value) inputs values
