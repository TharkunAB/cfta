@SourceCurrentAllocatedNativeContextualCompletion.initial_complete : ∀ {width : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) (state : Checked width),
  Good state →
    ∀ (inputModel : InputMeaning (view state.native.machine.heap (SourceEqualityPCSGuard.holds formulas solver)))
      (inputRanked :
        RankedInput (view state.native.machine.heap (SourceEqualityPCSGuard.holds formulas solver)) inputModel.valid),
      SourceCurrentAllocatedNativeContextCache.Contextual
          (view state.native.machine.heap (SourceEqualityPCSGuard.holds formulas solver)) inputModel inputRanked
          (SourceEqualityPCSGuard.holds formulas solver) state.native →
        SemanticReady state.native.machine.heap →
          SourceRecursiveIntersectionNative.Idle state.native →
            ∀ (left right : Value Symbol Guard),
              Original left →
                Original right →
                  Available state.native.machine.heap left →
                    Available state.native.machine.heap right →
                      left.free = [] →
                        right.free = [] →
                          WordRanges (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) state →
                            ∃ fuel value after,
                              (SourceCurrentAllocatedNativeContextualCompletion.Receipt fuel
                                  (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) state
                                  value after (fun final value => Available final.heap value) fun x value =>
                                  SourceCurrentAllocatedNativeContextCache.NodeLaw
                                    (view state.native.machine.heap (SourceEqualityPCSGuard.holds formulas solver))
                                    inputModel inputRanked (SourceEqualityPCSGuard.holds formulas solver)
                                    { domain := IntersectionEmptyDomain.emptyDomain, left := left, right := right }
                                    value) ∧
                                SourceRecursiveIntersectionNative.Idle after.native
@SourceCurrentAllocatedNativeContextualCompletion.cold_complete : ∀ {width : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) (machine : Machine Symbol Guard)
  (operations : SourceEqualityConstraintMemoAllocation.State),
  Good { native := initial width machine, operations := operations } →
    SemanticReady machine.heap →
      ∀ (left right : Value Symbol Guard),
        Original left →
          Original right →
            Available machine.heap left →
              Available machine.heap right →
                left.free = [] →
                  right.free = [] →
                    WordRanges (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right))
                        { native := initial width machine, operations := operations } →
                      ∃ inputModel inputRanked fuel value after,
                        (SourceCurrentAllocatedNativeContextualCompletion.Receipt fuel
                            (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right))
                            { native := initial width machine, operations := operations } value after
                            (fun final value => Available final.heap value) fun x value =>
                            SourceCurrentAllocatedNativeContextCache.NodeLaw
                              (view machine.heap (SourceEqualityPCSGuard.holds formulas solver)) inputModel inputRanked
                              (SourceEqualityPCSGuard.holds formulas solver)
                              { domain := IntersectionEmptyDomain.emptyDomain, left := left, right := right } value) ∧
                          SourceRecursiveIntersectionNative.Idle after.native ∧
                            ∀ (output : InternedGuardedLanguage.Env Symbol) (term : Term Symbol),
                              InternedGuardedLanguage.meaning (SourceEqualityPCSGuard.holds formulas solver) output
                                  value term ↔
                                InternedGuardedLanguage.meaning (SourceEqualityPCSGuard.holds formulas solver) output
                                    left term ∧
                                  InternedGuardedLanguage.meaning (SourceEqualityPCSGuard.holds formulas solver) output
                                    right term
