@SourceCurrentAllocatedNativeScopedCertificates.prefix_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  {width : Nat} [inst_1 : DecidableEq Symbol] (request : EdgeRequest Symbol Guard)
  (before : SourceEqualityNativeDemand.State width) (code : Code Symbol Guard (EdgeValue Symbol Guard))
  (operations : SourceEqualityConstraintMemoAllocation.State),
  SourceRecursiveIntersectionKernel.Valid before.native.machine →
    SourceEqualityRequiredSemanticCache.SemanticReady before.native.machine.heap →
      SourceEqualityNativeDemand.step (SourceEqualityNativeDemand.Control.edgeBody request Code.pure) before =
          SourceEqualityNativeDemand.Outcome.yielded (SourceEqualityNativeDemand.Control.code code)
            { native := before.native, operations := operations } →
        Certified code before.native.machine fun x value =>
          SourceRecursiveIntersectionResultScope.EdgeScope request.domain.key.seen value
