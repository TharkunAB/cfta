@SourceCurrentAllocatedNativeScopedCertificates.node_walk_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  {A : Type u_1} (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey)
  (operands : A → Value Symbol Guard × Value Symbol Guard) (inputs : List A) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
      Certified
        (SourceRecursiveIntersectionCode.walk
          (fun input => requestNode domain (operands input).fst (operands input).snd) inputs)
        state fun after values =>
        InternedNestedProvenance.Values after.heap values ∧
          ∀ (value : Value Symbol Guard), value ∈ values → Scope domain.key.seen value
@SourceCurrentAllocatedNativeScopedCertificates.edge_walk_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  {A : Type u_1} (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey)
  (operands : A → EdgeValue Symbol Guard × EdgeValue Symbol Guard) (inputs : List A) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
      Certified
        (SourceRecursiveIntersectionCode.walk
          (fun input => requestEdge domain (operands input).fst (operands input).snd) inputs)
        state fun after values =>
        InternedNestedProvenance.Edges after.heap values ∧
          ∀ (value : EdgeValue Symbol Guard),
            value ∈ values → SourceRecursiveIntersectionResultScope.EdgeScope domain.key.seen value
@SourceCurrentAllocatedNativeScopedCertificates.compileRows_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  [inst_1 : DecidableEq Symbol] (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey)
