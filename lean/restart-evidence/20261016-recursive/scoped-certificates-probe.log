@SourceCurrentAllocatedNativeScopedCertificates.left_union_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey) (members : List (Value Symbol Guard))
  (right : Value Symbol Guard) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
      Certified
        ((SourceRecursiveIntersectionCode.walk (fun member => requestNode domain member right) members).bind
          fun values => Code.work (makeUnion values) Code.pure)
        state fun x value => Scope domain.key.seen value
@SourceCurrentAllocatedNativeScopedCertificates.right_union_certified : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)]
  (domain : Interned IntersectionFlatMemoKeyDomain.DomainKey) (members : List (Value Symbol Guard))
  (left : Value Symbol Guard) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SourceEqualityRequiredSemanticCache.SemanticReady state.heap →
      Certified
        ((SourceRecursiveIntersectionCode.walk (fun member => requestNode domain left member) members).bind
          fun values => Code.work (makeUnion values) Code.pure)
        state fun x value => Scope domain.key.seen value
