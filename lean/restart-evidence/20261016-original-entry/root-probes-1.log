MicroCFTA.SourceCurrentAllocatedNativeConstructedHistory.query_complete {width : Nat} [DecidableEq Symbol]
  [DecidableEq (EdgeKey Symbol Guard)] {initialCache finalCache : Cache.State Key} {originals : List Guard}
  (history : SourceEqualityOriginalAllocationHistory.History initialCache finalCache originals)
  (initialValid : Cache.Valid initialCache) (expression : InternedNestedConstruction.Syntax Symbol Guard)
  (covered : ∀ (original : Guard), original ∈ SourceEqualityConstraintOrigins.guards expression → original ∈ originals)
  (value : Value Symbol Guard) (heap : InternedConstructorTemplates.State Symbol Guard)
  (built :
    InternedFreshOrdinaryConstruction.build expression [] empty = InternedNestedConstruction.Outcome.done value heap)
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  (pairs : List (Value Symbol Guard × Value Symbol Guard))
  (available : Values heap (SourceCurrentAllocatedNativeColdHistoryExact.operands pairs))
  (closed :
    ∀ (operand : Value Symbol Guard),
      operand ∈ SourceCurrentAllocatedNativeColdHistoryExact.operands pairs → operand.free = [])
  (ranges :
    WordRanges (Control.code (SourceCurrentAllocatedNativeWarmHistory.program pairs))
      { native := initial width { heap := heap, domains := emptyState },
        operations := SourceEqualityConstraintMemoAllocation.initial finalCache }) :
  ∃ inputs fuel values after,
    SourceCurrentAllocatedNativeWarmHistory.Receipt heap formulas solver inputs fuel pairs
      { native := initial width { heap := heap, domains := emptyState },
        operations := SourceEqualityConstraintMemoAllocation.initial finalCache }
      values after
MicroCFTA.SourceCurrentAllocatedNativePreparedHistory.query_complete {width : Nat} [DecidableEq Symbol]
