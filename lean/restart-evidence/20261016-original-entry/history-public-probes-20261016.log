@History.cached : ∀ {Formula : Type} {initial final : Cache.State SourceEqualityPartialConstraintKey.Key}
  {originals : List (SourceSymbolicIndex.Constraint Formula)},
  History initial final originals →
    ∀ (original : SourceSymbolicIndex.Constraint Formula),
      original ∈ originals → SourceEqualityGuardReadback.Cached original.equalities
@History.cached_inventory : ∀ {Formula Symbol : Type}
  {initial final : Cache.State SourceEqualityPartialConstraintKey.Key}
  {originals : List (SourceSymbolicIndex.Constraint Formula)},
  History initial final originals →
    ∀ (expression : InternedNestedConstruction.Syntax Symbol (SourceSymbolicIndex.Constraint Formula)),
      (∀ (original : SourceSymbolicIndex.Constraint Formula),
          original ∈ SourceEqualityConstraintOrigins.guards expression → original ∈ originals) →
        ∀ (original : SourceSymbolicIndex.Constraint Formula),
          original ∈ SourceEqualityConstraintOrigins.guards expression →
            SourceEqualityGuardReadback.Cached original.equalities
@History.syntax_valid : ∀ {Formula Symbol : Type} {initial final : Cache.State SourceEqualityPartialConstraintKey.Key}
  {originals : List (SourceSymbolicIndex.Constraint Formula)},
  History initial final originals →
    ∀ (expression : InternedNestedConstruction.Syntax Symbol (SourceSymbolicIndex.Constraint Formula)),
      (∀ (original : SourceSymbolicIndex.Constraint Formula),
          original ∈ SourceEqualityConstraintOrigins.guards expression → original ∈ originals) →
        InternedFreshOrdinaryConstraintHeap.SyntaxValid
