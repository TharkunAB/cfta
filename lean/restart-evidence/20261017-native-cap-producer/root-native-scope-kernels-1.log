                @Cap Symbol Guard annotation depth right →
                  @Eq.{1} (List.{0} Reference) (@Value.free Symbol Guard left) (@List.nil.{0} Reference) →
                    @Eq.{1} (List.{0} Reference) (@Value.free Symbol Guard right) (@List.nil.{0} Reference) →
                      ∀ (cache : Cache.State DomainKey),
