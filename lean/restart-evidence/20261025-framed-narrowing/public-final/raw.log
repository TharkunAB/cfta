                              MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                    representativeFuel uv oldHandle scs oldValue caller.checked.native.machine.heap =
                                  MicroCFTA.MergedSourceComparison.Result.done
                                    (result, some MicroCFTA.EnumerationState.reject) heap ∧
                                ¬∃ after,
                                    MicroCFTA.EnumerationCorrectness.Success MicroCFTA.EnumerationState.reject entry ()
                                      after) ∧
                          (result ≠ MicroCFTA.InternedConstructorTemplates.Value.empty →
                            ∃ representativeFuel countFuel action after,
                              MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                    representativeFuel uv oldHandle scs oldValue caller.checked.native.machine.heap =
                                  MicroCFTA.MergedSourceComparison.Result.done (result, some action) heap ∧
                                MicroCFTA.EnumerationCorrectness.Success action entry () after.core ∧
                                  (newHandle = oldHandle ∧
                                        after = MicroCFTA.EnumerationExpandableIndex.frame entry before ∨
                                      newHandle ≠ oldHandle ∧
                                        ∃ reentry,
                                          MicroCFTA.EnumerationCorrectness.Success
                                              (MicroCFTA.EnumerationState.representative representativeFuel uv) entry uv
                                              reentry ∧
                                            MicroCFTA.EnumerationCorrectness.Success
                                                (MicroCFTA.EnumerationState.setValue uv
                                                  (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                    scs))
                                                reentry () after.core ∧
                                              ∀ (extra : Nat),
                                                MicroCFTA.SourcePruningEnumerationNativeIndex.write
                                                    afterCaller.checked.native.machine.heap (countFuel + extra) uv
                                                    (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                      scs)
                                                    scs scs
                                                    (MicroCFTA.EnumerationExpandableIndex.frame reentry before) =
                                                  some after) ∧
                                    after.waiting = before.waiting ∧
                                      MicroCFTA.EnumerationDriver.Ready uv after.core ∧
                                        MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                                          MicroCFTA.SourcePruningEnumerationObservation.PendingRealized
                                              afterCaller.checked.native.machine.heap after.core ∧
                                            after.core.values[uv]? =
                                                some
                                                  (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle)
                                                    scs) ∧
