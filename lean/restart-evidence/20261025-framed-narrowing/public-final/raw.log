MicroCFTA.SourcePruningEnumerationReplacement.after_frame {EnumGuard NativeGuard : Type}
  (heap nextHeap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (kept : MicroCFTA.SourceEqualityRequiredCache.Keeps heap nextHeap)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readAfter entry rereadAfter after :
    MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readFuel rereadFuel uv root oldHandle newHandle : Nat) (scs : List MicroCFTA.EnumerationState.Suspended)
  (value : MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (roots : Nat → Nat) (ready : MicroCFTA.EnumerationDriver.Ready uv before.core)
  (paths : MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots)
  (realized : MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap before.core)
  (decoded : MicroCFTA.SourcePruningEnumerationNodes.lookupNode nextHeap newHandle = some value)
  (available : MicroCFTA.InternedProbeProvenance.Available nextHeap value) (closed : value.free = [])
  (counts : MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting)
  (flags :
    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot))
  (read :
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.getValue readFuel uv) before.core
      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) readAfter)
  (entered : MicroCFTA.EnumerationCompressionFrame.Frame readAfter entry)
  (entryReady : MicroCFTA.EnumerationDriver.Ready uv entry)
  (reread :
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.representative rereadFuel uv) entry root
      rereadAfter)
  (written :
    MicroCFTA.EnumerationCorrectness.Success
      (MicroCFTA.EnumerationState.setValue root
        (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs))
      rereadAfter () after) :
  root = uv ∧
    MicroCFTA.EnumerationCompressionFrame.Frame before.core rereadAfter ∧
      ∃ fuel cached,
        (∀ (extra : Nat),
            MicroCFTA.SourcePruningEnumerationNativeIndex.write nextHeap (fuel + extra) uv
                (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs) scs scs
                (MicroCFTA.EnumerationExpandableIndex.frame rereadAfter before) =
              some cached) ∧
          cached.core = after ∧
            cached.waiting = before.waiting ∧
              (cached.expandable = fun slot =>
                  if slot = uv then !(MicroCFTA.MergedOrdinaryHeight.recursiveBoundary value && scs.isEmpty)
                  else before.expandable slot) ∧
                MicroCFTA.EnumerationDriver.Ready uv after ∧
                  MicroCFTA.EnumerationSchedule.Roots after.representatives roots ∧
                    MicroCFTA.SourcePruningEnumerationObservation.PendingRealized nextHeap after ∧
                      after.values[uv]? =
                          some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs) ∧
                        MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.values cached.waiting ∧
                          (∀ (slot : Nat),
                              MicroCFTA.SourcePruningEnumerationNativeIndex.candidate nextHeap
                                  (after.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                some (cached.expandable slot)) ∧
                            (MicroCFTA.EnumerationReferences.PendingReferences before.core →
                                MicroCFTA.EnumerationReferences.PendingReferences after) ∧
                              ∀ (held : Nat),
                                MicroCFTA.EnumerationReferences.IncomingAvoid held before.core →
                                  MicroCFTA.EnumerationReferences.IncomingAvoid held after
