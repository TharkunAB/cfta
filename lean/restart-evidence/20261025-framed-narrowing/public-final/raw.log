  (ready : MicroCFTA.EnumerationDriver.Ready uv before.core)
  (realized :
    MicroCFTA.SourcePruningEnumerationObservation.PendingRealized caller.checked.native.machine.heap before.core)
  (paths : MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots)
  (counts : MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting)
  (flags :
    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate caller.checked.native.machine.heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot))
  (read :
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.getValue readFuel uv) before.core
      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) readAfter)
  (entered : MicroCFTA.EnumerationCompressionFrame.Frame readAfter entry)
  (entryReady : MicroCFTA.EnumerationDriver.Ready uv entry) :
  ∃ oldValue result nativeFuel heap newHandle final,
    have afterCaller :=
      MicroCFTA.SourceCurrentAllocatedPartialState.advance caller
        (MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical caller.checked
          { heap := heap, equality := caller.checked.operations })
        caller.fourth caller.merge;
    MicroCFTA.SourcePruningEnumerationNodes.lookupNode caller.checked.native.machine.heap oldHandle = some oldValue ∧
      MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata nativeFuel uv oldValue
            caller.checked.native.machine.heap =
          MicroCFTA.MergedSourceComparison.Result.done result heap ∧
        (∀ (extra : Nat),
            MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata (nativeFuel + extra) uv oldValue
                caller.checked.native.machine.heap =
              MicroCFTA.MergedSourceComparison.Result.done result heap) ∧
          MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver inventory caller afterCaller final ∧
            MicroCFTA.Cache.Extends memos.unfolding final.unfolding ∧
              final.query = memos.query ∧
                MicroCFTA.InternedProbeProvenance.Available afterCaller.checked.native.machine.heap result ∧
                  result.free = [] ∧
                    MicroCFTA.SourcePruningEnumerationNodes.encodeNode result = some newHandle ∧
