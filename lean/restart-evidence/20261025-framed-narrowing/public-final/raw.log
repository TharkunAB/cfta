MicroCFTA.SourcePruningEnumerationNarrowCache.complete_after_frame {EnumGuard NativeGuard Typing Key : Type}
  [DecidableEq (MicroCFTA.InternedConstructorTemplates.EdgeKey MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)]
  (holeKey : Typing → Nat → Key) (fits : Key → MicroCFTA.SourcePruningTemplates.Symbol → Bool)
  (admits :
    Key → MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol NativeGuard → Bool)
  (metadata : MicroCFTA.SourcePruningRecordTypes.Metadata Typing)
  (heap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readAfter entry : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (readFuel uv oldHandle : Nat) (scs : List MicroCFTA.EnumerationState.Suspended) (roots : Nat → Nat)
  (nativeReady : MicroCFTA.SourceEqualityRequiredCache.Ready heap)
  (ready : MicroCFTA.EnumerationDriver.Ready uv before.core)
  (realized : MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap before.core)
  (paths : MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots)
  (counts : MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting)
  (flags :
    ∀ (slot : Nat),
      MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
          (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
        some (before.expandable slot))
  (read :
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.getValue readFuel uv) before.core
      (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) readAfter)
  (entered : MicroCFTA.EnumerationCompressionFrame.Frame readAfter entry)
  (entryReady : MicroCFTA.EnumerationDriver.Ready uv entry) :
  ∃ oldValue result nativeFuel nextHeap newHandle,
    MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap oldHandle = some oldValue ∧
      MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata nativeFuel uv oldValue heap =
          MicroCFTA.MergedSourceComparison.Result.done result nextHeap ∧
        (∀ (extra : Nat),
            MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata (nativeFuel + extra) uv oldValue
                heap =
              MicroCFTA.MergedSourceComparison.Result.done result nextHeap) ∧
          MicroCFTA.SourceEqualityRequiredCache.Keeps heap nextHeap ∧
            MicroCFTA.InternedProbeProvenance.Available nextHeap result ∧
              result.free = [] ∧
                MicroCFTA.SourcePruningEnumerationNodes.encodeNode result = some newHandle ∧
                  MicroCFTA.SourcePruningEnumerationNodes.lookupNode nextHeap newHandle = some result ∧
                    (result = MicroCFTA.InternedConstructorTemplates.Value.empty →
                        ∀ (representativeFuel : Nat),
                          MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                representativeFuel uv oldHandle scs oldValue heap =
                              MicroCFTA.MergedSourceComparison.Result.done
                                (result, some MicroCFTA.EnumerationState.reject) nextHeap ∧
                            ¬∃ final,
                                MicroCFTA.EnumerationCorrectness.Success MicroCFTA.EnumerationState.reject entry ()
                                  final) ∧
                      (result ≠ MicroCFTA.InternedConstructorTemplates.Value.empty →
                        ∃ representativeFuel countFuel action after,
                          MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                                representativeFuel uv oldHandle scs oldValue heap =
                              MicroCFTA.MergedSourceComparison.Result.done (result, some action) nextHeap ∧
                            MicroCFTA.EnumerationCorrectness.Success action entry () after.core ∧
                              (newHandle = oldHandle ∧ after = MicroCFTA.EnumerationExpandableIndex.frame entry before ∨
                                  newHandle ≠ oldHandle ∧
                                    ∃ reentry,
                                      MicroCFTA.EnumerationCorrectness.Success
                                          (MicroCFTA.EnumerationState.representative representativeFuel uv) entry uv
                                          reentry ∧
                                        MicroCFTA.EnumerationCorrectness.Success
                                            (MicroCFTA.EnumerationState.setValue uv
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs))
                                            reentry () after.core ∧
                                          ∀ (extra : Nat),
                                            MicroCFTA.SourcePruningEnumerationNativeIndex.write nextHeap
                                                (countFuel + extra) uv
                                                (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs)
                                                scs scs (MicroCFTA.EnumerationExpandableIndex.frame reentry before) =
                                              some after) ∧
                                after.waiting = before.waiting ∧
                                  MicroCFTA.EnumerationDriver.Ready uv after.core ∧
                                    MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                                      MicroCFTA.SourcePruningEnumerationObservation.PendingRealized nextHeap
                                          after.core ∧
                                        after.core.values[uv]? =
                                            some
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated (some newHandle) scs) ∧
                                          MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values
                                              after.waiting ∧
                                            (∀ (slot : Nat),
                                                MicroCFTA.SourcePruningEnumerationNativeIndex.candidate nextHeap
                                                    (after.core.values[slot]?.getD
                                                      MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                                  some (after.expandable slot)) ∧
                                              (MicroCFTA.EnumerationReferences.PendingReferences before.core →
                                                  MicroCFTA.EnumerationReferences.PendingReferences after.core) ∧
                                                ∀ (held : Nat),
                                                  MicroCFTA.EnumerationReferences.IncomingAvoid held before.core →
                                                    MicroCFTA.EnumerationReferences.IncomingAvoid held after.core)
