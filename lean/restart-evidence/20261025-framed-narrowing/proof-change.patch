+      (readAfter : EnumerationState.State Symbol EnumGuard) (checkFuel : Nat) (repeated : Bool)
+      (checked : EnumerationExpandableIndex.Cached Symbol EnumGuard),
+      before.core.values[uv]? = some (.unenumerated (some oldHandle) scs) ∧
