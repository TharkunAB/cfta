theorem MicroCFTA.SourceListSortRunsOrdered.sequences_ordered.{u_1} : ∀ {Item : Type u_1}
  (relation : Item → Item → Prop) (gt : Item → Item → Bool),
  (∀ {a b c : Item}, relation a b → relation b c → relation a c) →
    (∀ (a b : Item),
        @ite.{1} Prop (@Eq.{1} Bool (gt a b) Bool.true) (instDecidableEqBool (gt a b) Bool.true) (relation b a)
          (relation a b)) →
      ∀ (input run : List.{u_1} Item),
