fun {Item} relation gt transitive compared input =>
  @MicroCFTA.SourceListSortRunsOrdered.sequences_ordered._mutual.{u_1} Item relation gt transitive compared
    (@PSum.inl.{u_1 + 1, u_1 + 1} (List.{u_1} Item)
      (PSum.{u_1 + 1, u_1 + 1}
        (@PSigma.{u_1 + 1, u_1 + 1} Item fun last =>
          @PSigma.{u_1 + 1, u_1 + 1} (List.{u_1} Item) fun reversed =>
            @PSigma.{u_1 + 1, 0} (List.{u_1} Item) fun rest =>
              @List.Pairwise.{u_1} Item relation (@List.cons.{u_1} Item last reversed))
        (@PSigma.{u_1 + 1, u_1 + 1} Item fun last =>
          @PSigma.{u_1 + 1, u_1 + 1} (List.{u_1} Item → List.{u_1} Item) fun append =>
            @PSigma.{u_1 + 1, u_1 + 1} (List.{u_1} Item) fun rest =>
              @PSigma.{u_1 + 1, 1} (List.{u_1} Item) fun initial =>
                @PSigma.{0, 0}
                  (∀ (suffix : List.{u_1} Item),
                    @Eq.{u_1 + 1} (List.{u_1} Item) (append suffix)
                      (@HAppend.hAppend.{u_1, u_1, u_1} (List.{u_1} Item) (List.{u_1} Item) (List.{u_1} Item)
                        (@instHAppendOfAppend.{u_1} (List.{u_1} Item) (@List.instAppend.{u_1} Item)) initial suffix))
                  fun exact =>
                  @List.Pairwise.{u_1} Item relation
                    (@HAppend.hAppend.{u_1, u_1, u_1} (List.{u_1} Item) (List.{u_1} Item) (List.{u_1} Item)
                      (@instHAppendOfAppend.{u_1} (List.{u_1} Item) (@List.instAppend.{u_1} Item)) initial
                      (@List.cons.{u_1} Item last (@List.nil.{u_1} Item)))))
      input)
