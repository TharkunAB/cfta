                                          (earlier ++ later) ≤
                                        MicroCFTA.SourceCurrentAllocatedFiniteOrdinarySerialCallerResources.nodeBudget
                                          rows arity count bound ∧
                                      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryReservations.edgeRequests
                                            (earlier ++ later) ≤
                                          MicroCFTA.SourceCurrentAllocatedFiniteOrdinarySerialCallerResources.edgeBudget
                                            rows arity count bound ∧
                                        after.nodes.next ≤
                                            before.nodes.next +
                                              MicroCFTA.SourceCurrentAllocatedFiniteOrdinarySerialCallerResources.nodeBudget
                                                rows arity count bound ∧
                                          after.edges.next ≤
                                            before.edges.next +
                                              MicroCFTA.SourceCurrentAllocatedFiniteOrdinarySerialCallerResources.edgeBudget
                                                rows arity count bound
