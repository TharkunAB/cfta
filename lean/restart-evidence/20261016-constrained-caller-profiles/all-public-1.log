  (before : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
    MicroCFTA.InternedNestedProvenance.Values before values →
      MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryNativeProfile.ChildrenShape rows arity values →
        ∀ (count depth bound : Nat),
          values.length ≤ count →
            path.length ≤ depth →
              MicroCFTA.MergedOrdinaryHeight.childrenHeight values ≤ bound →
                ∃ middle current result after earlier later,
                  MicroCFTA.SourceEqualityRequiredWorkerComplete.StableRun
                      (fun fuel readFuel =>
                        MicroCFTA.SourceEqualityRequiredExecution.requireAll fuel readFuel paths values before)
                      middle current ∧
                    MicroCFTA.SourceEqualityProjectionGraph.Forest path middle current result after ∧
                      MicroCFTA.SourceEqualityRequiredWorkerComplete.StableRun
                          (fun fuel readFuel =>
                            MicroCFTA.SourceEqualityProjectionWorker.forest fuel readFuel path middle current)
                          result after ∧
                        MicroCFTA.SourceEqualityRequiredCache.Keeps before after ∧
                          MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady after ∧
                            MicroCFTA.InternedProbeProvenance.Available after result ∧
                              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryNativeProfile.NodeShape
                                  (MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryProjectionProfile.forestRows rows count
                                    depth)
                                  arity result ∧
