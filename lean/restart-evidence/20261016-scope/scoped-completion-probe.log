@SourceCurrentAllocatedNativeScopedCode.certified_bind : ∀ {A B : Type} [inst : DecidableEq (EdgeKey Symbol Guard)]
  (code : Code Symbol Guard A) (next : A → Code Symbol Guard B) (state : Machine Symbol Guard),
  SourceRecursiveIntersectionKernel.Valid state →
    SemanticReady state.heap →
      ∀ (intermediate : Machine Symbol Guard → A → Prop) (post : Machine Symbol Guard → B → Prop),
        SourceCurrentAllocatedNativeScopedCode.Certified code state intermediate →
          (∀ (value : A) (after : Machine Symbol Guard),
              SourceRecursiveIntersectionKernel.Valid after →
                Extension state after →
                  SemanticReady after.heap →
                    intermediate after value →
                      SourceCurrentAllocatedNativeScopedCode.Certified (next value) after post) →
            SourceCurrentAllocatedNativeScopedCode.Certified (code.bind next) state post
@SourceCurrentAllocatedNativeScopeCompletion.Receipt.done : ∀ {A : Type} {width fuel : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] {control : Control A} {before after : Checked width} {value : A}
  {post scopePost : Machine Symbol Guard → A → Prop},
  SourceCurrentAllocatedNativeScopeCompletion.Receipt fuel control before value after post scopePost →
    SourceEqualityNativeDemand.execute (fuel + 1) control before = Outcome.done value after
@SourceCurrentAllocatedNativeScopeCompletion.node_complete : ∀ {width : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (source : InternedConstructorTemplates.State Symbol Guard),
  InternedNestedFacts.Facts source →
    ∀ (holds : Guard → Term Symbol → Bool) (request : NodeRequest Symbol Guard),
      NodeScope source request →
        ∀ (complete : Completes (view source holds) (SourceRecursiveIntersectionNative.nodeSemantic request))
          (state : Checked width),
          Good state →
            Scoped state.native →
              SemanticReady state.native.machine.heap →
                SourceRecursiveIntersectionThunks.NodeReady state.native.machine request →
                  Grows source state.native.machine.heap →
                    Extends source.nodes.issued state.native.machine.heap.nodes.issued →
                      ActiveAbove (view source holds) holds
                          (requiredFuel (view source holds) (SourceRecursiveIntersectionNative.nodeSemantic request)
                            complete)
                          state.native →
                        WordRanges (Control.code (compileNode request)) state →
                          SourceCurrentAllocatedNativeScopeCompletion.Returned (Control.code (compileNode request))
                            state (fun after value => Available after.heap value) fun x value =>
                            SourceCurrentAllocatedNativeScopeCache.NodeLaw request value
