@SourceCurrentAllocatedNativeScopeCompletion.initial_complete : ∀ {width : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (holds : Guard → Term Symbol → Bool) (state : Checked width),
  Good state →
    Scoped state.native →
      SemanticReady state.native.machine.heap →
        SourceRecursiveIntersectionNative.Idle state.native →
          ∀ (left right : Value Symbol Guard),
            Original left →
              Original right →
                Available state.native.machine.heap left →
                  Available state.native.machine.heap right →
                    left.free = [] →
                      right.free = [] →
                        WordRanges (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) state →
                          ∃ fuel value after,
                            (SourceCurrentAllocatedNativeScopeCompletion.Receipt fuel
                                (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right)) state value
                                after (fun final value => Available final.heap value) fun x value =>
                                SourceCurrentAllocatedNativeScopeCache.NodeLaw
                                  { domain := IntersectionEmptyDomain.emptyDomain, left := left, right := right }
                                  value) ∧
                              SourceRecursiveIntersectionNative.Idle after.native ∧ value.free = []
@SourceCurrentAllocatedNativeScopeCompletion.cold_complete : ∀ {width : Nat} [inst : DecidableEq Symbol]
  [inst_1 : DecidableEq (EdgeKey Symbol Guard)] (holds : Guard → Term Symbol → Bool) (machine : Machine Symbol Guard)
  (operations : SourceEqualityConstraintMemoAllocation.State),
  Good { native := initial width machine, operations := operations } →
    SemanticReady machine.heap →
      ∀ (left right : Value Symbol Guard),
        Original left →
          Original right →
            Available machine.heap left →
              Available machine.heap right →
                left.free = [] →
                  right.free = [] →
                    WordRanges (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right))
                        { native := initial width machine, operations := operations } →
                      ∃ fuel value after,
                        (SourceCurrentAllocatedNativeScopeCompletion.Receipt fuel
                            (Control.code (requestNode IntersectionEmptyDomain.emptyDomain left right))
                            { native := initial width machine, operations := operations } value after
                            (fun final value => Available final.heap value) fun x value =>
                            SourceCurrentAllocatedNativeScopeCache.NodeLaw
                              { domain := IntersectionEmptyDomain.emptyDomain, left := left, right := right } value) ∧
                          SourceRecursiveIntersectionNative.Idle after.native ∧ value.free = []
