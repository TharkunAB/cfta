                      ActiveAbove (view source holds) holds
                          (requiredFuel (view source holds)
                            (SourceRecursiveIntersectionNative.edgeSemantic holds request) complete)
                          state.native →
                        WordRanges (Control.edgeBody request Code.pure) state →
                          SourceCurrentAllocatedNativeScopeCompletion.Returned (Control.edgeBody request Code.pure)
                            state (fun after value => EdgeResident after.heap value) fun x value =>
                            SourceCurrentAllocatedNativeScopeCache.EdgeLaw request value
