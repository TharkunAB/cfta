@MicroCFTA.SourcePruningEnumerationCachedPrepare.boundary_complete : ∀ {EnumGuard NativeGuard : Type}
  (heap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (value : MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (scs : List MicroCFTA.EnumerationState.Suspended) (roots : Nat → Nat),
  MicroCFTA.InternedRecordCoherence.Coherent heap →
    MicroCFTA.InternedProbeProvenance.Available heap value →
      value.free = [] →
        MicroCFTA.MergedOrdinaryHeight.recursiveBoundary value = true →
          (scs.any fun sc => MicroCFTA.EqualityTrie.isTerminal sc.trie) = false →
            MicroCFTA.EnumerationCorrectness.StorageValid before.core →
              MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap before.core →
                MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots →
                  MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting →
                    (∀ (slot : Nat),
                        MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                            (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
                          some (before.expandable slot)) →
                      ∃ handle action after,
                        MicroCFTA.SourcePruningEnumerationNodes.encodeNode value = some handle ∧
                          MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap handle = some value ∧
                            MicroCFTA.SourcePruningEnumerationShallowChild.prepareChild scs value = some action ∧
                              (∀ (fuel : Nat),
                                  MicroCFTA.SourcePruningEnumerationCachedPrepare.prepareChild heap fuel scs value
                                      before =
                                    some [(MicroCFTA.Fragments.Fragment.hole before.core.counter, after)]) ∧
                                (action before.core).run =
                                    [Except.ok (MicroCFTA.Fragments.Fragment.hole before.core.counter, after.core)] ∧
                                  after.core = MicroCFTA.EnumerationState.allocated (some handle) before.core ∧
                                    after.core.values[before.core.counter]? =
                                        some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) []) ∧
                                      after.core.counter = before.core.counter + 1 ∧
                                        after.core.counter = after.core.values.length ∧
                                          after.core.representatives = before.core.representatives ∧
                                            MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                                              MicroCFTA.EnumerationCorrectness.StorageValid after.core ∧
                                                MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap
                                                    after.core ∧
                                                  MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values
                                                      after.waiting ∧
                                                    after.waiting = before.waiting ∧
                                                      after.expandable = before.expandable ∧
                                                        (∀ (slot : Nat),
                                                            MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                                                                (after.core.values[slot]?.getD
                                                                  MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                                              some (after.expandable slot)) ∧
                                                          MicroCFTA.EnumerationCorrectness.FragmentBound
                                                            after.core.counter
                                                            (MicroCFTA.Fragments.Fragment.hole before.core.counter)
'MicroCFTA.SourcePruningEnumerationCachedPrepare.boundary_complete' depends on axioms: [propext, Quot.sound]
@MicroCFTA.SourcePruningEnumerationCachedPrepare.complete : ∀ {EnumGuard NativeGuard : Type}
  (heap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (before : MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol EnumGuard)
  (value : MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol NativeGuard)
  (scs : List MicroCFTA.EnumerationState.Suspended) (roots : Nat → Nat),
  MicroCFTA.InternedRecordCoherence.Coherent heap →
    MicroCFTA.InternedProbeProvenance.Available heap value →
      value.free = [] →
        MicroCFTA.EnumerationCorrectness.StorageValid before.core →
          MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap before.core →
            MicroCFTA.EnumerationSchedule.Roots before.core.representatives roots →
              MicroCFTA.EnumerationCanonicalWaiting.Correct roots before.core.values before.waiting →
                (∀ (slot : Nat),
                    MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                        (before.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
                      some (before.expandable slot)) →
                  (∀ (sc : MicroCFTA.EnumerationState.Suspended), sc ∈ scs → sc.var < before.core.counter) →
                    (value ≠ MicroCFTA.InternedConstructorTemplates.Value.empty →
                        (scs.any fun sc => MicroCFTA.EqualityTrie.isTerminal sc.trie) = false) →
                      ∃ action fuel rows,
                        MicroCFTA.SourcePruningEnumerationShallowChild.prepareChild scs value = some action ∧
                          (∀ (extra : Nat),
                              MicroCFTA.SourcePruningEnumerationCachedPrepare.prepareChild heap (fuel + extra) scs value
                                  before =
                                some rows) ∧
                            (action before.core).run =
                                List.map (fun result => Except.ok (result.fst, result.snd.core)) rows ∧
                              (value = MicroCFTA.InternedConstructorTemplates.Value.empty ∧ rows = [] ∨
                                ∃ after,
                                  value ≠ MicroCFTA.InternedConstructorTemplates.Value.empty ∧
                                    rows = [(MicroCFTA.Fragments.Fragment.hole before.core.counter, after)] ∧
                                      after.core.counter = before.core.counter + 1 ∧
                                        after.core.counter = after.core.values.length ∧
                                          after.core.representatives = before.core.representatives ∧
                                            MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                                              MicroCFTA.EnumerationCorrectness.StorageValid after.core ∧
                                                MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap
                                                    after.core ∧
                                                  MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values
                                                      after.waiting ∧
                                                    (∀ (slot : Nat),
                                                        MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                                                            (after.core.values[slot]?.getD
                                                              MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                                          some (after.expandable slot)) ∧
                                                      MicroCFTA.EnumerationCorrectness.FragmentBound after.core.counter
                                                        (MicroCFTA.Fragments.Fragment.hole before.core.counter))
