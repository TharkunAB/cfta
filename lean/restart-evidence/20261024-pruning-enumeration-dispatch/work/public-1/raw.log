@MicroCFTA.SourcePruningEnumerationDispatch.dispatch_complete : ∀ {EnumGuard : Type} {width : Nat}
  [inst : DecidableEq MicroCFTA.SourcePruningTemplates.Symbol]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [inst_2 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
  (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula)
  (inventory : MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory)
  (beforeCaller : MicroCFTA.SourceCurrentAllocatedPartialState.State width)
  (before : MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol EnumGuard) (checkEmpty : Bool)
  (source target : Nat) (memos : MicroCFTA.EndpointMemoGateTrace.Memos),
  MicroCFTA.SourceCurrentAllocatedPartialInvariant.Context formulas solver inventory beforeCaller memos →
    MicroCFTA.SourcePruningEnumerationObservation.PendingRealized beforeCaller.checked.native.machine.heap before →
      (source = target ∨
          before.values[source]? = some MicroCFTA.EnumerationState.UVarValue.eliminated ∨
            ∃ sourceNode targetNode sourceScs targetScs,
              before.values[source]? = some (MicroCFTA.EnumerationState.UVarValue.unenumerated sourceNode sourceScs) ∧
                before.values[target]? =
                  some (MicroCFTA.EnumerationState.UVarValue.unenumerated targetNode targetScs)) →
        (if source = target then True
          else
            match before.values[source]?, before.values[target]? with
            | some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some left) a),
              some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some right) a_1) =>
              match MicroCFTA.SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap left,
                MicroCFTA.SourcePruningEnumerationNodes.lookupNode beforeCaller.checked.native.machine.heap right with
              | some first, some second =>
                MicroCFTA.SourceCurrentAllocatedNativeRequestBounds.WordRanges
                  (MicroCFTA.SourceEqualityNativeDemand.Control.code
                    (MicroCFTA.SourceRecursiveIntersectionCode.requestNode MicroCFTA.IntersectionEmptyDomain.emptyDomain
                      first second))
                  beforeCaller.checked
              | x, x_1 => True
            | x, x_1 => True) →
          ∃ fuel p h action afterCaller savedQueries final next,
            (∀ (extra P H : Nat),
                p ≤ P →
                  h ≤ H →
                    MicroCFTA.SourcePruningEnumerationDispatch.dispatch checkEmpty (fuel + extra) P H beforeCaller
                        before source target memos.query =
                      (Except.ok (some action), afterCaller, savedQueries)) ∧
              MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver next beforeCaller afterCaller
                  final ∧
                final.query = savedQueries ∧
                  MicroCFTA.SourcePruningEnumerationObservation.PendingRealized afterCaller.checked.native.machine.heap
                      before ∧
                    (source = target ∨ before.values[source]? = some MicroCFTA.EnumerationState.UVarValue.eliminated →
                        (action before).run = [Except.ok ((), before)] ∧
                          afterCaller = beforeCaller ∧ final = memos ∧ next = inventory) ∧
                      (source ≠ target →
                        before.values[source]? ≠ some MicroCFTA.EnumerationState.UVarValue.eliminated →
                          ∃ sourceNode targetNode merged sourceScs targetScs,
                            before.values[source]? =
                                some (MicroCFTA.EnumerationState.UVarValue.unenumerated sourceNode sourceScs) ∧
                              before.values[target]? =
                                  some (MicroCFTA.EnumerationState.UVarValue.unenumerated targetNode targetScs) ∧
                                ((action before).run =
                                    if merged = some 0 then []
                                    else
                                      [Except.ok
                                          ((),
                                            MicroCFTA.EnumerationCorrectness.assimilated before target source
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated merged
                                                (sourceScs ++ targetScs)))]) ∧
                                  (merged ≠ some 0 →
                                      (MicroCFTA.EnumerationCorrectness.assimilated before target source
                                                (MicroCFTA.EnumerationState.UVarValue.unenumerated merged
                                                  (sourceScs ++ targetScs))).values[target]? =
                                          some
                                            (MicroCFTA.EnumerationState.UVarValue.unenumerated merged
                                              (sourceScs ++ targetScs)) ∧
                                        (MicroCFTA.EnumerationCorrectness.assimilated before target source
                                                  (MicroCFTA.EnumerationState.UVarValue.unenumerated merged
                                                    (sourceScs ++ targetScs))).values[source]? =
                                            some MicroCFTA.EnumerationState.UVarValue.eliminated ∧
                                          MicroCFTA.SourcePruningEnumerationObservation.PendingRealized
                                            afterCaller.checked.native.machine.heap
                                            (MicroCFTA.EnumerationCorrectness.assimilated before target source
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated merged
                                                (sourceScs ++ targetScs)))) ∧
                                    (sourceNode = none ∨ targetNode = none →
                                        (merged = sourceNode.orElse fun x => targetNode) ∧
                                          afterCaller = beforeCaller ∧ final = memos ∧ next = inventory) ∧
                                      ∀ (leftHandle rightHandle : Nat),
                                        sourceNode = some leftHandle →
                                          targetNode = some rightHandle →
                                            ∃ left right query replacement queried handle,
                                              MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                    beforeCaller.checked.native.machine.heap leftHandle =
                                                  some left ∧
                                                MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                      beforeCaller.checked.native.machine.heap rightHandle =
                                                    some right ∧
                                                  next.source = beforeCaller.checked.native.machine.heap ∧
                                                    next.roots = inventory.roots ++ [left, right] ∧
                                                      MicroCFTA.SourceCurrentAllocatedTargetQuery.Receipt formulas
                                                          solver next left right beforeCaller.checked query queried
                                                          memos ∧
                                                        merged = some handle ∧
                                                          MicroCFTA.SourcePruningEnumerationNodes.encodeNode
                                                                replacement =
                                                              some handle ∧
                                                            MicroCFTA.SourcePruningEnumerationNodes.lookupNode
                                                                  afterCaller.checked.native.machine.heap handle =
                                                                some replacement ∧
                                                              MicroCFTA.InternedProbeProvenance.Available
                                                                  afterCaller.checked.native.machine.heap replacement ∧
                                                                replacement.free = [] ∧
                                                                  (∀
                                                                      (ambient :
                                                                        MicroCFTA.InternedGuardedLanguage.Env
                                                                          (MicroCFTA.SourceObservations.Label
                                                                            MicroCFTA.FullSyntax.Formula))
                                                                      (term :
                                                                        MicroCFTA.Language.Term
                                                                          (MicroCFTA.SourceObservations.Label
                                                                            MicroCFTA.FullSyntax.Formula)),
                                                                      MicroCFTA.InternedGuardedLanguage.meaning
                                                                          (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                            formulas solver)
                                                                          ambient replacement term ↔
                                                                        MicroCFTA.InternedGuardedLanguage.meaning
                                                                            (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                              formulas solver)
                                                                            ambient left term ∧
                                                                          MicroCFTA.InternedGuardedLanguage.meaning
                                                                            (MicroCFTA.SourceEqualityPCSGuard.holds
                                                                              formulas solver)
                                                                            ambient right term) ∧
                                                                    (checkEmpty = false →
                                                                        replacement = query ∧
                                                                          afterCaller =
                                                                              MicroCFTA.SourceCurrentAllocatedPartialState.advance
                                                                                beforeCaller queried beforeCaller.fourth
                                                                                beforeCaller.merge ∧
                                                                            final = memos) ∧
                                                                      (checkEmpty = true →
                                                                        ∃ reached answer guardSaved,
                                                                          MicroCFTA.SourceEndpointMemo.run query
                                                                                memos.query =
                                                                              (reached, guardSaved) ∧
                                                                            MicroCFTA.SourceEndpointMemoCorrect.Checked
                                                                                queried.native.machine.heap memos.query
                                                                                (MicroCFTA.SourceCurrentEmptinessMerge.reaches
                                                                                  query)
                                                                                (reached, guardSaved) ∧
                                                                              (∀ (P H : Nat),
                                                                                  p ≤ P →
                                                                                    h ≤ H →
                                                                                      MicroCFTA.SourcePruningEnumerationEnabledEmpty.check
                                                                                          P H query queried
                                                                                          beforeCaller.fourth
                                                                                          memos.query =
                                                                                        (MicroCFTA.SourceCurrentAllocatedConjunctionWorker.Outcome.done
                                                                                            answer afterCaller.checked
                                                                                            afterCaller.fourth,
                                                                                          guardSaved)) ∧
                                                                                savedQueries = guardSaved ∧
                                                                                  (replacement =
                                                                                      if answer = true then
                                                                                        MicroCFTA.InternedConstructorTemplates.Value.empty
                                                                                      else query) ∧
                                                                                    (reached = false →
                                                                                        answer = false ∧
                                                                                          afterCaller.checked =
                                                                                              queried ∧
                                                                                            afterCaller.fourth =
                                                                                                beforeCaller.fourth ∧
                                                                                              final =
                                                                                                {
                                                                                                  unfolding :=
                                                                                                    memos.unfolding,
                                                                                                  query :=
                                                                                                    guardSaved }) ∧
                                                                                      (reached = true →
                                                                                        ∃ reachedPhysical,
                                                                                          afterCaller.checked =
                                                                                              MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical
                                                                                                queried
                                                                                                reachedPhysical ∧
                                                                                            ∃ actual,
                                                                                              MicroCFTA.SourceCurrentConjunctionGlobalMemos.CallReads
                                                                                                actual
                                                                                                {
                                                                                                  unfolding :=
                                                                                                    memos.unfolding,
                                                                                                  query := guardSaved }
                                                                                                final)))
