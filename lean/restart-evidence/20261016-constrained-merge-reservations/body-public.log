  (edge : MicroCFTA.InternedConstructorTemplates.EdgeValue Symbol Guard)
  (before : MicroCFTA.InternedConstructorTemplates.State Symbol Guard),
  MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
    MicroCFTA.InternedFreshOrdinaryCostHeap.Heap before →
      MicroCFTA.InternedEdgeResidency.EdgeResident before edge →
        ∀ (rows arity bound : Nat),
          MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryNativeProfile.EdgeShape rows arity edge →
            MicroCFTA.MergedOrdinaryHeight.edgeHeight edge ≤ bound →
              MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryMergeBudgetCode.Certified clear
                (MicroCFTA.SourceCurrentMemoMergeGraph.small edge) before fun after result =>
