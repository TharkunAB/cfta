  (heap : MicroCFTA.InternedConstructorTemplates.State MicroCFTA.SourcePruningTemplates.Symbol Guard) (handle : Nat)
  (value : MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol Guard),
  MicroCFTA.InternedRecordCoherence.Coherent heap →
    MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap handle = some value →
      MicroCFTA.SourcePruningEnumerationNodes.encodeNode value = some handle
