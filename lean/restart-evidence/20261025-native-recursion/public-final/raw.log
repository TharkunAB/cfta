                                        (MicroCFTA.EnumerationState.representative fuel uv) before.core uv resolved ∧
                                      MicroCFTA.EnumerationState.recursionKey handle scs ∈
                                          resolved.recursionAncestry uv ∧
                                        MicroCFTA.EnumerationCorrectness.Success
                                            (MicroCFTA.EnumerationState.setValue uv
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) []))
                                            resolved () after.core ∧
                                          ∀ (extra : Nat),
                                            MicroCFTA.SourcePruningEnumerationNativeIndex.write heap (countFuel + extra)
                                                uv (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) [])
                                                [] scs (MicroCFTA.EnumerationExpandableIndex.frame resolved before) =
                                              some after)
