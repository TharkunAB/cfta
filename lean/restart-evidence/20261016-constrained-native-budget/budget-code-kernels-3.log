@checked_children_budget : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)] (scheme : Scheme Symbol Guard)
  (domain : Cache.Interned IntersectionFlatMemoKeyDomain.DomainKey) (left right : EdgeValue Symbol Guard)
  (combined : SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) (perChild : Nat),
  (∀ (pair : Value Symbol Guard × Value Symbol Guard),
      pair ∈ left.children.zip right.children →
        scheme.nodeInputs { domain := domain, left := pair.fst, right := pair.snd }) →
    (∀ (pair : Value Symbol Guard × Value Symbol Guard),
        pair ∈ left.children.zip right.children →
          scheme.nodeCost { domain := domain, left := pair.fst, right := pair.snd } ≤ perChild) →
      Bound scheme (SourceEqualityNativeCheckedCode.children domain left right combined)
        (perChild * (left.children.zip right.children).length + 1)
'MicroCFTA.NativeBudgetCodeKernels.checked_children_budget' depends on axioms: [propext, Quot.sound]
@rejected_has_no_child_budget : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)] (left : EdgeValue Symbol Guard),
  have scheme :=
    { nodeInputs := fun x => False, edgeInputs := fun x => False, nodeCost := fun x => 999, edgeCost := fun x => 999 };
  Bound scheme (SourceEqualityNativeCheckedCode.sentinel left) 1
