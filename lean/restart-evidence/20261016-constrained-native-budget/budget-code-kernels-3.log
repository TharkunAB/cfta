@edge_then_node_budget : ∀ [inst : DecidableEq (EdgeKey Symbol Guard)] (scheme : Scheme Symbol Guard) (symbol : Symbol)
  (guard : Guard) (values : List (Value Symbol Guard)),
  Bound scheme (Code.work (makeEdge symbol guard values) fun edge => Code.work (makeNode [edge]) Code.pure) 2
