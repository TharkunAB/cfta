'MicroCFTA.NativeProfileKernels.Domain.joined_child_profiles' depends on axioms: [propext, sorryAx]
@joined_child_profiles : ∀ {Symbol Guard : Type} [inst : DecidableEq Symbol] {rows arity : Nat}
  {left right : Value Symbol Guard},
  NodeShape rows arity left →
    NodeShape rows arity right →
      ∀ {a b : EdgeValue Symbol Guard},
        a ∈ InternedEdgeResidency.nodeEdges left →
          b ∈ InternedEdgeResidency.nodeEdges right →
            ∀ {child : Value Symbol Guard × Value Symbol Guard},
              child ∈ a.children.zip b.children →
                (SourceRecursiveIntersectionKernel.pairs (InternedEdgeResidency.nodeEdges left)
                        (InternedEdgeResidency.nodeEdges right)).length ≤
                    rows * rows ∧
                  a.children.length ≤ arity ∧
                    b.children.length ≤ arity ∧ NodeShape rows arity child.fst ∧ NodeShape rows arity child.snd
