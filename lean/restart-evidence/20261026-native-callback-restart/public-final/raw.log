  ∃ readFuel handle scs value readAfter checkFuel repeated after,
    before.core.values[uv]? = some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) scs) ∧
      MicroCFTA.SourcePruningEnumerationNodes.lookupNode heap handle = some value ∧
        MicroCFTA.InternedProbeProvenance.Available heap value ∧
          value.free = [] ∧
            (∀ (extra : Nat),
                (MicroCFTA.EnumerationState.getValue (readFuel + extra) uv before.core).run =
                  [Except.ok (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) scs, readAfter)]) ∧
              MicroCFTA.EnumerationCompressionFrame.Frame before.core readAfter ∧
                (∀ (extra : Nat),
                    (MicroCFTA.SourcePruningEnumerationRecursion.checkRepeated heap (checkFuel + extra) uv handle scs
                          readAfter).run =
                      [Except.ok (repeated, after.core)]) ∧
                  MicroCFTA.EnumerationDriver.Ready uv after.core ∧
                    MicroCFTA.EnumerationSchedule.Roots after.core.representatives roots ∧
                      MicroCFTA.SourcePruningEnumerationObservation.PendingRealized heap after.core ∧
                        MicroCFTA.EnumerationCanonicalWaiting.Correct roots after.core.values after.waiting ∧
                          (∀ (slot : Nat),
                              MicroCFTA.SourcePruningEnumerationNativeIndex.candidate heap
                                  (after.core.values[slot]?.getD MicroCFTA.EnumerationState.UVarValue.eliminated) =
                                some (after.expandable slot)) ∧
                            MicroCFTA.EnumerationReferences.IncomingAvoid uv after.core ∧
                              (MicroCFTA.EnumerationReferences.PendingReferences before.core →
                                  MicroCFTA.EnumerationReferences.PendingReferences after.core) ∧
                                (repeated = false →
                                    MicroCFTA.EnumerationCompressionFrame.Frame before.core after.core ∧
                                      after.expandable = before.expandable ∧
                                        after.waiting = before.waiting ∧
                                          after.core.values[uv]? =
                                            some
                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) scs)) ∧
                                  (repeated = true →
                                      after.core.counter = before.core.counter ∧
                                        ∀ (level : Nat → Nat) (frontier : Nat),
                                          MicroCFTA.EnumerationOrder.Stratified before.core level frontier →
                                            MicroCFTA.EnumerationOrder.Stratified after.core level frontier) ∧
                                    (repeated = true →
                                      MicroCFTA.MergedOrdinaryHeight.recursiveBoundary value = true ∧
                                        after.core.values[uv]? =
                                            some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some handle) []) ∧
                                          after.expandable uv = false ∧
                                            after.waiting =
                                                MicroCFTA.EnumerationCanonicalWaiting.count roots (-1) scs
                                                  before.waiting ∧
                                              ∃ resolved countFuel,
                                                MicroCFTA.EnumerationCompressionFrame.Frame before.core resolved ∧
                                                  MicroCFTA.EnumerationCorrectness.Success
                                                      (MicroCFTA.EnumerationState.representative checkFuel uv) readAfter
                                                      uv resolved ∧
                                                    MicroCFTA.EnumerationState.recursionKey handle scs ∈
                                                        resolved.recursionAncestry uv ∧
                                                      MicroCFTA.EnumerationCorrectness.Success
                                                          (MicroCFTA.EnumerationState.setValue uv
                                                            (MicroCFTA.EnumerationState.UVarValue.unenumerated
                                                              (some handle) []))
                                                          resolved () after.core ∧
                                                        ∀ (extra : Nat),
                                                          MicroCFTA.SourcePruningEnumerationNativeIndex.write heap
                                                              (countFuel + extra) uv
                                                              (MicroCFTA.EnumerationState.UVarValue.unenumerated
                                                                (some handle) [])
                                                              [] scs
                                                              (MicroCFTA.EnumerationExpandableIndex.frame resolved
                                                                before) =
                                                            some after)
