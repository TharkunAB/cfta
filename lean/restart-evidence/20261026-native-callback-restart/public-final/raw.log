        MicroCFTA.EnumerationExpandableIndex.Cached MicroCFTA.SourcePruningTemplates.Symbol
            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
          Option MicroCFTA.EnumerationState.Next :=
fun {Typing} stop order metadata before =>
  match stop with
  | none => some (MicroCFTA.EnumerationPureSelection.next (order metadata) before)
  | some rule =>
    have remaining := MicroCFTA.EnumerationIndexSelection.candidates before;
    if (!remaining.isEmpty && remaining.all (rule metadata)) = true then none
    else some (MicroCFTA.EnumerationPureSelection.next (order metadata) before)
