fun {Typing} graph templates fuel metadata uv fragment before result after =>
  ∀ (stop : Option (MicroCFTA.SourcePruningRecordTypes.Metadata Typing → Nat → Bool))
    (order : MicroCFTA.SourcePruningRecordTypes.Metadata Typing → List Nat → Option Nat),
    have decision :=
      MicroCFTA.SourcePruningEnumerationRestart.decision stop order result.snd
        (MicroCFTA.EnumerationExpandableIndex.frame after before);
    (result.fst = true ∨ decision = some MicroCFTA.EnumerationState.Next.stuck →
        ∀ (output : MicroCFTA.SourcePruningRecordTypes.Metadata Typing × Option MicroCFTA.EnumerationState.Next)
          (final :
            MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol
              (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
          ¬MicroCFTA.EnumerationCorrectness.Success
              (MicroCFTA.SourcePruningEnumerationAfterCallback.run graph templates stop order fuel metadata uv fragment
                before)
              before.core output final) ∧
      (result.fst = false →
        decision ≠ some MicroCFTA.EnumerationState.Next.stuck →
          MicroCFTA.EnumerationCorrectness.Success
            (MicroCFTA.SourcePruningEnumerationAfterCallback.run graph templates stop order fuel metadata uv fragment
              before)
            before.core (result.snd, decision) after)
def MicroCFTA.SourcePruningEnumerationRestart.decision : {Typing : Type} →
