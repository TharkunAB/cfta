def MicroCFTA.SourcePruningEnumerationReceiptCallback.Completes : {Typing : Type} →
  {width : Nat} →
    MicroCFTA.EnumerationState.Graph MicroCFTA.SourcePruningTemplates.Symbol
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
      List (MicroCFTA.Template.Pattern MicroCFTA.SourcePruningTemplates.Symbol) →
        MicroCFTA.SourcePruningRecordTypes.Metadata Typing →
          Nat →
            MicroCFTA.EnumerationState.State MicroCFTA.SourcePruningTemplates.Symbol
                (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
              MicroCFTA.SourcePruningEnumerationSelectedEdge.Result width → Prop :=
fun {Typing} {width} graph templates metadata uv before x =>
  match x with
  | MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment caller queries after =>
    ∀ (level : Nat → Nat) (frontier : Nat),
      MicroCFTA.EnumerationOrder.Stratified before level frontier →
        (∀ (group : MicroCFTA.SourcePruningPartialMatch.Pending MicroCFTA.SourcePruningTemplates.Symbol),
            group ∈ metadata.pending → MicroCFTA.SourcePruningPartialMatch.PendingBound before.counter group) →
          ∃ nextLevel fuel result final,
            MicroCFTA.EnumerationCorrectness.Success
                (MicroCFTA.SourcePruningRecordTypes.recordTypes graph templates fuel metadata uv (Sum.inl fragment))
                after.core result final ∧
              MicroCFTA.EnumerationDriver.RenderStable after.core final ∧
                MicroCFTA.EnumerationCompressionFrame.Frame after.core final ∧
                  MicroCFTA.EnumerationOrder.Stratified final nextLevel (frontier + 1) ∧
                    result.snd.types = MicroCFTA.SourcePruningRecordTypes.updatedTypes metadata uv (Sum.inl fragment) ∧
                      result.snd.openHoles = metadata.openHoles ∧
                        result.snd.typing = metadata.typing ∧
                          MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Admitted uv
                              (MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment caller queries
                                (MicroCFTA.EnumerationExpandableIndex.frame final after)) ∧
                            MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.FragmentHistory before
                                (MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment caller queries
                                  (MicroCFTA.EnumerationExpandableIndex.frame final after)) ∧
                              (MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Pending
                                    (MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment caller
                                      queries after) →
                                  MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Pending
                                    (MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.complete fragment caller
                                      queries (MicroCFTA.EnumerationExpandableIndex.frame final after))) ∧
                                (∀ (preference : List Nat → Option Nat),
                                    MicroCFTA.EnumerationPureSelection.next preference
                                        (MicroCFTA.EnumerationExpandableIndex.frame final after) =
                                      MicroCFTA.EnumerationPureSelection.next preference after) ∧
                                  MicroCFTA.SourcePruningEnumerationAfterCallback.Follows graph templates fuel metadata
                                      uv fragment after result final ∧
                                    ∀
                                      (group :
                                        MicroCFTA.SourcePruningPartialMatch.Pending
                                          MicroCFTA.SourcePruningTemplates.Symbol),
                                      group ∈ result.snd.pending →
                                        MicroCFTA.SourcePruningPartialMatch.PendingBound final.counter group
  | x => True
