index 000000000..91981e677
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationFoldCacheBounds.lean
@@ -0,0 +1,231 @@
+import MicroCFTA.SourcePruningEnumerationCachedFold
+import MicroCFTA.SourcePruningEnumerationDispatchShape
+import MicroCFTA.SourcePruningEnumerationSuspendedMass
+
+/-!
+# Scalar cache bounds at actual terminal fold observations
+
+An actual dispatch singleton keeps its input or assimilates two pending slots.
+Both cases preserve the counter and total suspended mass. A rejected action
+retains the current fold prefix. These observers require no future admission.
+-/
+namespace MicroCFTA.SourcePruningEnumerationFold
+open EnumerationState EnumerationCorrectness InternedConstructorTemplates
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Raw" => List (Except EnumerationState.Error (Unit × Core))
+variable {width : Nat}
+local notation "Observation" => Except
+  (SourceEqualityNativeDemand.Outcome width Node ⊕ SourceCurrentAllocatedConjunctionWorker.Outcome width)
+  (Option Raw)
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- An actual dispatch singleton preserves the counter and every suspended occurrence. -/
+theorem dispatch_counter_mass
+    (checkEmpty : Bool) (nativeFuel p h : Nat) (beforeCaller : Caller width) (before : Core)
+    (source target : Nat) (queries : Queries) (action : EnumerateM Symbol Constraint Unit)
+    (afterCaller : Caller width) (savedQueries : Queries) (after : Core)
+    (selected : SourcePruningEnumerationDispatch.dispatch checkEmpty nativeFuel p h
+      beforeCaller before source target queries = (.ok (some action), afterCaller, savedQueries))
+    (completed : ExceptT.run (action before) = [.ok ((), after)]) :
+    after.counter = before.counter ∧ suspendedBound after = suspendedBound before := by
+  rcases SourcePruningEnumerationDispatchShape.singleton checkEmpty nativeFuel p h
+    beforeCaller before source target queries action afterCaller savedQueries after selected completed with
+    rfl | ⟨different, sourceNode, targetNode, merged, sourceScs, targetScs, sourceStored, targetStored, rfl⟩
+  · exact ⟨rfl, rfl⟩
+  · exact ⟨rfl, SourcePruningEnumerationSuspendedMass.assimilated_mass before source target
+      sourceNode targetNode merged sourceScs targetScs sourceStored targetStored (Ne.symm different)⟩
+
+/-- The raw singleton core is the exact returned outer fold core. -/
+theorem singleton_core
+    (checkEmpty : Bool) (nativeFuel p h : Nat) (sources : List Nat)
+    (beforeCaller : Caller width) (before : Core) (target : Nat) (queries : Queries)
+    (returned : Core) (afterCaller : Caller width) (savedQueries : Queries) (outer : Core)
+    (observed : run checkEmpty nativeFuel p h sources beforeCaller before target queries =
+      (.ok (some [.ok ((), returned)]), afterCaller, savedQueries, outer)) :
+    returned = outer := by
+  induction sources generalizing beforeCaller before queries with
+  | nil =>
+    simp only [run, Prod.mk.injEq, Except.ok.injEq, Option.some.injEq,
+      List.cons.injEq, and_true, true_and] at observed
+    rcases observed with ⟨rfl, _callerSame, _querySame, rfl⟩
+    rfl
+  | cons source rest ih =>
+    rcases dispatchObserved : SourcePruningEnumerationDispatch.dispatch checkEmpty nativeFuel p h
+        beforeCaller before source target queries with ⟨dispatchResult, reachedCaller, saved⟩
+    cases dispatchResult with
+    | error fault => simp only [run, dispatchObserved] at observed; cases observed
+    | ok possible =>
+      cases possible with
+      | none => simp only [run, dispatchObserved] at observed; cases observed
+      | some action =>
+        cases rawObserved : ExceptT.run (action before) with
+        | nil => simp only [run, dispatchObserved, rawObserved] at observed; cases observed
+        | cons first tail =>
+          cases first with
+          | error fault => simp only [run, dispatchObserved, rawObserved] at observed; cases observed
+          | ok pair =>
+            rcases pair with ⟨valueUnit, middle⟩
+            cases valueUnit
+            cases tail with
+            | cons second remaining =>
+              simp only [run, dispatchObserved, rawObserved] at observed
+              cases observed
+            | nil =>
+              simp only [run, dispatchObserved, rawObserved] at observed
+              exact ih reachedCaller middle saved observed
+
+/-- Every actual returned fold prefix preserves counter and suspended mass, for every result tag. -/
+theorem observed_counter_mass
+    (checkEmpty : Bool) (nativeFuel p h : Nat) (sources : List Nat)
+    (beforeCaller : Caller width) (before : Core) (target : Nat) (queries : Queries)
+    (result : Observation) (afterCaller : Caller width) (savedQueries : Queries) (after : Core)
+    (observed : run checkEmpty nativeFuel p h sources beforeCaller before target queries =
+      (result, afterCaller, savedQueries, after)) :
+    after.counter = before.counter ∧ suspendedBound after = suspendedBound before := by
+  induction sources generalizing beforeCaller before queries with
+  | nil =>
+      simp only [run, Prod.mk.injEq] at observed
+      rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+      exact ⟨rfl, rfl⟩
+  | cons source rest ih =>
+      rcases dispatchObserved : SourcePruningEnumerationDispatch.dispatch checkEmpty nativeFuel p h
+        beforeCaller before source target queries with ⟨dispatchResult, reachedCaller, saved⟩
+      cases dispatchResult with
+      | error fault =>
+          simp only [run, dispatchObserved, Prod.mk.injEq] at observed
+          rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+          exact ⟨rfl, rfl⟩
+      | ok possible =>
+          cases possible with
+          | none =>
+              simp only [run, dispatchObserved, Prod.mk.injEq] at observed
+              rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+              exact ⟨rfl, rfl⟩
+          | some action =>
+              cases rawObserved : ExceptT.run (action before) with
+              | nil =>
+                  simp only [run, dispatchObserved, rawObserved, Prod.mk.injEq] at observed
+                  rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                  exact ⟨rfl, rfl⟩
+              | cons first tail =>
+                  cases first with
+                  | error error =>
+                      simp only [run, dispatchObserved, rawObserved, Prod.mk.injEq] at observed
+                      rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                      exact ⟨rfl, rfl⟩
+                  | ok pair =>
+                      rcases pair with ⟨valueUnit, middle⟩
+                      cases valueUnit
+                      cases tail with
+                      | nil =>
+                          have headBounds := dispatch_counter_mass checkEmpty nativeFuel p h beforeCaller
+                            before source target queries action reachedCaller saved middle dispatchObserved rawObserved
+                          simp only [run, dispatchObserved, rawObserved] at observed
+                          have tailBounds := ih reachedCaller middle saved observed
+                          exact ⟨tailBounds.1.trans headBounds.1, tailBounds.2.trans headBounds.2⟩
+                      | cons second remaining =>
+                          simp only [run, dispatchObserved, rawObserved, Prod.mk.injEq] at observed
+                          rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                          exact ⟨rfl, rfl⟩
+
+end MicroCFTA.SourcePruningEnumerationFold
+
+namespace MicroCFTA.SourcePruningEnumerationCachedFold
+open EnumerationState InternedConstructorTemplates
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Raw" => List (Except EnumerationState.Error (Unit × Core))
+variable {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- An actual returned cache preserves the original counter and suspended mass, including raw rejection. -/
+theorem observed_cache_bounds
+    (checkEmpty : Bool) (nativeFuel p h : Nat) (sources : List Nat)
+    (beforeCaller : Caller width) (before : Cached) (target : Nat) (queries : Queries)
+    (after : Cached)
+    (observed : (run checkEmpty nativeFuel p h sources beforeCaller before target queries).2 = some after) :
+    after.core.counter = before.core.counter ∧ suspendedBound after.core = suspendedBound before.core := by
+  induction sources generalizing beforeCaller before queries with
+  | nil =>
+      simp only [run, Option.some.injEq] at observed
+      subst after
+      exact ⟨rfl, rfl⟩
+  | cons source rest ih =>
+      rcases dispatchObserved : SourcePruningEnumerationDispatch.dispatch checkEmpty nativeFuel p h
+        beforeCaller before.core source target queries with ⟨dispatchResult, reachedCaller, saved⟩
+      cases dispatchResult with
+      | error fault =>
+          simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved] at observed
+          cases observed
+      | ok possible =>
+          cases possible with
+          | none =>
+              simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved] at observed
+              cases observed
+          | some action =>
+              cases rawObserved : ExceptT.run (action before.core) with
+              | nil =>
+                  simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved,
+                    rawObserved, SourcePruningEnumerationCachedAdapter.adapt, Option.some.injEq] at observed
+                  subst after
+                  exact ⟨rfl, rfl⟩
+              | cons first tail =>
+                  cases first with
+                  | error error =>
+                      simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved,
+                        rawObserved, SourcePruningEnumerationCachedAdapter.adapt] at observed
+                      cases observed
+                  | ok pair =>
+                      rcases pair with ⟨valueUnit, middle⟩
+                      cases valueUnit
+                      cases tail with
+                      | nil =>
+                          have headBounds := SourcePruningEnumerationFold.dispatch_counter_mass
+                            checkEmpty nativeFuel p h beforeCaller before.core source target queries action
+                            reachedCaller saved middle dispatchObserved rawObserved
+                          cases cacheObserved : SourcePruningEnumerationCachedAdapter.adapt
+                              reachedCaller.checked.native.machine.heap before source target [.ok ((), middle)] with
+                          | none =>
+                              simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved,
+                                rawObserved, cacheObserved] at observed
+                              cases observed
+                          | some recovered =>
+                              simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved,
+                                rawObserved, cacheObserved] at observed
+                              have tailBounds := ih reachedCaller (EnumerationExpandableIndex.frame middle recovered) saved observed
+                              exact ⟨tailBounds.1.trans headBounds.1, tailBounds.2.trans headBounds.2⟩
+                      | cons second remaining =>
+                          simp only [run, SourcePruningEnumerationCachedAdapter.run, dispatchObserved,
+                            rawObserved, SourcePruningEnumerationCachedAdapter.adapt] at observed
+                          cases observed
+
+/-- A full actual successful observation retains both scalar bounds at its outer prefix and returned cache. -/
+theorem observed_bounds
+    (checkEmpty : Bool) (nativeFuel p h : Nat) (sources : List Nat)
+    (beforeCaller : Caller width) (before : Cached) (target : Nat) (queries : Queries)
+    (raw : Raw) (afterCaller : Caller width) (savedQueries : Queries) (outer : Core) (after : Cached)
+    (observed : run checkEmpty nativeFuel p h sources beforeCaller before target queries =
+      ((.ok (some raw), afterCaller, savedQueries, outer), some after)) :
+    outer.counter = before.core.counter ∧ suspendedBound outer = suspendedBound before.core ∧
+    after.core.counter = before.core.counter ∧ suspendedBound after.core = suspendedBound before.core := by
+  have erased := erase checkEmpty nativeFuel p h sources beforeCaller before target queries
+  rw [observed] at erased
+  have outerBounds := SourcePruningEnumerationFold.observed_counter_mass checkEmpty nativeFuel p h
+    sources beforeCaller before.core target queries (.ok (some raw)) afterCaller savedQueries outer erased.symm
+  have cacheBounds := observed_cache_bounds checkEmpty nativeFuel p h sources beforeCaller before target queries
+    after (by rw [observed])
+  exact ⟨outerBounds.1, outerBounds.2, cacheBounds.1, cacheBounds.2⟩
+
+end MicroCFTA.SourcePruningEnumerationCachedFold
diff --git a/lean/MicroCFTA/SourcePruningEnumerationTerminalPrefixBounds.lean b/lean/MicroCFTA/SourcePruningEnumerationTerminalPrefixBounds.lean
new file mode 100644
index 000000000..1c77e66c5
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationTerminalPrefixBounds.lean
@@ -0,0 +1,69 @@
+import MicroCFTA.SourcePruningEnumerationTerminalPrefix
+import MicroCFTA.SourcePruningEnumerationSuspendedMass
+
+/-!
+# Scalar bounds for the actual terminal prefix
+
+Representative lookup and class union change only the forest. Every actual
+successful prefix therefore preserves the counter and suspended mass.
+-/
+namespace MicroCFTA.SourcePruningEnumerationTerminalPrefix
+open EnumerationState EnumerationCorrectness EnumerationSchedule
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Core" => EnumerationState.State Symbol Constraint
+attribute [local instance] terminalPrefixMonadList
+
+/-- Every actual successful prefix changes only the representative forest. -/
+theorem success_frame
+    (fuel : Nat) (first : Suspended) (rest : List Suspended)
+    (waiting : EnumerationWaitingIndex.Waiting) (before after : Core)
+    (result : List Nat × Nat × EnumerationWaitingIndex.Waiting)
+    (completed : Success (run fuel first rest waiting) before result after) :
+    after = {before with representatives := after.representatives} := by
+  simp only [run] at completed
+  obtain ⟨recorded, scanned, scan, continued⟩ := (success_bind _ _ _ _ _).mp completed
+  obtain ⟨ignored, united, unions, continued⟩ := (success_bind _ _ _ _ _).mp continued
+  cases ignored
+  obtain ⟨winner, resolved, resolution, finished⟩ := (success_bind _ _ _ _ _).mp continued
+  obtain ⟨_resultSame, stateSame⟩ := (success_pure _ result resolved after).mp finished
+  have scanFrame : scanned = {before with representatives := scanned.representatives} := by
+    apply mapM_invariant (fun (sc : Suspended) => representative fuel sc.var)
+      (fun current => current = {before with representatives := current.representatives})
+      (first :: rest) ?_ before scanned recorded rfl scan
+    intro sc _member current root next previous success
+    obtain ⟨found, _lookup, _rootSame, nextSame⟩ :=
+      (representative_success fuel sc.var current next root).mp success
+    rw [nextSame]
+    exact congrArg (fun state : Core => {state with representatives := found.forest}) previous
+  have unionFrame : united = {before with representatives := united.representatives} := by
+    apply forM_invariant (fun (sc : Suspended) => unionVariables fuel first.var sc.var)
+      (fun current => current = {before with representatives := current.representatives})
+      rest ?_ scanned united scanFrame unions
+    intro sc _member current next previous success
+    obtain ⟨forest, _lookup, nextSame⟩ :=
+      (unionVariables_success fuel first.var sc.var current next).mp success
+    rw [nextSame]
+    exact congrArg (fun state : Core => {state with representatives := forest}) previous
+  obtain ⟨found, _lookup, _rootSame, resolvedSame⟩ :=
+    (representative_success fuel first.var united resolved winner).mp resolution
+  rw [stateSame, resolvedSame]
+  exact congrArg (fun state : Core => {state with representatives := found.forest}) unionFrame
+
+/-- An actual singleton prefix retains the original counter and all suspended occurrences. -/
+theorem observed_counter_mass
+    (fuel : Nat) (first : Suspended) (rest : List Suspended)
+    (waiting : EnumerationWaitingIndex.Waiting) (before after : Core)
+    (result : List Nat × Nat × EnumerationWaitingIndex.Waiting)
+    (observed : ExceptT.run (run fuel first rest waiting before) = [.ok (result, after)]) :
+    after.counter = before.counter ∧ suspendedBound after = suspendedBound before := by
+  have completed : Success (run fuel first rest waiting) before result after := by
+    simp only [Success, observed, List.mem_singleton]
+  have frame := success_frame fuel first rest waiting before after result completed
+  have counterSame := congrArg (fun state : Core => state.counter) frame
+  have valuesSame := congrArg (fun state : Core => state.values) frame
+  exact ⟨counterSame, SourcePruningEnumerationPrefixAdmission.suspendedBound_values
+    before after valuesSame⟩
+
+end MicroCFTA.SourcePruningEnumerationTerminalPrefix
diff --git a/lean/MicroCFTA/SourcePruningEnumerationNonterminalCacheBounds.lean b/lean/MicroCFTA/SourcePruningEnumerationNonterminalCacheBounds.lean
new file mode 100644
index 000000000..3bf292294
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationNonterminalCacheBounds.lean
@@ -0,0 +1,116 @@
+import MicroCFTA.SourcePruningEnumerationChildDispatch
+import MicroCFTA.SourcePruningEnumerationSuspendedMass
+
+/-!
+# Counter and suspended mass of actual cached nonterminal children
+
+Ordinary nodes store the complete incoming bucket. Mu and Union allocate
+with an empty bucket. Every successful singleton allocates one slot.
+Empty rejects before allocation and retains the input cache.
+-/
+namespace MicroCFTA.SourcePruningEnumerationCachedPrepare
+open EnumerationState
+open SourcePruningEnumerationNodes
+open SourcePruningEnumerationPrefixAdmission (suspendedBound)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => InternedConstructorTemplates.Value Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+
+/-- Allocation appends one empty bucket and retains the entire original suspended mass. -/
+theorem allocated_mass (node : Option Nat) (before : Core) :
+    suspendedBound (allocated node before) = suspendedBound before := by
+  simp only [suspendedBound, allocated, List.map_append, List.map_cons, List.map_nil,
+    List.sum_append, List.sum_cons, List.sum_nil, List.length_nil, Nat.add_zero]
+
+/-- An actual singleton cache has its exact shape-dependent mass and one fresh slot. -/
+theorem singleton_counter_mass
+    (heap : InternedConstructorTemplates.State Symbol Constraint) (fuel : Nat)
+    (scs : List Suspended) (value : Node) (before after : Cached)
+    (fragment : Fragments.Fragment Symbol)
+    (aligned : before.core.counter = before.core.values.length)
+    (cached : prepareChild heap fuel scs value before = some [(fragment, after)]) :
+    after.core.counter = before.core.counter + 1 ∧
+      suspendedBound after.core = suspendedBound before.core +
+        (match value with | .node .. => scs.length | _ => 0) := by
+  cases value with
+  | empty => simp [prepareChild] at cached
+  | reference name => simp [prepareChild] at cached
+  | node entry edges depth free =>
+      by_cases terminal : scs.any (fun sc => EqualityTrie.isTerminal sc.trie) = true
+      · simp [prepareChild, SourcePruningEnumerationCachedChild.prepareOrdinary, terminal] at cached
+      simp only [prepareChild, Option.map_eq_some_iff] at cached
+      obtain ⟨result, prepared, rowsSame⟩ := cached
+      have resultSame : result = (fragment, after) := (List.cons.inj rowsSame).1
+      subst result
+      simp only [SourcePruningEnumerationCachedChild.prepareOrdinary, terminal, Bool.false_eq_true,
+        ↓reduceIte, encodeNode, Option.bind_some, Option.bind_eq_some_iff,
+        Option.map_eq_some_iff] at prepared
+      obtain ⟨allocation, nativeAllocated, writtenAfter, written, pairSame⟩ := prepared
+      have afterSame : writtenAfter = after := (Prod.mk.inj pairSame).2
+      subst writtenAfter
+      simp only [SourcePruningEnumerationCachedChild.allocate, Option.map_eq_some_iff] at nativeAllocated
+      obtain ⟨flag, _classified, allocationSame⟩ := nativeAllocated
+      subst allocation
+      simp only [SourcePruningEnumerationCachedChild.writeSlot, Option.bind_eq_some_iff] at written
+      obtain ⟨old, _stored, nativeWritten⟩ := written
+      simp only [SourcePruningEnumerationNativeIndex.write, Option.bind_eq_some_iff,
+        Option.some.injEq] at nativeWritten
+      obtain ⟨afterFlag, _afterClassified, removed, _removedCounts, saved, _savedCounts, afterSame⟩ := nativeWritten
+      subst after
+      refine ⟨rfl, ?_⟩
+      have mass := SourcePruningEnumerationSuspendedMass.incoming_mass
+        (allocated (some (entry.identity + 1)) before.core) before.core.counter
+        (some (entry.identity + 1)) (some (entry.identity + 1)) scs []
+        (allocated_slot (some (entry.identity + 1)) before.core aligned)
+      simpa only [List.append_nil, allocated_mass] using mass
+  | union entry _ _ _ | mu entry _ _ _ =>
+      by_cases terminal : scs.any (fun sc => EqualityTrie.isTerminal sc.trie) = true
+      · simp [prepareChild, terminal] at cached
+      simp only [prepareChild, terminal, Bool.false_eq_true, ↓reduceIte, encodeNode,
+        Option.bind_some, Option.map_eq_some_iff] at cached
+      obtain ⟨allocation, nativeAllocated, rowsSame⟩ := cached
+      simp only [SourcePruningEnumerationCachedChild.allocate, Option.map_eq_some_iff] at nativeAllocated
+      obtain ⟨flag, _classified, allocationSame⟩ := nativeAllocated
+      subst allocation
+      have afterSame := (Prod.mk.inj (List.cons.inj rowsSame).1).2
+      subst after
+      exact ⟨rfl, by simpa only [Nat.add_zero] using allocated_mass (some (entry.identity + 1)) before.core⟩
+
+/-- Every actual successful singleton adds at most the complete incoming bucket length. -/
+theorem singleton_counter_mass_le
+    (heap : InternedConstructorTemplates.State Symbol Constraint) (fuel : Nat)
+    (scs : List Suspended) (value : Node) (before after : Cached)
+    (fragment : Fragments.Fragment Symbol)
+    (aligned : before.core.counter = before.core.values.length)
+    (cached : prepareChild heap fuel scs value before = some [(fragment, after)]) :
+    after.core.counter = before.core.counter + 1 ∧
+      suspendedBound after.core ≤ suspendedBound before.core + scs.length := by
+  obtain ⟨counter, mass⟩ := singleton_counter_mass heap fuel scs value before after fragment aligned cached
+  refine ⟨counter, ?_⟩
+  rw [mass]
+  cases value <;> simp only [Nat.add_zero] <;> omega
+
+end MicroCFTA.SourcePruningEnumerationCachedPrepare
+
+namespace MicroCFTA.SourcePruningEnumerationChildDispatch
+open EnumerationState InternedConstructorTemplates
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+variable {width : Nat}
+variable [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+
+/-- Empty rejects at the original native endpoint and retains exactly the input cache. -/
+theorem empty_cached
+    (checkEmpty : Bool) (r n p h k : Nat) (scs : List Suspended)
+    (caller : Caller width) (before : Cached) (queries : Queries) :
+    run checkEmpty r n p h k scs .empty caller before queries =
+      ((.ok (some []), caller, queries, before.core, before.waiting), some before) := by
+  simp [run]
+
+end MicroCFTA.SourcePruningEnumerationChildDispatch
