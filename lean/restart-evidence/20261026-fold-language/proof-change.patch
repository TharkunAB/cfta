new file mode 100644
index 000000000..46f86c700
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationDispatchObservedPacket.lean
@@ -0,0 +1,118 @@
+import MicroCFTA.SourcePruningEnumerationDispatchLanguage
+import MicroCFTA.SourcePruningEnumerationDispatchUnique
+import MicroCFTA.EnumerationCompleteness
+
+/-!
+# Current entry facts and assignment meaning of an actual dispatcher observation
+
+One canonical receipt identifies the observed action, caller and query memo.
+An actual singleton retains the target and every old pending or eliminated slot.
+-/
+namespace MicroCFTA.SourcePruningEnumerationDispatch
+open EnumerationState EnumerationCorrectness InternedConstructorTemplates InternedProbeProvenance
+open SourcePruningEnumerationNodes SourcePruningEnumerationObservation
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Context Post)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => InternedConstructorTemplates.Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Queries" => SourceEndpointMemo.Memos
+variable {EnumGuard : Type} {width : Nat}
+
+/-- Retain the exact head receipt and derive current slot facts from its actual singleton. -/
+theorem observed_packet
+    [DecidableEq Symbol] [DecidableEq (EdgeKey Symbol Constraint)] [DecidableEq Node]
+    (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (beforeCaller : Caller width)
+    (before : EnumerationState.State Symbol EnumGuard)
+    (checkEmpty : Bool) (source target : Nat) (memos : Memos)
+    (initial : Context formulas solver inventory beforeCaller memos)
+    (realized : PendingRealized beforeCaller.checked.native.machine.heap before)
+    (slots : source = target ∨ before.values[source]? = some .eliminated ∨
+      ∃ (sourceNode targetNode : Option Nat) (sourceScs targetScs : List EnumerationState.Suspended),
+        before.values[source]? = some (.unenumerated sourceNode sourceScs) ∧
+        before.values[target]? = some (.unenumerated targetNode targetScs))
+    (ranges : if source = target then True else
+      match before.values[source]?, before.values[target]? with
+      | some (.unenumerated (some left) _), some (.unenumerated (some right) _) =>
+          match lookupNode beforeCaller.checked.native.machine.heap left,
+              lookupNode beforeCaller.checked.native.machine.heap right with
+          | some first, some second => SourceCurrentAllocatedNativeRequestBounds.WordRanges
+              (.code (SourceRecursiveIntersectionCode.requestNode IntersectionEmptyDomain.emptyDomain first second))
+              beforeCaller.checked
+          | _, _ => True
+      | _, _ => True)
+    (targetPending : EnumerationCompleteness.PendingAt before target)
+    {n p h : Nat} {action : EnumerateM Symbol EnumGuard Unit}
+    {reachedCaller : Caller width} {savedQueries : Queries}
+    (observed : dispatch checkEmpty n p h beforeCaller before source target memos.query =
+      (.ok (some action), reachedCaller, savedQueries)) :
+    ∃ (next : Inventory) (final : Memos),
+      Post formulas solver next beforeCaller reachedCaller final ∧ final.query = savedQueries ∧
+      PendingRealized reachedCaller.checked.native.machine.heap before ∧
+      (∀ after : EnumerationState.State Symbol EnumGuard,
+        ExceptT.run (action before) = [.ok ((), after)] →
+          PendingRealized reachedCaller.checked.native.machine.heap after ∧
+          EnumerationCompleteness.PendingAt after target ∧
+          after.representatives = before.representatives ∧
+          ∀ uv, (before.values[uv]? = some .eliminated ∨ EnumerationCompleteness.PendingAt before uv) →
+            after.values[uv]? = some .eliminated ∨ EnumerationCompleteness.PendingAt after uv) ∧
+      ∀ (ambient : InternedGuardedLanguage.Env Symbol)
+        (residualMeaning : EnumGuard → Language.Term Symbol → Prop)
+        (assignment : Nat → Language.Term Symbol),
+        UnionFind.SameClass before.representatives source target →
+          ((∃ after : EnumerationState.State Symbol EnumGuard,
+            Except.ok ((), after) ∈ ExceptT.run (action before) ∧
+            Satisfies
+              (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+                ambient reachedCaller.checked.native.machine.heap) residualMeaning assignment after) ↔
+          Satisfies
+            (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+              ambient beforeCaller.checked.native.machine.heap) residualMeaning assignment before) := by
+  obtain ⟨fuel, minimumP, minimumH, canonical, afterCaller, returnedQueries, final, next,
+    stable, post, querySame, afterRealized, noop, live, semantic⟩ :=
+      dispatch_complete_semantics formulas solver inventory beforeCaller before checkEmpty source target memos
+        initial realized slots ranges
+  have canonicalObserved : dispatch checkEmpty fuel minimumP minimumH
+      beforeCaller before source target memos.query =
+      (.ok (some canonical), afterCaller, returnedQueries) := by
+    simpa only [Nat.add_zero] using
+      stable 0 minimumP minimumH (Nat.le_refl minimumP) (Nat.le_refl minimumH)
+  obtain ⟨actionsSame, callerSame, queriesSame⟩ := ok_unique checkEmpty observed canonicalObserved
+  have actionSame : action = canonical := Option.some.inj actionsSame
+  subst canonical
+  subst afterCaller
+  refine ⟨next, final, post, querySame.trans queriesSame.symm, afterRealized, ?_, semantic⟩
+  intro after completed
+  by_cases noWork : source = target ∨ before.values[source]? = some .eliminated
+  · have raw := (noop noWork).1
+    have afterSame : before = after := by
+      simpa only [raw, List.cons.injEq, Except.ok.injEq, Prod.mk.injEq, true_and, and_true] using completed
+    subst after
+    exact ⟨afterRealized, targetPending, rfl, fun _ previous => previous⟩
+  · have different : source ≠ target := fun same => noWork (.inl same)
+    have notEliminated : before.values[source]? ≠ some .eliminated := fun same => noWork (.inr same)
+    obtain ⟨sourceNode, targetNode, merged, sourceScs, targetScs, sourceStored, targetStored,
+      raw, surviving, _optional, _present⟩ := live different notEliminated
+    have nonzero : merged ≠ some 0 := by
+      intro empty
+      rw [raw, ite_eq_left empty] at completed
+      cases completed
+    rw [raw, ite_eq_right nonzero] at completed
+    have afterSame :
+        assimilated before target source (.unenumerated merged (sourceScs ++ targetScs)) = after := by
+      simpa only [List.cons.injEq, Except.ok.injEq, Prod.mk.injEq, true_and, and_true] using completed
+    subst after
+    obtain ⟨_targetStored, _sourceStored, nextRealized⟩ := surviving nonzero
+    have pending := EnumerationCompleteness.assimilated_pending before target source merged
+      (sourceScs ++ targetScs) (Ne.symm different)
+      (List.getElem?_eq_some_iff.mp targetStored).1 (List.getElem?_eq_some_iff.mp sourceStored).1
+    refine ⟨nextRealized, pending.1, rfl, ?_⟩
+    intro uv previous
+    have oldShape : EnumerationCompleteness.PendingOrEliminated before uv := previous.elim Or.inr Or.inl
+    exact (pending.2 uv oldShape).elim Or.inr Or.inl
+
+end MicroCFTA.SourcePruningEnumerationDispatch
diff --git a/lean/MicroCFTA/SourcePruningEnumerationFoldObservedLanguage.lean b/lean/MicroCFTA/SourcePruningEnumerationFoldObservedLanguage.lean
new file mode 100644
index 000000000..33202beab
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationFoldObservedLanguage.lean
@@ -0,0 +1,151 @@
+import MicroCFTA.SourcePruningEnumerationFold
+import MicroCFTA.SourcePruningEnumerationDispatchObservedPacket
+
+/-!
+# Complete assignments through an actual native fold observation
+
+Each surviving head supplies the original admission for its actual suffix.
+Every returned row uses its own reached native heap. A rejected head has
+no satisfying branch. No future successful call or final assignment is an input.
+-/
+namespace MicroCFTA.SourcePruningEnumerationFold
+open EnumerationState EnumerationCorrectness
+open SourcePruningEnumerationNodes SourcePruningEnumerationObservation
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Context Post)
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => InternedConstructorTemplates.Value Symbol Constraint
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Queries" => SourceEndpointMemo.Memos
+variable {EnumGuard : Type} {width : Nat}
+
+/-- The whole actual fold preserves assignments already equated at every selected source. -/
+theorem observed_semantics
+    [DecidableEq Symbol] [DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Constraint)] [DecidableEq Node]
+    (formulas : SourceGuards.Formulas FullSyntax.Formula)
+    (solver : SourceGuards.Entailment FullSyntax.Formula)
+    (inventory : Inventory) (beforeCaller : Caller width)
+    (before : EnumerationState.State Symbol EnumGuard) (sources : List Nat)
+    (checkEmpty : Bool) (target : Nat) (memos : Memos)
+    (initial : Context formulas solver inventory beforeCaller memos)
+    (realized : PendingRealized beforeCaller.checked.native.machine.heap before)
+    (targetPending : ∃ (node : Option Nat) (scs : List EnumerationState.Suspended),
+      before.values[target]? = some (.unenumerated node scs))
+    (selected : ∀ source ∈ sources, before.values[source]? = some .eliminated ∨
+      ∃ (node : Option Nat) (scs : List EnumerationState.Suspended),
+        before.values[source]? = some (.unenumerated node scs))
+    (ranges : Ranges checkEmpty sources beforeCaller before target memos.query)
+    {n p h : Nat}
+    {raw : List (Except EnumerationState.Error (Unit × EnumerationState.State Symbol EnumGuard))}
+    {afterCaller : Caller width} {after : EnumerationState.State Symbol EnumGuard} {savedQueries : Queries}
+    (observed : run checkEmpty n p h sources beforeCaller before target memos.query =
+      (.ok (some raw), afterCaller, savedQueries, after)) :
+    ∀ (ambient : InternedGuardedLanguage.Env Symbol)
+      (residualMeaning : EnumGuard → Language.Term Symbol → Prop)
+      (assignment : Nat → Language.Term Symbol),
+      (∀ source ∈ sources, UnionFind.SameClass before.representatives source target) →
+        ((∃ output : EnumerationState.State Symbol EnumGuard,
+          Except.ok ((), output) ∈ raw ∧
+          Satisfies
+            (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+              ambient afterCaller.checked.native.machine.heap) residualMeaning assignment output) ↔
+        Satisfies
+          (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+            ambient beforeCaller.checked.native.machine.heap) residualMeaning assignment before) := by
+  induction sources generalizing inventory beforeCaller before memos with
+  | nil =>
+      simp only [run, Prod.mk.injEq, Except.ok.injEq, Option.some.injEq] at observed
+      rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+      intro ambient residualMeaning assignment _joined
+      simp
+  | cons source rest ih =>
+      rcases dispatched : SourcePruningEnumerationDispatch.dispatch checkEmpty n p h
+          beforeCaller before source target memos.query with ⟨result, reachedCaller, saved⟩
+      cases result with
+      | error fault =>
+          simp only [run, dispatched] at observed
+          cases observed
+      | ok possible =>
+          cases possible with
+          | none =>
+              simp only [run, dispatched] at observed
+              cases observed
+          | some action =>
+              have slots : source = target ∨ before.values[source]? = some .eliminated ∨
+                  ∃ (sourceNode targetNode : Option Nat) (sourceScs targetScs : List EnumerationState.Suspended),
+                    before.values[source]? = some (.unenumerated sourceNode sourceScs) ∧
+                    before.values[target]? = some (.unenumerated targetNode targetScs) := by
+                rcases selected source (List.mem_cons_self) with eliminated | ⟨sourceNode, sourceScs, sourceStored⟩
+                · exact .inr (.inl eliminated)
+                · obtain ⟨targetNode, targetScs, targetStored⟩ := targetPending
+                  exact .inr (.inr ⟨sourceNode, targetNode, sourceScs, targetScs, sourceStored, targetStored⟩)
+              obtain ⟨headInventory, headMemos, headPost, querySame, _oldRealized,
+                singleton, headMeaning⟩ := SourcePruningEnumerationDispatch.observed_packet
+                  formulas solver inventory beforeCaller before checkEmpty source target memos initial
+                  realized slots ranges.1 targetPending dispatched
+              cases rawObserved : ExceptT.run (action before) with
+              | nil =>
+                  simp only [run, dispatched, rawObserved, Prod.mk.injEq, Except.ok.injEq,
+                    Option.some.injEq] at observed
+                  rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                  intro ambient residualMeaning assignment joined
+                  simpa only [rawObserved] using
+                    headMeaning ambient residualMeaning assignment (joined source (List.mem_cons_self))
+              | cons first tail =>
+                  cases first with
+                  | error fault =>
+                      simp only [run, dispatched, rawObserved, Prod.mk.injEq, Except.ok.injEq,
+                        Option.some.injEq] at observed
+                      rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                      intro ambient residualMeaning assignment joined
+                      simpa only [rawObserved] using
+                        headMeaning ambient residualMeaning assignment (joined source (List.mem_cons_self))
+                  | ok pair =>
+                      rcases pair with ⟨valueUnit, middle⟩
+                      cases valueUnit
+                      cases tail with
+                      | cons next remaining =>
+                          simp only [run, dispatched, rawObserved, Prod.mk.injEq, Except.ok.injEq,
+                            Option.some.injEq] at observed
+                          rcases observed with ⟨rfl, rfl, rfl, rfl⟩
+                          intro ambient residualMeaning assignment joined
+                          simpa only [rawObserved] using
+                            headMeaning ambient residualMeaning assignment (joined source (List.mem_cons_self))
+                      | nil =>
+                          obtain ⟨middleRealized, middlePending, forestSame, preserved⟩ := singleton middle rawObserved
+                          have tailSelected : ∀ remaining ∈ rest,
+                              middle.values[remaining]? = some .eliminated ∨
+                                ∃ (node : Option Nat) (scs : List EnumerationState.Suspended),
+                                  middle.values[remaining]? = some (.unenumerated node scs) := by
+                            intro remaining member
+                            exact preserved remaining (selected remaining (List.mem_cons_of_mem source member))
+                          have tailRanges : Ranges checkEmpty rest reachedCaller middle target headMemos.query := by
+                            rw [querySame]
+                            exact ranges.2 n p h action reachedCaller saved middle dispatched rawObserved
+                          have tailObserved : run checkEmpty n p h rest reachedCaller middle target headMemos.query =
+                              (.ok (some raw), afterCaller, savedQueries, after) := by
+                            rw [querySame]
+                            simpa only [run, dispatched, rawObserved] using observed
+                          intro ambient residualMeaning assignment joined
+                          have tailJoined : ∀ remaining ∈ rest,
+                              UnionFind.SameClass middle.representatives remaining target := by
+                            intro remaining member
+                            rw [forestSame]
+                            exact joined remaining (List.mem_cons_of_mem source member)
+                          have tailMeaning := ih headInventory reachedCaller middle headMemos
+                            headPost.context middleRealized middlePending tailSelected tailRanges tailObserved
+                            ambient residualMeaning assignment tailJoined
+                          have singleMeaning :
+                              Satisfies
+                                (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+                                  ambient reachedCaller.checked.native.machine.heap) residualMeaning assignment middle ↔
+                              Satisfies
+                                (SourcePruningEnumerationNativeLanguage.handles (SourceEqualityPCSGuard.holds formulas solver)
+                                  ambient beforeCaller.checked.native.machine.heap) residualMeaning assignment before := by
+                            simpa [rawObserved] using
+                              headMeaning ambient residualMeaning assignment (joined source (List.mem_cons_self))
+                          exact tailMeaning.trans singleMeaning
+
+end MicroCFTA.SourcePruningEnumerationFold
diff --git a/lean/MicroCFTA/SourcePruningEnumerationFoldLanguage.lean b/lean/MicroCFTA/SourcePruningEnumerationFoldLanguage.lean
