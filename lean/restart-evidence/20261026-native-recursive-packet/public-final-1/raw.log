                                                                                    ((uv, newHandle, scs,
                                                                                        MicroCFTA.InternedConstructorTemplates.Value.node
                                                                                          parentEntry storedEdges depth
                                                                                          free),
                                                                                      entered.core)],
                                                                                some outcome))) ∧
                                                                      MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post
                                                                          formulas solver next caller lastCaller last ∧
                                                                        last.query = saved ∧
                                                                          (∀
                                                                              (receipt :
                                                                                MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                  width),
                                                                              receipt ∈ processed →
                                                                                MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Admitted
                                                                                  uv receipt) ∧
                                                                            (∀
                                                                                (receipt :
