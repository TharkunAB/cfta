                      queries = memos.query ∧
                        MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver inventory caller reached
                            final ∧
                          final.query = queries ∧
                            (value = MicroCFTA.InternedConstructorTemplates.Value.empty ∧
