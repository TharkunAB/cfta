'MicroCFTA.OuterPrefixUniqueChecks.two_ordered_rows_align' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
@MicroCFTA.OuterPrefixUniqueChecks.two_ordered_rows_align : ∀
  [inst : DecidableEq.{1} (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq.{1}
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [inst_2 :
    DecidableEq.{1}
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  {width budget : Nat} {inherited : MicroCFTA.SourceEqualityConstraintAllocation.Value}
  {original1 original2 narrowed1 otherNarrowed1 child1 otherChild1 narrowed2 otherNarrowed2 child2 otherChild2 :
    MicroCFTA.InternedConstructorTemplates.EdgeValue (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {before mid1 otherMid1 after1 otherAfter1 mid2 otherMid2 after2 otherAfter2 :
    MicroCFTA.SourceCurrentAllocatedPartialState.State width},
  @MicroCFTA.SourceCurrentAllocatedPartialGraph.EdgeCall inst inst_1 inst_2 width budget
      { inherited := inherited, value := original1 } before narrowed1 mid1 →
    @MicroCFTA.SourceCurrentAllocatedPartialGraph.EdgeCall inst inst_1 inst_2 width budget
        { inherited := inherited, value := original1 } before otherNarrowed1 otherMid1 →
      @MicroCFTA.SourceCurrentAllocatedPartialGraph.Descendants inst inst_1 inst_2 width budget inherited narrowed1 mid1
          child1 after1 →
        @MicroCFTA.SourceCurrentAllocatedPartialGraph.Descendants inst inst_1 inst_2 width budget inherited
            otherNarrowed1 otherMid1 otherChild1 otherAfter1 →
          @MicroCFTA.SourceCurrentAllocatedPartialGraph.EdgeCall inst inst_1 inst_2 width budget
              { inherited := inherited, value := original2 } after1 narrowed2 mid2 →
            @MicroCFTA.SourceCurrentAllocatedPartialGraph.EdgeCall inst inst_1 inst_2 width budget
                { inherited := inherited, value := original2 } otherAfter1 otherNarrowed2 otherMid2 →
              @MicroCFTA.SourceCurrentAllocatedPartialGraph.Descendants inst inst_1 inst_2 width budget inherited
                  narrowed2 mid2 child2 after2 →
                @MicroCFTA.SourceCurrentAllocatedPartialGraph.Descendants inst inst_1 inst_2 width budget inherited
                    otherNarrowed2 otherMid2 otherChild2 otherAfter2 →
                  And
                    (@Eq.{1}
                      (MicroCFTA.InternedConstructorTemplates.EdgeValue
                        (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                      narrowed1 otherNarrowed1)
                    (And (@Eq.{2} (MicroCFTA.SourceCurrentAllocatedPartialState.State width) mid1 otherMid1)
                      (And
                        (@Eq.{1}
                          (MicroCFTA.InternedConstructorTemplates.EdgeValue
                            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                          child1 otherChild1)
                        (And (@Eq.{2} (MicroCFTA.SourceCurrentAllocatedPartialState.State width) after1 otherAfter1)
                          (And
                            (@Eq.{1}
                              (MicroCFTA.InternedConstructorTemplates.EdgeValue
                                (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                                (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                              narrowed2 otherNarrowed2)
                            (And (@Eq.{2} (MicroCFTA.SourceCurrentAllocatedPartialState.State width) mid2 otherMid2)
                              (And
                                (@Eq.{1}
                                  (MicroCFTA.InternedConstructorTemplates.EdgeValue
                                    (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                                    (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
                                  child2 otherChild2)
                                (@Eq.{2} (MicroCFTA.SourceCurrentAllocatedPartialState.State width) after2
                                  otherAfter2)))))))
