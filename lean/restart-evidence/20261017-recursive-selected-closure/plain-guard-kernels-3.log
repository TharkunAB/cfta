  SourceEqualityConstraintMemoAllocation.Valid before →
    SourceEqualityGuardReadback.Cached (@SourceSymbolicIndex.Constraint.equalities FullSyntax.Formula left) →
      SourceEqualityGuardReadback.Cached (@SourceSymbolicIndex.Constraint.equalities FullSyntax.Formula right) →
        @Eq.{1} Bool (SourceMemoGate.plain left) true →
          @Eq.{1} Bool (SourceMemoGate.plain right) true →
            @Exists.{1} (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) fun first =>
              @Exists.{1} SourceEqualityConstraintMemoAllocation.State fun middle =>
                @Exists.{1} (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) fun second =>
                  @Exists.{1} SourceEqualityConstraintMemoAllocation.State fun loaded =>
                    @Exists.{1} (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) fun combined =>
                      @Exists.{1} (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) fun result =>
                        And
                          (@Eq.{1}
                            (Prod.{0, 0}
                              (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                              SourceEqualityConstraintMemoAllocation.State)
                            (@SourceEqualityConjoinAllocation.construct FullSyntax.Formula
                              (@SourceSymbolicIndex.Constraint.equalities FullSyntax.Formula left)
                              (@SourceSymbolicIndex.Constraint.guard FullSyntax.Formula left) before)
                            (@Prod.mk.{0, 0}
                              (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                              SourceEqualityConstraintMemoAllocation.State
                              (@Except.ok.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula)
                                first)
                              middle))
                          (And
                            (@Eq.{1}
                              (Prod.{0, 0}
                                (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                                SourceEqualityConstraintMemoAllocation.State)
                              (@SourceEqualityConjoinAllocation.construct FullSyntax.Formula
                                (@SourceSymbolicIndex.Constraint.equalities FullSyntax.Formula right)
                                (@SourceSymbolicIndex.Constraint.guard FullSyntax.Formula right) middle)
                              (@Prod.mk.{0, 0}
                                (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                                SourceEqualityConstraintMemoAllocation.State
                                (@Except.ok.{0, 0} String
                                  (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula) second)
                                loaded))
                            (And
                              (@Eq.{1}
                                (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                                (@Prod.fst.{0, 0}
                                  (Except.{0, 0} String (SourceEqualityConjoinAllocation.Constraint FullSyntax.Formula))
                                  SourceEqualityConstraintMemoAllocation.State
                                  (@SourceEqualityConjoinAllocation.conjoin FullSyntax.Formula inst le first second
