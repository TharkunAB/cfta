      (∀ (paths : MicroCFTA.EqualityNormalize.Class),
          paths ∈ classes → ∀ (path : MicroCFTA.EqualityNormalize.Path), path ∈ paths → path ≠ []) →
        (∀ (paths : MicroCFTA.EqualityNormalize.Class),
            paths ∈ classes → MicroCFTA.EqualityNormalize.Nontrivial paths) →
          MicroCFTA.SourceCurrentConjunctionClassScanCompletion.Ranges budget MicroCFTA.SourceMemoGate.unconstrained
              (MicroCFTA.SourceEndpointReachability.reaches MicroCFTA.SourceMemoGate.unconstrained) values classes
              before.checked before.fourth →
            MicroCFTA.SourceCurrentAllocatedScanWorker.scan g s p h n budget values classes before.checked
                  before.fourth =
                MicroCFTA.SourceCurrentAllocatedScanWorker.Outcome.done (outcome, selected) after saved →
