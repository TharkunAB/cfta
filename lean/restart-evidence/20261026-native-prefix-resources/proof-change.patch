index 000000000..93b05f924
--- /dev/null
+++ b/lean/MicroCFTA/SourcePruningEnumerationCallbackResources.lean
@@ -0,0 +1,110 @@
+import MicroCFTA.SourcePruningEnumerationRecursiveCallback
+import MicroCFTA.SourcePruningEnumerationPrefixResources
+
+/-!
+# Initial resources through the actual callback and next prefix
+
+The callback retains its exact earlier certificate and native caller. The
+next accepted prefix supplies its actual native resource bound and restart
+packet. This result does not execute a recursive subtree or later sibling.
+-/
+namespace MicroCFTA.SourcePruningEnumerationRecursive
+open EnumerationState EnumerationCorrectness EnumerationDriver EnumerationOrder EnumerationCompressionFrame
+open SourceCurrentAllocatedNativeInventoryState (Inventory)
+open SourceCurrentAllocatedPartialInvariant (Post)
+open SourceCurrentAllocatedNativeResourceForecast (Profile)
+open SourceCurrentConstrainedCapGeneratedQueryResources (Fits)
+local notation "Heap" => SourceEqualityAnnotationHeap.Heap
+open SourcePruningRecordTypes SourcePruningPartialMatch
+local notation "Symbol" => SourcePruningTemplates.Symbol
+local notation "Constraint" => SourceSymbolicIndex.Constraint FullSyntax.Formula
+local notation "Node" => InternedConstructorTemplates.Value Symbol Constraint
+local notation "Fragment" => Fragments.Fragment Symbol
+local notation "Caller" => SourceCurrentAllocatedPartialState.State
+local notation "Queries" => SourceEndpointMemo.Memos
+local notation "Memos" => EndpointMemoGateTrace.Memos
+local notation "Cached" => EnumerationExpandableIndex.Cached Symbol Constraint
+local notation "Core" => EnumerationState.State Symbol Constraint
+variable {Typing Key : Type} {width : Nat}
+variable [DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Constraint)]
+variable (formulas : SourceGuards.Formulas FullSyntax.Formula)
+variable (solver : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory)
+variable (graph : Graph Symbol Constraint) (templates : List (Template.Pattern Symbol))
+variable (metadata : Metadata Typing) (uv : Nat) (fragment : Fragment)
+variable (caller : Caller width) (memos : Memos) (before : Cached)
+local notation "Result" => SourcePruningEnumerationNativeContinuations.HookResult
+  (Output width Typing) (Failure width Typing) width
+variable [DecidableEq Symbol] [DecidableEq Node]
+
+/-- The actual callback and its next prefix retain full packets and original resources. -/
+theorem callback_prefix_complete_resources
+    (holeKey : Typing → Nat → Key) (fits : Key → Symbol → Bool) (admits : Key → Node → Bool)
+    (checkEmpty : Bool) (edgesOf : Node → List (InternedConstructorTemplates.EdgeValue Symbol Constraint))
+    (stop : Option (Metadata Typing → Nat → Bool)) (order : Metadata Typing → List Nat → Option Nat)
+    (packet : Packet formulas solver inventory caller memos metadata before)
+    (allocated : FragmentBound before.core.counter fragment)
+    (profile : Profile) (property : Constraint → Prop)
+    (bounded : Fits profile caller.checked) (known : Heap property caller.checked.native.machine.heap) :
+    ∃ fuel result after,
+      (Packet formulas solver inventory caller memos result.2 (EnumerationExpandableIndex.frame after before) ∧
+      RenderStable before.core after ∧ Frame before.core after ∧
+      result.2.types = updatedTypes metadata uv (.inl fragment) ∧
+      result.2.openHoles = metadata.openHoles ∧ result.2.typing = metadata.typing ∧
+      ∀ extra,
+        Success (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment)) before.core result after ∧
+        ExceptT.run (recordTypes graph templates (fuel + extra) metadata uv (.inl fragment) before.core) =
+          [.ok (result, after)] ∧
+        (∀ recur : Metadata Typing → Caller width → Queries → Cached → Option Next → Result,
+          continueWith recur graph templates stop order (fuel + extra) metadata uv fragment caller memos.query before =
+            if result.1 then .complete [] caller memos.query
+            else recur result.2 caller memos.query (EnumerationExpandableIndex.frame after before)
+              (SourcePruningEnumerationRestart.decision stop order result.2
+                (EnumerationExpandableIndex.frame after before))) ∧
+        (result.1 = false → ∀ selected,
+          SourcePruningEnumerationRestart.decision stop order result.2
+              (EnumerationExpandableIndex.frame after before) = some (.expand selected) →
+          SourcePruningEnumerationSelectedStep.PrefixValid holeKey fits admits graph templates checkEmpty edgesOf
+            stop order result.2 formulas solver inventory (fuel + extra) selected caller
+            (EnumerationExpandableIndex.frame after before) memos
+            (SourcePruningEnumerationSelectedStep.runPrefix holeKey fits admits graph templates stop order result.2
+              (fuel + extra) (fuel + extra) (fuel + extra) (fuel + extra) (fuel + extra) (fuel + extra)
+              selected caller (EnumerationExpandableIndex.frame after before) memos.query))) ∧
+      (∀ extra, result.1 = false → ∀ selected,
+        SourcePruningEnumerationRestart.decision stop order result.2
+            (EnumerationExpandableIndex.frame after before) = some (.expand selected) →
+        let observed := SourcePruningEnumerationSelectedStep.runPrefix holeKey fits admits graph templates
+          stop order result.2 (fuel + extra) (fuel + extra) (fuel + extra)
+          (fuel + extra) (fuel + extra) (fuel + extra) selected caller
+          (EnumerationExpandableIndex.frame after before) memos.query
+        SourcePruningEnumerationSelectedStep.Resources profile property caller observed ∧
+        match observed with
+        | .parked _ (some reachedCache) _ =>
+            Packet formulas solver inventory caller memos result.2 reachedCache
+        | .narrowed _ _ reached queries _ (some reachedCache) _ _ =>
+            ∃ final, Post formulas solver inventory caller reached final ∧ final.query = queries ∧
+              Packet formulas solver inventory reached final result.2 reachedCache
+        | _ => True) := by
+  obtain ⟨fuel, result, after, returned, stable, frame, types, holes, typing, callback⟩ :=
+    callback_prefix_complete formulas solver inventory graph templates metadata uv fragment caller memos before
+      holeKey fits admits checkEmpty edgesOf stop order packet allocated
+  obtain ⟨_roots, _paths, _storage, realized, _counts, _flags⟩ := returned.valid
+  refine ⟨fuel, result, after, ⟨returned, stable, frame, types, holes, typing, callback⟩, ?_⟩
+  intro extra accepted selected chosen
+  have valid := (callback extra).2.2.2 accepted selected chosen
+  dsimp only
+  generalize actual : SourcePruningEnumerationSelectedStep.runPrefix holeKey fits admits graph templates
+    stop order result.2 (fuel + extra) (fuel + extra) (fuel + extra)
+    (fuel + extra) (fuel + extra) (fuel + extra) selected caller
+    (EnumerationExpandableIndex.frame after before) memos.query = observed at valid ⊢
+  refine ⟨SourcePruningEnumerationSelectedStep.prefix_resources holeKey fits admits graph templates checkEmpty edgesOf
+      stop order result.2 formulas solver inventory (fuel + extra) selected caller
+      (EnumerationExpandableIndex.frame after before) memos profile property returned.context realized bounded known _ valid, ?_⟩
+  have reached := prefix_packet holeKey fits admits graph templates checkEmpty edgesOf stop order result.2
+    formulas solver inventory (fuel + extra) selected caller memos
+    (EnumerationExpandableIndex.frame after before) returned observed valid
+  cases observed with
+  | stopped _ _ => trivial
+  | parked checked candidate raw => cases candidate <;> exact reached
+  | narrowed checked prepared native queries action candidate right ordinary => cases candidate <;> exact reached
+
+end MicroCFTA.SourcePruningEnumerationRecursive
diff --git a/lean/MicroCFTA/SourcePruningEnumerationPrefixResources.lean b/lean/MicroCFTA/SourcePruningEnumerationPrefixResources.lean
