child : Node
split : originals✝ = skipped ++ original :: rest
cut :
  Reached g s r e p h m c n budget
    (Phase.rows fuel✝
      { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.inherited originals✝
      before)
    (Phase.rows (childFuel + slot + 2)
      { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.inherited
      (original :: rest) rowBefore)
parent :
  edgeCall (childFuel + slot + 1) g s r e p h m c n budget
      {
        inherited :=
          { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.inherited,
        value := original }
      rowBefore =
    Outcome.done parented afterParent
combinedAt :
  (SourceCurrentAllocatedInheritedPrefix.run parented.entry.key.constraint
        { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.inherited
        afterParent.checked.operations).fst =
    Except.ok (some combined)
live : combined ≠ SourceEqualityConstraintAllocation.Value.contradiction
previous :
  walk (childFuel + slot + 1) g s r e p h m c n budget combined 0 (List.take slot parented.children)
      (prefixState afterParent parented
        { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.inherited) =
    Outcome.done earlier start
selected : parented.children[slot]? = some child
tail :
  NodeTail childFuel { inherited := (descend start combined slot).fst, value := child }
    (descend start combined slot).snd (Phase.node candidateFuel candidate current)
ownerSplit : ownerRows = skipped ++ original :: rest
