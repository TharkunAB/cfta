width g s r e p h m c n budget candidateFuel : Nat
inherited : EqValue
ownerEntry : Interned InternedBinderProtocol.NodeKey
ownerDepth : Nat
ownerFree : List InternedBinderProtocol.Reference
ownerRows : List Edge
before current : Caller width
candidate : NodeRequest
fuel✝ : Nat
originals✝ : List Edge
entry✝ : Interned InternedBinderProtocol.NodeKey
depth✝ : Nat
free✝ : List InternedBinderProtocol.Reference
actual :
  Reached g s r e p h m c n budget
    (Phase.body (fuel✝ + 1) { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }
      before)
    (Phase.node candidateFuel candidate current)
ordinary :
  { inherited := inherited, value := Value.node ownerEntry ownerRows ownerDepth ownerFree }.value =
    Value.node entry✝ originals✝ depth✝ free✝
remaining :
  Reached g s r e p h m c n budget
