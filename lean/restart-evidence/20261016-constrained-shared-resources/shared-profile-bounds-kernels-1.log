'MicroCFTA.SharedProfileBoundChecks.three_member_order' does not depend on any axioms
three_member_order : operandPaths [[0], [1], [2]] [1] = [[0], [2]] ∧
  (operandPaths [[0], [1], [2]] [1]).length = 2 ∧
    ∀ (path : List Int), path ∈ operandPaths [[0], [1], [2]] [1] → path.length ≤ 1
'MicroCFTA.SharedProfileBoundChecks.singleton_target' depends on axioms: [propext, Quot.sound]
singleton_target : ∀ (rows arity count depth bound : Nat) (path : EqualityNormalize.Path),
  SourceCurrentAllocatedFiniteOrdinaryTargetResources.outputRows rows count depth bound
        (operandPaths [path] path).length =
      0 ∧
    N rows arity count depth bound (operandPaths [path] path).length = 0 ∧
      E rows arity count depth bound (operandPaths [path] path).length = 0
'MicroCFTA.SharedProfileBoundChecks.original_record_target' depends on axioms: [propext, Classical.choice, Quot.sound]
@original_record_target : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (EdgeKey Symbol Guard)]
  (formulas : SourceGuards.Formulas FullSyntax.Formula) (solver : SourceGuards.Entailment FullSyntax.Formula)
  (inventory : Inventory) (record : Record),
  Coherent record →
    ∀ (selected : EqualityNormalize.Path),
      selected ∈ record.paths →
        ∀ (bits : Nat) (values : List (Value Symbol Guard)) (before : Checked (bits + 2)) (memo : Memo),
          Ready before →
            At formulas solver inventory before →
              Values before.native.machine.heap values →
                SourceCurrentMemoMergeEffects.Stored before.native.machine.heap memo →
                  Profiles memo →
                    NativeStored before.native →
                      OutputStored before.native →
                        (∀ (ambient : InternedGuardedLanguage.Env Symbol),
                            SourceCurrentMemoMergeLanguage.CacheCovers (SourceEqualityPCSGuard.holds formulas solver)
                              ambient memo) →
                          ∀ (memos : Memos),
                            EndpointMemoGateTrace.Valid before.native.machine.heap memos →
                              ∀ (rows arity count depth bound members : Nat),
                                ChildrenShape rows arity values →
                                  values.length ≤ count →
                                    List.length record.paths ≤ members →
                                      (∀ (path : EqualityNormalize.Path),
                                          path ∈ record.paths → List.length path ≤ depth) →
                                        childrenHeight values ≤ bound →
                                          before.native.machine.heap.nodes.next +
                                                N rows arity count depth bound (members - 1) ≤
                                              2 ^ bits →
                                            before.native.machine.heap.edges.next +
                                                  E rows arity count depth bound (members - 1) ≤
                                                2 ^ (bits + 2) →
                                              ∃ result after saved next final actual,
                                                StableRun
                                                    (fun p h m s n =>
                                                      SourceCurrentAllocatedTargetWorker.target p h m s n values
                                                        (operandPaths record.paths selected) before memo)
                                                    result after saved ∧
                                                  TargetReads formulas solver actual memos final ∧
                                                    Receipt formulas solver next values
                                                        (operandPaths record.paths selected) before memo result after
                                                        saved memos final ∧
                                                      NodeShape
                                                          (SourceCurrentAllocatedFiniteOrdinaryTargetResources.outputRows
                                                            rows count depth bound (members - 1))
                                                          (max arity 1) result ∧
                                                        height result ≤ bound ∧
                                                          Profiles saved ∧
                                                            NativeStored after.native ∧ OutputStored after.native ∧ ⋯
