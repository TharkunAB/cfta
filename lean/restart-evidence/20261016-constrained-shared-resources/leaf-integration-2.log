'MicroCFTA.SharedLeafResourceChecks.leaf_present' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
@leaf_present : ∀ [inst : DecidableEq.{1} Symbol] [inst_1 : DecidableEq.{1} (EdgeKey Symbol Guard)] {width : Nat}
  {formulas : SourceGuards.Formulas FullSyntax.Formula} {solver : SourceGuards.Entailment FullSyntax.Formula}
  {inventory : Inventory} {record : Record} {values : List.{0} (Value Symbol Guard)}
  {base : InternedConstructorTemplates.State Symbol Guard} {path : Path} {input result : Value Symbol Guard}
  {before after : Shared width} {memos final : Memos},
  Receipt formulas solver inventory record values base path input before result after memos final →
    Exists.{1} fun target => Eq.{1} (after.targets path) (some.{0} target)
'MicroCFTA.SharedLeafResourceChecks.two_leaves' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
@two_leaves : ∀ [inst : DecidableEq.{1} Symbol] [inst_1 : DecidableEq.{1} (EdgeKey Symbol Guard)]
