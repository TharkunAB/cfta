                      LE.le.{0} (childrenHeight values) bound →
                        Stored (TargetRows record rows count depth bound) (max.{0} arity 1) bound before →
                          ∀ (input : Value Symbol Guard) (inputRows inputArity inputBound : Nat),
                            Available before.checked.native.machine.heap input →
                              NodeShape inputRows inputArity input →
                                LE.le.{0} (height input) inputBound →
                                  LE.le.{0}
                                      (HAdd.hAdd.{0, 0, 0}
                                        (HAdd.hAdd.{0, 0, 0} before.checked.native.machine.heap.nodes.next
                                          (LeafN record rows arity count depth bound inputRows inputArity inputBound
                                            before path))
                                        (QueryN record rows arity count depth bound
                                          (HMul.hMul.{0, 0, 0}
                                            (max.{0} (TargetRows record rows count depth bound) inputRows)
                                            (max.{0} (TargetRows record rows count depth bound) inputRows))
                                          (max.{0} (max.{0} (max.{0} arity 1) inputArity) 1) inputBound))
                                      (HPow.hPow.{0, 0, 0} 2 bits) →
                                    LE.le.{0}
                                        (HAdd.hAdd.{0, 0, 0}
                                          (HAdd.hAdd.{0, 0, 0} before.checked.native.machine.heap.edges.next
                                            (LeafE record rows arity count depth bound inputRows inputArity inputBound
                                              before path))
                                          (QueryN record rows arity count depth bound
                                            (HMul.hMul.{0, 0, 0}
                                              (max.{0} (TargetRows record rows count depth bound) inputRows)
                                              (max.{0} (TargetRows record rows count depth bound) inputRows))
                                            (max.{0} (max.{0} (max.{0} arity 1) inputArity) 1) inputBound))
                                        (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} bits 2)) →
                                      ∀ (memos : Memos),
                                        Valid before.checked.native.machine.heap memos →
