                      (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) annotation source
                      (@MicroCFTA.SourceEqualityNativeDemand.State.native width before))
                    (And
                      (@MicroCFTA.SourceCurrentHereditaryNativeCode.EdgeLaw
                        (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) annotation source
                        request value)
                      (@MicroCFTA.InternedEdgeResidency.EdgeResident
                        (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)
                        (@MicroCFTA.SourceRecursiveIntersectionKernel.Machine.heap
                          (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)
                          (@MicroCFTA.SourceRecursiveIntersectionThunks.State.machine width
                            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)
                            (@MicroCFTA.SourceEqualityNativeDemand.State.native width before)))
                        value)))
