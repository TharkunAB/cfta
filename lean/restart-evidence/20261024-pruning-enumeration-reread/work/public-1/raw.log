@MicroCFTA.SourcePruningEnumerationReread.pending_reread_complete : ∀ {Symbol Guard : Type}
  (readFuel uv oldHandle : Nat) (scs : List MicroCFTA.EnumerationState.Suspended)
  (before readAfter entry : MicroCFTA.EnumerationState.State Symbol Guard),
  MicroCFTA.UnionFind.Total before.representatives →
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.getValue readFuel uv) before
        (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) readAfter →
      MicroCFTA.EnumerationCompressionFrame.Frame readAfter entry →
        ∃ root size rereadFuel after,
          MicroCFTA.EnumerationCompressionFrame.Frame before readAfter ∧
            MicroCFTA.UnionFind.Reaches before.representatives uv root size ∧
              MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationState.representative rereadFuel uv) entry
                  root after ∧
                MicroCFTA.EnumerationCompressionFrame.Frame entry after ∧
                  MicroCFTA.EnumerationCompressionFrame.Frame before after ∧
                    after.values[root]? =
                        some (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs) ∧
                      root < after.values.length
'MicroCFTA.SourcePruningEnumerationReread.pending_reread_complete' depends on axioms: [propext, Quot.sound]
@MicroCFTA.SourcePruningEnumerationReread.checkRepeated_false_frame : ∀ {Symbol Guard : Type}
  (graph : MicroCFTA.EnumerationState.Graph Symbol Guard) (fuel uv node : Nat)
  (scs : List MicroCFTA.EnumerationState.Suspended) (before after : MicroCFTA.EnumerationState.State Symbol Guard),
  MicroCFTA.UnionFind.Total before.representatives →
    MicroCFTA.EnumerationCorrectness.Success (MicroCFTA.EnumerationDriver.checkRepeated graph fuel uv node scs) before
        false after →
      MicroCFTA.EnumerationCompressionFrame.Frame before after
'MicroCFTA.SourcePruningEnumerationReread.checkRepeated_false_frame' depends on axioms: [propext, Quot.sound]
