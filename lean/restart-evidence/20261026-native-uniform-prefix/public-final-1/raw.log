                        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) →
                      List
                        (MicroCFTA.InternedConstructorTemplates.EdgeValue MicroCFTA.SourcePruningTemplates.Symbol
                          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))) →
                    Option (MicroCFTA.SourcePruningRecordTypes.Metadata Typing → Nat → Bool) →
                      (MicroCFTA.SourcePruningRecordTypes.Metadata Typing → List Nat → Option Nat) →
                        MicroCFTA.SourcePruningRecordTypes.Metadata Typing →
                          [DecidableEq MicroCFTA.SourcePruningTemplates.Symbol] →
                            [DecidableEq
                                  (MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
                                    (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))] →
                              MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula →
                                MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula →
                                  MicroCFTA.SourceCurrentAllocatedNativeInventoryState.Inventory →
                                    Nat →
                                      Nat →
                                        Nat →
                                          Nat →
                                            Nat →
                                              Nat →
                                                Nat →
                                                  Nat →
                                                    Nat →
                                                      Nat →
                                                        Nat →
                                                          Nat →
                                                            MicroCFTA.SourceCurrentAllocatedPartialState.State width →
                                                              MicroCFTA.EnumerationExpandableIndex.Cached
                                                                  MicroCFTA.SourcePruningTemplates.Symbol
                                                                  (MicroCFTA.SourceSymbolicIndex.Constraint
                                                                    MicroCFTA.FullSyntax.Formula) →
                                                                MicroCFTA.EndpointMemoGateTrace.Memos →
                                                                  MicroCFTA.SourcePruningEnumerationSelectedStep.Result
                                                                      width Typing →
                                                                    Prop :=
fun {Typing Key} {width}
    [DecidableEq
        (MicroCFTA.InternedConstructorTemplates.EdgeKey MicroCFTA.SourcePruningTemplates.Symbol
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
    holeKey fits admits graph templates checkEmpty edgesOf stop order metadata
    [DecidableEq MicroCFTA.SourcePruningTemplates.Symbol]
    [DecidableEq
        (MicroCFTA.InternedConstructorTemplates.Value MicroCFTA.SourcePruningTemplates.Symbol
          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
    formulas solver inventory readFuel checkFuel nativeFuel representativeFuel indexFuel callbackFuel r n p h k uv
    caller before memos result =>
  ∃ oldHandle scs readAfter,
    (MicroCFTA.EnumerationState.getValue readFuel uv before.core).run =
        [Except.ok (MicroCFTA.EnumerationState.UVarValue.unenumerated (some oldHandle) scs, readAfter)] ∧
      match result with
      | MicroCFTA.SourcePruningEnumerationSelectedStep.Result.stopped read checked => False
      | MicroCFTA.SourcePruningEnumerationSelectedStep.Result.parked checked candidate raw =>
        (MicroCFTA.SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap checkFuel uv
                oldHandle scs readAfter).run =
            [Except.ok (true, checked)] ∧
          ∃ after,
            candidate = some after ∧
              after.core = checked ∧
                MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.CacheValid caller after ∧
                  MicroCFTA.EnumerationSchedule.Safe after.core ∧
                    MicroCFTA.EnumerationReferences.PendingReferences after.core ∧
                      after.core.counter = before.core.counter ∧
                        (∀ (level : Nat → Nat) (frontier : Nat),
                            MicroCFTA.EnumerationOrder.Stratified before.core level frontier →
                              MicroCFTA.EnumerationOrder.Stratified after.core level frontier) ∧
                          raw =
                            some (MicroCFTA.SourcePruningEnumerationRestart.run stop order metadata after checked).run
      |
      MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed checked prepared reached queries action candidate
          right ordinary =>
        (MicroCFTA.SourcePruningEnumerationRecursion.checkRepeated caller.checked.native.machine.heap checkFuel uv
                oldHandle scs readAfter).run =
            [Except.ok (false, checked)] ∧
          ∃ oldValue value heap selectedAction final,
            MicroCFTA.SourcePruningEnumerationNodes.lookupNode caller.checked.native.machine.heap oldHandle =
                some oldValue ∧
              MicroCFTA.SourcePruningOuterNarrow.narrow holeKey fits admits metadata nativeFuel uv oldValue
                    caller.checked.native.machine.heap =
                  MicroCFTA.MergedSourceComparison.Result.done value heap ∧
                MicroCFTA.SourcePruningEnumerationAction.prepare holeKey fits admits metadata nativeFuel
                      representativeFuel uv oldHandle scs oldValue caller.checked.native.machine.heap =
                    MicroCFTA.MergedSourceComparison.Result.done (value, some selectedAction) heap ∧
                  prepared = MicroCFTA.MergedSourceComparison.Result.done (value, some selectedAction) heap ∧
                    reached =
                        MicroCFTA.SourceCurrentAllocatedPartialState.advance caller
                          (MicroCFTA.SourceCurrentAllocatedQueryMemo.advancePhysical caller.checked
                            { heap := heap, equality := caller.checked.operations })
                          caller.fourth caller.merge ∧
                      queries = memos.query ∧
                        MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post formulas solver inventory caller reached
                            final ∧
                          final.query = queries ∧
                            (value = MicroCFTA.InternedConstructorTemplates.Value.empty ∧
                                action = some [] ∧ candidate = none ∧ right = none ∧ ordinary = none ∨
                              ∃ newHandle after,
                                value ≠ MicroCFTA.InternedConstructorTemplates.Value.empty ∧
                                  MicroCFTA.SourcePruningEnumerationNodes.encodeNode value = some newHandle ∧
                                    action = some [Except.ok ((), after.core)] ∧
                                      candidate = some after ∧
                                        MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.CacheValid reached
                                            after ∧
                                          MicroCFTA.EnumerationSchedule.Safe after.core ∧
                                            MicroCFTA.EnumerationReferences.PendingReferences after.core ∧
                                              MicroCFTA.EnumerationDriver.Ready uv after.core ∧
                                                after.core.values[uv]? =
                                                    some
                                                      (MicroCFTA.EnumerationState.UVarValue.unenumerated
                                                        (some newHandle) scs) ∧
                                                  after.waiting = before.waiting ∧
                                                    right = some [Except.ok ((false, metadata), after.core)] ∧
                                                      ordinary =
                                                          some
                                                            (MicroCFTA.SourcePruningEnumerationNativeOrdinary.run
                                                              checkEmpty r n p h k uv edgesOf reached after queries) ∧
                                                        ∀
                                                          (parentEntry :
                                                            MicroCFTA.Cache.Interned
                                                              MicroCFTA.InternedBinderProtocol.NodeKey)
                                                          (storedEdges :
                                                            List
                                                              (MicroCFTA.InternedConstructorTemplates.EdgeValue
                                                                MicroCFTA.SourcePruningTemplates.Symbol
                                                                (MicroCFTA.SourceSymbolicIndex.Constraint
                                                                  MicroCFTA.FullSyntax.Formula)))
                                                          (depth : Nat)
                                                          (free : List MicroCFTA.InternedBinderProtocol.Reference),
                                                          value =
                                                              MicroCFTA.InternedConstructorTemplates.Value.node
                                                                parentEntry storedEdges depth free →
                                                            (scs.any fun sc =>
                                                                  MicroCFTA.EqualityTrie.isTerminal sc.trie) =
                                                                false →
                                                              (∀
                                                                  (edge :
                                                                    MicroCFTA.InternedConstructorTemplates.EdgeValue
                                                                      MicroCFTA.SourcePruningTemplates.Symbol
                                                                      (MicroCFTA.SourceSymbolicIndex.Constraint
                                                                        MicroCFTA.FullSyntax.Formula)),
                                                                  edge ∈
                                                                      edgesOf
                                                                        (MicroCFTA.InternedConstructorTemplates.Value.node
                                                                          parentEntry storedEdges depth free) →
                                                                    edge ∈ storedEdges) →
                                                                MicroCFTA.SourcePruningEnumerationNativeOrdinary.Ranges
                                                                    checkEmpty uv edgesOf reached after queries →
                                                                  ∃ R N P H K entered processed lastCaller saved last
                                                                    next outcome,
                                                                    (∀ (er en ep eh ek : Nat),
                                                                        MicroCFTA.SourcePruningEnumerationSelectedStep.run
                                                                            holeKey fits admits graph templates
                                                                            checkEmpty edgesOf stop order metadata
                                                                            readFuel checkFuel nativeFuel
                                                                            representativeFuel indexFuel callbackFuel
                                                                            (R + er) (N + en) (P + ep) (H + eh) (K + ek)
                                                                            uv caller before memos.query =
                                                                          MicroCFTA.SourcePruningEnumerationSelectedStep.Result.narrowed
                                                                            checked prepared reached queries action
                                                                            candidate right
                                                                            (some
                                                                              ([Except.ok
                                                                                    ((uv, newHandle, scs,
                                                                                        MicroCFTA.InternedConstructorTemplates.Value.node
                                                                                          parentEntry storedEdges depth
                                                                                          free),
                                                                                      entered.core)],
                                                                                some outcome))) ∧
                                                                      MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post
                                                                          formulas solver next caller lastCaller last ∧
                                                                        last.query = saved ∧
                                                                          (∀
                                                                              (receipt :
                                                                                MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                  width),
                                                                              receipt ∈ processed →
                                                                                MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Admitted
                                                                                  uv receipt) ∧
                                                                            (∀
                                                                                (receipt :
                                                                                  MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                    width),
                                                                                receipt ∈ processed →
                                                                                  MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.Pending
                                                                                    receipt) ∧
                                                                              (∀
                                                                                  (receipt :
                                                                                    MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                      width),
                                                                                  receipt ∈ processed →
                                                                                    ∃ reached savedQueries
                                                                                      receiptInventory receiptMemos,
                                                                                      MicroCFTA.SourcePruningEnumerationNativeBranches.advance
                                                                                            receipt =
                                                                                          some (reached, savedQueries) ∧
                                                                                        MicroCFTA.SourceCurrentAllocatedPartialInvariant.Post
                                                                                            formulas solver
                                                                                            receiptInventory caller
                                                                                            reached receiptMemos ∧
                                                                                          receiptMemos.query =
                                                                                            savedQueries) ∧
                                                                                (∀
                                                                                    (receipt :
                                                                                      MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                        width),
                                                                                    receipt ∈ processed →
                                                                                      MicroCFTA.SourcePruningEnumerationNativeBranchCompletion.FragmentHistory
                                                                                        before.core receipt) ∧
                                                                                  (∀
                                                                                      (receipt :
                                                                                        MicroCFTA.SourcePruningEnumerationSelectedEdge.Result
                                                                                          width),
                                                                                      receipt ∈ processed →
                                                                                        MicroCFTA.SourcePruningEnumerationReceiptCallback.Completes
                                                                                          graph templates metadata uv
                                                                                          before.core receipt) ∧
                                                                                    (outcome =
                                                                                          MicroCFTA.SourcePruningEnumerationNativeBranches.Result.complete
                                                                                            processed lastCaller saved ∨
                                                                                        outcome =
                                                                                          MicroCFTA.SourcePruningEnumerationNativeBranches.Result.stopped
                                                                                            processed
                                                                                            (some
                                                                                              MicroCFTA.SourcePruningEnumerationSelectedEdge.Result.unhandled)) ∧
                                                                                      ((∀
                                                                                          (edge :
                                                                                            MicroCFTA.InternedConstructorTemplates.EdgeValue
                                                                                              MicroCFTA.SourcePruningTemplates.Symbol
                                                                                              (MicroCFTA.SourceSymbolicIndex.Constraint
                                                                                                MicroCFTA.FullSyntax.Formula)),
                                                                                          edge ∈
                                                                                              edgesOf
                                                                                                (MicroCFTA.InternedConstructorTemplates.Value.node
                                                                                                  parentEntry
                                                                                                  storedEdges depth
                                                                                                  free) →
                                                                                            MicroCFTA.EnumerationState.arityAllows
                                                                                                  edge.children.length
                                                                                                  scs =
                                                                                                true →
                                                                                              MicroCFTA.SourcePruningEnumerationConstraint.project
                                                                                                  edge.entry.key.constraint ≠
                                                                                                none) →
                                                                                        outcome =
                                                                                          MicroCFTA.SourcePruningEnumerationNativeBranches.Result.complete
                                                                                            processed lastCaller saved))
