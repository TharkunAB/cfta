                            (∀ (record : MicroCFTA.SourceEqualityClassOrder.Record),
                                record ∈ kept →
                                  MicroCFTA.SourceEqualityClassOrder.Coherent record ∧
                                    MicroCFTA.EqualityTrie.Ascending record.trie ∧
                                      MicroCFTA.EqualityNormalize.Nontrivial record.paths) ∧
                              MicroCFTA.SourceCurrentConjunctionClassScanGlobalMemos.ScanReads actual memos scanMemos ∧
