                                      (MicroCFTA.SourceEqualitySelectedRequired.paths selected) values results
                                      after.native.machine.heap heap scanMemos finalMemos ∧
                                    MicroCFTA.EndpointMemoGateTrace.Valid heap finalMemos ∧
                                      MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver heap saved
@MicroCFTA.SourceCurrentConjunctionAllocatedRequired.finite : ∀
  {initialCache finalCache : MicroCFTA.Cache.State MicroCFTA.SourceEqualityPartialConstraintKey.Key}
  {originals : List (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  [inst : DecidableEq (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  [inst_2 :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  (width : Nat),
  MicroCFTA.SourceEqualityOriginalAllocationHistory.History initialCache finalCache originals →
    MicroCFTA.Cache.Valid initialCache →
      ∀
        (expression :
          MicroCFTA.InternedNestedConstruction.Syntax (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
        (∀ (original : MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula),
            original ∈ MicroCFTA.SourceEqualityConstraintOrigins.guards expression → original ∈ originals) →
          ∀
            (value :
              MicroCFTA.InternedConstructorTemplates.Value
                (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))
            (heap :
              MicroCFTA.InternedConstructorTemplates.State
                (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
            MicroCFTA.InternedFreshOrdinaryConstruction.build expression []
                  MicroCFTA.InternedConstructorTemplates.empty =
                MicroCFTA.InternedNestedConstruction.Outcome.done value heap →
              ∀
                (edge :
                  MicroCFTA.InternedConstructorTemplates.EdgeValue
                    (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                    (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)),
                MicroCFTA.InternedEdgeResidency.EdgeResident heap edge →
                  ∀ (formulas : MicroCFTA.SourceGuards.Formulas MicroCFTA.FullSyntax.Formula)
                    (solver : MicroCFTA.SourceGuards.Entailment MicroCFTA.FullSyntax.Formula) (budget : Nat)
                    (memo : MicroCFTA.SourceCurrentEmptinessMemo.Memo),
                    MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver heap memo →
                      ∀ (memos : MicroCFTA.EndpointMemoGateTrace.Memos),
                        MicroCFTA.EndpointMemoGateTrace.Valid heap memos →
                          ∃ loaded,
                            MicroCFTA.SourceEqualityConstraintFieldLookup.load edge.entry.key.constraint finalCache =
                                Except.ok (some loaded) ∧
                              MicroCFTA.SourceEqualityConjoinAllocation.readback loaded = edge.entry.key.constraint ∧
                                MicroCFTA.SourceEqualityConstraintAllocation.Ready finalCache loaded.stored ∧
                                  ∀ (inherited : MicroCFTA.SourceEqualityConstraintAllocation.Value),
                                    MicroCFTA.SourceEqualityConstraintAllocation.Ready finalCache inherited →
                                      ∀ (output : List MicroCFTA.SourceEqualityClassOrder.Record),
                                        (MicroCFTA.SourceEqualityPartialPrecheckAllocation.run loaded.stored
                                                loaded.guard inherited
                                                (MicroCFTA.SourceEqualityConstraintMemoAllocation.initial
                                                  finalCache)).fst =
                                            Except.ok (MicroCFTA.SourceEqualityPrecheck.Branch.classes output) →
                                          MicroCFTA.SourceCurrentConjunctionClassScanCompletion.Ranges budget
                                              MicroCFTA.SourceMemoGate.unconstrained
                                              (MicroCFTA.SourceEndpointReachability.reaches
                                                MicroCFTA.SourceMemoGate.unconstrained)
                                              edge.children
                                              (List.map MicroCFTA.SourceEqualityClassOrder.Record.paths output)
                                              (MicroCFTA.SourceCurrentConjunctionAllocatedClassEntry.prefixState width
                                                heap loaded inherited finalCache)
                                              memo →
                                            ∃ outcome selected after saved next actual,
                                              MicroCFTA.SourceCurrentConjunctionClassScan.Ready after ∧
                                                MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver
                                                    next after ∧
                                                  (∀ (rejected : MicroCFTA.EqualityNormalize.Class),
                                                      outcome = some rejected →
                                                        rejected ∈
                                                            List.map MicroCFTA.SourceEqualityClassOrder.Record.paths
                                                              output ∧
                                                          ∀
                                                            (ambient :
                                                              MicroCFTA.InternedGuardedLanguage.Env
                                                                (MicroCFTA.SourceObservations.Label
                                                                  MicroCFTA.FullSyntax.Formula)),
                                                            ⋯) ∧
                                                    (outcome = none → ∃ kept, Exists ⋯)
