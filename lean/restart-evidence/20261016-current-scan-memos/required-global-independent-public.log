      (MicroCFTA.SourceEndpointReachability.reaches MicroCFTA.SourceMemoGate.unconstrained) values
      (List.map MicroCFTA.SourceEqualityClassOrder.Record.paths records) before memo none selected after saved),
  MicroCFTA.SourceCurrentConjunctionClassScan.Ready before →
    MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver inventory before →
      MicroCFTA.InternedNestedProvenance.Values before.native.machine.heap values →
        (∀ (record : MicroCFTA.SourceEqualityClassOrder.Record),
            record ∈ records → ∀ (path : MicroCFTA.EqualityNormalize.Path), path ∈ record.paths → path ≠ []) →
          (∀ (record : MicroCFTA.SourceEqualityClassOrder.Record),
              record ∈ records →
                MicroCFTA.SourceEqualityClassOrder.Coherent record ∧
                  MicroCFTA.EqualityTrie.Ascending record.trie ∧ MicroCFTA.EqualityNormalize.Nontrivial record.paths) →
            MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver before.native.machine.heap memo →
