bodyPast :
  Reached g s r e p h m c n budget first
    (Phase.body (bodyFuel + 1) { inherited := inherited, value := Value.node entry originals depth free } running)
results : List Edge
rowEnd : Caller (bits + 2)
rowsDone : rows bodyFuel g s r e p h m c n budget inherited originals running = Outcome.done results rowEnd
observed :
  ((nodeBody (bodyFuel + 1) g s r e p h m c n budget
          { inherited := inherited, value := Value.node entry originals depth free } running).bind
      fun result after => Outcome.done result (finishNode handle result after)) =
    Outcome.done
      (SourceCurrentAllocatedRawRebuild.modify (Value.node entry originals depth free) originals results
          rowEnd.checked).fst
      (finishNode handle
        (SourceCurrentAllocatedRawRebuild.modify (Value.node entry originals depth free) originals results
            rowEnd.checked).fst
        (advance rowEnd
