        rowEnd.fourth rowEnd.merge)
count : Nat := rankCount (Option.getD inherited.payload []) (Value.node entry originals depth free)
mass : Nat := massOf (Value.node entry originals depth free)
all : List Guard × Profile → List (Nat × Nat × List Guard × Profile) := images budget count mass
rowStep : Nat × Nat × List Guard × Profile → Nat × Nat × List Guard × Profile := row budget all
rowSeed : Nat → List Guard × Profile := fun j => (fold rowStep j (0, 0, seed)).snd.snd
complete : List Guard × Profile := rowSeed mass
rowsFit :
  ∀ (rowFuel j : Nat) (values : List Edge) (start finish : Caller (bits + 2)) (output : List Edge),
    rowFuel ≤ bodyFuel →
      j + values.length ≤ mass →
        Reached g s r e p h m c n budget
            (Phase.body (bodyFuel + 1) { inherited := inherited, value := Value.node entry originals depth free }
              running)
            (Phase.rows rowFuel inherited values start) →
          Fits (rowSeed j).snd start.checked →
            SourceEqualityAnnotationHeap.Heap (fun guard => guard ∈ (rowSeed j).fst) start.checked.native.machine.heap →
              rows rowFuel g s r e p h m c n budget inherited values start = Outcome.done output finish →
                Fits complete.snd finish.checked ∧
                  SourceEqualityAnnotationHeap.Heap (fun guard => guard ∈ complete.fst)
                    finish.checked.native.machine.heap
rowInside :
  Reached g s r e p h m c n budget
    (Phase.body (bodyFuel + 1) { inherited := inherited, value := Value.node entry originals depth free } running)
    (Phase.rows bodyFuel inherited originals running)
⊢ 0 + originals.length ≤ massOf (Value.node entry originals depth free)
