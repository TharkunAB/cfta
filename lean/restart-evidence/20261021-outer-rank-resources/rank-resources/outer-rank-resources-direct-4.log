                (massOf { inherited := inherited, value := Value.node entry originals depth free }.value)
                seed).snd.snd.fst
terminal :
  Fits
      (envelope budget
              (rankCount
                (Option.getD
                  { inherited := inherited, value := Value.node entry originals depth free }.inherited.payload [])
                { inherited := inherited, value := Value.node entry originals depth free }.value)
              (massOf { inherited := inherited, value := Value.node entry originals depth free }.value)
              seed).snd.snd.snd
      running.checked ∧
    SourceEqualityAnnotationHeap.Heap
      (fun guard =>
        guard ∈
          (envelope budget
                  (rankCount
                    (Option.getD
                      { inherited := inherited, value := Value.node entry originals depth free }.inherited.payload [])
                    { inherited := inherited, value := Value.node entry originals depth free }.value)
                  (massOf { inherited := inherited, value := Value.node entry originals depth free }.value)
                  seed).snd.snd.fst)
      running.checked.native.machine.heap
bodyFuel : Nat
ih :
  ∀ (m_1 : Nat),
    m_1 < bodyFuel + 1 →
      ∀ {request : NodeRequest} {before after : Caller (bits + 2)} {result : Node} (seed : List Guard × Profile),
        Reached g s r e p h m c n budget first (Phase.node m_1 request before) →
          Fits seed.snd before.checked →
            SourceEqualityAnnotationHeap.Heap (fun guard => guard ∈ seed.fst) before.checked.native.machine.heap →
              Room bits
                  (envelope budget (rankCount (Option.getD request.inherited.payload []) request.value)
                          (massOf request.value) seed).snd.snd.snd →
                nodeCall m_1 g s r e p h m c n budget request before = Outcome.done result after →
                  let output :=
                    envelope budget (rankCount (Option.getD request.inherited.payload []) request.value)
                      (massOf request.value) seed;
                  Fits output.snd.snd.snd after.checked ∧
                    SourceEqualityAnnotationHeap.Heap (fun guard => guard ∈ output.snd.snd.fst)
                      after.checked.native.machine.heap
past :
