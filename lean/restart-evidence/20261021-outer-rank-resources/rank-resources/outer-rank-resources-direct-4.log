bodyDone :
  ((rows bodyFuel g s r e p h m c n budget inherited originals running).bind fun results after =>
      Outcome.done
        (SourceCurrentAllocatedRawRebuild.modify (Value.node entry originals depth free) originals results
            after.checked).fst
        (advance after
