  ∀ (input : InternedConstructorTemplates.Value Symbol Constraint × List Suspended),
    input ∈ (value, bucket) :: rest → ∀ (sc : Suspended), sc ∈ input.snd → sc.var < before.core.counter
action : EnumerateM Symbol Constraint (Fragments.Fragment Symbol)
prepared : SourcePruningEnumerationShallowChild.prepareChild bucket value = some action
nonterminal :
  value ≠ InternedConstructorTemplates.Value.empty → (bucket.any fun sc => EqualityTrie.isTerminal sc.trie) = false
headAction : EnumerateM Symbol Constraint (Fragments.Fragment Symbol)
headFuel : Nat
childRows : List (Fragments.Fragment Symbol × EnumerationExpandableIndex.Cached Symbol Constraint)
headPrepared : SourcePruningEnumerationShallowChild.prepareChild bucket value = some headAction
headRun :
  ∀ (extra : Nat),
    SourcePruningEnumerationCachedPrepare.prepareChild heap (headFuel + extra) bucket value before = some childRows
headRaw : (action before.core).run = List.map (fun result => Except.ok (result.fst, result.snd.core)) childRows
sameAction : headAction = action
middle : EnumerationExpandableIndex.Cached Symbol Constraint
_nonempty : value ≠ InternedConstructorTemplates.Value.empty
childSingleton : childRows = [(Fragments.Fragment.hole before.core.counter, middle)]
middleCounter : middle.core.counter = before.core.counter + 1
_middleAligned : middle.core.counter = middle.core.values.length
middleForest : middle.core.representatives = before.core.representatives
middlePaths : Roots middle.core.representatives roots
middleStorage : StorageValid middle.core
middleRealized : PendingRealized heap middle.core
middleCounts : EnumerationCanonicalWaiting.Correct roots middle.core.values middle.waiting
middleFlags :
  ∀ (slot : Nat),
    SourcePruningEnumerationNativeIndex.candidate heap (middle.core.values[slot]?.getD UVarValue.eliminated) =
      some (middle.expandable slot)
headBound : FragmentBound middle.core.counter (Fragments.Fragment.hole before.core.counter)
tailBounded :
  ∀ (input : InternedConstructorTemplates.Value Symbol Constraint × List Suspended),
    input ∈ rest → ∀ (sc : Suspended), sc ∈ input.snd → sc.var < middle.core.counter
tailFuel : Nat
rows : List (Option (List (Fragments.Fragment Symbol)) × EnumerationExpandableIndex.Cached Symbol Constraint)
after : EnumerationExpandableIndex.Cached Symbol Constraint
tailRun : ∀ (extra : Nat), run heap (tailFuel + extra) rest middle = some (rows, after)
tailRaw :
  (SourcePruningEnumerationEdgeTraversal.runStaged
        (List.map
          (fun input => (input.fst, input.snd, SourcePruningEnumerationShallowChild.prepareChild input.snd input.fst))
          rest)
        middle.core).run =
    List.map (fun row => Except.ok (row.fst, row.snd.core)) rows
grows : middle.core.counter ≤ after.core.counter
alignedAfter : after.core.counter = after.core.values.length
forestSame : after.core.representatives = middle.core.representatives
pathsAfter : Roots after.core.representatives roots
storageAfter : StorageValid after.core
realizedAfter : PendingRealized heap after.core
countsAfter : EnumerationCanonicalWaiting.Correct roots after.core.values after.waiting
flagsAfter :
  ∀ (slot : Nat),
    SourcePruningEnumerationNativeIndex.candidate heap (after.core.values[slot]?.getD UVarValue.eliminated) =
      some (after.expandable slot)
lifted : List (Option (List (Fragments.Fragment Symbol)) × EnumerationExpandableIndex.Cached Symbol Constraint) :=
  List.map
    (fun row =>
      (Option.map (fun fragments => Fragments.Fragment.hole before.core.counter :: fragments) row.fst, row.snd))
    rows
result : Option (List (Fragments.Fragment Symbol))
tailSingleton : rows = [(result, after)]
_tailBound :
  ∀ (fragments : List (Fragments.Fragment Symbol)),
    result = some fragments → FragmentsBound after.core.counter fragments
⊢ List.flatMap
      (fun result =>
        match result with
        | Except.error error => [Except.error error]
        | Except.ok (value, after) =>
          (pure (Option.map (fun tail => Fragments.Fragment.hole before.core.counter :: tail) value) after).run)
      (List.map (fun row => Except.ok (row.fst, row.snd.core)) [(result, after)]) =
    List.map (fun row => Except.ok (row.fst, row.snd.core)) lifted
