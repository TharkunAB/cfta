MicroCFTA.SourceSizedFiniteKeysRankEvaluation.native_rank_laws {State : Type} [DecidableEq State] [Ord State]
  {Formula : Type} [DecidableEq Formula] [Ord (MicroCFTA.SourceObservations.Label Formula)]
  [Std.TransOrd (MicroCFTA.SourceObservations.Label Formula)]
  [Std.LawfulEqOrd (MicroCFTA.SourceObservations.Label Formula)]
  (table :
    MicroCFTA.SourceSizedFiniteKeys.Table State (MicroCFTA.SourceObservations.Label Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint Formula))
  (root : State)
  (valid :
    MicroCFTA.FTAValidation.validateRows root (MicroCFTA.SourceSizedFiniteKeys.interpreted table fun x x_1 => true) =
      Except.ok (MicroCFTA.SourceSizedFiniteKeys.interpreted table fun x x_1 => true))
  (passed :
    (MicroCFTA.SourceSizedDispatcher.plainCheck (MicroCFTA.SourceSizedFiniteKeys.lookup table)
          (MicroCFTA.SourceDenseRows.keys table) &&
        (MicroCFTA.SourceSizedDeterministic.bottomUpDeterministic
            (MicroCFTA.SourceSizedDispatcher.ordinaryRows
              (MicroCFTA.SourceSizedFiniteKeys.nativeSorted table root valid))
            (MicroCFTA.SourceDenseRows.keys table) ||
          MicroCFTA.SourceSizedFiniteKeysDispatch.unambiguous table root valid)) =
      true)
  (api : MicroCFTA.SourceSizedDispatcher.Api (MicroCFTA.SourceObservations.Label Formula))
  (success : MicroCFTA.SourceSizedFiniteKeysDispatch.nativeSized table root valid = Except.ok api)
  (term : MicroCFTA.Language.Term (MicroCFTA.SourceObservations.Label Formula)) :
