      (MicroCFTA.SourceSizedDispatcher.ordinaryRows (MicroCFTA.SourceSizedFiniteKeys.nativeSorted table root valid))
      (MicroCFTA.SourceSizedFiniteKeysRankEvaluation.rankCounts table root valid term) ∧
    MicroCFTA.TablePositionFiniteEvaluation.positionLookup
          (MicroCFTA.SourceSizedFiniteKeysRankEvaluation.rankTable table root valid term) root =
