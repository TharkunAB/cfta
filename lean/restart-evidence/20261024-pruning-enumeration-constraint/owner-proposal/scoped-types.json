      "scope": "same some branch"
    },
    {
      "name": "equalityExact",
      "type": "∀ term : Term (Label Formula), (∀ trie ∈ EnumerationEquality.readClasses classes, EqualityHolds term trie) ↔ EqualityNormalize.Satisfies term classes",
      "scope": "same some branch"
    }
