  MicroCFTA.SourceCurrentConjunctionClassScan.Scan budget unconstrained reaches values classes before fourth none
      selected middle savedFourth →
    MicroCFTA.SourceCurrentConjunctionClassScan.Ready before →
      MicroCFTA.SourceCurrentAllocatedNativeInventoryState.At formulas solver inventory before →
        MicroCFTA.InternedNestedProvenance.Values before.native.machine.heap values →
          (∀ (paths : MicroCFTA.EqualityNormalize.Class),
              paths ∈ classes → ∀ (path : MicroCFTA.EqualityNormalize.Path), path ∈ paths → path ≠ []) →
            (∀ (paths : MicroCFTA.EqualityNormalize.Class),
                paths ∈ classes → MicroCFTA.EqualityNormalize.Nontrivial paths) →
              MicroCFTA.SourceCurrentEmptinessMemo.Correct formulas solver before.native.machine.heap fourth →
                MicroCFTA.SourceCurrentConjunctionClassScanCompletion.Ranges budget unconstrained reaches values classes
                    before fourth →
                  ∀ {fuel readFuel : Nat}
                    {heap :
