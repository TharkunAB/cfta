'MicroCFTA.PartialEdgeActualIndependent.same_owner' depends on axioms: [propext, Classical.choice, Quot.sound]
@same_owner : ∀ [inst : DecidableEq Symbol] [inst_1 : DecidableEq (InternedConstructorTemplates.EdgeKey Symbol Guard)]
  [inst_2 : DecidableEq (Value Symbol Guard)] {width : Nat} (F : SourceGuards.Formulas FullSyntax.Formula)
  (S : SourceGuards.Entailment FullSyntax.Formula) (inventory : Inventory) {budget : Nat}
  {request original : EdgeRequest} {before running middle : Caller width} {handle : Nat} {result : Edge}
  {memos final : Memos},
  beginEdge request before = (handle, FlatMemoThunk.Observation.evaluate original, running) →
    ∀ {body : EdgeBody budget original running result middle},
      SourceCurrentAllocatedPartialSourceReads.EdgeBodyReads F S body memos final →
        Ready before.checked →
          At F S inventory before.checked →
            Sound F S before →
              SourceEqualityConstraintAllocation.Ready before.checked.operations.constraints request.inherited →
                Resident before.checked.native.machine.heap request.value →
                  SourceCurrentEmptinessMemo.Correct F S before.checked.native.machine.heap before.fourth →
                    SourceCurrentMemoMergeEffects.Stored before.checked.native.machine.heap before.merge →
                      (∀ (ambient : InternedGuardedLanguage.Env Symbol),
                          SourceCurrentMemoMergeLanguage.CacheCovers (SourceEqualityPCSGuard.holds F S) ambient
                            before.merge) →
                        SourceCurrentAllocatedPartialEdgeActual.CallRanges budget request before →
                          EndpointMemoGateTrace.Valid before.checked.native.machine.heap memos →
                            ProbeHeap before.checked.native.machine.heap →
                              ∃ next,
                                SourceCurrentAllocatedPartialEdgeCall.Receipt F S next request before result
                                    (finishEdge handle result middle) final ∧
                                  ProbeHeap (finishEdge handle result middle).checked.native.machine.heap ∧
                                    (finishEdge handle result middle).edgeResults.cells handle =
                                        some { request := original, status := FlatMemoThunk.Status.returned result } ∧
                                      original.key = request.key
