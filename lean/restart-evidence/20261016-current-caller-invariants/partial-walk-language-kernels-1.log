@contradiction_skips : ∀ [inst : DecidableEq (SourceObservations.Label FullSyntax.Formula)]
  [inst_1 :
    DecidableEq
      (EdgeKey (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  [inst_2 :
    DecidableEq
      (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))]
  {width : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) (budget : Nat)
  (value : Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
  (before : SourceCurrentAllocatedPartialState.State width),
  @Exists
    (@Children inst inst_1 inst_2 width budget SourceEqualityConstraintAllocation.Value.contradiction
      (@List.cons
        (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)) value
        (@List.nil
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))))
      before
      (@List.cons
        (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
        (@Value.empty (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
        (@List.nil
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))))
      before)
    fun actual =>
    And
      (@ChildrenLaw width inst inst_1 inst_2 formulas solver budget
        SourceEqualityConstraintAllocation.Value.contradiction
        (@List.cons
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
          value
          (@List.nil
            (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))))
        (@List.cons
          (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
          (@Value.empty (SourceObservations.Label FullSyntax.Formula)
            (SourceSymbolicIndex.Constraint FullSyntax.Formula))
          (@List.nil
            (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))))
        before before actual)
      (∀ (ambient : Env (SourceObservations.Label FullSyntax.Formula))
        (term : Term (SourceObservations.Label FullSyntax.Formula)),
        Not
          (@All₂
            (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
            (Term (SourceObservations.Label FullSyntax.Formula))
            (@meaning (SourceSymbolicIndex.Constraint FullSyntax.Formula) (SourceObservations.Label FullSyntax.Formula)
              (@SourceEqualityPCSGuard.holds FullSyntax.Formula FormulaExecutable.formulaDecidableEq formulas solver)
              ambient)
            (@List.cons
              (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
              (@Value.empty (SourceObservations.Label FullSyntax.Formula)
                (SourceSymbolicIndex.Constraint FullSyntax.Formula))
              (@List.nil
                (Value (SourceObservations.Label FullSyntax.Formula)
                  (SourceSymbolicIndex.Constraint FullSyntax.Formula))))
            (@List.cons (Term (SourceObservations.Label FullSyntax.Formula)) term
              (@List.nil (Term (SourceObservations.Label FullSyntax.Formula))))))
@receipt_then_call : ∀ [inst : DecidableEq (SourceObservations.Label FullSyntax.Formula)]
