        @Eq SourceEqualityPrecheck.Constraint
            (@Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
                (@descend width middle (SourceEqualityConstraintAllocation.Value.live identity records)
                  (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                    (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))
                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))).payload
            (SourceEqualityDescend.descend (@some (List SourceEqualityClassOrder.Record) records)
              (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))
