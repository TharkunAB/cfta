                          ambient)
                        (@List.cons
                          (Value (SourceObservations.Label FullSyntax.Formula)
                            (SourceSymbolicIndex.Constraint FullSyntax.Formula))
                          firstResult
                          (@List.cons
                            (Value (SourceObservations.Label FullSyntax.Formula)
                              (SourceSymbolicIndex.Constraint FullSyntax.Formula))
                            secondResult
                            (@List.nil
                              (Value (SourceObservations.Label FullSyntax.Formula)
                                (SourceSymbolicIndex.Constraint FullSyntax.Formula)))))
                        (@List.cons (Term (SourceObservations.Label FullSyntax.Formula)) firstTerm
                          (@List.cons (Term (SourceObservations.Label FullSyntax.Formula)) secondTerm
                            (@List.nil (Term (SourceObservations.Label FullSyntax.Formula))))))
                      (@All₂
                        (Value (SourceObservations.Label FullSyntax.Formula)
                          (SourceSymbolicIndex.Constraint FullSyntax.Formula))
                        (Term (SourceObservations.Label FullSyntax.Formula))
                        (@meaning (SourceSymbolicIndex.Constraint FullSyntax.Formula)
                          (SourceObservations.Label FullSyntax.Formula)
