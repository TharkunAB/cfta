  {width : Nat} (formulas : SourceGuards.Formulas FullSyntax.Formula)
  (solver : SourceGuards.Entailment FullSyntax.Formula) {budget index : Nat}
  {combined : SourceEqualityConstraintAllocation.Value}
  {first second firstResult secondResult :
    Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula)}
  {before middle after : SourceCurrentAllocatedPartialState.State width}
  (firstCall :
    @NodeCall inst inst_1 inst_2 width budget
      {
        inherited :=
          @Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
