      (@Prod.snd SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
        (@descend width before combined index))
      firstResult middle)
  (secondCall :
    @NodeCall inst inst_1 inst_2 width budget
      {
        inherited :=
          @Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
            (@descend width middle combined
              (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) index
                (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))),
        value := second }
      (@Prod.snd SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
        (@descend width middle combined
          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) index
            (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
      secondResult after),
  @Eq SourceEqualityPrecheck.Constraint
      (@Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
