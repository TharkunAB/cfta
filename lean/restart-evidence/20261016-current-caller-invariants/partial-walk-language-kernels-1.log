              (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) index
                (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))).payload
        (SourceEqualityDescend.descend combined.payload
          (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) index
            (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))) →
      NodeLaw formulas solver
          {
            inherited :=
              @Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
                (@descend width before combined index),
            value := first }
          firstResult →
        NodeLaw formulas solver
            {
              inherited :=
                @Prod.fst SourceEqualityConstraintAllocation.Value (SourceCurrentAllocatedPartialState.State width)
                  (@descend width middle combined
                    (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) index
                      (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))),
              value := second }
            secondResult →
          @WalkLaw width inst inst_1 inst_2 formulas solver budget combined index
            (@List.cons
              (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
              first
              (@List.cons
                (Value (SourceObservations.Label FullSyntax.Formula)
                  (SourceSymbolicIndex.Constraint FullSyntax.Formula))
                second
                (@List.nil
                  (Value (SourceObservations.Label FullSyntax.Formula)
                    (SourceSymbolicIndex.Constraint FullSyntax.Formula)))))
            (@List.cons
              (Value (SourceObservations.Label FullSyntax.Formula) (SourceSymbolicIndex.Constraint FullSyntax.Formula))
              firstResult
              (@List.cons
                (Value (SourceObservations.Label FullSyntax.Formula)
                  (SourceSymbolicIndex.Constraint FullSyntax.Formula))
                secondResult
                (@List.nil
                  (Value (SourceObservations.Label FullSyntax.Formula)
                    (SourceSymbolicIndex.Constraint FullSyntax.Formula)))))
            before after ⋯
@live_two_calls : ∀ [inst : DecidableEq (SourceObservations.Label FullSyntax.Formula)]
