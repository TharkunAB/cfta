@MicroCFTA.SourceCurrentAllocatedProjectionReadValidityProbes.root_two_ordered_reads : ∀
  [inst :
    DecidableEq
      (MicroCFTA.InternedConstructorTemplates.EdgeKey (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))]
  {first second result :
    MicroCFTA.InternedConstructorTemplates.Value (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {before middle afterReads after :
    MicroCFTA.InternedConstructorTemplates.State (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)}
  {left right :
    List
      (MicroCFTA.InternedConstructorTemplates.EdgeValue
        (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
        (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula))}
  {firstTrace : MicroCFTA.SourceEqualityProjectionRead.Read first before left middle}
  {secondTrace : MicroCFTA.SourceEqualityProjectionRead.Read second middle right afterReads}
  {memos : MicroCFTA.EndpointMemoGateTrace.Memos}
  {middleMemo finalMemo :
    MicroCFTA.InternedFreshOrdinaryUnfoldMemo.Memo (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
      (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)},
  MicroCFTA.SourceEqualityProjectionMemos.ReadReads firstTrace memos.unfolding middleMemo →
    MicroCFTA.SourceEqualityProjectionMemos.ReadReads secondTrace middleMemo finalMemo →
      MicroCFTA.InternedConstructorTemplates.run
            (MicroCFTA.InternedConstructorTemplates.makeNode (left ++ (right ++ []))) afterReads =
          (result, after) →
        MicroCFTA.SourceEqualityRequiredSemanticCache.SemanticReady before →
          MicroCFTA.InternedFreshOrdinaryCostHeap.Heap before →
            MicroCFTA.InternedNestedProvenance.Values before [first, second] →
              MicroCFTA.EndpointMemoGateTrace.Valid before memos →
                ∃ actual,
                  MicroCFTA.SourceEqualityQueryGlobalMemos.ProjectionReads actual memos
                      { unfolding := finalMemo, query := memos.query } ∧
                    MicroCFTA.EndpointMemoGateTrace.Valid after { unfolding := finalMemo, query := memos.query } ∧
                      MicroCFTA.Cache.Extends memos.unfolding finalMemo
