                    available closed).valid
                input →
              input ≠ Input.empty →
                ∀ (term : Term Symbol),
                  finiteLanguages (view target holds)
                      (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput target targetFacts holds targetRoots
                        ⋯ targetAvailable targetClosed)
                      (identity input) term ↔
                    finiteLanguages (view source holds)
                      (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput source sourceFacts holds roots
                        originals available closed)
                      (identity input) term
@target_root_valid : ∀ {Symbol Guard : Type} (target : InternedConstructorTemplates.State Symbol Guard)
  (facts : InternedNestedFacts.Facts target) (holds : Guard → Term Symbol → Bool) (roots : List (Value Symbol Guard))
  (available : Values target roots) (closed : ∀ (root : Value Symbol Guard), root ∈ roots → root.free = [])
  (root : Value Symbol Guard),
  root ∈ roots →
    (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput target facts holds roots ⋯ available closed).valid
      (inputOf root)
