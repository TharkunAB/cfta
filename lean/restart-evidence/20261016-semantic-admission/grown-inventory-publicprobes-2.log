@closed_originals : ∀ {Symbol Guard : Type} (target : InternedConstructorTemplates.State Symbol Guard),
  InternedNestedFacts.Facts target →
    ∀ (roots : List (Value Symbol Guard)),
      Values target roots →
        (∀ (root : Value Symbol Guard), root ∈ roots → root.free = []) →
          ∀ (root : Value Symbol Guard), root ∈ roots → Original root
@reachable_grows : ∀ {Symbol Guard : Type} (source target : InternedConstructorTemplates.State Symbol Guard),
  InternedNestedFacts.Facts source →
    InternedNestedFacts.Facts target →
      Grows source target →
        Extends source.nodes.issued target.nodes.issued →
          ∀ (holds : Guard → Term Symbol → Bool) (roots : List (Value Symbol Guard)),
            (∀ (root : Value Symbol Guard), root ∈ roots → Original root) →
              Values source roots →
                (∀ (root : Value Symbol Guard), root ∈ roots → root.free = []) →
                  ∀ (input : Input),
                    SourceCurrentAllocatedNativeInputInventoryModels.Reachable source holds roots input →
                      SourceCurrentAllocatedNativeInputInventoryModels.Reachable target holds roots input
@valid_grows : ∀ {Symbol Guard : Type} (source target : InternedConstructorTemplates.State Symbol Guard)
  (sourceFacts : InternedNestedFacts.Facts source) (targetFacts : InternedNestedFacts.Facts target),
  Grows source target →
    Extends source.nodes.issued target.nodes.issued →
      ∀ (holds : Guard → Term Symbol → Bool) (roots : List (Value Symbol Guard))
        (originals : ∀ (root : Value Symbol Guard), root ∈ roots → Original root) (available : Values source roots)
        (closed : ∀ (root : Value Symbol Guard), root ∈ roots → root.free = [])
        (targetRoots : List (Value Symbol Guard)) (targetAvailable : Values target targetRoots)
        (targetClosed : ∀ (root : Value Symbol Guard), root ∈ targetRoots → root.free = []),
        (∀ (root : Value Symbol Guard), root ∈ roots → root ∈ targetRoots) →
          ∀ (input : Input),
            (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput source sourceFacts holds roots originals
                    available closed).valid
                input →
              (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput target targetFacts holds targetRoots ⋯
                    targetAvailable targetClosed).valid
                input
@rank_exact : ∀ {Symbol Guard : Type} (source target : InternedConstructorTemplates.State Symbol Guard)
  (sourceFacts : InternedNestedFacts.Facts source) (targetFacts : InternedNestedFacts.Facts target),
  Grows source target →
    Extends source.nodes.issued target.nodes.issued →
      ∀ (holds : Guard → Term Symbol → Bool) (roots : List (Value Symbol Guard))
        (originals : ∀ (root : Value Symbol Guard), root ∈ roots → Original root) (available : Values source roots)
        (closed : ∀ (root : Value Symbol Guard), root ∈ roots → root.free = [])
        (targetRoots : List (Value Symbol Guard)) (targetAvailable : Values target targetRoots)
        (targetClosed : ∀ (root : Value Symbol Guard), root ∈ targetRoots → root.free = []),
        (∀ (root : Value Symbol Guard), root ∈ roots → root ∈ targetRoots) →
          ∀ (input : Input),
            (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput source sourceFacts holds roots originals
                    available closed).valid
                input →
              ∀ (rank : Nat) (term : Term Symbol),
                inputAt
                    (finiteRanks (view target holds)
                      (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput target targetFacts holds targetRoots
                        ⋯ targetAvailable targetClosed))
                    input rank term ↔
                  inputAt
                    (finiteRanks (view source holds)
                      (SourceCurrentAllocatedNativeInputInventoryModels.finiteInput source sourceFacts holds roots
                        originals available closed))
                    input rank term
