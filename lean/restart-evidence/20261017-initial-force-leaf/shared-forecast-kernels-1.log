'MicroCFTA.SharedForecastKernels.singleton_miss_then_hit' depends on axioms: [propext, Quot.sound.{u}]
MicroCFTA.SharedForecastKernels.singleton_miss_then_hit : ∀ (bits count : Nat) (seed : List.{0} Int)
  (profile : MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Profile),
  MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Room bits
      (MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.step
        (MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.step
          (MicroCFTA.SourceCurrentConstrainedCapTargetForecast.operand seed count profile))) →
    have first :=
      MicroCFTA.SourceCurrentConstrainedCapSharedForecast.leafProfile count
        (@List.cons.{0} (List.{0} Int) seed (@List.nil.{0} (List.{0} Int))) Bool.false profile;
    And
      (MicroCFTA.SourceCurrentConstrainedCapSharedForecast.LeafReserved bits count
        (@List.cons.{0} (List.{0} Int) seed (@List.nil.{0} (List.{0} Int))) Bool.false profile)
      (And
        (MicroCFTA.SourceCurrentConstrainedCapSharedForecast.LeafReserved bits count
          (@List.cons.{0} (List.{0} Int) seed (@List.nil.{0} (List.{0} Int))) Bool.true first)
        (And
          (@Eq.{1} MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Profile
            (MicroCFTA.SourceCurrentConstrainedCapSharedForecast.leafProfile count
              (@List.cons.{0} (List.{0} Int) seed (@List.nil.{0} (List.{0} Int))) Bool.true first)
            (MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.step
              (MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.step
                (MicroCFTA.SourceCurrentConstrainedCapTargetForecast.operand seed count profile))))
          (MicroCFTA.SourceCurrentAllocatedNativeResourceForecast.Le profile
            (MicroCFTA.SourceCurrentConstrainedCapSharedForecast.leafProfile count
              (@List.cons.{0} (List.{0} Int) seed (@List.nil.{0} (List.{0} Int))) Bool.true first))))
