                          (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                          (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)
                          (@MicroCFTA.SourceCurrentAllocatedSharedTargetState.State.memo width after))
                        (And
                          (@MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryOutputStored.Stored width
                            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula)
                            (@MicroCFTA.SourceEqualityNativeDemand.State.native width
                              (@MicroCFTA.SourceCurrentAllocatedSharedTargetState.State.checked width after)))
                          (@MicroCFTA.SourceCurrentAllocatedFiniteOrdinaryRequired.NodeNarrow
                            (MicroCFTA.SourceObservations.Label MicroCFTA.FullSyntax.Formula)
                            (MicroCFTA.SourceSymbolicIndex.Constraint MicroCFTA.FullSyntax.Formula) input second)))
