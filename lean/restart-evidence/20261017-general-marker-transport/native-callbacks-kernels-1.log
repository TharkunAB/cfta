'MicroCFTA.NativeCallbackKernels.serial' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
@serial : ∀ {Symbol Guard : Type} [inst : DecidableEq.{1} (EdgeKey Symbol Guard)] (annotation : Guard → Prop)
  (depth : Nat) (body : Value Symbol Guard) (old first second : Reference)
  (state : InternedConstructorTemplates.State Symbol Guard),
  @Ready Symbol Guard state →
    @Available Symbol Guard state body →
      @Available Symbol Guard state (@Value.reference Symbol Guard first) →
        @Available Symbol Guard state (@Value.reference Symbol Guard second) →
          @Cap Symbol Guard annotation depth body →
            @MuStored Guard Symbol annotation state →
              ∀ (weight : Reference → Nat) (bound : Nat),
                @Eq.{1} Nat (weight old) bound →
                  @Classified Symbol Guard weight bound body →
                    Not
                        (@Membership.mem.{0, 0} Reference (List.{0} Reference) (@List.instMembership.{0} Reference)
                          (@Value.free Symbol Guard body) first) →
                      Not
                          (@Membership.mem.{0, 0} Reference (List.{0} Reference) (@List.instMembership.{0} Reference)
                            (@Value.free Symbol Guard body) second) →
                        @Exists.{1} (Value Symbol Guard) fun left =>
                          @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun middle =>
                            @Exists.{1} (Value Symbol Guard) fun right =>
                              @Exists.{1} (InternedConstructorTemplates.State Symbol Guard) fun final =>
                                And
                                  (@Eq.{1} (Outcome Symbol Guard (Value Symbol Guard))
                                    (@SourceRecursiveIntersectionMaybeMu.callback Symbol Guard inst old body first
                                      state)
                                    (@Outcome.done Symbol Guard (Value Symbol Guard) left middle))
                                  (And
                                    (@Eq.{1} (Outcome Symbol Guard (Value Symbol Guard))
                                      (@SourceRecursiveIntersectionMaybeMu.callback Symbol Guard inst old body second
                                        middle)
                                      (@Outcome.done Symbol Guard (Value Symbol Guard) right final))
                                    (And (@Cap Symbol Guard annotation depth left)
                                      (And (@Cap Symbol Guard annotation depth right)
                                        (And (@Classified Symbol Guard (mark weight first bound) bound left)
                                          (And (@Classified Symbol Guard (mark weight second bound) bound right)
                                            (And (@MuStored Guard Symbol annotation final)
                                              (@Keeps Symbol Guard state final)))))))
