-- Check the cfta library with LiquidHaskell:
--   cabal build cfta:lib:cfta --project-file=cabal.project.liquid
-- The plugin runs inside GHC at compile time. Build it with optimization,
-- because an unoptimized plugin makes each check slow.
import: cabal.project

package cfta
  flags: +liquid

package liquidhaskell-boot
  optimization: True

package liquidhaskell
  optimization: True
